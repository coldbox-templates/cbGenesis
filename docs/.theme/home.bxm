	<!--- Sponsorship Section --->
	<section>
		<div class="bxh-wrap">
			<div class="cta sponsor-cta">
				<span class="eyebrow">Built with community support</span>
				<a class="sponsor-logo" href="https://loebelectric.com/" target="_blank" rel="noopener noreferrer" aria-label="Visit Loeb Electric website">
					<img src="https://loebelectric.com/wp-content/themes/loebelectric/images/loeb-electric-logo.png" alt="Loeb Electric">
				</a>
				<p>Loeb Electric and Gary Knight are sponsoring the cbGenesis initiative. Their support helps make this work possible.</p>
				<p>Help sponsor cbGenesis development and new features through Patreon or by contacting us directly.</p>
				<div class="hero-actions">
					<a class="bxh-btn bxh-btn-primary" href="https://www.patreon.com/ortussolutions" target="_blank" rel="noopener noreferrer">Sponsor us on Patreon</a>
					<a class="bxh-btn bxh-btn-ghost" href="mailto:consulting@ortussolutions.com">Email us about sponsoring</a>
				</div>
			</div>
		</div>
	</section>

	<!--- Footer Section --->
	<footer class="bxh-footer">
