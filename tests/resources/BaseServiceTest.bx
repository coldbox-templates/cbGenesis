/**
 * Base test class for all service unit tests
 *
 * Provides transaction-based rollback so tests never corrupt database state.
 * Extends BaseModelTest and adds an @aroundEach wrapper that begins a
 * transaction, runs the spec, then rolls back in the finally block.
 *
 * @model annotation must be set to the service path under test.
 */
@model( "app.models.BaseService" )
class extends="coldbox.system.testing.BaseModelTest" {


	/*********************************** LIFE CYCLE Methods ***********************************/

	/**
	 * Run before all tests
	 */
	function beforeAll() {
		super.beforeAll();
		super.setup();
		model.init();
	}

	/**
	 * Run after all tests
	 */
	function afterAll() {
		super.afterAll();
	}

	/*********************************** BDD SUITES ***********************************/

	/**
	 * Wrap every spec in a database transaction that is rolled back afterwards.
	 * This prevents any test from leaving permanent data in the database.
	 *
	 * @aroundEach
	 */
	function wrapInTransaction( spec ) {
		transaction action="begin" {
			try {
				arguments.spec.body( argumentCollection = arguments );
			} catch ( any e ) {
				rethrow;
			} finally {
				transaction action="rollback";
			}
		}
	}

}
