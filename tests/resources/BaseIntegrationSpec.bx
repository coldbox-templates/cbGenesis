@appMapping( "/cbapp" )
@autowire
class extends="coldbox.system.testing.BaseTestCase"{

	/**
	 * --------------------------------------------------------------------------
	 * Dependency Injection
	 * --------------------------------------------------------------------------
	 */

	@inject( "provider:securityService" )
	property name="securityService";

	@inject( "provider:settingService" )
	property name="settingService";

	@inject( "provider:JWTService@cbsecurity" )
	property name="jwt";

	@inject( "provider:CBSecurity@cbsecurity" )
	property name="cbsecure";

	@inject( "provider:QueryBuilder@qb" )
	property name="qb";

	@inject( "provider:UserService" )
	property name="userService";


    // Load on first test
    this.loadColdBox    = true;
    // Never unload until the request dies
    this.unloadColdBox  = false;

	/**
	 * --------------------------------------------------------------------------
	 * Fixture Data
	 * --------------------------------------------------------------------------
	 * Here is the global fixture data you can use
	 */
	variables.bCryptHashOfPasswordTest = "$2a$12$FE2J7ZLWaI2rSqejAu/84uLy7qlSufQsDsSE1lNNKyA05GG30gr8C";
	variables.testPassword = "test";

	/**
	 * --------------------------------------------------------------------------
	 * Life Cycle Methods
	 * --------------------------------------------------------------------------
	 */

	function beforeAll() {
		// Setup ColdBox
		super.beforeAll()

		// Make sure the settings are loaded and valid
		settingService.preFlightCheck()

		// Clear ORM Session, this is important to avoid caching issues with ORM and the tests
		ormClearSession()

		// Logout just in case
		securityService.logout()
	}

    /**
     * This function is tagged as an around each handler.  All the integration tests we build
     * will be automatically rolled backed. No database corruption
     *
     * @aroundEach
     */
    function aroundTransaction( spec ) {
        transaction action="begin" {
            try {
                arguments.spec.body();
            } catch ( any e ){
                rethrow;
            } finally {
                transaction action="rollback";
            }
        }
    }

	/****************** fixture methods *********************/

	function keyChecksOff() {
		queryExecute( "SET FOREIGN_KEY_CHECKS=0;" );
	}

	function keyChecksOn() {
		queryExecute( "SET FOREIGN_KEY_CHECKS=1;" );
	}

	/**
	 * Seed a table with records.  This is a helper method to make it easier to seed data for integration tests.
	 *
	 * @table The table name to seed
	 * @records The array of structs to seed into the table
	 */
	function seed( required table, required records ) {
		variables.qb.newQuery()
			.from( arguments.table )
			.insert( arguments.records )
		return this
	}

	/**
	 * Get a base record with default values for testing.  This is a helper method to make it easier to seed data for integration tests.
	 *
	 * @id The id to use for the record, or it defaults to 'id'
	 */
	function getBaseRecord( id = "id" ) {
		return {
			"#arguments.id#": createUUID(),
			"isActive": true,
			"createdDate": now(),
			"updatedDate": now()
		}
	}

	/**
	 * Create a verified user for authentication integration tests.
	 * The surrounding test transaction rolls the user back automatically.
	 */
	User function createVerifiedUser( string email = "security-test-#createUUID()#@example.com" ) {
		var user = userService.new( {
			firstName: "Security",
			lastName: "Tester",
			email: arguments.email,
			password: "correct-password",
			verifiedAt: now()
		} )
		return userService.save( user )
	}

}
