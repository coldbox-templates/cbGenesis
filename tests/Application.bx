class {

	/**
	 * --------------------------------------------------------------------------
	 * Application Properties: Modify as you see fit!
	 * --------------------------------------------------------------------------
	 */
	this.name = "ColdBoxTestingSuite"
	this.sessionManagement = true
	this.setClientCookies = true
	this.sessionTimeout = createTimespan( 0, 0, 15, 0 )
	this.applicationTimeout = createTimespan( 0, 0, 15, 0 )

	/**
	 * --------------------------------------------------------------------------
	 * Location Mappings
	 * --------------------------------------------------------------------------
	 * The majority of mappings are in the boxlang.json pre-configured for you
	 * so they can be reused.
	 */
	_testsRoot = getDirectoryFromPath( getCurrentTemplatePath() )
	_appRoot = REReplaceNoCase( _testsRoot, "tests(\\|/)", "" )
	// Create testing mapping
	this.mappings[ "/tests" ]   = _testsRoot

	/**
	 * --------------------------------------------------------------------------
	 * ORM + Datasource Settings
	 * --------------------------------------------------------------------------
	 */
	this.datasource = "cbGenesis"
	cbGenesisDatasource = {
		driver: getSystemSetting( "DB_DRIVER", "mysql" ),
		host: getSystemSetting( "DB_HOST", "localhost" ),
		port: getSystemSetting( "DB_PORT", 3306 ),
		database: getSystemSetting( "DB_DATABASE", "cbGenesis" ),
		username: getSystemSetting( "DB_USER", "" ),
		password: getSystemSetting( "DB_PASSWORD", "" )
	}
	// SQLite only allows one writer at a time; without a busy timeout, a second
	// connection's write while another is in-flight fails immediately with
	// "SQLITE_BUSY: database is locked" instead of waiting for the lock to clear.
	if ( cbGenesisDatasource.driver == "sqlite" ) {
		cbGenesisDatasource.connectionInitSql = "PRAGMA busy_timeout = 5000;"
	}
	this.datasources = {
		"cbGenesis" = cbGenesisDatasource
	}
	// ORM SETTINGS
	this.ormEnabled = true;
	this.ormSettings = {
		entityPaths: [ "/app/models" ],
		dbcreate: "none",
		savemapping: false,
		secondarycacheenabled: false,
		// Temporarily enabled to diagnose an MSSQL-only SQLGrammarException; revert once resolved.
		logSQL: true,
		flushAtRequestEnd: false,
		autoManageSession: false,
		eventHandling: true,
		eventHandler: "cborm.models.BXEventHandler",
		ignoreParseErrors: true,
		// Quote all table/column identifiers so reserved words (e.g. the "value"
		// column on settings) don't break on databases like MSSQL that reserve them.
		quoteIdentifiers: true
	}

	/**
	 * Fires on every test request. It builds a Virtual ColdBox application for you
	 *
	 * @targetPage The requested page
	 */
	public boolean function onRequestStart( targetPage ) output="true"{
		// Set a high timeout for long running tests
		bx:setting requestTimeout   ="9999";

		// New ColdBox Virtual Application Starter
		request.coldBoxVirtualApp= new coldbox.system.testing.VirtualApp(
			appMapping : "/app",
			webMapping : "/public"
		)

		// If hitting the runner or specs, prep our virtual app
		if ( getBaseTemplatePath().replace( expandPath( "/tests" ), "" ).reFindNoCase( "(runner|specs)" ) ) {
			request.coldBoxVirtualApp.startup( true );
		}

		// Reload for fresh results
		if ( structKeyExists( url, "fwreinit" ) ) {
			pagePoolClear()
			ormReload()
			request.coldBoxVirtualApp.restart();
		}

		return true;
	}

	/**
	 * Fires when the testing requests end and the ColdBox application is shutdown
	 */
	public void function onRequestEnd( required targetPage ){
		request.coldBoxVirtualApp.shutdown();
	}

}
