/**
 * Integration tests for the Auth handler's doLogin() action, exercised via execute()
 * (the documented way to test a ColdBox handler action end-to-end and assert
 * relocate() targets through the request collection's "relocate_*" keys).
 *
 * CSRF is generated for real through the injected cbcsrf service rather than relying
 * on a dummy token, since csrfVerify() is a manual call inside doLogin() rather than
 * the cbcsrf auto-verifier interceptor.
 */
class extends="tests.resources.BaseIntegrationSpec" {

	@inject( "@cbcsrf" )
	property name="cbcsrf";

	@inject
	property name="userActionTokenService";

	/*********************************** LIFE CYCLE Methods ***********************************/

	function beforeAll() {
		super.beforeAll();
	}

	/*********************************** BDD SUITES ***********************************/

	function run() {
		describe( "Auth Handler", () => {
			beforeEach( ( currentSpec ) => {
				// Setup as a new ColdBox request, VERY IMPORTANT. ELSE EVERYTHING LOOKS LIKE THE SAME REQUEST.
				setup();
				securityService.logout( quiet: true );
			} );

			story( "Log in with a reset-pending account", () => {
				it( "redirects a correct password straight into the reset-password flow instead of failing", () => {
					var user = createVerifiedUser();
					user.setIsPasswordReset( true );
					userService.save( user );

					form.email = user.getEmail();
					form.password = "correct-password";
					form.csrf = cbcsrf.generate();

					var event = execute( "auth.doLogin" );

					expect( securityService.isLoggedIn() ).toBeFalse();
					expect( event.getValue( "relocate_event", "" ) ).toInclude( "reset-password?token=" );
				} );

				it( "still rejects a wrong password without ever reaching the reset-pending check", () => {
					var user = createVerifiedUser();
					user.setIsPasswordReset( true );
					userService.save( user );

					form.email = user.getEmail();
					form.password = "wrong-password";
					form.csrf = cbcsrf.generate();

					var event = execute( "auth.doLogin" );

					expect( securityService.isLoggedIn() ).toBeFalse();
					expect( event.getValue( "relocate_event", "" ) ).toBe( "login" );
				} );
			} );

			story( "Log in with a normal verified account", () => {
				it( "logs in and relocates to the dashboard with correct credentials", () => {
					var user = createVerifiedUser();

					form.email = user.getEmail();
					form.password = "correct-password";
					form.csrf = cbcsrf.generate();

					var event = execute( "auth.doLogin" );

					expect( securityService.isLoggedIn() ).toBeTrue();
					expect( event.getValue( "relocate_event", "" ) ).toBe( "dashboard" );
				} );

				it( "rejects an incorrect password", () => {
					var user = createVerifiedUser();

					form.email = user.getEmail();
					form.password = "wrong-password";
					form.csrf = cbcsrf.generate();

					var event = execute( "auth.doLogin" );

					expect( securityService.isLoggedIn() ).toBeFalse();
					expect( event.getValue( "relocate_event", "" ) ).toBe( "login" );
				} );
			} );

			story( "verifyEmailChange() confirms a pending email change even while the confirming user is still logged in", () => {
				it( "swaps the email and redirects to profile - not login - for a still-logged-in confirmer", () => {
					var user = createVerifiedUser();
					securityService.authenticate( username: user.getEmail(), password: "correct-password" );
					var newEmail = "confirmed-#createUUID()#@example.com";
					userService.requestEmailChange( user, newEmail );
					var tokenResult = userActionTokenService.issue(
						user: user,
						purpose: userActionTokenService.PURPOSE_EMAIL_CHANGE,
						expiresAt: dateAdd( "h", 24, now() )
					);

					form.token = tokenResult.rawToken;
					var event = execute( "auth.verifyEmailChange" );

					expect( event.getValue( "relocate_event", "" ) ).toBe( "profile" );
					expect( securityService.isLoggedIn() ).toBeTrue();
					var reloaded = userService.getOrFail( user.getUserId() );
					expect( reloaded.getEmail() ).toBe( newEmail );
					expect( reloaded.getPendingEmail() ).toBe( "" );
				} );

				it( "redirects to login for an invalid token without a session", () => {
					securityService.logout( quiet: true );

					form.token = "bxt_not-a-real-token";
					var event = execute( "auth.verifyEmailChange" );

					expect( event.getValue( "relocate_event", "" ) ).toBe( "login" );
				} );
			} );
		} );
	}
}
