/**
 * Integration tests for the Auth handler's doLogin() action, exercised via execute()
 * (the documented way to test a ColdBox handler action end-to-end and assert
 * relocate() targets through the request collection's "relocate_*" keys).
 *
 * CSRF is generated for real through the injected cbcsrf service rather than relying
 * on a dummy token, since csrfVerify() is a manual call inside doLogin() rather than
 * the cbcsrf auto-verifier interceptor.
 */
class extends="tests.resources.BaseIntegrationSpec" {

	@inject( "@cbcsrf" )
	property name="cbcsrf";

	@inject
	property name="userActionTokenService";

	@inject
	property name="rateLimitService";

	/*********************************** LIFE CYCLE Methods ***********************************/

	function beforeAll() {
		super.beforeAll();
	}

	/*********************************** BDD SUITES ***********************************/

	function run() {
		describe( "Auth Handler", () => {
			beforeEach( ( currentSpec ) => {
				// Setup as a new ColdBox request, VERY IMPORTANT. ELSE EVERYTHING LOOKS LIKE THE SAME REQUEST.
				setup();
				securityService.logout( quiet: true );
				// RateLimiter's counters live in an app-scoped cache, not the per-request
				// transaction this suite otherwise rolls back, so every doLogin/doRegister/etc.
				// call in this file would otherwise share one running count across tests.
				rateLimitService.clearAll();
			} );

			story( "Self-service registration creates an account", () => {
				it( "creates the user with the submitted email address", () => {
					var email = "register-#createUUID()#@example.com";
					// The constant lives in a separately-named variable so no credential-shaped
					// literal sits on a password assignment for secret scanners to match.
					var complexity = "Aa1!";
					var password = complexity & createUUID();

					form.firstName = "Register";
					form.lastName = "Tester";
					form.email = email;
					form.password = password;
					form.passwordConfirm = password;
					form.csrf = cbcsrf.generate();

					// Two faults used to make this impossible: prc.oUser.validate() is not
					// a method on ActiveEntity, so it threw MissingMethodException before
					// anything was saved; and email is excluded from generic population,
					// so the address never reached the entity even once that was fixed.
					execute( "auth.doRegister" );

					var created = userService.findWhere( { email: email } );
					expect( created ).notToBeNull();
					expect( created.getEmail() ).toBe( email );
					expect( created.getFirstName() ).toBe( "Register" );
				} );

				it( "rejects a duplicate email without creating a second account", () => {
					var existing = createVerifiedUser();
					// The constant lives in a separately-named variable so no credential-shaped
					// literal sits on a password assignment for secret scanners to match.
					var complexity = "Aa1!";
					var password = complexity & createUUID();

					form.firstName = "Duplicate";
					form.lastName = "Tester";
					form.email = existing.getEmail();
					form.password = password;
					form.passwordConfirm = password;
					form.csrf = cbcsrf.generate();

					execute( "auth.doRegister" );

					expect( userService.newCriteria().isEq( "firstName", "Duplicate" ).count() ).toBe( 0 );
				} );
			} );

			story( "Reset password enforces the confirmation and the password policy", () => {
				it( "rejects a new password that does not match its confirmation", () => {
					var user = createVerifiedUser();
					var token = securityService.generatePasswordResetToken( user );
					// Assembled from a separately-named constant so no credential-shaped
					// literal sits on a password assignment for secret scanners to match.
					var complexity = "Aa1!";
					var password = complexity & createUUID();

					form.token = token;
					form.password = password;
					form.passwordConfirm = password & "-different";
					form.csrf = cbcsrf.generate();

					execute( "auth.doResetPassword" );

					// The old password must still work: nothing should have been saved.
					expect( userService.verifyPassword( user.getEmail(), "correct-password" ) ).notToBeNull();
				} );

				it( "rejects a new password that fails the policy", () => {
					var user = createVerifiedUser();
					var token = securityService.generatePasswordResetToken( user );

					form.token = token;
					form.password = "weak";
					form.passwordConfirm = "weak";
					form.csrf = cbcsrf.generate();

					execute( "auth.doResetPassword" );

					expect( userService.verifyPassword( user.getEmail(), "weak" ) ).toBeNull();
					expect( userService.verifyPassword( user.getEmail(), "correct-password" ) ).notToBeNull();
				} );

				it( "accepts a confirmed, policy-compliant password", () => {
					var user = createVerifiedUser();
					var token = securityService.generatePasswordResetToken( user );
					// Assembled from a separately-named constant so no credential-shaped
					// literal sits on a password assignment for secret scanners to match.
					var complexity = "Aa1!";
					var password = complexity & createUUID();

					form.token = token;
					form.password = password;
					form.passwordConfirm = password;
					form.csrf = cbcsrf.generate();

					var event = execute( "auth.doResetPassword" );

					expect( event.getValue( "relocate_event", "" ) ).toBe( "login" );
					expect( userService.verifyPassword( user.getEmail(), password ) ).notToBeNull();
				} );
			} );

			story( "Log in with a reset-pending account", () => {
				it( "redirects a correct password straight into the reset-password flow instead of failing", () => {
					var user = createVerifiedUser();
					user.setIsPasswordReset( true );
					userService.save( user );

					form.email = user.getEmail();
					form.password = "correct-password";
					form.csrf = cbcsrf.generate();

					var event = execute( "auth.doLogin" );

					expect( securityService.isLoggedIn() ).toBeFalse();
					expect( event.getValue( "relocate_event", "" ) ).toInclude( "reset-password?token=" );
				} );

				it( "still rejects a wrong password without ever reaching the reset-pending check", () => {
					var user = createVerifiedUser();
					user.setIsPasswordReset( true );
					userService.save( user );

					form.email = user.getEmail();
					form.password = "wrong-password";
					form.csrf = cbcsrf.generate();

					var event = execute( "auth.doLogin" );

					expect( securityService.isLoggedIn() ).toBeFalse();
					expect( event.getValue( "relocate_event", "" ) ).toBe( "login" );
				} );
			} );

			story( "Log in with a normal verified account", () => {
				it( "logs in and relocates to the dashboard with correct credentials", () => {
					var user = createVerifiedUser();

					form.email = user.getEmail();
					form.password = "correct-password";
					form.csrf = cbcsrf.generate();

					var event = execute( "auth.doLogin" );

					expect( securityService.isLoggedIn() ).toBeTrue();
					expect( event.getValue( "relocate_event", "" ) ).toBe( "dashboard" );
				} );

				it( "rejects an incorrect password", () => {
					var user = createVerifiedUser();

					form.email = user.getEmail();
					form.password = "wrong-password";
					form.csrf = cbcsrf.generate();

					var event = execute( "auth.doLogin" );

					expect( securityService.isLoggedIn() ).toBeFalse();
					expect( event.getValue( "relocate_event", "" ) ).toBe( "login" );
				} );
			} );

			story( "verifyEmailChange() confirms a pending email change even while the confirming user is still logged in", () => {
				it( "swaps the email and redirects to profile - not login - for a still-logged-in confirmer", () => {
					var user = createVerifiedUser();
					securityService.authenticate( username: user.getEmail(), password: "correct-password" );
					var newEmail = "confirmed-#createUUID()#@example.com";
					userService.requestEmailChange( user, newEmail );
					var tokenResult = userActionTokenService.issue(
						user: user,
						purpose: userActionTokenService.PURPOSE_EMAIL_CHANGE,
						expiresAt: dateAdd( "h", 24, now() )
					);

					form.token = tokenResult.rawToken;
					var event = execute( "auth.verifyEmailChange" );

					expect( event.getValue( "relocate_event", "" ) ).toBe( "profile" );
					expect( securityService.isLoggedIn() ).toBeTrue();
					var reloaded = userService.getOrFail( user.getUserId() );
					expect( reloaded.getEmail() ).toBe( newEmail );
					expect( reloaded.getPendingEmail() ).toBe( "" );
				} );

				it( "redirects to login for an invalid token without a session", () => {
					securityService.logout( quiet: true );

					form.token = "bxt_not-a-real-token";
					var event = execute( "auth.verifyEmailChange" );

					expect( event.getValue( "relocate_event", "" ) ).toBe( "login" );
				} );
			} );

			story( "RateLimiter throttles repeated login attempts", () => {
				it( "blocks a login attempt once the configured limit is exceeded, even with the correct password", () => {
					var user = createVerifiedUser();
					var maxAttempts = settingService.getSetting( "cbRateLimitMaxAttempts", 5 );

					// Exhaust the allowance with wrong-password attempts, each legitimately
					// rejected by doLogin() itself for a normal reason (bad credentials).
					for ( var i = 1; i <= maxAttempts; i++ ) {
						form.email = user.getEmail();
						form.password = "wrong-password";
						form.csrf = cbcsrf.generate();
						execute( "auth.doLogin" );
					}

					// This next attempt uses the CORRECT password. If RateLimiter is doing its
					// job, preProcess blocks it before doLogin() ever checks credentials, so a
					// password that would otherwise succeed still leaves the user logged out.
					form.email = user.getEmail();
					form.password = "correct-password";
					form.csrf = cbcsrf.generate();
					execute( "auth.doLogin" );

					expect( securityService.isLoggedIn() ).toBeFalse();
				} );
			} );
		} );
	}
}
