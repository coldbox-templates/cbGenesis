class extends="tests.resources.BaseIntegrationSpec" {

	function run() {
		describe( "Auth Handler", () => {
			beforeEach( () => {
				setup()
			} )

			it( "renders the registration form", () => {
				var event = get( route = "/register" )

				expect( event.getCurrentView() ).toBe( "auth/register" )
			} )

			it( "rejects a registration with an invalid csrf token", () => {
				var event = post(
					route : "/register",
					params: {
						firstName     : "Test",
						lastName      : "User",
						email         : "registration-#createUUID()#@example.com",
						password      : "CorrectPassword123!",
						passwordConfirm: "CorrectPassword123!",
						_token        : "invalid-token"
					}
				)

				expect( getFlashScope().exists( "errors" ) ).toBeTrue()
			} )

			it( "returns field validation errors without persisting credentials", () => {
				prepareMock( getInstance( "@cbcsrf" ) )
					.$( "verify" )
					.$results( true )
				var event = post(
					route : "/register",
					params: {
						firstName     : "",
						lastName      : "",
						email         : "not-an-email",
						password      : "short",
						passwordConfirm: "different",
						_token        : "valid-token"
					}
				)

				var validationErrors = event.getPrivateValue( "validationErrors" )
				expect( event.getCurrentView() ).toBe( "auth/register" )
				expect( structKeyExists( validationErrors, "email" ) ).toBeTrue()
				expect( structKeyExists( validationErrors, "passwordConfirm" ) ).toBeTrue()
			} )
		} )
	}
}
