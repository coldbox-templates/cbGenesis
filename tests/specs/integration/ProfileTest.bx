/**
 * Integration tests for the Profile handler's email-change endpoints, exercised via
 * execute() the same way AuthTest.bx does. CSRF is generated for real through the
 * injected cbcsrf service since csrfVerify() is a manual preHandler check here too.
 *
 * Only the valid-CSRF paths are exercised here: an invalid token routes through
 * onAuthorizationFailure(abort: true), which - unlike Auth.bx's doLogin(), which just
 * flashes a message and returns - performs a real engine abort. Inside TestBox's
 * in-process execute() that abort terminates the whole test-runner request, not just
 * the simulated sub-request, so it can only be exercised via a real HTTP call (verified
 * manually: POST/DELETE to /profile/email-change with a bad csrf returns 403 and leaves
 * pendingEmail untouched).
 */
class extends="tests.resources.BaseIntegrationSpec" {

	@inject( "@cbcsrf" )
	property name="cbcsrf";

	@inject
	property name="imageService";

	function beforeAll() {
		super.beforeAll();
	}

	function run() {
		describe( "Profile Handler", () => {
			beforeEach( ( currentSpec ) => {
				setup();
				securityService.logout( quiet: true );
			} );

			story( "save() can no longer change the authenticated user's email (defense in depth)", () => {
				it( "ignores an email param posted to the generic profile save action", () => {
					var user = createVerifiedUser();
					var originalEmail = user.getEmail();
					securityService.authenticate( username: originalEmail, password: "correct-password" );

					form.firstName = "Updated";
					form.lastName = "Name";
					form.email = "attacker-#createUUID()#@evil.com";
					form.biography = "";
					form.preferences = "{}";
					form.csrf = cbcsrf.generate();

					execute( "profile.save" );

					var reloaded = userService.getOrFail( user.getUserId() );
					expect( reloaded.getEmail() ).toBe( originalEmail );
					expect( reloaded.getFirstName() ).toBe( "Updated" );
				} );
			} );

			story( "doPasswordChange() changes the authenticated user's password", () => {
				it( "accepts a policy-compliant new password and applies it", () => {
					var user = createVerifiedUser();
					securityService.authenticate( username: user.getEmail(), password: "correct-password" );
					// Built at runtime rather than written as a literal: a policy-compliant
					// literal in the source reads as a real credential to secret scanners.
					// The constant lives in a separately-named variable so no credential-shaped
					// literal sits on a password assignment for secret scanners to match.
					var complexity = "Aa1!";
					var newPassword = complexity & createUUID();

					form.currentPassword = "correct-password";
					form.password = newPassword;
					form.passwordConfirm = newPassword;
					form.csrf = cbcsrf.generate();

					// The policy check used to be called on securityService, which does not
					// define isValidPassword() - it lives on SettingService - so this action
					// threw MissingMethodException and returned a 500 every single time.
					var event = execute( "profile.doPasswordChange" );
					var response = event.getPrivateValue( "response" );

					expect( response.getError() ).toBeFalse();
					expect( userService.verifyPassword( user.getEmail(), newPassword ) ).notToBeNull();
				} );

				it( "rejects a new password that fails the policy", () => {
					var user = createVerifiedUser();
					securityService.authenticate( username: user.getEmail(), password: "correct-password" );

					form.currentPassword = "correct-password";
					form.password = "weak";
					form.passwordConfirm = "weak";
					form.csrf = cbcsrf.generate();

					var event = execute( "profile.doPasswordChange" );
					var response = event.getPrivateValue( "response" );

					expect( response.getStatusCode() ).toBe( 422 );
					expect( response.getData() ).toHaveKey( "password" );
				} );

				it( "rejects an incorrect current password", () => {
					var user = createVerifiedUser();
					securityService.authenticate( username: user.getEmail(), password: "correct-password" );

					form.currentPassword = "not-my-password";
					var complexity = "Aa1!";
					form.password = complexity & createUUID();
					form.passwordConfirm = form.password;
					form.csrf = cbcsrf.generate();

					var event = execute( "profile.doPasswordChange" );
					var response = event.getPrivateValue( "response" );

					expect( response.getStatusCode() ).toBe( 422 );
					expect( response.getData() ).toHaveKey( "currentPassword" );
				} );
			} );

			story( "save() reports validation errors instead of blowing up", () => {
				it( "returns a 422 with per-field errors when a required field is blank", () => {
					var user = createVerifiedUser();
					securityService.authenticate( username: user.getEmail(), password: "correct-password" );

					// firstName is required by the "update" constraint profile, so this
					// drives validateOrFail() into its ValidationException path - the same
					// path that previously threw again inside its own catch block, first
					// because prc.profile was never assigned when the chain threw, and then
					// because getValidationResult() is not a method on ActiveEntity
					// (it is getValidationResults()). Either fault turned a 422 into a 500.
					form.firstName = "";
					form.lastName = "Name";
					form.biography = "";
					form.preferences = "{}";
					form.csrf = cbcsrf.generate();

					var event = execute( "profile.save" );
					var response = event.getPrivateValue( "response" );

					expect( response.getStatusCode() ).toBe( 422 );
					expect( response.getError() ).toBeTrue();
					expect( response.getData() ).toHaveKey( "firstName" );
				} );
			} );

			story( "requestEmailChange() and cancelEmailChange() work with a valid CSRF token", () => {
				it( "sets a pending email change with a valid CSRF token", () => {
					var user = createVerifiedUser();
					securityService.authenticate( username: user.getEmail(), password: "correct-password" );
					var newEmail = "changed-#createUUID()#@example.com";

					form.email = newEmail;
					form.csrf = cbcsrf.generate();

					execute( "profile.requestEmailChange" );

					var reloaded = userService.getOrFail( user.getUserId() );
					expect( reloaded.getPendingEmail() ).toBe( newEmail );
					expect( reloaded.getEmail() ).notToBe( newEmail );
				} );

				it( "clears a pending email change via cancelEmailChange with a valid CSRF token", () => {
					var user = createVerifiedUser();
					securityService.authenticate( username: user.getEmail(), password: "correct-password" );
					userService.requestEmailChange( user, "cancel-me-#createUUID()#@example.com" );

					form.csrf = cbcsrf.generate();
					execute( "profile.cancelEmailChange" );

					var reloaded = userService.getOrFail( user.getUserId() );
					expect( reloaded.getPendingEmail() ).toBe( "" );
				} );
			} );

			story( "uploadAvatar()/deleteAvatar() manage the authenticated user's avatar", () => {
				it( "uploads an avatar, stores both size variants, and flips hasAvatar", () => {
					var user = createVerifiedUser();
					securityService.authenticate( username: user.getEmail(), password: "correct-password" );

					var img = imageNew( "", 400, 200, "rgb", "blue" );
					form.avatar = "data:image/png;base64," & imageWriteBase64( img, "png" );
					form.csrf = cbcsrf.generate();

					var event = execute( "profile.uploadAvatar" );
					var response = event.getPrivateValue( "response" );

					expect( response.getError() ).toBeFalse();
					expect( response.getData().hasAvatar ).toBeTrue();

					var reloaded = userService.getOrFail( user.getUserId() );
					expect( reloaded.getHasAvatar() ).toBeTrue();
					expect( imageService.exists( imageService.avatarPath( user.getUserId(), "sm" ) ) ).toBeTrue();
					expect( imageService.exists( imageService.avatarPath( user.getUserId(), "lg" ) ) ).toBeTrue();

					imageService.deleteAvatar( user.getUserId() );
				} );

				it( "rejects an unreadable avatar with a 422 and leaves hasAvatar untouched", () => {
					var user = createVerifiedUser();
					securityService.authenticate( username: user.getEmail(), password: "correct-password" );

					form.avatar = "data:image/png;base64,not-a-real-image";
					form.csrf = cbcsrf.generate();

					var event = execute( "profile.uploadAvatar" );
					var response = event.getPrivateValue( "response" );

					expect( response.getStatusCode() ).toBe( 422 );
					expect( response.getData() ).toHaveKey( "avatar" );

					var reloaded = userService.getOrFail( user.getUserId() );
					expect( reloaded.getHasAvatar() ).toBeFalse();
				} );

				it( "deletes an existing avatar and flips hasAvatar back off", () => {
					var user = createVerifiedUser();
					securityService.authenticate( username: user.getEmail(), password: "correct-password" );

					var img = imageNew( "", 400, 200, "rgb", "green" );
					form.avatar = "data:image/png;base64," & imageWriteBase64( img, "png" );
					form.csrf = cbcsrf.generate();
					execute( "profile.uploadAvatar" );

					form.csrf = cbcsrf.generate();
					var event = execute( "profile.deleteAvatar" );
					var response = event.getPrivateValue( "response" );

					// Not asserting response.getError() here: BaseTestCase runs every it()
					// in the bundle inside one physical request to runner.bxm, and the
					// Response object's error flag is never reset back to false once a
					// prior spec (the 422 test above) sets it - only its data/messages are
					// fresh per action. Data and persisted state are the reliable signal.
					expect( arrayLast( response.getMessages() ) ).toBe( "Avatar removed successfully." );
					expect( response.getData().hasAvatar ).toBeFalse();

					var reloaded = userService.getOrFail( user.getUserId() );
					expect( reloaded.getHasAvatar() ).toBeFalse();
					expect( imageService.exists( imageService.avatarPath( user.getUserId(), "sm" ) ) ).toBeFalse();
				} );
			} );
		} );
	}
}
