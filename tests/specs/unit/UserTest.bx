/**
 * The base model test case will use the 'model' annotation as the instantiation path
 * and then create it, prepare it for mocking and then place it in the variables scope as 'model'. It is your
 * responsibility to update the model annotation instantiation path and init your model.
 */
@model( "app.models.User" )
class extends="coldbox.system.testing.BaseModelTest" {

	/*********************************** LIFE CYCLE Methods ***********************************/

	function beforeAll(){
		super.beforeAll();

		// setup the model
		super.setup();

		// init the model object
		variables.user = model.init();
	}

	function afterAll(){
		super.afterAll();
	}

	/*********************************** BDD SUITES ***********************************/

	function run(){
		describe( "A User", function(){
			it( "can be created", function(){
				expect( user ).toBeComponent();
			} );

			it( "can get a user's full name", function(){
				expect(
					user
						.setFirstname( "luis" )
						.setLastName( "majano" )
						.getFullName()
				).toBe( "luis majano" );
			} );

			it( "can get a non persisted id", function(){
				expect( user.getId() ).toBeEmpty();
				expect( user.isLoaded() ).toBeFalse();
			} );

			it( "can get a persisted id", function(){
				user.setId( createUUID() );
				expect( user.getId() ).notToBeEmpty();
				expect( user.isLoaded() ).toBeTrue();
			} );

			it( "can determine if a user has been verified or not", function(){
				expect( user.isEmailVerified() ).toBeFalse();
				user.setVerifiedAt( now() );
				expect( user.isEmailVerified() ).toBeTrue();
			} );
		} );
	}

}
