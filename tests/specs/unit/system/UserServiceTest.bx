/**
 * The base model test case will use the 'model' annotation as the instantiation path
 * and then create it, prepare it for mocking and then place it in the variables scope as 'model'. It is your
 * responsibility to update the model annotation instantiation path and init your model.
 */

@model( "app.models.UserService" )
class extends="coldbox.system.testing.BaseModelTest" {

	/*********************************** LIFE CYCLE Methods ***********************************/

	function beforeAll() {
		super.beforeAll();

		// setup the model
		super.setup();

		// init the model object
		model.init();
	}

	function afterAll() {
		super.afterAll();
	}

	/*********************************** BDD SUITES ***********************************/

	function run() {
		describe(
			"UserService",
			function() {
				it(
					"can be created",
					function() {
						expect( model ).toBeComponent();
					}
				);
				it(
					"normalizes valid sort orders and rejects invalid input",
					function() {
						expect( model.ensureSortOrder( "lastName" ) ).toBe( "lastName asc" );
						expect( model.ensureSortOrder( " EMAIL DESC " ) ).toBe( "email desc" );
						expect( model.ensureSortOrder( "verifiedAt asc" ) ).toBe( "verifiedAt asc" );
						expect( model.ensureSortOrder( "email desc, password" ) ).toBe( "lastName asc" );
						expect( model.ensureSortOrder( "unknown asc" ) ).toBe( "lastName asc" );
					}
				);
			}
		);
	}
}