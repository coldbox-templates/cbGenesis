/**
 * The base model test case will use the 'model' annotation as the instantiation path
 * and then create it, prepare it for mocking and then place it in the variables scope as 'model'. It is your
 * responsibility to update the model annotation instantiation path and init your model.
 */
class extends="tests.resources.BaseIntegrationSpec" {

	@inject
	property name="settingService";

	/*********************************** BDD SUITES ***********************************/

	function run() {
		describe( "Setting Service", () => {

			it( "can be created", () => {
				expect( settingService ).notToBeNull()
			} )

			it( "builds a host-specific cache key", () => {
				expect( settingService.getSettingsCacheKey() ).toBe(
					"cbgenesis-settings-#cgi.http_host#"
				)
			} )

			it( "stores and retrieves settings from the cache", () => {
				var settings = {
					"cbTestSetting": {
						"name": "cbTestSetting",
						"value": "test value"
					}
				}

				expect( settingService.storeSettings( settings ) ).toBe( settingService )

				expect( settingService.getAllSettings() ).toBe( settings )
				expect( settingService.getSetting( "cbTestSetting" ) ).toBe(
					settings.cbTestSetting
				)
			} )

			it( "returns a default value when a setting is missing", () => {
				settingService.storeSettings( {} )

				expect(
					settingService.getSetting( "missingSetting", "fallback value" )
				).toBe( "fallback value" )
			} )

			it( "throws when a setting is missing without a default", () => {
				settingService.storeSettings( {} )

				expect( () => settingService.getSetting( "missingSetting" ) ).toThrow(
					"SettingNotFound"
				)
			} )

			it( "initializes the setting entity service", () => {
				expect( settingService.init() ).toBe( settingService )
			} )

			it( "searches settings through the criteria builder", () => {
				var service = prepareMock( settingService )
				var criteria = createEmptyMock( "cborm.models.criterion.CriteriaBuilder" )
				var records = [ { name: "cbSearchSetting", value: "value" } ]

				criteria.$( "eq" ).$results( criteria )
				criteria.$( "when" ).$results( criteria )
				criteria.$( "count" ).$results( 1 )
				criteria.$( "withProjections" ).$results( criteria )
				criteria.$( "asStruct" ).$results( criteria )
				criteria.$( "list" ).$results( records )
				service.$( "newCriteria" ).$results( criteria )

				var results = service.search(
					search: "cbSearchSetting",
					isCore: true,
					currentUser: {}
				)

				expect( results.count ).toBe( 1 )
				expect( results.records ).toBe( records )
				expect( criteria.$once( "count" ) ).toBeTrue()
			} )

			it( "toggles a setting and returns its memento", () => {
				var service = prepareMock( settingService )
				var setting = createMock( "app.models.system.Setting" )
				var memento = { name: "cbToggleSetting", isActive: false }

				setting.$( "setIsActive" ).$results( setting )
				setting.$( "save" ).$results( setting )
				setting.$( "getMemento" ).$results( memento )

				expect( service.toggleStatus( setting, false ) ).toBe( memento )
				expect( setting.$once( "setIsActive" ) ).toBeTrue()
				expect( setting.$once( "save" ) ).toBeTrue()
			} )

		} )
	}
}