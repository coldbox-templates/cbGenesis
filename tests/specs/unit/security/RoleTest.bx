/**
 * The base model test case will use the 'model' annotation as the instantiation path
 * and then create it, prepare it for mocking and then place it in the variables scope as 'model'. It is your
 * responsibility to update the model annotation instantiation path and init your model.
 */

@model( "app.models.security.Role" )
class extends="coldbox.system.testing.BaseModelTest" {

	/*********************************** LIFE CYCLE Methods ***********************************/

	function beforeAll() {
		super.beforeAll();

		// setup the model
		super.setup();

		// init the model object
		variables.role = getInstance( "app.models.security.Role" );
	}

	function afterAll() {
		super.afterAll();
	}

	/*********************************** BDD SUITES ***********************************/

	function run() {
		describe(
			"A Role",
			function() {
				it(
					"can be created",
					function() {
						expect( variables.role ).toBeComponent();
					}
				);

				it(
					"has default values on creation",
					function() {
						expect( variables.role.getIsActive() ).toBeTrue();
						expect( variables.role.getRole() ).toBe( "" );
						expect( variables.role.getDescription() ).toBe( "" );
						expect( variables.role.isLoaded() ).toBeFalse();
					}
				);

				it(
					"has a non-persisted id before persistence",
					function() {
						expect( variables.role.getId() ).toBeNull();
						expect( variables.role.isLoaded() ).toBeFalse();
					}
				);

				it(
					"can get a persisted id after setting it",
					function() {
						variables.role.setId( createUUID() );
						expect( variables.role.getId() ).notToBeEmpty();
						expect( variables.role.isLoaded() ).toBeTrue();
					}
				);

				it(
					"can set and get role",
					function() {
						variables.role.setRole( "Admin" );
						expect( variables.role.getRole() ).toBe( "Admin" );
					}
				);

				it(
					"can set and get description",
					function() {
						variables.role.setDescription( "Administrator role" );
						expect( variables.role.getDescription() ).toBe( "Administrator role" );
					}
				);

				it(
					"has memento configuration with default includes",
					function() {
						expect( variables.role ).toHaveKey( "memento" );
						expect( variables
								.role
								.memento
								.defaultIncludes ).toInclude( "role" );
						expect( variables
								.role
								.memento
								.defaultIncludes ).toInclude( "description" );
					}
				);

				it(
					"has validation constraints",
					function() {
						expect( variables.role ).toHaveKey( "constraints" );
						expect( variables.role.constraints ).toHaveKey( "role" );
						expect( variables.role.constraints ).toHaveKey( "description" );
					}
				);

				it(
					"can produce a memento struct",
					function() {
						variables.role.setRole( "Editor" );
						variables.role.setDescription( "Content editor role" );

						var memento = variables.role.getMemento();
						expect( memento ).toHaveKey( "role" );
						expect( memento ).toHaveKey( "description" );
						expect( memento.role ).toBe( "Editor" );
						expect( memento.description ).toBe( "Content editor role" );
					}
				);

				it(
					"can get a role slug",
					function() {
						variables.role.setRole( "  SuperAdmin  " );
						expect( variables.role.getRoleSlug() ).toBe( "superadmin" );
					}
				);
			}
		);
	}
}