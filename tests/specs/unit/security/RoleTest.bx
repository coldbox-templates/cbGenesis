/**
 * The base model test case will use the 'model' annotation as the instantiation path
 * and then create it, prepare it for mocking and then place it in the variables scope as 'model'. It is your
 * responsibility to update the model annotation instantiation path and init your model.
 */
class extends="tests.resources.BaseIntegrationSpec" {

	@inject
	property name="roleService";

	@inject
	property name="permissionService";

	/*********************************** BDD SUITES ***********************************/

	function run() {
		describe( "A Role", () => {
			beforeEach( () => {
				variables.role = roleService.new()
			} )

			it( "can be created", () => {
				expect( role ).notToBeNull()
			} )

			it( "initializes with default values", () => {
				expect( role.isLoaded() ).toBeFalse()
				expect( role.getRole() ).toBe( "" )
				expect( role.getDescription() ).toBe( "" )
				expect( role.getPermissions() ).toBeArray()
				expect( role.getUsers() ).toBeArray()
			} )

			describe( "validation", () => {
				it( "requires role field", () => {
					role.setRole( "" )
					expect( role.isValid() ).toBeFalse()
					var results = role.getValidationResults()
					expect( results.hasErrors() ).toBeTrue()
					expect( results.getFieldErrors( "role" ) ).notToBeEmpty()
				} )

				it( "validates role size between 1 and 255 characters", () => {
					role.setRole( repeatString( "a", 256 ) )
					expect( role.isValid() ).toBeFalse()
				} )

				it( "allows description to be optional", () => {
					role.setRole( "user" )
					expect( role.isValid() ).toBeTrue( role.getValidationResults().getAllErrorsAsJSON() )
				} )
			} )

			describe( "relationships", () => {
				it( "has many-to-many relationship with permissions", () => {
					expect( role.getPermissions() ).toBeArray()
				} )

				it( "has many-to-many relationship with users", () => {
					expect( role.getUsers() ).toBeArray()
				} )
			} )

			describe( "hasPermission()", () => {
				it( "returns true for a matching permission and false otherwise", () => {
					var permission = permissionService.new()
					permission.setPermission( "users:read" )
					role.setPermissions( [ permission ] )

					expect( role.hasPermission( "users:read" ) ).toBeTrue()
					expect( role.hasPermission( "users:delete" ) ).toBeFalse()
				} )

				it( "returns true when an array contains a matching permission", () => {
					var permission = permissionService.new()
					permission.setPermission( "users:read" )
					role.setPermissions( [ permission ] )

					expect( role.hasPermission( [ "users:delete", "users:read" ] ) ).toBeTrue()
					expect( role.hasPermission( [ "users:delete", "users:update" ] ) ).toBeFalse()
				} )
			} )

			describe( "memento", () => {
				it( "includes all properties by default", () => {
					role.setRole( "admin" )
					role.setDescription( "Administrator role" )
					var permission = permissionService.new()
					permission.setPermission( "users:read" )
					role.setPermissions( [ permission ] )

					var memento = role.getMemento()

					expect( memento ).toHaveKey( "role" )
					expect( memento ).toHaveKey( "description" )
					expect( memento ).toHaveKey( "permissions" )
					expect( memento.permissions ).toBeArray()
					expect( memento.permissions[ 1 ].permission ).toBe( "users:read" )
				} )
			} )
		} )
	}
}