/**
 * The base model test case will use the 'model' annotation as the instantiation path
 * and then create it, prepare it for mocking and then place it in the variables scope as 'model'. It is your
 * responsibility to update the model annotation instantiation path and init your model.
 */

@model( "app.models.security.PermissionService" )
class extends="coldbox.system.testing.BaseModelTest" {

	/*********************************** LIFE CYCLE Methods ***********************************/

	function beforeAll() {
		super.beforeAll();

		// setup the model
		super.setup();

		// init the model object
		model.init();
	}

	function afterAll() {
		super.afterAll();
	}

	/*********************************** BDD SUITES ***********************************/

	function run() {
		describe(
			"PermissionService",
			function() {
				it(
					"can be created",
					function() {
						expect( model ).toBeComponent();
					}
				);

				it(
					"can create a new Permission via the new() dispenser",
					function() {
						var perm = model.new();
						expect( perm ).toBeComponent();
						expect( perm.isLoaded() ).toBeFalse();
					}
				);

				it(
					"has a list() method",
					function() {
						expect( model ).toHaveKey( "list" );
					}
				);

				it(
					"has a save() method",
					function() {
						expect( model ).toHaveKey( "save" );
					}
				);

				it(
					"has a delete() method",
					function() {
						expect( model ).toHaveKey( "delete" );
					}
				);

				it(
					"has a getById() method",
					function() {
						expect( model ).toHaveKey( "getById" );
					}
				);

				it(
					"has a getByName() method",
					function() {
						expect( model ).toHaveKey( "getByName" );
					}
				);

				it(
					"has an exists() method",
					function() {
						expect( model ).toHaveKey( "exists" );
					}
				);

				it(
					"has a getRolesForPermission() method",
					function() {
						expect( model ).toHaveKey( "getRolesForPermission" );
					}
				);
			}
		);
	}
}