/**
 * Security Services tests
 */
class extends="tests.resources.BaseIntegrationSpec" {

	@inject
	property name="securityService";

	function beforeAll() {
		super.beforeAll()

		// get the test fixture user
		variables.testUser = userService.findWhere( {
			email: "admin@cbGenesis.com"
		} )
	}

	function run() {
		describe( "SecurityService", function() {
			it( "can be created", function() {
				expect( securityService ).toBeClass()
			} )
		} )

		story( "Authenticate users", () => {
			it( "authenticates a verified user with valid credentials", () => {
				var user = createVerifiedUser()

				var authenticatedUser = securityService.authenticate(
					username: user.getEmail(),
					password: "correct-password"
				)

				expect( authenticatedUser.getId() ).toBe( user.getId() )
				expect( securityService.isLoggedIn() ).toBeTrue()
				expect( securityService.getCurrentUser().getId() ).toBe( user.getId() )
			} )

			it( "rejects invalid credentials without creating a session", () => {
				var user = createVerifiedUser()
				securityService.logout( quiet: true )

				expect( () => securityService.authenticate(
					username: user.getEmail(),
					password: "wrong-password"
				) ).toThrow()
				expect( securityService.isLoggedIn() ).toBeFalse()
			} )

			it( "rejects an unverified user without creating a session", () => {
				var user = userService.new({
					firstName: "Unverified",
					lastName: "Tester",
					email: "unverified-#createUUID()#@example.com",
					password: "correct-password"
				} )
				userService.save( user )
				securityService.logout( quiet: true )

				expect( () => securityService.authenticate(
					username: user.getEmail(),
					password: "correct-password"
				) ).toThrow()
				expect( securityService.isLoggedIn() ).toBeFalse()
			} )
		} )

		story( "Manage authenticated sessions", () => {
			it( "returns an empty user when no session is active", () => {
				securityService.logout()

				expect( securityService.isLoggedIn() ).toBeFalse()
				expect( securityService.getCurrentUser().isLoaded() ).toBeFalse()
			} )

			it( "clears the session when the user logs out", () => {
				var user = createVerifiedUser()
				securityService.authenticate( user.getEmail(), "correct-password" )

				securityService.logout()

				expect( securityService.isLoggedIn() ).toBeFalse()
			} )
		} )

		story( "Manage password reset tokens", () => {
			it( "resolves a generated reset token to its user", () => {
				var token = securityService.generatePasswordResetToken( variables.testUser )
				var result = securityService.verifyPasswordResetToken( token )

				expect( token ).notToBeEmpty()
				expect( result.error ).toBeFalse()
				expect( result.user.getId() ).toBe( variables.testUser.getId() )
			} )

			it( "rejects an unknown reset token", () => {
				var result = securityService.verifyPasswordResetToken( "unknown-token" )

				expect( result.error ).toBeTrue()
				expect( result.user ).toBeEmpty()
			} )

			it( "does not verify a reset token after it is cleared", () => {
				var token = securityService.generatePasswordResetToken( variables.testUser )

				expect( securityService.clearPasswordResetToken( token ) ).toBeTrue()
				expect( securityService.verifyPasswordResetToken( token ).error ).toBeTrue()
			} )
		} )
	}
}
