/**
 * SecurityService Unit Tests
 *
 * Tests the SecurityService login/logout/isLoggedIn functionality
 * using mocked dependencies.
 */

@model( "app.models.security.SecurityService" )
class extends="coldbox.system.testing.BaseModelTest" {

	/*********************************** LIFE CYCLE Methods ***********************************/

	function beforeAll() {
		super.beforeAll();

		// setup the model
		super.setup();

		// init the model object
		model.init();
	}

	function afterAll() {
		super.afterAll();
	}

	/*********************************** BDD SUITES ***********************************/

	function run() {
		describe(
			"SecurityService",
			function() {
				it(
					"can be created",
					function() {
						expect( model ).toBeComponent();
					}
				);

				it(
					"is a singleton",
					function() {
						var s1 = model;
						var s2 = wirebox.getInstance( "SecurityService" );
						expect( s1 ).toBe( s2 );
					}
				);

				it(
					"has login method",
					function() {
						expect( model ).toHaveMethod( "login" );
					}
				);

				it(
					"has logout method",
					function() {
						expect( model ).toHaveMethod( "logout" );
					}
				);

				it(
					"has isLoggedIn method",
					function() {
						expect( model ).toHaveMethod( "isLoggedIn" );
					}
				);

				it(
					"has getCurrentUser method",
					function() {
						expect( model ).toHaveMethod( "getCurrentUser" );
					}
				);

				describe(
					"login()",
					function() {
						it(
							"throws SecurityException on invalid credentials",
							function() {
								var mockAuthService = createMock( "cbsecurity.modules.cbauth.models.AuthenticationService" );
								mockAuthService
									.$( "isLoggedIn" )
									.$( "getUser" )
									.$( "authenticate" )
									.$( "login" )
									.$( "logout" )
									.$( "getUserService" )
									.$( "getUserId" );

								var mockUserService = createMock( "app.models.UserService" );
								mockUserService.$( "isValidCredentials" ).$returns( false );
								mockUserService.$( "retrieveUserByUsername" ).$returns( {} );

								// Inject mocks
								model.$( "getAuthenticationService" ).$returns( mockAuthService );
								model.$( "getUserService" ).$returns( mockUserService );

								var exception = createMock( "coldbox.system.web.context.ExceptionBean" );

								expect(
									function() {
										model.login( "test@example.com", "wrongpassword" );
									}
								).toThrow( "SecurityException" );
							}
						);

						it(
							"calls userService.isValidCredentials before authentication",
							function() {
								var mockAuthService = createMock( "cbsecurity.modules.cbauth.models.AuthenticationService" );
								mockAuthService
									.$( "isLoggedIn" )
									.$( "getUser" )
									.$( "authenticate" )
									.$( "login" )
									.$( "logout" )
									.$( "getUserService" )
									.$( "getUserId" );

								var mockUserService = createMock( "app.models.UserService" );
								mockUserService.$( "isValidCredentials" ).$returns( true );

								var mockUser = createMock( "app.models.User" );
								mockUser.$( "getId" ).$returns( "test-user-id" );
								mockUser.$( "getEmail" ).$returns( "test@example.com" );

								mockAuthService.$( "authenticate" ).$returns( mockUser );

								var mockQB = createMock( "qb.models.QueryBuilder" );
								var mockQuery = createMock( "qb\Query" );
								mockQB.$( "table" ).$returns( mockQuery );
								mockQuery.$( "where" ).$returns( mockQuery );
								mockQuery.$( "update" ).$returns( { result: { generatedKey: "" } } );

								model.$( "getAuthenticationService" ).$returns( mockAuthService );
								model.$( "getUserService" ).$returns( mockUserService );
								model.$( "getQB" ).$returns( mockQB );

								// Should not throw - valid credentials
								var result = model.login( "test@example.com", "correctpassword" );
								expect( result ).toBeComponent( "app.models.User" );
							}
						);

						it(
							"updates lastLogin on successful login",
							function() {
								var mockAuthService = createMock( "cbsecurity.modules.cbauth.models.AuthenticationService" );
								mockAuthService
									.$( "isLoggedIn" )
									.$( "getUser" )
									.$( "authenticate" )
									.$( "login" )
									.$( "logout" )
									.$( "getUserService" )
									.$( "getUserId" );

								var mockUserService = createMock( "app.models.UserService" );
								mockUserService.$( "isValidCredentials" ).$returns( true );

								var mockUser = createMock( "app.models.User" );
								mockUser.$( "getId" ).$returns( "user-123" );
								mockUser.$( "getEmail" ).$returns( "test@example.com" );

								mockAuthService.$( "authenticate" ).$returns( mockUser );

								var mockQB = createMock( "qb.models.QueryBuilder" );
								var mockQuery = createMock( "qb\Query" );
								mockQB.$( "table" ).$returns( mockQuery );
								mockQuery.$( "where" ).$returns( mockQuery );
								mockQuery.$( "update" ).$returns( { result: { generatedKey: "" } } );

								model.$( "getAuthenticationService" ).$returns( mockAuthService );
								model.$( "getUserService" ).$returns( mockUserService );
								model.$( "getQB" ).$returns( mockQB );

								// This should call update internally
								model.login( "test@example.com", "correctpassword" );

								// Verify the update was called (lastLogin update)
								expect( mockQuery.$callLog().where ).toInclude( "id" );
							}
						);
					}
				);

				describe(
					"logout()",
					function() {
						it(
							"calls authenticationService.logout()",
							function() {
								var mockAuthService = createMock( "cbsecurity.modules.cbauth.models.AuthenticationService" );
								mockAuthService
									.$( "isLoggedIn" )
									.$( "getUser" )
									.$( "authenticate" )
									.$( "login" )
									.$( "logout" )
									.$( "getUserService" )
									.$( "getUserId" );

								model.$( "getAuthenticationService" ).$returns( mockAuthService );

								// Should not throw
								model.logout();

								// Verify logout was called
								expect( mockAuthService.$callLog().logout ).notToBeEmpty();
							}
						);

						it(
							"handles logout when not logged in silently",
							function() {
								var mockAuthService = createMock( "cbsecurity.modules.cbauth.models.AuthenticationService" );
								mockAuthService
									.$( "isLoggedIn" )
									.$( "getUser" )
									.$( "authenticate" )
									.$( "login" )
									.$( "logout" )
									.$( "getUserService" )
									.$( "getUserId" );

								model.$( "getAuthenticationService" ).$returns( mockAuthService );

								// Should not throw even when not logged in
								model.logout();
							}
						);
					}
				);

				describe(
					"isLoggedIn()",
					function() {
						it(
							"returns true when user is logged in",
							function() {
								var mockAuthService = createMock( "cbsecurity.modules.cbauth.models.AuthenticationService" );
								mockAuthService
									.$( "isLoggedIn" )
									.$( "getUser" )
									.$( "authenticate" )
									.$( "login" )
									.$( "logout" )
									.$( "getUserService" )
									.$( "getUserId" );

								mockAuthService.$( "isLoggedIn" ).$returns( true );

								model.$( "getAuthenticationService" ).$returns( mockAuthService );

								expect( model.isLoggedIn() ).toBeTrue();
							}
						);

						it(
							"returns false when user is not logged in",
							function() {
								var mockAuthService = createMock( "cbsecurity.modules.cbauth.models.AuthenticationService" );
								mockAuthService
									.$( "isLoggedIn" )
									.$( "getUser" )
									.$( "authenticate" )
									.$( "login" )
									.$( "logout" )
									.$( "getUserService" )
									.$( "getUserId" );

								mockAuthService.$( "isLoggedIn" ).$returns( false );

								model.$( "getAuthenticationService" ).$returns( mockAuthService );

								expect( model.isLoggedIn() ).toBeFalse();
							}
						);
					}
				);

				describe(
					"getCurrentUser()",
					function() {
						it(
							"returns user when logged in",
							function() {
								var mockAuthService = createMock( "cbsecurity.modules.cbauth.models.AuthenticationService" );
								mockAuthService
									.$( "isLoggedIn" )
									.$( "getUser" )
									.$( "authenticate" )
									.$( "login" )
									.$( "logout" )
									.$( "getUserService" )
									.$( "getUserId" );

								var mockUser = createMock( "app.models.User" );
								mockUser.$( "getId" ).$returns( "user-456" );
								mockUser.$( "getEmail" ).$returns( "test@example.com" );

								mockAuthService.$( "getUser" ).$returns( mockUser );

								model.$( "getAuthenticationService" ).$returns( mockAuthService );

								var user = model.getCurrentUser();
								expect( user ).notToBeEmpty();
								expect( user.getId() ).toBe( "user-456" );
							}
						);

						it(
							"returns null when not logged in",
							function() {
								var mockAuthService = createMock( "cbsecurity.modules.cbauth.models.AuthenticationService" );
								mockAuthService
									.$( "isLoggedIn" )
									.$( "getUser" )
									.$( "authenticate" )
									.$( "login" )
									.$( "logout" )
									.$( "getUserService" )
									.$( "getUserId" );

								// Simulate NoUserLoggedIn exception by throwing SecurityException
								mockAuthService.$( "getUser" ).$throws(
										excType    = "SecurityException",
										excMessage = "No user is logged in.",
										excDetail  = "There is no authenticated user."
									);

								model.$( "getAuthenticationService" ).$returns( mockAuthService );

								expect( model.getCurrentUser() ).toBeEmpty();
							}
						);
					}
				);
			}
		);
	}
}