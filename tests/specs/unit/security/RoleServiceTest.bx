/**
 * The base model test case will use the 'model' annotation as the instantiation path
 * and then create it, prepare it for mocking and then place it in the variables scope as 'model'. It is your
 * responsibility to update the model annotation instantiation path and init your model.
 */
class extends="tests.resources.BaseIntegrationSpec" {

	@inject
	property name="roleService";

	/*********************************** BDD SUITES ***********************************/

	function run() {
		describe( "Role Service", () => {

			it( "can be created", () => {
				expect( roleService ).notToBeNull()
			} )

			it( "deletes a role that is still assigned to a user", () => {
				var role = roleService.new( { role: "Deletable-#createUUID()#", description: "temp" } )
				roleService.save( role )
				var roleId = role.getRoleId()

				var user = createVerifiedUser()
				user.addRole( role )
				userService.save( user )

				// deleteRole() used to call userService.removeRoleFromUsers(), which does
				// not exist, so this threw MissingMethodException via cborm's
				// onMissingMethod. Nothing called it, so the break stayed invisible.
				roleService.deleteRole( role )

				expect( roleService.findWhere( { roleId: roleId } ) ).toBeNull()

				var reloaded = userService.getOrFail( user.getUserId() )
				expect( reloaded.getRoles().filter( ( r ) => r.getRoleId() == roleId ) ).toBeEmpty()
			} )

		} )
	}
}