/**
 * The base model test case will use the 'model' annotation as the instantiation path
 * and then create it, prepare it for mocking and then place it in the variables scope as 'model'. It is your
 * responsibility to update the model annotation instantiation path and init your model.
 */
class extends="tests.resources.BaseIntegrationSpec" {

	@inject
	property name="permissionService";

	/*********************************** BDD SUITES ***********************************/

	function run() {
		describe( "A Permission", () => {
			beforeEach( () => {
				variables.permission = permissionService.new()
			} )

			it( "can be created", () => {
				expect( permission ).notToBeNull()
			} )

			it( "initializes with default values", () => {
				expect( permission.isLoaded() ).toBeFalse()
				expect( permission.getPermission() ).toBe( "" )
				expect( permission.getDescription() ).toBe( "" )
				expect( permission.getRoles() ).toBeArray()
				expect( permission.getUsers() ).toBeArray()
			} )

			describe( "getPrefix()", () => {
				it( "returns prefix when permission contains colon", () => {
					permission.setPermission( "user:create" )
					expect( permission.getPrefix() ).toBe( "user" )
				} )

				it( "returns empty string when permission has no colon", () => {
					permission.setPermission( "admin" )
					expect( permission.getPrefix() ).toBe( "" )
				} )

				it( "handles multiple colons by returning first segment", () => {
					permission.setPermission( "api:v1:read" )
					expect( permission.getPrefix() ).toBe( "api" )
				} )
			} )

			describe( "getSlug()", () => {
				it( "returns slug when permission contains colon", () => {
					permission.setPermission( "user:create" )
					expect( permission.getSlug() ).toBe( "create" )
				} )

				it( "returns entire permission when no colon exists", () => {
					permission.setPermission( "admin" )
					expect( permission.getSlug() ).toBe( "admin" )
				} )

				it( "handles multiple colons by returning everything after first colon", () => {
					permission.setPermission( "api:v1:read" )
					expect( permission.getSlug() ).toBe( "v1:read" )
				} )
			} )

			describe( "validation", () => {
				it( "requires permission field", () => {
					permission.setPermission( "" )
					expect( permission.isValid() ).toBeFalse()
					var results = permission.getValidationResults()
					expect( results.hasErrors() ).toBeTrue()
					expect( results.getFieldErrors( "permission" ) ).notToBeEmpty()
				} )

				it( "validates permission size between 1 and 255 characters", () => {
					permission.setPermission( repeatString( "a", 256 ) )
					expect( permission.isValid() ).toBeFalse()
				} )

				it( "allows description to be optional", () => {
					permission.setPermission( "user:create" )
					permission.setDescription( "" )
					expect( permission.isValid() ).toBeTrue()
				} )
			} )

			describe( "relationships", () => {
				it( "has many-to-many relationship with roles", () => {
					expect( permission.getRoles() ).toBeArray()
				} )

				it( "has many-to-many relationship with users", () => {
					expect( permission.getUsers() ).toBeArray()
				} )
			} )

			describe( "memento", () => {
				it( "includes all properties by default", () => {
					permission.setPermission( "user:create" )
					permission.setDescription( "Create users" )

					var memento = permission.getMemento()

					expect( memento ).toHaveKey( "permission" )
					expect( memento ).toHaveKey( "description" )
				} )
			} )
		} )
	}
}