/**
 * Integration tests for the API token service.
 */
class extends="tests.resources.BaseIntegrationSpec"{

	@inject
	property name="apiTokenService";

	@inject
	property name="userService";

	function beforeAll() {
		super.beforeAll()
		// get the test fixture user
		variables.testUser = userService.findWhere( {
			email: "admin@cbGenesis.com"
		} )
		// Create any other fixtures here
	}

	/*********************************** BDD SUITES ***********************************/

	function run(){
		describe( "API Token Service", () => {

			it( "can be created", () => {
				expect( apiTokenService ).notToBeNull()
			} )

			it( "creates and validates a token without exposing its hash", () => {
				var tokenData = apiTokenService.createToken(
					user      = variables.testUser,
					label     = "Service test token",
					expiration = dateAdd( "d", 1, now() )
				)
				var token = tokenData.token

				expect( tokenData.rawToken ).toStartWith( "cb_" )
				expect( token.getTokenId() ).notToBeEmpty()
				expect( token.getLabel() ).toBe( "Service test token" )
				expect( apiTokenService.isValidToken( tokenData.rawToken ) ).toBeTrue()

				var persistedToken = apiTokenService.findByIdForUser(
					tokenId = token.getTokenId(),
					userId  = variables.testUser.getId()
				)
				expect( persistedToken.getToken() ).notToBe( tokenData.rawToken )
				expect( persistedToken.getToken().len() ).toBe( 64 )
				expect( persistedToken.getLastUsed() ).notToBeNull()
			} )

			it( "revokes a token and prevents further validation", () => {
				var tokenData = apiTokenService.createToken(
					user  = variables.testUser,
					label = "Revocation test token"
				)

				apiTokenService.revokeToken( tokenData.token.getTokenId() )

				expect( apiTokenService.isValidToken( tokenData.rawToken ) ).toBeFalse()
			} )

			it( "lists and deletes tokens only for their owner", () => {
				var tokenData = apiTokenService.createToken(
					user  = variables.testUser,
					label = "Ownership test token"
				)
				var tokens = apiTokenService.listForUser( variables.testUser.getId() )

				expect( tokens ).toBeArray()
				expect( tokens.map( ( token ) => token.tokenId ) ).toInclude( tokenData.token.getTokenId() )
				expect(
					apiTokenService.deleteToken(
						tokenId = tokenData.token.getTokenId(),
						userId  = variables.testUser.getId()
					)
				).toBeTrue()
			} )

			it( "touches a token and supports listing inactive tokens", () => {
				var tokenData = apiTokenService.createToken(
					user  = variables.testUser,
					label = "Touch test token"
				)
				var tokenId = tokenData.token.getTokenId()

				expect( tokenData.token.getLastUsed() ).toBeNull()
				var touchedToken = apiTokenService.touchLastUsed( tokenId )
				expect( touchedToken.getLastUsed() ).notToBeNull()

				apiTokenService.revokeToken( tokenId )
				var inactiveTokens = apiTokenService.listForUser(
					userId = variables.testUser.getId(),
					activeOnly = false
				)
				expect( inactiveTokens.map( ( token ) => token.tokenId ) ).toInclude( tokenId )
			} )

			it( "revokes all tokens for a user", () => {
				var firstToken = apiTokenService.createToken(
					user  = variables.testUser,
					label = "Bulk revoke one"
				)
				var secondToken = apiTokenService.createToken(
					user  = variables.testUser,
					label = "Bulk revoke two"
				)
				var tokenCount = apiTokenService.listForUser(
					userId = variables.testUser.getId()
					, activeOnly = false
				).len()

				expect( apiTokenService.revokeAllForUser( variables.testUser.getId() ) ).toBe( tokenCount )
				expect( apiTokenService.isValidToken( firstToken.rawToken ) ).toBeFalse()
				expect( apiTokenService.isValidToken( secondToken.rawToken ) ).toBeFalse()
			} )

			it( "rejects invalid, expired, and unauthorized token access", () => {
				var expiredToken = apiTokenService.createToken(
					user       = variables.testUser,
					label      = "Expired validation token",
					expiration = dateAdd( "d", -1, now() )
				)
				var revokedToken = apiTokenService.createToken(
					user  = variables.testUser,
					label = "Revoked validation token"
				)
				apiTokenService.revokeToken( revokedToken.token.getTokenId() )

				expect( () => apiTokenService.validateToken( "unknown-token" ) ).toThrow( "APIToken.Invalid" )
				expect( () => apiTokenService.validateToken( expiredToken.rawToken ) ).toThrow( "APIToken.Invalid" )
				expect( () => apiTokenService.validateToken( revokedToken.rawToken ) ).toThrow( "APIToken.Invalid" )
				expect( () => apiTokenService.findByIdForUser(
					tokenId = expiredToken.token.getTokenId(),
					userId = createUUID()
				) ).toThrow( "APIToken.NotFound" )
				expect( () => apiTokenService.deleteToken(
					tokenId = expiredToken.token.getTokenId(),
					userId = createUUID()
				) ).toThrow( "APIToken.NotFound" )
			} )

			it( "purges expired tokens", () => {
				var expiredToken = apiTokenService.new()
				expiredToken
					.setLabel( "Expired token" )
					.setToken( generateSecretKey( "AES", 256 ) )
					.setExpiration( dateAdd( "d", -1, now() ) )
					.setUser( variables.testUser )
				apiTokenService.save( entity: expiredToken )

				var anotherExpiredToken = apiTokenService.new()
				anotherExpiredToken
					.setLabel( "Another expired token" )
					.setToken( generateSecretKey( "AES", 256 ) )
					.setExpiration( dateAdd( "d", -2, now() ) )
					.setUser( variables.testUser )
				apiTokenService.save( entity: anotherExpiredToken )

				var activeToken = apiTokenService.new()
				activeToken
					.setLabel( "Active token" )
					.setToken( generateSecretKey( "AES", 256 ) )
					.setExpiration( dateAdd( "d", 1, now() ) )
					.setUser( variables.testUser )
				apiTokenService.save( entity: activeToken )

				$assert.isTrue( apiTokenService.purgeExpiredTokens() > 1 )
			} )
		} )
	}
}
