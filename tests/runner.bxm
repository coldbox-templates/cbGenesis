<!--- enableOutputOnly is intentionally NOT set here: TestBox's HTMLRunner.cfm writes
	its report via a bare writeoutput() call (not inside an explicit <cfoutput> tag), and
	under BoxLang, enableOutputOnly=true suppresses that call -- the response comes back
	HTTP 200 with a genuinely empty body (confirmed via the x-testbox-total* summary
	headers still reporting real results while Content-Length is 0), which silently
	breaks `box testbox run` and any other client reading the report body. --->
<!--- Executes all tests in the 'specs' folder with simple reporter by default --->

<bx:param name="url.reporter" 			default="simple">
<bx:param name="url.directory" 			default="tests.specs">
<bx:param name="url.recurse" 			default="true" type="boolean">
<bx:param name="url.bundles" 			default="">
<bx:param name="url.labels" 			default="">
<bx:param name="url.excludes" 			default="">
<bx:param name="url.reportpath" 		default="#expandPath( "/tests/results" )#">
<bx:param name="url.propertiesFilename" default="TEST.properties">
<bx:param name="url.propertiesSummary"	default="false" type="boolean">
<bx:param name="url.editor" 			default="vscode">
<bx:param name="url.bundlesPattern" 	default="*Spec*.cfc|*Test*.cfc|*Spec*.bx|*Test*.bx">

<!--- Streaming mode: streams results via Server-Sent Events (SSE) for real-time progress --->
<bx:param name="url.streaming"						default="false" type="boolean">
<bx:param name="url.dryRun"							default="false" type="boolean">

<!--- Code Coverage requires FusionReactor --->
<bx:param name="url.coverageEnabled"				default="false" type="boolean">
<bx:param name="url.coveragePathToCapture"			default="#expandPath( '/root' )#">
<bx:param name="url.coverageWhitelist"				default="">
<bx:param name="url.coverageBlacklist"				default="/testbox,/coldbox,/tests,/modules,Application.cfc,/index.cfm,Application.bx,/index.bxm">
<!---<bx:param name="url.coverageBrowserOutputDir"		default="#expandPath( '/tests/results/coverageReport' )#">--->
<!---<bx:param name="url.coverageSonarQubeXMLOutputPath"	default="#expandPath( '/tests/results/SonarQubeCoverage.xml' )#">--->
<!--- Enable batched code coverage reporter, useful for large test bundles which require spreading over multiple testbox run commands. --->
<!--- <bx:param name="url.isBatched"						default="false"> --->

<!--- Include the appropriate runner based on streaming mode.
	Written as a single <bx:script> block using script-syntax include/savecontent/if
	rather than <bx:if>/<bx:include>/<bx:savecontent> tags -- BoxLang's .bxm tag parser
	doesn't bind some of those as valid elements in this position (observed: "The
	prefix 'bx' for element 'bx:savecontent' is not bound", a fatal XML parse error
	dumped straight into the response body), while the equivalent script statements
	work fine. --->
<bx:script>
	if ( url.streaming && !url.dryRun ) {
		// Stream results in real-time via SSE
		include template="/testbox/system/runners/StreamingRunner.cfm";
	} else {
		// Traditional batch results: capture everything HTMLRunner.cfm outputs rather
		// than letting it stream straight to the client. ColdBox's testing HTTP
		// simulation (get()/post() inside a spec) can render a real view as part of
		// running that spec -- e.g. a login page plus cbcsrf's injected rotation script
		// -- and that markup can leak directly into this same response buffer, ahead of
		// the actual report. For the json reporter (the one `box testbox run` and CI
		// consume), locate TestBox's own payload by its stable leading key and emit
		// only from there, dropping anything that leaked before it. Any other reporter
		// (simple HTML, ANTJunit, dryRun) is emitted untouched, since no such marker
		// applies to it.
		savecontent variable="rawRunnerOutput" {
			include template="/testbox/system/runners/HTMLRunner.cfm";
		}

		jsonMarker = '{"CFMLEngine"';
		jsonStart = find( jsonMarker, rawRunnerOutput );
		if ( url.reporter == "json" && jsonStart > 0 ) {
			writeOutput( mid( rawRunnerOutput, jsonStart, len( rawRunnerOutput ) - jsonStart + 1 ) );
		} else {
			writeOutput( rawRunnerOutput );
		}
	}
</bx:script>
