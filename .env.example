# App Name and Environment
APPNAME=cbGenesis
ENVIRONMENT=development
# Public URL prefix for Vite production assets.
ASSET_URL=/includes

# BoxLang Environment
BOXLANG_DEBUG=true

# Framework reinit password, used as ?fwreinit=<value>. REQUIRED in production:
# leaving it unset locks reinit down behind a random per-boot value. The
# development environment ignores it and allows a bare ?fwreinit=1.
COLDBOX_REINIT_PASSWORD=

# Database Information
DB_CONNECTIONSTRING=jdbc:mysql://127.0.0.1:3306/cbgenesis?useSSL=false&useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC&useLegacyDatetimeCode=true&allowPublicKeyRetrieval=true
DB_DRIVER=MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_SCHEMA=
DB_DATABASE=cbgenesis
DB_USER=root
DB_PASSWORD=