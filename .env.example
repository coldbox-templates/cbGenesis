# App Name and Environment
APPNAME=cbGenesis
ENVIRONMENT=development
# Public URL prefix for Vite production assets.
ASSET_URL=/includes

# BoxLang Environment
BOXLANG_DEBUG=true

# Framework reinit password, used as ?fwreinit=<value>. Leaving it unset is the
# safe default: reinit falls back to a random per-boot value nobody knows, which
# closes it. Set one only if you need to reinit a running production instance,
# and treat it as a credential. The development environment overrides this and
# allows a bare ?fwreinit=1.
COLDBOX_REINIT_PASSWORD=

# CBFS Assets Disk Path
# Path to the CBFS assets disk relative to the application root.
CBFS_ASSETS_DISK_PATH=.cbfs

# Signing key for cbsecurity's JWT support (app/config/modules/cbsecurity.bx).
# Required only if you issue JWTs; set a long random value before you do.
JWT_SECRET=

# Encryption key for cbstorages' cookie storage (app/config/modules/cbstorages.bx).
# Only used when that module's useEncryption is turned on (off by default). Set a
# long random value before enabling it - otherwise the key regenerates on every
# boot/reinit and silently invalidates all previously encrypted cookies.
COOKIE_ENCRYPTION_KEY=

# Optional Google SSO. Register this callback URL with Google:
# /cbsso/auth/Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Automatic provisioning requires both an explicit true value and an allowlist.
CBSSO_AUTO_PROVISION=false
CBSSO_ALLOWED_DOMAINS=

# Database Information
DB_CONNECTIONSTRING=jdbc:mysql://127.0.0.1:3306/cbgenesis?useSSL=false&useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC&useLegacyDatetimeCode=true&allowPublicKeyRetrieval=true
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_SCHEMA=
DB_DATABASE=cbgenesis
DB_USER=root
DB_PASSWORD=