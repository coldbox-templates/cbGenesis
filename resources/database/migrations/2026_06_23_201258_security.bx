class {

	function up( schema, qb ) {
		// Permissions table
		schema.create( "permissions", ( table ) => {
			table.string( "permissionId", 36 ).primaryKey()
			table.boolean( "isActive" ).default( true )
			table.timestamps()

			table.string( "permission" ).unique()
			// MySQL forbids a literal default on TEXT/BLOB/JSON columns, so this
			// relies on application code (Permission.bx's `default=""` property)
			// to always supply a value on insert.
			table.longText( "description" ).nullable()

			// Indexes
			table.index( "isActive", "idx_permissionIsActive" )
			table.index( [ "permission", "isActive" ], "idx_permissionActive" )
		} )

		// Roles table
		schema.create( "roles", ( table ) => {
			table.string( "roleId", 36 ).primaryKey()
			table.boolean( "isActive" ).default( true )
			table.timestamps()

			table.string( "role" ).unique()
			// See the permissions table above for why this is nullable instead
			// of defaulted: MySQL rejects a literal default on TEXT columns.
			table.longText( "description" ).nullable()

			// Indexes
			table.index( "isActive", "idx_roleIsActive" )
			table.index( [ "role", "isActive" ], "idx_roleActive" )
		} )

		// Role-Permissions join table
		schema.create( "role_permissions", ( table ) => {
			table.string( "FK_roleId", 36 )
			table.string( "FK_permissionId", 36 )

			// Constraints
			table.primaryKey( [ "FK_roleId", "FK_permissionId" ], "pk_role_permissions" )

			// References
			table
				.foreignKey( "FK_permissionId" )
				.references( "permissionId" )
				.onTable( "permissions" )
				.onDelete( "CASCADE" )
			table
				.foreignKey( "FK_roleId" )
				.references( "roleId" )
				.onTable( "roles" )
				.onDelete( "CASCADE" )
		} )
	}

	function down( schema, qb ) {
		schema.dropIfExists( "role_permissions" )
		schema.dropIfExists( "roles" )
		schema.dropIfExists( "permissions" )
	}

}
