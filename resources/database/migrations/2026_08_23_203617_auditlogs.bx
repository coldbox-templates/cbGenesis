			table.index( "category", "idx_auditCategory" )
			table.index( "FK_userId", "idx_auditActor" )
			table.index( [ "severity", "createdDate" ], "idx_auditSeverityDate" )
		} )
	}

	function down( schema, qb ) {
		schema.dropIfExists( "audit_logs" )
