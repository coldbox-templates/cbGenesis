		// Audit Log table - append-only record of admin/auth/security activity
		schema.create( "audit_logs", ( table ) => {
			table.guid( "auditLogId" ).primaryKey()
			table.timestamp( "createdDate" )

			// Classification
			table.string( "severity", 20 )
			table.string( "category", 50 )
			table.string( "action", 100 )
			table.longText( "message" )

			// Actor (denormalized so the trail survives the actor being deleted)
			table.guid( "FK_userId" ).nullable()
			table.string( "actorEmail" ).nullable()
			table.string( "actorName" ).nullable()

			// Target of the action, if any
			table.string( "targetType", 100 ).nullable()
			table.string( "targetId", 100 ).nullable()
