/**
 * Seeds the database with the initial admin role, permissions, and admin user.
 *
 * Run with: migrate seed run
 */
class {

	static {
		test_bcrypt = "$2a$10$nIfWUb9y5BtKWWNinHxtkOo9QIg.AaoVh.7MbukPrg5uLX9BNVC42"
	}

	function run( qb, mockdata ) {

		var adminRoleId = "00000000-0000-0000-0000-000000000001"
		var permissions = [
			{
				id          : "00000000-0000-0000-0000-000000000101",
				permission  : "roles:read",
				description : "View roles"
			},
			{
				id          : "00000000-0000-0000-0000-000000000102",
				permission  : "roles:write",
				description : "Create and update roles"
			},
			{
				id          : "00000000-0000-0000-0000-000000000103",
				permission  : "roles:delete",
				description : "Delete roles"
			},
			{
				id          : "00000000-0000-0000-0000-000000000104",
				permission  : "roles:admin",
				description : "Full role administration"
			},

			{
				id          : "00000000-0000-0000-0000-000000000201",
				permission  : "users:read",
				description : "View users"
			},
			{
				id          : "00000000-0000-0000-0000-000000000202",
				permission  : "users:write",
				description : "Create and update users"
			},
			{
				id          : "00000000-0000-0000-0000-000000000203",
				permission  : "users:delete",
				description : "Delete users"
			},
			{
				id          : "00000000-0000-0000-0000-000000000204",
				permission  : "users:admin",
				description : "Full user administration"
			},

			{
				id          : "00000000-0000-0000-0000-000000000301",
				permission  : "permissions:read",
				description : "View permissions"
			},
			{
				id          : "00000000-0000-0000-0000-000000000302",
				permission  : "permissions:write",
				description : "Create and update permissions"
			},
			{
				id          : "00000000-0000-0000-0000-000000000303",
				permission  : "permissions:delete",
				description : "Delete permissions"
			},
			{
				id          : "00000000-0000-0000-0000-000000000304",
				permission  : "permissions:admin",
				description : "Full permission administration"
			},

			{
				id          : "00000000-0000-0000-0000-000000000401",
				permission  : "settings:read",
				description : "Read settings"
			},
			{
				id          : "00000000-0000-0000-0000-000000000402",
				permission  : "settings:write",
				description : "Create and update settings"
			},
			{
				id          : "00000000-0000-0000-0000-000000000403",
				permission  : "settings:delete",
				description : "Delete settings"
			},
			{
				id          : "00000000-0000-0000-0000-000000000404",
				permission  : "settings:admin",
				description : "Full settings administration"
			}
		]

		// Create Admin role
		qb.newQuery().from( "roles" ).insert( {
			roleId      : adminRoleId,
			role        : "Admin",
			description : "System Administrator",
			isActive    : true
		} )

		// Create permissions and assign all to Admin
		permissions.each( ( permission ) => {

			qb.newquery().from( "permissions" ).insert( {
				permissionId : permission.id,
				permission   : permission.permission,
				description  : permission.description,
				isActive     : true
			} )

			qb.newquery().from( "role_permissions" ).insert( {
				FK_roleId       : adminRoleId,
				FK_permissionId : permission.id
			} )

		} )

		// Create Admin user and assign Admin role
		var adminUserId = "00000000-0000-0000-0000-000000000001"
		qb.newQuery().from( "users" ).insert( {
			userId    : adminUserId,
			isActive  : true,
			firstName : "Admin",
			lastName  : "User",
			email     : "admin@cbgenesis.com",
			password  : static.test_bcrypt,
			biography : "I am a wonderful CBGenesis Admin",
			preferences:  "{}",
			isPasswordReset: false,
			is2FactorAuth: false
		} )
		// Add the admin role to the admin user
		qb.newQuery().from( "user_roles" ).insert( {
			FK_userId : adminUserId,
			FK_roleId : adminRoleId
		} )

	}

}
