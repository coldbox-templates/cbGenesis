{
	"componentCacheEnabled":false,
	"debuggingReportExecutionTimes": false,
	"saveClassFiles":false,
	"systemErr":"System",
	"systemOut":"System",
	"robustExceptionEnabled":true,
	"requestTimeoutEnabled":true,
	"requestTimeout":"0,0,5,0",
	"thistimezone":"UTC",
    "whitespaceManagement":"white-space-pref",
	"datasources" : {
		 "${DB_DATABASE:coldbox}":{
			 "host":"${DB_HOST:127.0.0.1}",
			 "dbdriver":"${DB_DRIVER:MySQL}",
			 "database":"${DB_DATABASE:coldbox}",
			 "dsn":"jdbc:mysql://{host}:{port}/{database}",
			 "custom":"useUnicode=true&characterEncoding=UTF-8&useLegacyDatetimeCode=true&autoReconnect=true",
			 "port":"${DB_PORT:3306}",
			 "class":"${DB_CLASS}",
			 "username":"${DB_USER:root}",
			 "password":"${DB_PASSWORD}",
			 "connectionLimit":"100",
			 "connectionTimeout":"1"
		 }
	}
}
