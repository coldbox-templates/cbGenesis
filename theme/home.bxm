		return icons[ key ] ?: icons[ "handler" ]
	}

	function renderSocialLinks( required array links ) {
		var html = ""
		for ( var link in arguments.links ) {
			html &= '<a class="social-link" href="' & bxsitesUrlAttr( link.url ) & '" target="_blank" rel="noopener noreferrer" aria-label="' & encodeForHTML( link.label ?: link.icon ?: "Link" ) & '" title="' & encodeForHTML( link.label ?: link.icon ?: "Link" ) & '">' & bxsitesIcon( link.icon ?: "generic" ) & '</a>'
		}
		return html
	}

	function renderVersionSwitcher( required array versions, required string currentVersion ) {
		var html = '<select class="version-switcher form-select form-select-sm" onchange="location.href=this.value" aria-label="' & encodeForHTML( variables.strings.version ) & '">'
		for ( var v in arguments.versions ) {
			var selected = v.label == arguments.currentVersion ? " selected" : ""
			html &= '<option value="' & bxsitesUrlAttr( v.url ) & '"' & selected & '>' & encodeForHTML( v.label ) & '</option>'
		}
		html &= '</select>'
		return html
	}

	function renderLocaleDropdown( required array locales, required string currentLocale ) {
		var current = locales[ 1 ]
		for ( var l in arguments.locales ) {
			if ( l.code == arguments.currentLocale ) {
				current = l
				break
			}
		}
		var currentFlag = len( current.flag ?: "" ) ? current.flag : bxsitesLocaleFlag( current.code )

		var html = '<div class="locale-dropdown" x-data="{ open: false }" @click.outside="open = false" @keydown.escape.window="open = false">'
		html &= '<button type="button" class="locale-dropdown__trigger" @click="open = !open" aria-haspopup="true" :aria-expanded="open" aria-label="' & encodeForHTML( variables.stringsResolver.format( variables.strings.language, { "label" : current.label } ) ) & '">'
		html &= '<span class="locale-dropdown__flag" aria-hidden="true">' & currentFlag & '</span>'
		html &= '<span class="locale-dropdown__caret" aria-hidden="true">▾</span>'
		html &= '</button>'
		html &= '<ul class="locale-dropdown__menu" x-show="open" x-cloak role="menu">'
		for ( var l in arguments.locales ) {
			var flag = len( l.flag ?: "" ) ? l.flag : bxsitesLocaleFlag( l.code )
			var active = l.code == arguments.currentLocale
			html &= '<li role="none"><a role="menuitem" class="locale-dropdown__item' & ( active ? ' locale-dropdown__item--active' : '' ) & '" href="' & bxsitesUrlAttr( l.url ) & '">'
			html &= '<span class="locale-dropdown__flag" aria-hidden="true">' & flag & '</span> ' & encodeForHTML( l.label )
			html &= '</a></li>'
		}
		html &= '</ul></div>'
		return html
	}

	function resolveAssetUrl( required string url ) {
		return arguments.url.reFindNoCase( "^[a-z][a-z0-9+.\-]*://" ) ? arguments.url : variables.basePath & arguments.url
	}

	function renderArticleMeta() {
		if ( !len( trim( variables.page.publishedTime ?: "" ) ) ) {
			return ""
		}
		var html = '<meta property="article:published_time" content="' & encodeForHTML( variables.page.publishedTime ) & '">'
		for ( var authorUrl in ( variables.page.articleAuthorUrls ?: [] ) ) {
			html &= '<meta property="article:author" content="' & encodeForHTML( authorUrl ) & '">'
		}
		return html
	}

	function renderBrandMark() {
		var logo = trim( variables.siteConfig.theme.logo ?: "" )
		var name = encodeForHTML( variables.siteConfig.name )
		if ( len( logo ) ) {
			return '<img class="brand-logo" src="' & resolveAssetUrl( logo ) & '" alt=""><span class="brand-name">' & name & '</span>'
		}
		return '⚡ ' & name
	}

	function renderExtraCss( required array urls ) {
		var html = ""
		for ( var url in arguments.urls ) {
			html &= '<link rel="stylesheet" href="' & resolveAssetUrl( url ) & '">'
		}
		return html
	}

	function renderExtraJs( required array urls ) {
		var html = ""
		for ( var url in arguments.urls ) {
			html &= '<script src="' & resolveAssetUrl( url ) & '" defer></script>'
		}
		return html
	}

	variables.searchEnabled = ( variables.siteConfig.search ?: false ) ? true : false
	variables.searchProviderName = lCase( trim( variables.siteConfig.searchProvider.provider ?: "local" ) )
	variables.searchAlgolia = variables.siteConfig.searchProvider.algolia ?: {}
	variables.repoUrl = trim( variables.siteConfig.repo.url ?: "" )
	variables.socialLinks = variables.siteConfig.social ?: []
	variables.footerEnabled = ( variables.siteConfig.footer ?: false ) ? true : false
	variables.navCollapsible = ( variables.siteConfig.theme.options.navCollapsible ?: false ) ? true : false
	variables.navExpandAll = ( variables.siteConfig.theme.options.navExpandAll ?: true ) ? true : false
	variables.tocPosition = variables.siteConfig.theme.options.tocPosition ?: "top"
	variables.mainContentClass = variables.tocPosition == "sticky" ? "col-xl-8" : "col-xl-10"
	variables.pageMetaPosition = variables.siteConfig.theme.options.pageMetaPosition ?: "bottom"
	variables.breadcrumbsEnabled = ( variables.siteConfig.theme.options.breadcrumbs ?: true ) ? true : false
	variables.faviconUrl = trim( variables.siteConfig.theme.favicon ?: "" )
	variables.ogImageUrl = len( trim( variables.page.ogImage ?: "" ) ) ? trim( variables.page.ogImage ) : trim( variables.siteConfig.ogImage ?: "" )
	variables.ogDescription = len( variables.page.description ?: "" ) ? variables.page.description : ( variables.siteConfig.description ?: "" )
	variables.analyticsProvider = trim( variables.siteConfig.analytics.provider ?: "" )
	variables.analyticsId = trim( variables.siteConfig.analytics.id ?: "" )
	variables.mermaidEnabled = ( variables.siteConfig.mermaid ?: false ) ? true : false
	variables.mathEnabled = ( variables.siteConfig.math ?: false ) ? true : false
	variables.openapiEnabled = ( variables.siteConfig.openapi ?: false ) ? true : false
	variables.pageActionsEnabled = ( variables.siteConfig.pageActions ?: false ) ? true : false
	variables.pageActionsPosition = variables.siteConfig.theme.options.pageActionsPosition ?: "top"
	variables.accentColor = trim( variables.siteConfig.theme.options.accentColor ?: "" )
	variables.accentColorDark = trim( variables.siteConfig.theme.options.accentColorDark ?: "" )
</bx:script>
<bx:output>
<!doctype html>
<html lang="#encodeForHTML( variables.currentLocale.len() ? variables.currentLocale : 'en' )#" dir="#encodeForHTML( variables.currentLocaleDir )#">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>#encodeForHTML( variables.page.title )# - #encodeForHTML( variables.siteConfig.name )#</title>
	<meta property="og:type" content="#encodeForHTML( len( trim( variables.page.ogType ?: '' ) ) ? variables.page.ogType : 'website' )#">
	<meta property="og:site_name" content="#encodeForHTML( variables.siteConfig.name )#">
	<meta property="og:title" content="#encodeForHTML( variables.page.title )#">
	#renderArticleMeta()#
<bx:if len( variables.page.canonicalUrl )>
	<link rel="canonical" href="#encodeForHTML( variables.page.canonicalUrl )#">
</bx:if>
<bx:if len( variables.ogDescription )>
	<meta name="description" content="#encodeForHTML( variables.ogDescription )#">
	<meta property="og:description" content="#encodeForHTML( variables.ogDescription )#">
</bx:if>
<bx:if len( variables.ogImageUrl )>
	<meta property="og:image" content="#resolveAssetUrl( variables.ogImageUrl )#">
	<meta name="twitter:card" content="summary_large_image">
</bx:if>
<bx:if len( variables.faviconUrl )>
	<link rel="icon" href="#resolveAssetUrl( variables.faviconUrl )#">
</bx:if>
	<script>
		( function () {
			var configuredMode = "#variables.siteConfig.theme.options.colorMode ?: 'auto'#";
			var stored = localStorage.getItem( "bxsites-theme" );
			var prefersDark = window.matchMedia( "(prefers-color-scheme: dark)" ).matches;
			var wantsDark = stored ? stored === "dark" : ( configuredMode === "dark" || ( configuredMode === "auto" && prefersDark ) );
			if ( wantsDark ) {
				document.documentElement.setAttribute( "data-theme", "dark" );
			}
		} )();
	</script>
	<link rel="stylesheet" href="#variables.basePath#assets/vendor/bootstrap/bootstrap.min.css">
	<link rel="stylesheet" href="#variables.basePath#assets/vendor/highlight/github.min.css">
	<link rel="stylesheet" href="#variables.basePath##variables.siteConfig.theme.styleUrl ?: 'assets/theme/style.css'#">
	<link rel="stylesheet" href="#variables.basePath#assets/theme/home.css">
	#renderExtraCss( variables.siteConfig.extraCss ?: [] )#
<bx:if len( variables.accentColor ) or len( variables.accentColorDark )>
	<style>
<bx:if len( variables.accentColor )>
		:root {
			--bxsites-accent: #variables.accentColor#;
			--bxsites-link: #variables.accentColor#;
			--bxsites-link-hover: color-mix( in srgb, #variables.accentColor# 85%, black );
		}
</bx:if>
<bx:if len( variables.accentColorDark )>
		[data-theme="dark"] {
			--bxsites-accent: #variables.accentColorDark#;
			--bxsites-link: #variables.accentColorDark#;
			--bxsites-link-hover: color-mix( in srgb, #variables.accentColorDark# 85%, white );
		}
</bx:if>
	</style>
</bx:if>
<bx:if variables.mathEnabled>
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css">
</bx:if>
<bx:if variables.openapiEnabled>
	<link rel="stylesheet" href="#variables.basePath#assets/vendor/swagger-ui/swagger-ui.css">
</bx:if>
<bx:if variables.analyticsProvider == 'google'>
	<script async src="https://www.googletagmanager.com/gtag/js?id=#encodeForHTML( variables.analyticsId )#"></script>
	<script>
		window.dataLayer = window.dataLayer || [];
		function gtag(){dataLayer.push(arguments);}
		gtag('js', new Date());
		gtag('config', '#variables.analyticsId#');
	</script>
</bx:if>
<bx:if variables.searchEnabled and variables.searchProviderName eq 'local'>
	<script>window.__BXSITES_BASE_PATH__ = "#variables.basePath#";</script>
	<script>window.__BXSITES_SEARCH_NO_RESULTS__ = "#encodeForJavaScript( variables.strings.searchNoResults )#";</script>
	<script src="#variables.basePath#assets/vendor/minisearch/minisearch.js"></script>
	<script src="#variables.basePath#assets/search.js" defer></script>
</bx:if>
<bx:if variables.searchEnabled and variables.searchProviderName eq 'algolia'>
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@docsearch/css@3">
</bx:if>
<bx:if variables.searchEnabled and variables.searchProviderName eq 'pagefind'>
	<link rel="stylesheet" href="#variables.basePath#pagefind/pagefind-ui.css">
</bx:if>
	<script src="#variables.basePath#assets/vendor/alpine/cdn.min.js" defer></script>
</head>
<body class="bxsites-home" x-data="{ dark: document.documentElement.getAttribute( 'data-theme' ) === 'dark' }" x-init="$watch( 'dark', v => { document.documentElement.setAttribute( 'data-theme', v ? 'dark' : 'light' ); localStorage.setItem( 'bxsites-theme', v ? 'dark' : 'light' ) } )">

<header class="bxh-nav">
	<div class="bxh-wrap bxh-navrow">
		<a class="bxh-brand" href="#variables.basePath#">#renderBrandMark()#</a>
		<nav class="bxh-navlinks">
			<a href="#variables.basePath#getting-started/">Getting Started</a>
			<a href="#variables.basePath#architecture/">Architecture</a>
			<a href="#variables.basePath#guides/security/">Security</a>
			<a href="#variables.basePath#guides/database-orm/">Database</a>
		</nav>
		<div class="bxh-navcta">
			<div class="bxh-nav-utils">
<bx:if variables.versions.len() gt 1>
				#renderVersionSwitcher( variables.versions, variables.currentVersion )#
</bx:if>
<bx:if variables.locales.len() gt 1>
				#renderLocaleDropdown( variables.locales, variables.currentLocale )#
</bx:if>
				<button type="button" class="bxh-theme-toggle" @click="dark = !dark" aria-label="#encodeForHTML( variables.strings.toggleDarkMode )#">
					<span x-show="!dark">#bxsitesIcon( "moon" )#</span>
					<span x-show="dark" x-cloak>#bxsitesIcon( "sun" )#</span>
				</button>
			</div>
<bx:if len( variables.repoUrl )>
			<a class="bxh-btn bxh-btn-ghost bxh-btn-sm" href="#bxsitesUrlAttr( variables.repoUrl )#" target="_blank" rel="noopener noreferrer">#bxsitesIcon( "github" )# Star</a>
</bx:if>
			<a class="bxh-btn bxh-btn-primary bxh-btn-sm" href="#variables.basePath#getting-started/">Get Started</a>
		</div>
	</div>
</header>

<main class="bxh-wrap bxh-hero">
	<div class="bxh-hero-grid">
		<div>
			<div class="hero-mark">#homeIcon( "cbgenesis" )#</div>
			<span class="eyebrow">The official ColdBox starter</span>
			<h1>Scaffold. Build.<br><span class="grad">Accelerate.</span></h1>
			<p class="lead">A production-ready ColdBox HMVC starter for BoxLang &mdash; authentication, RBAC permissions, API tokens, an Alpine-powered admin panel, and a real test suite, so you spend day one building features instead of scaffolding auth.</p>
			<div class="hero-actions">
				<a class="bxh-btn bxh-btn-primary" href="#variables.basePath#getting-started/">Get Started &rarr;</a>
<bx:if len( variables.repoUrl )>
				<a class="bxh-btn bxh-btn-ghost" href="#bxsitesUrlAttr( variables.repoUrl )#" target="_blank" rel="noopener noreferrer">#bxsitesIcon( "github" )# View on GitHub</a>
</bx:if>
			</div>
			<div class="install-chip">
				<span>$</span><span>git clone coldbox-templates/cbGenesis &amp;&amp; box install</span>
			</div>
			<div class="req-row">
				<span>#homeIcon( "shield-check" )#BoxLang 1.16+</span>
				<span>#homeIcon( "shield-check" )#Java 21+</span>
				<span>#homeIcon( "shield-check" )#Node 18+</span>
			</div>
		</div>
		<div class="preview">
			<div class="float-badge badge-1">#homeIcon( "shield-check" )# RBAC &middot; resource:action</div>
			<div class="preview-card">
				<div class="preview-bar"><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="url">app.local/admin/permissions</span></div>
				<div class="admin-shell">
					<div class="admin-side">
						<div class="item">#homeIcon( "handler" )# Dashboard</div>
						<div class="grp">Access</div>
						<div class="item">#homeIcon( "users" )# Users</div>
						<div class="item active">#homeIcon( "shield-check" )# Permissions</div>
						<div class="item">#homeIcon( "logbox" )# Audit Log</div>
					</div>
					<div class="admin-main">
						<h4>Roles &amp; Permissions</h4>
						<div class="sub">resource:action grants, per role</div>
						<table class="perm-table">
							<thead><tr><th>Resource</th><th>view</th><th>edit</th><th>admin</th></tr></thead>
							<tbody>
								<tr><td>users</td><td class="yes">&check;</td><td class="yes">&check;</td><td class="no">&ndash;</td></tr>
								<tr><td>roles</td><td class="yes">&check;</td><td class="no">&ndash;</td><td class="no">&ndash;</td></tr>
								<tr><td>settings</td><td class="yes">&check;</td><td class="yes">&check;</td><td class="yes">&check;</td></tr>
							</tbody>
						</table>
					</div>
				</div>
			</div>
			<div class="float-badge badge-2">#homeIcon( "lock" )# CSRF protected by default</div>
		</div>
	</div>
</main>

<section>
	<div class="bxh-wrap bxh-orbit-wrap">
		<div class="section-head" style="text-align:center;margin-inline:auto">
			<span class="eyebrow" style="justify-content:center">Request lifecycle</span>
			<h2>Browser to database, in six hops.</h2>
		</div>
		<div class="flow-row">
			<div class="flow-stage"><div class="flow-icon">#homeIcon( "browser" )#</div><span>Browser</span></div>
			<div class="flow-connector"><div class="line"></div><span class="flow-pulse" style="animation-delay:0s"></span></div>
			<div class="flow-stage"><div class="flow-icon">#homeIcon( "router" )#</div><span>Router</span></div>
			<div class="flow-connector"><div class="line"></div><span class="flow-pulse" style="animation-delay:.5s"></span></div>
			<div class="flow-stage"><div class="flow-icon">#homeIcon( "handler" )#</div><span>Handler</span></div>
			<div class="flow-connector"><div class="line"></div><span class="flow-pulse" style="animation-delay:1s"></span></div>
			<div class="flow-stage"><div class="flow-icon">#homeIcon( "shield-check" )#</div><span>Service</span></div>
			<div class="flow-connector"><div class="line"></div><span class="flow-pulse" style="animation-delay:1.5s"></span></div>
			<div class="flow-stage"><div class="flow-icon">#homeIcon( "database" )#</div><span>ORM / qb</span></div>
			<div class="flow-connector"><div class="line"></div><span class="flow-pulse" style="animation-delay:2s"></span></div>
			<div class="flow-stage"><div class="flow-icon">#homeIcon( "view" )#</div><span>View / Layout</span></div>
		</div>
		<p class="orbit-caption">The same request path cbGenesis's own login screen runs on &mdash; convention over ceremony, every hop.</p>
	</div>
</section>

<section>
	<div class="bxh-wrap">
		<div class="section-head">
			<span class="eyebrow">Everything included</span>
			<h2>Day one, not sprint six.</h2>
			<p>Every card below is already wired up and tested in the template &mdash; not a TODO in the README.</p>
		</div>
		<div class="bxh-grid">
			<div class="bxh-card"><div class="icon">#homeIcon( "rocket" )#</div><h3><a href="#variables.basePath#getting-started/">Get Started in Minutes</a></h3><p>Install BoxLang, clone the template, run migrations, and be looking at the login screen in under ten minutes.</p></div>
			<div class="bxh-card"><div class="icon">#homeIcon( "folders" )#</div><h3><a href="#variables.basePath#architecture/">Modern Template Structure</a></h3><p>Application code lives in <code>app/</code>, fully separated from the public webroot in <code>public/</code> &mdash; enhanced security by default.</p></div>
			<div class="bxh-card"><div class="icon">#homeIcon( "shield-check" )#</div><h3><a href="#variables.basePath#guides/security/">Auth &amp; RBAC, Batteries Included</a></h3><p>Session auth via cbauth, <code>@secured</code> handler annotations, CSRF rotation, JWT support, and a <code>resource:action</code> permission model.</p></div>
			<div class="bxh-card"><div class="icon">#homeIcon( "database" )#</div><h3><a href="#variables.basePath#guides/database-orm/">Hibernate ORM + qb</a></h3><p><code>BaseEntity</code>/<code>BaseService</code> conventions on top of cborm, migrations via cfmigrations, and qb for anything raw SQL does better.</p></div>
			<div class="bxh-card"><div class="icon">#homeIcon( "palette" )#</div><h3><a href="#variables.basePath#guides/frontend/">Alpine.js + Bootstrap 5 UI</a></h3><p>Server-rendered BXM views, sprinkled with small Alpine components, compiled by Vite with hot module reload.</p></div>
			<div class="bxh-card"><div class="icon">#homeIcon( "test-tube" )#</div><h3><a href="#variables.basePath#guides/testing/">A Real Test Suite</a></h3><p>TestBox unit specs for every entity and service, plus integration specs that exercise real HTTP requests.</p></div>
			<div class="bxh-card"><div class="icon">#homeIcon( "sliders" )#</div><h3><a href="#variables.basePath#guides/configuration/">Easy Configuration</a></h3><p>Environment variables for the essentials, DB-backed admin settings for everything else &mdash; no redeploy needed to change them.</p></div>
			<div class="bxh-card"><div class="icon">#homeIcon( "deploy" )#</div><h3><a href="#variables.basePath#deployment/">Production Ready</a></h3><p>A real go-live checklist, Docker support, and a choice of CommandBox or the BoxLang MiniServer.</p></div>
		</div>
	</div>
</section>

<section>
	<div class="bxh-wrap">
		<div class="section-head">
			<span class="eyebrow">Already wired up</span>
			<h2>A stack you already know how to run.</h2>
			<p>No separate build system to learn &mdash; one CLI, from a fresh clone to a running server.</p>
			<div class="stack-strip">
				<span class="label">Works with</span>
				<span title="ColdBox">#homeIcon( "coldbox" )#</span>
				<span title="BoxLang">#homeIcon( "boxlang" )#</span>
				<span title="Bootstrap 5">#homeIcon( "palette" )#</span>
				<span title="Vite">#bxsitesIcon( "sparkle" )#</span>
				<span title="qb">#homeIcon( "database" )#</span>
			</div>
		</div>
		<div class="term-panel">
			<div class="preview-bar"><span class="dot"></span><span class="dot"></span><span class="dot"></span></div>
			<div class="term-body">
				<div class="term-line" style="animation-delay:0s"><span class="ok">&check;</span> <span class="term-cmd">box install</span></div>
				<div class="term-line" style="animation-delay:1.2s"><span class="ok">&check;</span> <span class="term-cmd">box migrate up &amp;&amp; box migrate seed</span></div>
				<div class="term-line" style="animation-delay:2.4s"><span class="ok">&check;</span> 7 migrations run &middot; admin user seeded</div>
				<div class="term-line" style="animation-delay:3.6s"><span class="ok">&check;</span> <span class="term-cmd">box server start</span><span class="term-cursor"></span></div>
			</div>
		</div>
	</div>
</section>

<section>
	<div class="bxh-wrap sec-grid">
		<div>
			<span class="eyebrow">Secured by convention</span>
			<h2>The firewall, not an if-check.</h2>
			<div class="sec-list">
				<div class="sec-item">
					<div class="icon">#homeIcon( "shield-check" )#</div>
					<div><h4>@secured, everywhere</h4><p>Every admin handler extends <code>BaseSecureHandler</code> and carries a <code>@secured( "resource:action,resource:admin" )</code> annotation &mdash; enforced before the handler ever runs.</p></div>
				</div>
				<div class="sec-item">
					<div class="icon">#homeIcon( "lock" )#</div>
					<div><h4>CSRF, deny by default</h4><p>Any non-GET request must carry a valid <code>rc.csrf</code> token, rotated per session &mdash; no hand-rolled checks scattered through controllers.</p></div>
				</div>
				<div class="sec-item">
					<div class="icon">#homeIcon( "key" )#</div>
					<div><h4>JWT &amp; API tokens</h4><p>First-class token auth alongside sessions &mdash; issue, list, and revoke tokens straight from a user's profile.</p></div>
				</div>
			</div>
		</div>
		<div class="matrix-card">
			<div class="cap">Roles &middot; live in the admin panel</div>
			<table class="perm-table">
				<thead><tr><th>Role</th><th>users</th><th>roles</th><th>settings</th><th>audit</th></tr></thead>
				<tbody>
					<tr><td>Admin</td><td class="yes">&check;</td><td class="yes">&check;</td><td class="yes">&check;</td><td class="yes">&check;</td></tr>
					<tr><td>Manager</td><td class="yes">&check;</td><td class="no">&ndash;</td><td class="no">&ndash;</td><td class="yes">&check;</td></tr>
					<tr><td>Support</td><td class="yes">&check;</td><td class="no">&ndash;</td><td class="no">&ndash;</td><td class="no">&ndash;</td></tr>
					<tr><td>Member</td><td class="no">&ndash;</td><td class="no">&ndash;</td><td class="no">&ndash;</td><td class="no">&ndash;</td></tr>
				</tbody>
			</table>
		</div>
	</div>
</section>

<section>
	<div class="bxh-wrap">
		<div class="section-head">
			<span class="eyebrow">How we compare</span>
			<h2>Batteries included, on purpose.</h2>
			<p>Most starters give you routing and a "good luck." cbGenesis gives you the parts every real app ends up building anyway.</p>
		</div>
		<div class="compare-wrap">
			<table class="compare">
				<thead><tr><th>&nbsp;</th><th class="us">cbGenesis</th><th>Vanilla ColdBox</th><th>Laravel + Breeze</th><th>Rails + Devise</th></tr></thead>
				<tbody>
					<tr><td>Auth &amp; sessions out of the box</td><td class="us yes">&check;</td><td class="no">&cross;</td><td class="yes" style="color:var(--muted)">&check;</td><td class="yes" style="color:var(--muted)">&check;</td></tr>
					<tr><td>RBAC permission model</td><td class="us yes">&check;</td><td class="no">&cross;</td><td class="no">&cross;</td><td class="no">&cross;</td></tr>
					<tr><td>API tokens included</td><td class="us yes">&check;</td><td class="no">&cross;</td><td class="no">&cross;</td><td class="no">&cross;</td></tr>
					<tr><td>Admin UI included</td><td class="us yes">&check;</td><td class="no">&cross;</td><td class="no">&cross;</td><td class="no">&cross;</td></tr>
					<tr><td>ORM + migrations</td><td class="us yes">&check;</td><td class="yes" style="color:var(--muted)">&check;</td><td class="yes" style="color:var(--muted)">&check;</td><td class="yes" style="color:var(--muted)">&check;</td></tr>
					<tr><td>Real test suite included</td><td class="us yes">&check;</td><td class="no">&cross;</td><td class="yes" style="color:var(--muted)">&check;</td><td class="yes" style="color:var(--muted)">&check;</td></tr>
					<tr><td>Docker included</td><td class="us yes">&check;</td><td class="no">&cross;</td><td class="yes" style="color:var(--muted)">&check;</td><td class="no">&cross;</td></tr>
					<tr><td>Production go-live checklist</td><td class="us yes">&check;</td><td class="no">&cross;</td><td class="no">&cross;</td><td class="no">&cross;</td></tr>
				</tbody>
			</table>
		</div>
	</div>
</section>

<section>
	<div class="bxh-wrap">
		<div class="section-head" style="text-align:center;margin-inline:auto">
			<span class="eyebrow" style="justify-content:center">Built on the ColdBox platform</span>
			<h2>Not a one‑off template. A whole platform.</h2>
			<div class="eco-hero-mark">#homeIcon( "coldbox" )#</div>
		</div>
		<div class="eco-row">
			<a class="eco-card" href="https://coldbox.ortusbooks.com" target="_blank" rel="noopener noreferrer"><div class="icon">#homeIcon( "coldbox" )#</div><b>ColdBox</b><span>The HMVC framework cbGenesis is built on.</span></a>
			<a class="eco-card" href="https://boxlang.io" target="_blank" rel="noopener noreferrer"><div class="icon">#homeIcon( "boxlang" )#</div><b>BoxLang</b><span>The modern, dynamic JVM language it runs on.</span></a>
			<a class="eco-card" href="https://wirebox.ortusbooks.com" target="_blank" rel="noopener noreferrer"><div class="icon">#homeIcon( "wirebox" )#</div><b>WireBox</b><span>Dependency injection for every handler and service.</span></a>
			<a class="eco-card" href="https://cachebox.ortusbooks.com" target="_blank" rel="noopener noreferrer"><div class="icon">#homeIcon( "cachebox" )#</div><b>CacheBox</b><span>Caching for settings, permissions, and lookups.</span></a>
			<a class="eco-card" href="https://logbox.ortusbooks.com" target="_blank" rel="noopener noreferrer"><div class="icon">#homeIcon( "logbox" )#</div><b>LogBox</b><span>Structured logging for every layer of the app.</span></a>
			<a class="eco-card" href="https://testbox.ortusbooks.com" target="_blank" rel="noopener noreferrer"><div class="icon">#homeIcon( "testbox" )#</div><b>TestBox</b><span>The BDD/TDD framework cbGenesis's own specs run on.</span></a>
			<a class="eco-card eco-card-wide" href="https://commandbox.ortusbooks.com" target="_blank" rel="noopener noreferrer"><div class="icon">#homeIcon( "commandbox" )#</div><b>CommandBox</b><span>The package manager and CLI that installs, migrates, and serves cbGenesis in three commands.</span></a>
		</div>
	</div>
</section>

<section>
	<div class="bxh-wrap">
		<div class="cta">
			<span class="eyebrow">Free &amp; open source</span>
			<h2>Ready to scaffold your next ColdBox app?</h2>
			<p>Clone it, run three commands, and start building on top of auth that's already done.</p>
			<div class="hero-actions">
				<a class="bxh-btn bxh-btn-primary" href="#variables.basePath#getting-started/">Get Started &rarr;</a>
<bx:if len( variables.repoUrl )>
				<a class="bxh-btn bxh-btn-ghost" href="#bxsitesUrlAttr( variables.repoUrl )#" target="_blank" rel="noopener noreferrer">View on GitHub</a>
</bx:if>
			</div>
		</div>
	</div>
</section>

<section>
	<div class="bxh-wrap">
		<div class="cta">
			<span class="eyebrow">Need a hand building on cbGenesis?</span>
			<h2>ColdBox is free &amp; open source &mdash; or let the team who builds it do the work.</h2>
			<p><a href="https://www.ortussolutions.com" target="_blank" rel="noopener noreferrer">Ortus Solutions</a> builds and maintains ColdBox, and offers professional services for custom builds, migrations, and production hardening.</p>
			<div class="hero-actions">
				<a class="bxh-btn bxh-btn-primary" href="mailto:consulting@ortussolutions.com">Email consulting@ortussolutions.com</a>
				<a class="bxh-btn bxh-btn-ghost" href="https://www.ortussolutions.com/services" target="_blank" rel="noopener noreferrer">Consulting &amp; Professional Services</a>
			</div>
		</div>
	</div>
</section>

