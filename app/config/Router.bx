/**
 * This is your application router.  From here you can controll all the incoming routes to your application.
 *
 * https://coldbox.ortusbooks.com/the-basics/routing
 */
class {

	function configure() {
		/**
		 * --------------------------------------------------------------------------
		 * App Routes
		 * --------------------------------------------------------------------------
		 * Here is where you can register the routes for your web application!
		 * Go get Funky!
		 */

		// A nice healthcheck route example
		route(
			"/healthcheck",
			( event, rc, prc ) -> "Ok!"
		)

		// App Routes
		route( pattern = "dashboard", target = "Dashboard.index" )
		route( pattern = "profile", target = "Profile.index" )
		route( pattern = "settings", target = "Settings.index" )
		route( pattern = "users", target = "Users.index" )
		route( pattern = "roles", target = "Roles.index" )
		route( pattern = "permissions", target = "Permissions.index" )

		// Auth Routes
		route( "login" ).withHandler( "Auth" ).toAction({
			GET: "login",
			POST: "doLogin"
		})
		post( pattern = "logout", target = "Auth.logout" )

		// @app_routes@

		// Conventions-Based Routing
		route( ":handler/:action?" ).end()
	}
}