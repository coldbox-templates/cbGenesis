/**
 * This is your application router.  From here you can controll all the incoming routes to your application.
 *
 * https://coldbox.ortusbooks.com/the-basics/routing
 */
class {

	function configure() {
		/**
		 * --------------------------------------------------------------------------
		 * App Routes
		 * --------------------------------------------------------------------------
		 * Here is where you can register the routes for your web application!
		 * Go get Funky!
		 */

		// A nice healthcheck
		route(
			"/healthcheck",
			( event, rc, prc ) -> "Ok!"
		)

		// Dashboard
		route( "dashboard", "Dashboard.index" )

		// Permission Resources
		resources(
			resource:"permissions",
			parameterName: "permissionId"
		)

		// Role Routes
		route( "/roles/:roleId/available-users", "Roles.availableUsers" )
		// Add and remove users from a role
		route( "/roles/:roleId/users/:userId" ).withHandler( "Roles" ).toAction({
			POST   : "addUser",
			DELETE : "removeUser"
		})
		// Get a user's roles
		route( "/roles/:roleId/users", "Roles.users" )
		// Role Resources
		resources(
			resource:"roles",
			parameterName: "roleId"
		)

		// User Routes
		resources(
			resource:"users",
			parameterName: "userId"
		)

		// Profile Routes
		post( "profile/password", "Profile.doPasswordChange" )
		route( "profile/api-tokens" ).withHandler( "Profile" ).toAction({
			GET : "listTokens",
			POST: "createToken"
		})
		route( "profile/api-tokens/:tokenId" ).withHandler( "Profile" ).toAction({
			POST  : "updateToken",
			DELETE: "deleteToken"
		})
		route( "profile" ).withHandler( "Profile" ).toAction({
			GET: "index",
			POST: "save"
		})

		// Settings Routes
		route( "settings" ).withHandler( "Settings" ).toAction({
			GET: "index",
			POST: "save"
		})

		// Setting Admin Actions
		post( "settings/clear-template-cache", "Settings.clearTemplateCache" )
		post( "settings/clear-sessions-cache", "Settings.clearSessionsCache" )
		post( "settings/revoke-remember-tokens", "Settings.revokeRememberTokens" )

		// Auth Routes
		route( "login" ).withHandler( "Auth" ).toAction({
			GET: "login",
			POST: "doLogin"
		})
		route( "register" ).withHandler( "Auth" ).toAction({
			GET: "register",
			POST: "doRegister"
		})
		post( pattern = "logout", target = "Auth.logout" )
		route( "forgot-password" ).withHandler( "Auth" ).toAction({
			GET: "forgotPassword",
			POST: "doForgotPassword"
		})
		route( "reset-password" ).withHandler( "Auth" ).toAction({
			GET: "resetPassword",
			POST: "doResetPassword"
		})

		// @app_routes@

		// Conventions-Based Routing
		route( ":handler/:action?" ).end()
	}
}