class {

	function configure() {
		var googleClientId = getSystemSetting( "GOOGLE_CLIENT_ID", "" );
		var googleClientSecret = getSystemSetting( "GOOGLE_CLIENT_SECRET", "" );
		var googleRedirectUri = getSystemSetting( "GOOGLE_REDIRECT_URI", "" );
		var providers = [];

		// Keep the application bootable before an administrator configures a provider.
		if (
			len( trim( googleClientId ) ) && len( trim( googleClientSecret ) ) && len( trim( googleRedirectUri ) )
		) {
			providers
				.append(
					{
						type         : "app.models.security.GoogleSSOProvider",
						clientId     : googleClientId,
						clientSecret : googleClientSecret,
						redirectUri  : googleRedirectUri
					}
				);
		}

		return {
			enableCBAuthIntegration : false,
			errorRedirect           : "/sso/complete",
			successRedirect         : "/sso/complete",
			providers               : providers
		};
	}
}