class {

	function configure() {
		return {
			// Register the disks used by this application
			"disks": {
				"assets": {
					provider  : "Local",
					properties: {
						path      : getSystemSetting( "CBFS_ASSETS_DISK_PATH", "#controller.getAppRootPath()#.cbfs" ),
						autoExpand: true
					}
				}
			}
		}
	}

}
