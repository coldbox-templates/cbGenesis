class {

	/**
	 * Configure the ColdBox Scheduler
	 * https://coldbox.ortusbooks.com/digging-deeper/scheduled-tasks
	 */
	function configure() {
		/**
		 * --------------------------------------------------------------------------
		 * Configuration Methods
		 * --------------------------------------------------------------------------
		 * From here you can set global configurations for the scheduler
		 * - setTimezone( ) : change the timezone for ALL tasks
		 * - setExecutor( executorObject ) : change the executor if needed
		 */

		/**
		 * --------------------------------------------------------------------------
		 * Register Scheduled Tasks
		 * --------------------------------------------------------------------------
		 * You register tasks with the task() method and get back a ColdBoxScheduledTask object
		 * that you can use to register your tasks configurations.
		 */
		task( "Purge Expired API Tokens" )
			.call( () => getInstance( "APITokenService" ).purgeExpiredTokens() )
			.everyDayAt( "03:00" )
			.onOneServer()
			.withNoOverlaps()

		task( "Purge Expired Remember Tokens" )
			.call( () => getInstance( "SecurityService" ).purgeExpiredRememberTokens() )
			.everyDayAt( "03:15" )
			.onOneServer()
			.withNoOverlaps()

		task( "Purge Old Audit Logs" )
			.call( () => getInstance( "AuditLogService" ).purgeOlderThan(
				getInstance( "SettingService" ).getSetting( "cbAuditLogRetentionDays", 90 )
			) )
			.everyDayAt( "03:30" )
			.onOneServer()
			.withNoOverlaps()

		// Rate limit history: every server flushes its own in-memory tally every minute, so
		// this is deliberately not onOneServer. Concurrent flushes add to the same rows.
		task( "Flush Rate Limit History" )
			.call( () => getInstance( "RateLimitHistoryService" ).flush() )
			.everyMinute()
			.withNoOverlaps()

		task( "Purge Old Rate Limit History" )
			.call( () => getInstance( "RateLimitHistoryService" ).purgeOlderThan(
				getInstance( "SettingService" ).getSetting( "cbRateLimitHistoryRetentionDays", 30 )
			) )
			.everyDayAt( "03:45" )
			.onOneServer()
			.withNoOverlaps()

		// A timed pause switches off by itself on time (RateLimitControlService.isEnabled()
		// does not wait for this); this only clears the stored values and audits it.
		task( "Expire Rate Limiting Pause" )
			.call( () => getInstance( "RateLimitControlService" ).expireIfDue() )
			.everyMinute()
			.onOneServer()
			.withNoOverlaps()

		// One audit entry a day while a pause has no end time, so it cannot be forgotten.
		task( "Remind Rate Limiting Is Paused" )
			.call( () => getInstance( "RateLimitControlService" ).remindIfPausedIndefinitely() )
			.everyDayAt( "09:00" )
			.onOneServer()
			.withNoOverlaps()
	}

	/**
	 * Called before the scheduler is going to be shutdown
	 */
	function onShutdown() {
		// Do not lose the last minute of rate limit tallies on a normal stop.
		getInstance( "RateLimitHistoryService" ).flush()
	}

	/**
	 * Called after the scheduler has registered all schedules
	 */
	function onStartup() {

	}

	/**
	 * Called whenever ANY task fails
	 *
	 * @task      The task that got executed
	 * @exception The ColdFusion exception object
	 */
	function onAnyTaskError( required task, required exception ) {
		log.error(
			"Scheduled task [#task.getName()#] failed: #exception.message#",
			exception
		)
	}

	/**
	 * Called whenever ANY task succeeds
	 *
	 * @task   The task that got executed
	 * @result The result (if any) that the task produced
	 */
	function onAnyTaskSuccess( required task, result ) {

	}

	/**
	 * Called before ANY task runs
	 *
	 * @task The task about to be executed
	 */
	function beforeAnyTask( required task ) {

	}

	/**
	 * Called after ANY task runs
	 *
	 * @task   The task that got executed
	 * @result The result (if any) that the task produced
	 */
	function afterAnyTask( required task, result ) {

	}
}