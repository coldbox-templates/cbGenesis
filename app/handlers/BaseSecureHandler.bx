/**
 * A base secured handler
 *
 * This handler is used to enforce authentication and authorization for all handlers that extend it.
 * It also sets the layout to "Admin" for all views rendered by handlers that extend this base handler.
 */
class extends="coldbox.system.RestHandler"{

	@inject
	property name="settingService";

	@inject
	property name="passkeyService";

	static{
		// The safe methods of RFC 9110, exempt from CSRF verification below.
		SAFE_HTTP_METHODS = "GET,HEAD,OPTIONS"
	}

	/**
	 * Pre-handler method that runs before any secure handler.
	 * It sets the layout to "Admin" for all views rendered by this handler.
	 */
	function preHandler( event, rc, prc ) {
		// --- CSRF Verification: deny by default ---
		// Every state-changing request into a secured handler must carry a valid token.
		// This used to be opt-in: each handler kept a static.csrfVerify map naming the
		// actions to check, and the maps had holes - Users omitted create and delete,
		// and Profile's "password" key never matched its doPasswordChange action, so
		// those endpoints were unprotected. Keying off the HTTP method instead means a
		// new action is covered the day it is added rather than when someone remembers
		// to list it.
		//
		// The safe methods of RFC 9110 are exempt: they must not change state, so they
		// carry no CSRF risk. HEAD is GET without a response body and OPTIONS is a
		// capability probe (including CORS preflight, which cannot carry a token at
		// all) - demanding one on either breaks ordinary clients for no benefit. If a
		// safe method does change state, that is the bug to fix, not this check.
		if (
			!static.SAFE_HTTP_METHODS.listFindNoCase( event.getHTTPMethod() )
			&& !csrfVerify( rc.csrf ?: "" )
		) {
			return onInvalidCSRF( argumentCollection = arguments )
		}

		event.setLayout( "Admin" )

		if (
			settingService.getSetting( "cbRequirePasskey", false )
			&& event.getCurrentAction() != "logout"
			&& !passkeyService.listForUser( prc.authUser.getId() ).len()
		) {
			return relocate( "profile/passkey-required" )
		}
	}

	/**
	 * How this handler reports a failed CSRF check.
	 *
	 * The default aborts with an authorization failure, which is what the JSON/AJAX
	 * handlers want. Handlers that render HTML forms override this to flash a message
	 * and redirect instead, so the user gets a page rather than a bare 403.
	 */
	private function onInvalidCSRF( event, rc, prc ) {
		event.getResponse().addMessage( "Invalid or expired CSRF token." )
		onAuthorizationFailure(
			event: event,
			rc: rc,
			prc: prc,
			abort: true,
			exception: { type: "InvalidCSRF", message: "Invalid or expired CSRF token" }
		)
	}

	/**
	 * Returns a default API results structure for use in AJAX responses.
	 *
	 * @error A boolean indicating whether an error occurred (default: false).
	 * @messages A string containing any messages related to the API response (default: "").
	 * @data Any additional data to include in the API response (default: "").
	 *
	 * @return struct A structure containing default API results with keys: error, messages, and data.
	 */
	private struct function getApiResults( boolean error = false, string messages = "", any data = "" ) {
		return {
			error: arguments.error,
			messages: arguments.messages,
			data: arguments.data
		}
	}

	/**
	 * Ensures that the provided sort direction is valid (either "asc" or "desc").
	 * If the provided direction is invalid, it defaults to "asc".
	 *
	 * @direction The sort direction to validate.
	 *
	 * @return string The validated sort direction ("asc" or "desc").
	 */
	private string function ensureSortDirection( required string direction ){
		var dir = lcase( arguments.direction ).trim()
		if ( dir != "asc" && dir != "desc" ) {
			dir = "asc"
		}
		return dir
	}

	/**
	 * This function is to receive a page number so we can do pagination.
	 * It should return a offset and max so we can pass to any service.
	 *
	 * @page The current page number (1-based index).
	 * @limit The maximum number of items per page (default: 25).
	 *
	 * @return struct A structure containing the calculated offset and limit for pagination.
	 */
	private struct function getPagination( required numeric page, numeric limit = 25 ) {
		arguments.page = max( 1, arguments.page )
		arguments.limit = max( 1, arguments.limit )

		var offset = ( arguments.page - 1 ) * arguments.limit

		return { offset: offset, limit: arguments.limit }
	}

	/**
	 * Decodes a base64 image upload into raw bytes, for handlers accepting an
	 * avatar/logo as a JSON field rather than a multipart file - this app's
	 * AJAX calls are all JSON/urlencoded, never multipart, and BoxLang has no
	 * built-in multipart form parser to receive one with anyway.
	 *
	 * Accepts either a data URI ("data:image/png;base64,...") or a bare
	 * base64 string.
	 *
	 * @throws Image.InvalidFormat When the value is not decodable as base64.
	 */
	private binary function decodeDataUri( required string value ) {
		var base64 = reReplaceNoCase( arguments.value, "^data:[^;]*;base64,", "" )
		try {
			return binaryDecode( base64, "base64" )
		} catch ( any e ) {
			throw( type = "Image.InvalidFormat", message = "The uploaded file is not a readable image." )
		}
	}

}