/**
 * Rate limiting administration: the emergency stop.
 *
 * Pausing and resuming change what the whole application enforces, so they need the
 * settings write permission. Like every BaseSecureHandler, state-changing actions also
 * need a valid CSRF token. The status action is read-only.
 */
@secured( "settings:admin,settings:read" )
class extends="BaseSecureHandler" {

	@inject
	property name="rateLimitControlService";

	@inject
	property name="rateLimitBlockService";

	@inject
	property name="rateLimitExclusionService";

	@inject( "CBSecurity@cbsecurity" )
	property name="cbsecurity";

	/**
	 * Reports whether rate limiting is being enforced and, if paused, until when and by whom.
	 *
	 * @return The API response whose data is the status: enabled, disabledByEnvironment,
	 *         paused, indefinite, pausedUntil, pausedAt, pausedBy, resumesInSeconds.
	 */
	@remote( "This action is requested remotely via JavaScript" )
	function status( event, rc, prc ) {
		return event.getResponse().setData( data: rateLimitControlService.getStatus() )
	}

	/**
	 * Pauses rate limiting.
	 *
	 * rc.minutes is a whole number from 1 to 1440, or 0 for "until I resume". Anything else
	 * is a 422. The pause is audited with who did it.
	 *
	 * @return The API response whose data is the new status.
	 */
	@remote( "This action is submitted remotely via JavaScript" )
	@secured( "settings:admin,settings:write" )
	function pause( event, rc, prc ) {
		var response = event.getResponse()
		try {
			if ( !isNumeric( rc.minutes ?: "" ) ) {
				throw( type = "RateLimit.InvalidPause", message = "Choose how many minutes to pause for, or 0 for until resumed." )
			}
			var status = rateLimitControlService.pause( minutes: val( rc.minutes ) )
			return response.setData(
				data   : status,
				message: status.indefinite
					? "Rate limiting is paused until you resume it."
					: "Rate limiting is paused for #int( status.resumesInSeconds / 60 )# minutes."
			)
		} catch ( "RateLimit.InvalidPause" error ) {
			return response.failure( message: error.message, statusCode: 422 )
		} catch ( any error ) {
			log.error( "Error pausing rate limiting: #error.message#", error )
			return response.failure( message: "Rate limiting could not be paused: #error.message#", statusCode: 500 )
		}
	}

	/**
	 * Resumes rate limiting. Safe to call when it is not paused.
	 *
	 * @return The API response whose data is the new status.
	 */
	@remote( "This action is submitted remotely via JavaScript" )
	@secured( "settings:admin,settings:write" )
	function resume( event, rc, prc ) {
		var response = event.getResponse()
		try {
			return response.setData( data: rateLimitControlService.resume(), message: "Rate limiting is on." )
		} catch ( any error ) {
			log.error( "Error resuming rate limiting: #error.message#", error )
			return response.failure( message: "Rate limiting could not be resumed: #error.message#", statusCode: 500 )
		}
	}

	/**
	 * Lists the active blocked IPs and ranges, newest first.
	 *
	 * @return The API response whose data is an array of blocks.
	 */
	@remote( "This action is requested remotely via JavaScript" )
	function blocks( event, rc, prc ) {
		return event.getResponse().setData( data: rateLimitBlockService.list() )
	}

	/**
	 * Blocks an IP address or CIDR range.
	 *
	 * rc.address is an address or range, rc.hours is 1 to 8760 or 0 for permanent, and
	 * rc.reason is optional. A bad address, a range that is too wide, the admin's own
	 * address and a full list are each a 422 with a message saying what to fix.
	 *
	 * @return The API response whose data is the block.
	 */
	@remote( "This action is submitted remotely via JavaScript" )
	@secured( "settings:admin,settings:write" )
	function block( event, rc, prc ) {
		var response = event.getResponse()
		try {
			var row = rateLimitBlockService.block(
				address    : rc.address ?: "",
				reason     : rc.reason ?: "",
				hours      : isNumeric( rc.hours ?: "" ) ? val( rc.hours ) : 0,
				createdBy  : prc.authUser.getEmail(),
				requesterIp: cbsecurity.getRealIP( trustUpstream = settingService.getSetting( "cbTrustProxyHeaders", true ) )
			)
			return response.setData( data: row, message: "[#row.address#] is blocked." )
		} catch ( any error ) {
			if ( error.type.startsWith( "RateLimit." ) ) {
				return response.failure( message: error.message, statusCode: 422 )
			}
			log.error( "Error blocking an IP: #error.message#", error )
			return response.failure( message: "The IP could not be blocked: #error.message#", statusCode: 500 )
		}
	}

	/**
	 * Removes a block. rc.blockId comes from the route.
	 *
	 * @return The API response, a 404 when there is no such block.
	 */
	@remote( "This action is submitted remotely via JavaScript" )
	@secured( "settings:admin,settings:write" )
	function unblock( event, rc, prc ) {
		var response = event.getResponse()
		try {
			if ( !rateLimitBlockService.unblock( rc.blockId ?: "" ) ) {
				return response.failure( message: "That block does not exist.", statusCode: 404 )
			}
			return response.setData( data: {}, message: "The IP is unblocked." )
		} catch ( any error ) {
			log.error( "Error unblocking an IP: #error.message#", error )
			return response.failure( message: "The IP could not be unblocked: #error.message#", statusCode: 500 )
		}
	}

	/**
	 * Lists the exclusions, newest first. A user exclusion also carries the user's email.
	 *
	 * @return The API response whose data is an array of exclusions.
	 */
	@remote( "This action is requested remotely via JavaScript" )
	function exclusions( event, rc, prc ) {
		return event.getResponse().setData( data: rateLimitExclusionService.list() )
	}

	/**
	 * Excludes an IP address, a range or a user from the attempt limits.
	 *
	 * rc.type is "ip" or "user". For "ip", rc.value is an address or range; for "user" it is
	 * the user's email. rc.label is optional. A bad address, a range that is too wide, an
	 * unknown user, an unknown type and a full list are each a 422 saying what to fix.
	 *
	 * @return The API response whose data is the exclusion.
	 */
	@remote( "This action is submitted remotely via JavaScript" )
	@secured( "settings:admin,settings:write" )
	function exclude( event, rc, prc ) {
		var response = event.getResponse()
		try {
			var type = lCase( rc.type ?: "" )
			if ( !listFind( "ip,user", type ) ) {
				throw( type = "RateLimit.InvalidType", message = "Choose what to exclude: an IP address or a user." )
			}

			var row = type == "ip"
				? rateLimitExclusionService.excludeIp( address: rc.value ?: "", label: rc.label ?: "", createdBy: prc.authUser.getEmail() )
				: rateLimitExclusionService.excludeUser( email: rc.value ?: "", label: rc.label ?: "", createdBy: prc.authUser.getEmail() )

			return response.setData( data: row, message: "[#row.value#] is excluded." )
		} catch ( any error ) {
			if ( error.type.startsWith( "RateLimit." ) ) {
				return response.failure( message: error.message, statusCode: 422 )
			}
			log.error( "Error adding an exclusion: #error.message#", error )
			return response.failure( message: "The exclusion could not be added: #error.message#", statusCode: 500 )
		}
	}

	/**
	 * Removes an exclusion. rc.exclusionId comes from the route.
	 *
	 * @return The API response, a 404 when there is no such exclusion.
	 */
	@remote( "This action is submitted remotely via JavaScript" )
	@secured( "settings:admin,settings:write" )
	function unexclude( event, rc, prc ) {
		var response = event.getResponse()
		try {
			if ( !rateLimitExclusionService.remove( rc.exclusionId ?: "" ) ) {
				return response.failure( message: "That exclusion does not exist.", statusCode: 404 )
			}
			return response.setData( data: {}, message: "The exclusion was removed." )
		} catch ( any error ) {
			log.error( "Error removing an exclusion: #error.message#", error )
			return response.failure( message: "The exclusion could not be removed: #error.message#", statusCode: 500 )
		}
	}

}
