/**
 * user Profile handler.
 */
@secured
class extends="BaseSecureHandler" {

	function preHandler( event, rc, prc ) {
		if ( event.getCurrentAction() != "index" && !csrfVerify( rc.csrf ?: "" ) ) {
			flash.put( "messages", {
				type   : "error",
				message: "Invalid security token detected."
			} )
			return relocate( "profile" )
		}
		super.preHandler( argumentCollection: arguments )
	}

	function index( event, rc, prc ) {
		prc.title = "My Profile"
		prc.profile = prc.authUser
		event.setView( "profile/index" )
	}

	function save( event, rc, prc ) {
		try {
			prc.profile = prc.authUser
				.populate( rc )
				.validateOrFail( fields: "firstName,lastName,email,biography,preferences" )
				.save()
			flash.put( "messages", {
				type   : "success",
				message: "Profile saved successfully."
			} )
		}
		catch( ValidationException error ) {
			flash.put( "messages", {
				type   : "error",
				message: "Profile validation errors" & prc.profile.getValidationResults().getAllErrors().toList( "<br>" )
			} )
		}
		catch ( any error ) {
			flash.put( "messages", {
				type   : "error",
				message: "Profile could not be saved: " & error.message
			} )
		}

		relocate( "profile" )
	}

}