/**
 * Mock profile handler.
 */
class extends="coldbox.system.EventHandler" {

	function index( event, rc, prc ){
		prc.title    = "My Profile"
		prc.authUser = getMockAuthUser()
		prc.profile  = {
			"firstName"  : "Luis",
			"lastName"   : "Majano",
			"email"      : "luis@ortussolutions.com",
			"bio"        : "Creator of BoxLang and ColdBox. CEO at Ortus Solutions.",
			"roles"      : [ "Super Admin" ],
			"permissions": [ "users:read", "users:write", "settings:read", "roles:read", "audit:read" ],
			"sessions"   : [
				{ "device": "Chrome on macOS", "location": "Austin, TX", "lastSeen": "Current session" },
				{ "device": "Safari on iPhone", "location": "Austin, TX", "lastSeen": "Yesterday" }
			],
			"tokens"     : [
				{ "name": "CLI Automation", "scope": "reports:export", "lastUsed": "4 hours ago" },
				{ "name": "Local Dev", "scope": "users:read", "lastUsed": "2 days ago" }
			]
		}

		event.setLayout( "Admin" )
		event.setView( "profile/index" )
	}

	function update( event, rc, prc ){
		return relocate( "profile" )
	}

	function password( event, rc, prc ){
		return relocate( "profile" )
	}

	function tokens( event, rc, prc ){
		return relocate( "profile" )
	}

	private struct function getMockAuthUser(){
		return { "name": "Luis Majano", "email": "luis@ortussolutions.com", "role": "Super Admin", "initials": "LM" }
	}

}