/**
 * user Profile handler.
 */
@secured
class extends="BaseSecureHandler" {

	function index( event, rc, prc ) {
		prc.title = "My Profile";
		prc.profile = {
			"firstName"  : "Luis",
			"lastName"   : "Majano",
			"email"      : "luis@ortussolutions.com",
			"bio"        : "Creator of BoxLang and ColdBox. CEO at Ortus Solutions.",
			"roles"      : [ "Super Admin"],
			"permissions": [ "users:read", "users:write", "settings:read", "roles:read", "audit:read"],
			"sessions"   : [
				{
					"device"  : "Chrome on macOS",
					"location": "Austin, TX",
					"lastSeen": "Current session"
				},
				{
					"device"  : "Safari on iPhone",
					"location": "Austin, TX",
					"lastSeen": "Yesterday"
				}
			],
			"tokens": [
				{
					"name"    : "CLI Automation",
					"scope"   : "reports:export",
					"lastUsed": "4 hours ago"
				},
				{
					"name"    : "Local Dev",
					"scope"   : "users:read",
					"lastUsed": "2 days ago"
				}
			]
		};

		event.setView( "profile/index" );
	}

}