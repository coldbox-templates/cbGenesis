/**
 * user Profile handler.
 */
@secured
class extends="BaseSecureHandler" {

	@inject
	property name="userService";

	@inject
	property name="securityService";

	@inject
	property name="apiTokenService";

	@inject
	property name="passkeyService";

	static{
		csrfVerify = {
			"save"    : true,
			"password": true,
			"requestEmailChange": true,
			"cancelEmailChange": true,
			"createToken": true,
			"updateToken": true,
			"deleteToken": true,
			"deletePasskey": true,
			"updatePasskey": true
		}
	}

	function preHandler( event, rc, prc ) {
		if (
			static.csrfVerify.keyExists( event.getCurrentAction() )
			&& !csrfVerify( rc.csrf ?: "" )
		) {
			event.getResponse().addMessage( "Invalid or expired CSRF token." )
			onAuthorizationFailure(
				event: event,
				rc: rc,
				prc: prc,
				abort: true,
				exception: {
					type: "InvalidCSRF",
					message: "Invalid or expired CSRF token"
				}
			)
		}
		super.preHandler( argumentCollection: arguments )
	}

	function index( event, rc, prc ) {
		prc.title = "My Profile"
		prc.profile = prc.authUser
		prc.apiTokenMaxValidityMonths = settingService.getSetting( "cbApiTokenMaxValidityMonths" )
		event.setView( "profile/index" )
	}

	function passkeyRequired( event, rc, prc ) {
		prc.title = "Passkey Required"
		event.setView( "profile/passkeyRequired" )
	}

	@remote( "Save the authenticated user's profile remotely via AJAX" )
	function save( event, rc, prc ) {
		var response = event.getResponse()
		param rc.preferences = "{}"
		try {
			// Assign before validating so prc.profile is available to the catch below.
			prc.profile = prc.authUser.populate( rc )
			prc.profile.validateOrFail( profiles: "update" ).save()
			response.setData(
				data: prc.profile.getMemento(),
				message: "Profile saved successfully."
			)
		}
		catch( ValidationException error ) {
			response.setErrorMessage(
				errorMessage: "Profile validation errors",
				statusCode: 422,
				data: prc.profile.getValidationResults().getAllErrorsAsStruct()
			)
		}
		catch ( any error ) {
			log.error( "Error saving profile: #error.message#", error )
			response.setErrorMessage(
				errorMessage: "Profile could not be saved: #error.message#",
				statusCode: 500
			)
		}

		return response
	}

	/**
	 * Request a change to the authenticated user's email address. Does not change the
	 * email directly - sends a confirmation link to the new address and a security
	 * notice to the current address. See UserService#requestEmailChange().
	 */
	@remote( "Request an email address change for the authenticated user remotely via AJAX" )
	function requestEmailChange( event, rc, prc ) {
		var response = event.getResponse()
		var newEmail = trim( rc.email ?: "" )

		try {
			userService.requestEmailChange( prc.authUser, newEmail )
			response.setData(
				data: prc.authUser.getMemento(),
				message: "Confirmation sent to #newEmail#. Check your inbox to complete the change."
			)
		} catch ( "User.InvalidEmail" error ) {
			response.setErrorMessage(
				errorMessage: "Please provide a valid email address.",
				statusCode: 422,
				data: { email: "Please provide a valid email address." }
			)
		} catch ( "User.EmailInUse" error ) {
			response.setErrorMessage(
				errorMessage: "This email address is already in use.",
				statusCode: 422,
				data: { email: "This email address is already in use." }
			)
		} catch ( any error ) {
			log.error( "Error requesting email change: #error.message#", error )
			response.setErrorMessage(
				errorMessage: "Email change could not be requested: #error.message#",
				statusCode: 500
			)
		}

		return response
	}

	/**
	 * Cancel a pending email change for the authenticated user.
	 */
	@remote( "Cancel a pending email change for the authenticated user remotely via AJAX" )
	function cancelEmailChange( event, rc, prc ) {
		var response = event.getResponse()
		try {
			userService.cancelEmailChange( prc.authUser )
			response.setData(
				data: prc.authUser.getMemento(),
				message: "Email change request cancelled."
			)
		} catch ( any error ) {
			log.error( "Error cancelling email change: #error.message#", error )
			response.setErrorMessage(
				errorMessage: "Email change could not be cancelled: #error.message#",
				statusCode: 500
			)
		}
		return response
	}

	@remote( "Change the authenticated user's password remotely via AJAX" )
	function doPasswordChange( event, rc, prc ) {
		var response = event.getResponse()
		var currentPassword = rc.currentPassword.trim() ?: ""
		var newPassword = rc.password.trim() ?: ""
		var passwordConfirm = rc.passwordConfirm.trim() ?: ""
		var errors = {}

		// Validate the current password
		if ( !prc.authUser.samePassword( currentPassword ) ) {
			errors.currentPassword = "The current password is incorrect."
			return response.setErrorMessage(
				errorMessage: "Password validation errors",
				statusCode: 422,
				data: errors
			)
		}

		// Validate the new password against the configured policy. This lives on
		// SettingService (it reads cbMinPasswordLength), not SecurityService - calling it
		// on the latter fell through to cborm's onMissingMethod and threw, so every
		// password change returned a 500.
		if ( !settingService.isValidPassword( newPassword ) ) {
			errors.password = "The new password must be at least 8 characters and include uppercase, lowercase, number, and special characters."
			return response.setErrorMessage(
				errorMessage: "Password validation errors",
				statusCode: 422,
				data: errors
			)
		}

		// Update the password for the authenticated user
		userService.save(
			user: prc.authUser.setPassword( newPassword ),
			passwordChange: true
		)

		response.addMessage( "Password changed successfully." )
	}

	/**
	 * List the authenticated user's active API tokens as safe mementos.
	 */
	@remote( "List the authenticated user's API tokens remotely via AJAX" )
	function listTokens( event, rc, prc ) {
		event.getResponse().setData(
			apiTokenService
				.listForUser( prc.authUser.getId() )
				.map( .getMemento )
		)
	}

	/**
	 * List safe metadata for the authenticated user's passkeys.
	 */
	@remote( "List the authenticated user's passkeys remotely via AJAX" )
	function listPasskeys( event, rc, prc ) {
		var passkeys = passkeyService.listForUser( prc.authUser.getId() )

		event.getResponse().setData(
			passkeys.map( ( item, index ) => {
				return {
					"passkeyId"   : item.getPasskeyId(),
					"label"       : item.getLabel() ?: "Passkey #index + 1#",
					"createdDate" : item.getCreatedDate(),
					"lastUsed"   : item.getLastUsedTimestamp()
				}
			} )
		)
	}

	/**
	 * Update an authenticated user's passkey display label.
	 */
	@remote( "Update an authenticated user's passkey label remotely via AJAX" )
	function updatePasskey( event, rc, prc ) {
		var response = event.getResponse()
		var label = trim( rc.label ?: "" )

		if ( !len( label ) || len( label ) > 100 ) {
			return response.setErrorMessage(
				errorMessage: "Passkey labels must be between 1 and 100 characters.",
				statusCode: 422
			)
		}

		try {
			var passkey = passkeyService.updateLabelForCredential(
				credentialId: rc.credentialId ?: "",
				userId      : prc.authUser.getId(),
				label       : label
			)
			return response.setData(
				data: {
					"passkeyId": passkey.getPasskeyId(),
					"label"    : passkey.getLabel()
				},
				message: "Passkey label saved successfully."
			)
		} catch ( any error ) {
			log.error( "Error updating passkey label: #error.message#", error )
			return response.setErrorMessage(
				errorMessage: "Passkey label could not be saved.",
				statusCode: error.type == "Passkey.NotFound" ? 404 : 500
			)
		}
	}

	/**
	 * Permanently delete an authenticated user's passkey after confirmation.
	 */
	@remote( "Delete an authenticated user's passkey remotely via AJAX" )
	function deletePasskey( event, rc, prc ) {
		var response = event.getResponse()
		try {
			if (
				settingService.getSetting( "cbRequirePasskey", false )
				&& passkeyService.listForUser( prc.authUser.getId() ).len() <= 1
			) {
				return response.setErrorMessage(
					errorMessage: "You must keep at least one passkey while mandatory passkey enrollment is enabled.",
					statusCode: 409
				)
			}
			passkeyService.deleteForUser(
				passkeyId: rc.passkeyId ?: "",
				userId   : prc.authUser.getId()
			)
			response.addMessage( "Passkey removed successfully." )
		} catch ( any error ) {
			log.error( "Error deleting passkey with ID [#rc.passkeyId#]: #error.message#", error )
			response.setErrorMessage(
				errorMessage: "Passkey could not be removed: #error.message & error.detail#",
				statusCode: 500
			)
		}

		return response
	}

	/**
	 * Create an API token for the authenticated user.
	 */
	@remote( "Create an API token remotely via AJAX" )
	function createToken( event, rc, prc ) {
		var response = event.getResponse()
		try {
			// Prep incoming data
			rc.label = trim( rc.label ?: "" )
			rc.expiration = trim( rc.expiration ?: "" )
			// Create the token
			// Assign before validating so prc.token is available to the catch below.
			prc.token = apiTokenService
				.new()
				.populate( rc )
				.setUser( prc.authUser )
			prc.token.validateOrFail()
			prc.tokenResults = apiTokenService.createToken( prc.token )
			response.setData(
				data: {
					token   : prc.tokenResults.token.getMemento(),
					rawToken: prc.tokenResults.rawToken
				},
				message: "API token created successfully."
			)
		} catch ( ValidationException error ) {
			response.setErrorMessage(
				errorMessage: "Token validation errors",
				statusCode: 422,
					data : prc.token.getValidationResults().getAllErrorsAsStruct()
			)
		} catch ( any error ) {
			log.error( "Error saving token: #error.message#", error )
			response.setErrorMessage(
				errorMessage: "Token could not be saved: #error.message & error.detail#",
				statusCode: 500
			)
		}
		return response
	}

	/**
	 * Update an authenticated user's API token label.
	 */
	@remote( "Update an API token remotely via AJAX" )
	function updateToken( event, rc, prc ) {
		var response = event.getResponse()
		try {
			// You can only update the label
			prc.token = apiTokenService.getOrFail( rc.tokenId ?: "" )

			// Verify ownership
			if ( !prc.token.sameUser( prc.authUser ) ) {
				throw( type: "APIToken.NotFound", message: "API token not found" )
			}

			// Update it
			prc.token
				.setLabel( rc.label ?: "" )
				.validateOrFail()
				.save()
			response.setData( data: prc.token.getMemento(), message: "API token saved successfully." )
		} catch ( any error ) {
			log.error( "Error updating API token: #error.message#", error )
			response.setErrorMessage(
				errorMessage   : "Token could not be saved: #error.message & error.detail#",
				statusCode: 500
			)
		}
		return response
	}

	/**
	 * Permanently delete an authenticated user's API token after confirmation.
	 */
	@remote( "Delete an API token remotely via AJAX" )
	function deleteToken( event, rc, prc ) {
		var response = event.getResponse()
		try {
			prc.token = apiTokenService.getOrFail( rc.tokenId ?: "" )

			// Verify ownership
			if ( !prc.token.sameUser( prc.authUser ) ) {
				throw( type: "APIToken.NotFound", message: "API token not found" )
			}

			// Delete it
			prc.token.delete()
			response.addMessage( "API token deleted successfully." )
		} catch ( any error ) {
			log.error( "Error deleting API token with ID [#rc.tokenId#]: #error.message#", error )
			response.setErrorMessage(
				errorMessage: "API token could not be deleted: #error.message & error.detail#",
				statusCode: 500
			)
		}

		return response
	}

}