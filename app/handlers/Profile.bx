/**
 * user Profile handler.
 */
@secured
class extends="BaseSecureHandler" {

	@inject
	property name="userService";

	@inject
	property name="securityService";

	@inject
	property name="apiTokenService";

	static{
		csrfVerify = {
			"save"    : true,
			"password": true,
			"createToken": true,
			"updateToken": true,
			"deleteToken": true
		}
	}

	function preHandler( event, rc, prc ) {
		if (
			static.csrfVerify.keyExists( event.getCurrentAction() )
			&& !csrfVerify( rc.csrf ?: "" )
		) {
			event.getResponse().addMessage( "Invalid or expired CSRF token." )
			onAuthorizationFailure(
				event: event,
				rc: rc,
				prc: prc,
				abort: true,
				exception: {
					type: "InvalidCSRF",
					message: "Invalid or expired CSRF token"
				}
			)
		}
		super.preHandler( argumentCollection: arguments )
	}

	function index( event, rc, prc ) {
		prc.title = "My Profile"
		prc.profile = prc.authUser
		event.setView( "profile/index" )
	}

	@remote( "Save the authenticated user's profile remotely via AJAX" )
	function save( event, rc, prc ) {
		var response = event.getResponse()
		try {
			prc.profile = prc.authUser
				.setFirstName( rc.firstName ?: "" )
				.setLastName( rc.lastName ?: "" )
				.setEmail( rc.email ?: "" )
				.setBiography( rc.biography ?: "" )
				.validateOrFail( fields: "firstName,lastName,email,biography" )
				.save()
			response.setData(
				data: prc.profile.getMemento(),
				message: "Profile saved successfully."
			)
		}
		catch( ValidationException error ) {
			response.setErrorMessage(
				errorMessage: "Profile validation errors",
				statusCode: 422,
				data: prc.profile.getValidationResult().getAllErrorsAsStruct()
			)
		}
		catch ( any error ) {
			log.error( "Error saving profile: #error.message#", error )
			response.setErrorMessage(
				errorMessage: "Profile could not be saved: #error.message#",
				statusCode: 500
			)
		}

		return response
	}

	@remote( "Change the authenticated user's password remotely via AJAX" )
	function doPasswordChange( event, rc, prc ) {
		var response = event.getResponse()
		var currentPassword = rc.currentPassword.trim() ?: ""
		var newPassword = rc.password.trim() ?: ""
		var passwordConfirm = rc.passwordConfirm.trim() ?: ""
		var errors = {}

		// Validate the current password
		if ( !prc.authUser.samePassword( currentPassword ) ) {
			errors.currentPassword = "The current password is incorrect."
			return response.setErrorMessage(
				errorMessage: "Password validation errors",
				statusCode: 422,
				data: errors
			)
		}

		// Validate the new password
		if ( !securityService.isValidPassword( newPassword ) ) {
			errors.password = "The new password must be at least 8 characters and include uppercase, lowercase, number, and special characters."
			return response.setErrorMessage(
				errorMessage: "Password validation errors",
				statusCode: 422,
				data: errors
			)
		}

		// Update the password for the authenticated user
		userService.save(
			user: prc.authUser.setPassword( newPassword ),
			passwordChange: true
		)

		response.addMessage( "Password changed successfully." )
	}

	/**
	 * List the authenticated user's active API tokens as safe mementos.
	 */
	@remote( "List the authenticated user's API tokens remotely via AJAX" )
	function listTokens( event, rc, prc ) {
		event.getResponse().setData(
			apiTokenService
				.listForUser( prc.authUser.getId() )
				.map( .getMemento )
		)
	}

	/**
	 * Create an API token for the authenticated user.
	 */
	@remote( "Create an API token remotely via AJAX" )
	function createToken( event, rc, prc ) {
		var response = event.getResponse()
		try {
			// Prep incoming data
			rc.label = trim( rc.label ?: "" )
			rc.expiration = trim( rc.expiration ?: "" )
			// Create the token
			prc.token = apiTokenService
				.new()
				.populate( rc )
				.setUser( prc.authUser )
				.validateOrFail()
			prc.tokenResults = apiTokenService.createToken( prc.token )
			response.setData(
				data: {
					token   : prc.tokenResults.token.getMemento(),
					rawToken: prc.tokenResults.rawToken
				},
				message: "API token created successfully."
			)
		} catch ( ValidationException error ) {
			response.setErrorMessage(
				errorMessage: "Token validation errors",
				statusCode: 422,
					data : prc.token.getValidationResult().getAllErrorsAsStruct()
			)
		} catch ( any error ) {
			log.error( "Error saving token: #error.message#", error )
			response.setErrorMessage(
				errorMessage: "Token could not be saved: #error.message & error.detail#",
				statusCode: 500
			)
		}
		return response
	}

	/**
	 * Update an authenticated user's API token label.
	 */
	@remote( "Update an API token remotely via AJAX" )
	function updateToken( event, rc, prc ) {
		var response = event.getResponse()
		try {
			// You can only update the label
			prc.token = apiTokenService.getOrFail( rc.tokenId ?: "" )

			// Verify ownership
			if ( !prc.token.sameUser( prc.authUser ) ) {
				throw( type: "APIToken.NotFound", message: "API token not found" )
			}

			// Update it
			prc.token
				.setLabel( rc.label ?: "" )
				.validateOrFail()
				.save()
			response.setData( data: prc.token.getMemento(), message: "API token saved successfully." )
		} catch ( any error ) {
			log.error( "Error updating API token: #error.message#", error )
			response.setErrorMessage(
				errorMessage   : "API token could not be saved.",
				statusCode: 500
			)
		}
		return response
	}

	/**
	 * Permanently delete an authenticated user's API token after confirmation.
	 */
	@remote( "Delete an API token remotely via AJAX" )
	function deleteToken( event, rc, prc ) {
		var response = event.getResponse()
		try {
			prc.token = apiTokenService.getOrFail( rc.tokenId ?: "" )

			// Verify ownership
			if ( !prc.token.sameUser( prc.authUser ) ) {
				throw( type: "APIToken.NotFound", message: "API token not found" )
			}

			// Delete it
			token.delete()
			response.addMessage( "API token deleted successfully." )
		} catch ( any error ) {
			log.error( "Error deleting API token with ID [#rc.tokenId#]: #error.message#", error )
			response.setErrorMessage(
				errorMessage: "API token could not be deleted: #error.message & error.detail#",
				statusCode: 500
			)
		}

		return response
	}

}