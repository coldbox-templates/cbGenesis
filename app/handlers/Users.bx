/**
 * Manages users and their roles and permissions.
 */
@secured( "users:admin,users:read" )
class extends="BaseSecureHandler" {

	@inject
	property name="userService";

	@inject
	property name="permissionService";

	@inject
	property name="roleService";

	// Present the users list view
	function index( event, rc, prc ) {
		prc.title = "Users"
		prc.payload = {
			records: [],
			count: 0,
			counts: userService.userCountsReport(),
			roles: roleService.getAllForLookup()
		}
		event.setView( "users/index" )
	}

	// Retrieve user listings
	@remote( "Retrieve user listings remotely via AJAX" )
	function search( event, rc, prc ) {
		var pagination = getPagination( rc.page ?: 1, rc.limit ?: 25 )
		prc.users = userService.search(
			searchTerm: rc.search ?: "",
			offset: pagination.offset,
			max: pagination.limit,
			sortOrder: rc.sortOrder ?: "",
			isActive: rc.isActive ?: null,
			isVerified: rc.isVerified ?: null,
			roleId: rc.roleId ?: null,
			propertyList= [
				"userId",
				"firstName",
				"lastName",
				"email",
				"isActive",
				"isPasswordReset",
				"is2FactorAuth",
				"createdDate",
				"verifiedAt"
			]
		)
		event.getResponse().withData( {
			records: prc.users.records,
			count: prc.users.count,
			counts: userService.userCountsReport()
		} )
	}

	// Create a new user
	@remote( "Create a new user remotely via AJAX" )
	@secured( "users:admin,users:write" )
	function create( event, rc, prc ) {
		var response = event.getResponse()
		try {
			var selectedRole = roleService.getOrFail( rc.roleId ?: "" )
			prc.user = userService
				.new()
				.populate( rc )
				.setRoles( [ selectedRole ] )
				.validateOrFail()
			userService.create( prc.user )
			response.setData( data: prc.user.getMemento(), message: "User created successfully." )
		}
		catch( ValidationException error ){
			response.failure(
				message: "User validation errors",
				statusCode: 422,
				data : prc.user.getValidationResult().getAllErrorsAsStruct()
			)
		}
		catch ( any error ) {
			log.error( "Error saving user: #error.message#", error )
			response.failure(
				message: "User could not be saved: #error.message & error.detail#",
				statusCode: 500
			)
		}

		return response
	}

	// Show a specific user detail page
	@secured( "users:read" )
	function show( event, rc, prc ) {
		// Get the user to manage
		prc.user = userService
			.getOrFail( rc.userId ?: "" )
			.getMemento()
		// Lookups
		prc.roles = roleService.list().map( .getMemento )
		prc.permissions = permissionService.list().map( .getMemento )
	}

	// Update an existing user
	@remote( "Update an existing user remotely via AJAX" )
	@secured( "users:admin,users:write" )
	function update( event, rc, prc ) {
		var response = event.getResponse()
		try {
			prc.user = userService
				.getOrFail( rc.userId ?: "" )
				.populate( rc )
				.validateOrFail()
				.save()
			response.setData( data: prc.user.getMemento(), message: "User updated successfully." )
		}
		catch( ValidationException error ){
			response.failure(
				message: "User validation errors",
				statusCode: 422,
				data : prc.user.getValidationResult().getAllErrorsAsStruct()
			)
		}
		catch ( any error ) {
			log.error( "Error saving user: #error.message#", error )
			response.failure(
				message: "User could not be saved: #error.message & error.detail#",
				statusCode: 500
			)
		}

		return response
	}

	// Delete a user
	@remote( "Delete a user remotely via AJAX" )
	@secured( "users:admin,users:delete" )
	function delete( event, rc, prc ) {
		var response = event.getResponse()
		try {
			prc.user = userService
				.getOrFail( rc.userId ?: "" )
				.delete()
			response.addMessage( "User deleted successfully." )
		} catch ( any error ) {
			log.error( "Error deleting user with ID [#rc.userId#]: #error.message#", error )
			response.failure(
				message: "User could not be deleted: #error.message & error.detail#",
				statusCode: 500
			)
		}

		return response
	}

}