/**
 * Mock permissions handler.
 */
class extends="coldbox.system.EventHandler" {

	function index( event, rc, prc ){
		prc.title    = "Permissions";
		prc.authUser = getMockAuthUser();

		prc.permissionGroups = [
			{
				"module"     : "Users",
				"description": "View, invite, edit, lock, and remove user accounts.",
				"permissions": [
					{ "permissionId": "perm-users-read", "permission": "users:read", "description": "View user lists and details" },
					{ "permissionId": "perm-users-write", "permission": "users:write", "description": "Create and update user records" },
					{ "permissionId": "perm-users-delete", "permission": "users:delete", "description": "Delete or deactivate users" },
					{ "permissionId": "perm-users-admin", "permission": "users:admin", "description": "Manage user roles and overrides" }
				]
			},
			{
				"module"     : "Roles",
				"description": "Role catalog and permission matrix controls.",
				"permissions": [
					{ "permissionId": "perm-roles-read", "permission": "roles:read", "description": "View roles" },
					{ "permissionId": "perm-roles-write", "permission": "roles:write", "description": "Create and edit roles" },
					{ "permissionId": "perm-roles-delete", "permission": "roles:delete", "description": "Archive roles" }
				]
			},
			{
				"module"     : "Settings",
				"description": "Global security and application controls.",
				"permissions": [
					{ "permissionId": "perm-settings-read", "permission": "settings:read", "description": "View settings" },
					{ "permissionId": "perm-settings-write", "permission": "settings:write", "description": "Update settings" },
					{ "permissionId": "perm-audit-read", "permission": "audit:read", "description": "View audit history" },
					{ "permissionId": "perm-reports-export", "permission": "reports:export", "description": "Export reports" }
				]
			}
		];

		event.setLayout( "Admin" );
		event.setView( "permissions/index" );
	}

	private struct function getMockAuthUser(){
		return { "name": "Luis Majano", "email": "luis@ortussolutions.com", "role": "Super Admin", "initials": "LM" };
	}

}