/**
 * Permissions handler.
 */
@secured
class extends="BaseSecureHandler" {

	@inject
	property name="permissionService";

	function index( event, rc, prc ) {
		prc.title = "Permissions"
		prc.permissionCatalog = permissionService.findAllWhere(
			criteria: {
				isActive: true,
			},
			sortOrder: "permission"
		)
		.map( .getMemento() )
		event.setView( "permissions/index" )
	}

	function create( event, rc, prc ) {
		arguments.permission = permissionService.new()
		save( argumentCollection: arguments )
		relocate( "permissions" )
	}

	function update( event, rc, prc ) {
		try {
			arguments.permission = permissionService.getOrFail( rc.permissionId )
			save( argumentCollection: arguments )
		} catch ( any error ) {
			flash.put( "messages", {
				type   : "error",
				message: "Invalid permission ID specified. Please try again."
			} )
		}
		relocate( "permissions" )
	}

	/**
	 * Consolidated save permissions handler for both create and update actions.
	 * Validates the CSRF token, populates the permission object, and attempts to save it.
	 * Returns true on success, false on failure.
	 */
	private boolean function save( event, rc, prc, permission ) {
		// --- CSRF Verification ---
		if ( !csrfVerify( rc.csrf ?: "" ) ) {
			flash.put( "messages", {
				type   : "error",
				message: "Invalid security token detected."
			} )
			return relocate( "permissions" )
		}

		arguments.permission.populate( rc )

		// --- Validation and Save ---
		if ( !arguments.permission.isValid() ) {
			flash.put( "messages", {
				type   : "error",
				message: "Permission could not be persisted. Please check the form for errors." &
					arguments.permission.getValidationResult().getAllErrors().toList( "<br>" )
			} )
			return relocate( "permissions" )
		}

		try {
			arguments.permission.save()
			flash.put( "messages", {
				type   : "success",
				message: "Permission saved successfully."
			} )
		} catch ( any error ) {
			log.error( "Error saving permission with ID [#arguments.permission.permissionId#]: #error.message#", error )
			flash.put( "messages", {
				type   : "error",
				message: "Permission could not be saved: #error.detail#"
			} )
		}
	}

	@remote( "This action is submitted remotely via JavaScript" )
	function delete( event, rc, prc ) {

		// --- CSRF Verification ---
		if ( !csrfVerify( rc.csrf ?: "" ) ) {
			event.setHTTPHeader( statusCode: 403 )
			return {
				error: true,
				messages: "Invalid security token detected.",
				data: ""
			}
		}

		// --- Attempt to Delete Permission ---
		try {
			permissionService
				.getOrFail( rc.permissionId ?: "" )
				.delete()
			return {
				error: false,
				messages: "Permission deleted successfully.",
				data: ""
			}
		} catch ( any error ) {
			log.error( "Error deleting permission with ID [#rc.permissionId#]: #error.message#", error )
			event.setHTTPHeader( statusCode: 500 )
			return {
				error: true,
				messages: "Permission could not be deleted: #error.detail#",
				data: ""
			}
		}
	}

}