/**
 * Permissions handler.
 */
@secured
class extends="BaseSecureHandler" {

	@inject
	property name="permissionService";

	function preHandler( event, rc, prc ) {
		// --- CSRF Verification ---
		if ( event.getCurrentAction() != "index" && !csrfVerify( rc.csrf ?: "" ) ) {
			flash.put( "messages", {
				type   : "error",
				message: "Invalid security token detected."
			} )
			return relocate( "permissions" )
		}
		super.preHandler( argumentCollection: arguments )
	}

	function index( event, rc, prc ) {
		prc.title = "Permissions"
		prc.permissionCatalog = permissionService.findAllWhere(
			criteria: {
				isActive: true,
			},
			sortOrder: "permission"
		)
		.map( .getMemento() )
		event.setView( "permissions/index" )
	}

	function create( event, rc, prc ) {
		try {
			prc.permission = permissionService
				.new()
				.populate( rc )
				.validateOrFail()
				.save()
			flash.put( "messages", {
				type   : "success",
				message: "Permission saved successfully."
			} )
		}
		catch( ValidationException error ){
			flash.put( "messages", {
				type   : "error",
				message: "Permission validation errors" &
					prc.permission.getValidationResult().getAllErrors().toList( "<br>" )
			} )
		}
		catch ( any error ) {
			log.error( "Error saving permission with ID [#permission.permissionId#]: #error.message#", error )
			flash.put( "messages", {
				type   : "error",
				message: "Permission could not be saved: #error.detail#"
			} )
		}
		relocate( "permissions" )
	}

	@remote( "This action is submitted remotely via JavaScript" )
	function update( event, rc, prc ) {
		var results = getApiResults()
		try {
			prc.permission = permissionService
				.getOrFail( rc.permissionId ?: "" )
				.populate( rc )
				.validateOrFail()
				.save()
			results.messages = "Permission saved successfully."
			results.data = prc.permission.getMemento()
		}
		catch( ValidationException error ){
			results.error = true
			results.messages = "Permission validation errors"
			results.data = prc.permission.getValidationResult().getAllErrorsAsStruct()
			event.setHTTPHeader( statusCode: 422 )
		}
		catch ( any error ) {
			log.error( "Error saving permission with ID [#permission.permissionId#]: #error.message#", error )
			results.error = true
			results.messages = "Permission could not be saved: #error.message & error.detail#"
			event.setHTTPHeader( statusCode: 500 )
		}

		return results
	}

	@remote( "This action is submitted remotely via JavaScript" )
	function delete( event, rc, prc ) {
		var results = getApiResults()
		// --- Attempt to Delete Permission ---
		try {
			permissionService
				.getOrFail( rc.permissionId ?: "" )
				.delete()
			results.messages = "Permission deleted successfully."
		} catch ( any error ) {
			log.error( "Error deleting permission with ID [#rc.permissionId#]: #error.message#", error )
			event.setHTTPHeader( statusCode: 500 )
			results.error = true
			results.messages = "Permission could not be deleted: #error.message & error.detail#"
		}

		return results
	}

}