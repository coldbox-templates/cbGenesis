/**
 * Permissions handler.
 */
@secured( "permissions:admin,permissions:read" )
class extends="BaseSecureHandler" {

	@inject
	property name="permissionService";

	@inject
	property name="auditLogService";

	/**
	 * Render the permissions management view with the active permission catalog.
	 */
	function index( event, rc, prc ) {
		prc.title = "Permissions"
		prc.permissionCatalog = permissionService.findAllWhere(
			criteria: {
				isActive: true,
			},
			sortOrder: "permission"
		)
		.map( .getMemento() )
		event.setView( "permissions/index" )
	}

	/**
	 * Validate and create a permission through AJAX and return validation or persistence results.
	 *
	 * This is submitted by PermissionsForm.js rather than as a native form post, so a
	 * failure (including an expired CSRF token, which BaseSecureHandler rejects with a
	 * JSON 403) is reported back to the still-open modal instead of reloading the page
	 * and discarding what the user typed.
	 *
	 * @return struct API results with the new permission memento, or its validation errors.
	 */
	@remote( "This action is submitted remotely via JavaScript" )
	@secured( "permissions:admin,permissions:write" )
	function create( event, rc, prc ) {
		var results = getApiResults()
		try {
			// Assign before validating so prc.permission is available to the catch below.
			prc.permission = permissionService
				.new()
				.populate( rc )
			prc.permission.validateOrFail().save()
			auditLogService.info(
				action     : "permission.created",
				message    : "Permission [#prc.permission.getPermission()#] was created.",
				category   : "data",
				targetType : "Permission",
				targetId   : prc.permission.getPermissionId(),
				targetLabel: prc.permission.getPermission()
			)
			results.messages = "Permission saved successfully."
			results.data = prc.permission.getMemento()
		}
		catch( ValidationException error ){
			results.error = true
			results.messages = "Permission validation errors: " &
				prc.permission.getValidationResults().getAllErrors().toList( " " )
			results.data = prc.permission.getValidationResults().getAllErrorsAsStruct()
			event.setHTTPHeader( statusCode: 422 )
		}
		catch ( any error ) {
			log.error( "Error creating permission: #error.message#", error )
			results.error = true
			results.messages = "Permission could not be saved: #error.message & error.detail#"
			event.setHTTPHeader( statusCode: 500 )
		}

		return results
	}

	/**
	 * Update a permission through AJAX and return validation or persistence results.
	 */
	@remote( "This action is submitted remotely via JavaScript" )
	@secured( "permissions:admin,permissions:write" )
	function update( event, rc, prc ) {
		var results = getApiResults()
		try {
			// Assign before validating so prc.permission is available to the catch below.
			prc.permission = permissionService
				.getOrFail( rc.permissionId ?: "" )
				.populate( rc )
			prc.permission.validateOrFail().save()
			auditLogService.info(
				action     : "permission.updated",
				message    : "Permission [#prc.permission.getPermission()#] was updated.",
				category   : "data",
				targetType : "Permission",
				targetId   : prc.permission.getPermissionId(),
				targetLabel: prc.permission.getPermission()
			)
			results.messages = "Permission saved successfully."
			results.data = prc.permission.getMemento()
		}
		catch( ValidationException error ){
			results.error = true
			results.messages = "Permission validation errors"
			results.data = prc.permission.getValidationResults().getAllErrorsAsStruct()
			event.setHTTPHeader( statusCode: 422 )
		}
		catch ( any error ) {
			log.error( "Error saving permission with ID [#permission.permissionId#]: #error.message#", error )
			results.error = true
			results.messages = "Permission could not be saved: #error.message & error.detail#"
			event.setHTTPHeader( statusCode: 500 )
		}

		return results
	}

	/**
	 * Delete a permission through AJAX and return the operation status.
	 */
	@remote( "This action is submitted remotely via JavaScript" )
	@secured( "permissions:admin,permissions:delete" )
	function delete( event, rc, prc ) {
		var results = getApiResults()
		// --- Attempt to Delete Permission ---
		try {
			var permission = permissionService.getOrFail( rc.permissionId ?: "" )
			var permissionSlug = permission.getPermission()
			var permissionId = permission.getPermissionId()
			permission.delete()
			auditLogService.warn(
				action     : "permission.deleted",
				message    : "Permission [#permissionSlug#] was deleted.",
				category   : "data",
				targetType : "Permission",
				targetId   : permissionId,
				targetLabel: permissionSlug
			)
			results.messages = "Permission deleted successfully."
		} catch ( any error ) {
			log.error( "Error deleting permission with ID [#rc.permissionId#]: #error.message#", error )
			event.setHTTPHeader( statusCode: 500 )
			results.error = true
			results.messages = "Permission could not be deleted: #error.message & error.detail#"
		}

		return results
	}

}