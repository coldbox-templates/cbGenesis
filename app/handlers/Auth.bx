/**
 * Authentication Handler
 *
 * Handles login, registration, password recovery, and logout flows.
 * Uses SecurityService → cbauth for session-based authentication backed
 * by the database UserService (bcrypt password verification).
 *
 * CSRF tokens are generated by cbcsrf (bundled with cbsecurity) via the
 * csrfToken() / csrfVerify() helpers that cbcsrf injects globally.
 */
class extends="coldbox.system.EventHandler" output=true{

	// ============================================================
	// Dependency Injection
	// ============================================================

	@inject
	property name="securityService";

	@inject
	property name="userService";

	/**
	 * Execute before any handler action is called.  This is a good place to check for
	 * authentication and authorization.
	 */
	function preHandler( event, rc, prc ) {
		// If the user is already logged in, redirect to the dashboard
		if ( securityService.isLoggedIn() && event.getCurrentAction() != "logout" ) {
			relocate( "dashboard" )
		}
		event.setLayout( prc.settings.cbLoginLayout )
	}

	// ============================================================
	// Login — GET
	// ============================================================

	/**
	 * Display the login form
	 */
	function login( event, rc, prc ) {
		prc.title = "Sign In"
		event.setView( "auth/login" )
	}

	// ============================================================
	// Login — POST
	// ============================================================

	/**
	 * Validate credentials and authenticate the user
	 */
	function doLogin( event, rc, prc ) {
		param rc.email = ""
		param rc.password = ""
		param rc.rememberMe = false
		param rc.csrf = ""

		// --- CSRF Verification ---
		if ( !csrfVerify( rc.csrf ) ) {
			flash.put( "messages", {
				type   : "error",
				message: "Invalid login token detected. Page refreshed, try again."
			} )
			login( argumentCollection: arguments )
			return
		}

		// --- Field Validation ---
		var args = arguments
		validate(
			target: rc,
			constraints: {
				email: { required: true, type: "email" },
				password: { required:true, min: prc.settings.cbMinPasswordLength }
			}
		)
		// Handle validation errors
		.onError( results => {
			flash.put( "messages", {
				type   : "error",
				message: "Please correct the highlighted errors and try again." & results.getAllErrors().toList( '<br>' )
			} )
			login( argumentCollection: args )
		} )
		// --- Authentication ---
		.onSuccess( results => {
			try {
				var oUser = variables.securityService.login(
					username = rc.email,
					password = rc.password,
					rememberMe = rc.rememberMe
				)
				// Success — redirect to the dashboard
				relocate( "dashboard" )
			} catch ( "InvalidCredentials" | "EntityNotFound" e ) {
				flash.put( "messages", {
					type   : "error",
					message: "Invalid email or password"
				} )
				relocate( "login" )
			}
		} )
	}

	// ============================================================
	// Register
	// ============================================================

	function register( event, rc, prc ) {
		prc.title = "Create Account"
		event.setView( "auth/register" )
	}

	// ============================================================
	// Register — POST
	// ============================================================

	/**
	 * Validate and create a new user account
	 */
	function doRegister( event, rc, prc ) {
		param rc.firstName = ""
		param rc.lastName = ""
		param rc.email = ""
		param rc.password = ""
		param rc.passwordConfirm = ""
		param rc.csrf = ""

		// --- Verify Registration Enabled ---
		if ( !prc.settings.cbAllowRegistration ) {
			flash.put( "messages", {
				type   : "error",
				message: "Registration is currently disabled."
			} )
			return relocate( "login" )
		}

		// --- CSRF Verify ---
		if ( !csrfVerify( rc.csrf ) ) {
			flash.put( "messages", {
				type   : "error",
				message: "Invalid registration token detected. Page refreshed, try again."
			} )
			return register( argumentCollection: args )
		}

		// --- Validate ---
		var args = arguments
		validate(
			target: rc,
			constraints: {
				firstName     : { required: true },
				lastName      : { required: true },
				email         : { required: true, type: "email", unique: { table: "users", column: "email" } },
				password      : { required: true, min: prc.settings.cbMinPasswordLength },
				passwordConfirm: { required: true, sameAs: "password" }
			}
		)
		// Handle validation errors
		.onError( results =>{
			flash.put( "messages", {
				type   : "error",
				message: "Please correct the highlighted errors and try again." & results.getAllErrors().toList( '<br>' )
			} )
			prc.validationErrors = results.getAllErrorsAsStruct()
			register( argumentCollection: args )
		})
		// --- Create User ---
		.onSuccess( results => {
			prc.oUser = variables.userService.new( {
				firstName: rc.firstName,
				lastName : rc.lastName,
				email    : rc.email,
				password : rc.password
			} )
			userService.create( prc.oUser )

			flash.put( "messages", {
				type   : "success",
				message: "Your account was created. Check your email to finish the registration process."
			} )

			return relocate( "login" )
		} )
	}

	// ============================================================
	// Forgot Password
	// ============================================================

	function forgotPassword( event, rc, prc ) {
		// --- Verify Forgot Password Enabled ---
		if( !prc.settings.cbAllowForgotPassword ){
			relocate( "login" )
		}

		prc.title = "Forgot Password"
		event.setView( "auth/forgotPassword" )
	}

	function doForgotPassword( event, rc, prc ) {
		// --- Verify Forgot Password Enabled ---
		if( !prc.settings.cbAllowForgotPassword ){
			relocate( "login" )
		}

		// --- Initialize ---
		param rc.email = ""
		param rc.csrf = ""

		// --- CSRF Verify ---
		if ( !csrfVerify( rc.csrf ) ) {
			flash.put( "messages", {
				type   : "error",
				message: "Invalid token detected. Page refreshed, try again."
			} )
			return forgotPassword( argumentCollection: arguments )
		}

		// --- Validate ---
		var args = arguments
		validate(
			target: rc,
			constraints: {
				email: { required: true, type: "email" }
			}
		)
		// Handle validation errors
		.onError( results => {
			flash.put( "messages", {
				type   : "error",
				message: "Invalid email address. Please correct the highlighted errors and try again."
			} )
			forgotPassword( argumentCollection: args )
		} )
		// --- Send Password Reset Email ---
		.onSuccess( results => {
			try{
				prc.oUser = userService.retrieveUserByUsername( rc.email )
				userService.sendPasswordReminder( prc.oUser )
			}catch( EntityNotFound e ) {
				// Don't reveal whether the email exists for security reasons
			}

			flash.put( "messages", {
				type   : "success",
				message: "A password reset link has been sent to your email address."
			} )

			return relocate( "login" )
		} )

	}

	// ============================================================
	// Reset Password
	// ============================================================

	function resetPassword( event, rc, prc ) {
		prc.title = "Set New Password"
		param rc.token = ""

		// --- Validate Token ---
		prc.tokenResults = variables.securityService.verifyPasswordResetToken( rc.token )
		if ( prc.tokenResults.error ) {
			flash.put( "messages", {
				type   : "error",
				message: "Invalid or expired password reset token. Please request a new password reset link."
			} )
			return relocate( "forgot-password" )
		}

		// Valid token, set the user in the request collection for the view
		prc.oUser = prc.tokenResults.user
		// Present the reset password view
		event.setView( "auth/resetPassword" )
	}

	function doResetPassword( event, rc, prc ) {
		param rc.token = ""
		param rc.password = ""
		param rc.passwordConfirm = ""
		param rc.csrf = ""

		// --- CSRF Verify ---
		if ( !csrfVerify( rc.csrf ) ) {
			flash.put( "messages", {
				type   : "error",
				message: "Invalid token detected. Page refreshed, try again."
			} )
			return resetPassword( argumentCollection: arguments )
		}

		// --- Validate Token ---
		prc.tokenResults = variables.securityService.verifyPasswordResetToken( rc.token )
		if ( prc.tokenResults.error ) {
			flash.put( "messages", {
				type   : "error",
				message: "Invalid or expired password reset token. Please request a new password reset link."
			} )
			return relocate( "forgot-password" )
		}

		// Change the password for the user associated with the token
		variables.userService.resetPassword(
			token: prc.tokenResults.token,
			user: prc.tokenResults.user,
			password: rc.password
		)

		flash.put( "messages", {
			type   : "success",
			message: "Your password has been reset successfully. You can now log in with your new password."
		} )

		return relocate( "login" )
	}

	// ============================================================
	// Logout
	// ============================================================

	function logout( event, rc, prc ) {
		variables.securityService.logout()
		return relocate( "login" )
	}
}