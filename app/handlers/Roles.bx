/**
 * Mock role management handler.
 */
class extends="coldbox.system.EventHandler" {

	function index( event, rc, prc ) {
		prc.title = "Roles";
		prc.authUser = getMockAuthUser();

		prc.permissionModules = [
			"Users",
			"Roles",
			"Permissions",
			"Settings",
			"Audit Log",
			"API Tokens"
		];
		prc.permissionActions = [ "read", "write", "delete", "admin"];
		prc.roles = [
			{
				"roleId"     : "role-super-admin",
				"role"       : "Super Admin",
				"description": "Full system access. Cannot be modified.",
				"users"      : 1,
				"system"     : true,
				"permissions": [
					"Users:*",
					"Roles:*",
					"Permissions:*",
					"Settings:*",
					"Audit Log:read",
					"Audit Log:admin",
					"API Tokens:*"
				]
			},
			{
				"roleId"     : "role-admin",
				"role"       : "Admin",
				"description": "Operational administrator for day-to-day access work.",
				"users"      : 3,
				"system"     : false,
				"permissions": [
					"Users:read",
					"Users:write",
					"Roles:read",
					"Permissions:read",
					"Settings:read",
					"Audit Log:read"
				]
			},
			{
				"roleId"     : "role-developer",
				"role"       : "Developer",
				"description": "Technical access to API tokens and deploy-adjacent diagnostics.",
				"users"      : 12,
				"system"     : false,
				"permissions": [ "Users:read", "API Tokens:read", "API Tokens:write", "Audit Log:read"]
			},
			{
				"roleId"     : "role-viewer",
				"role"       : "Viewer",
				"description": "Read-only access to common administration screens.",
				"users"      : 203,
				"system"     : false,
				"permissions": [ "Users:read", "Roles:read", "Settings:read"]
			}
		];

		event.setLayout( "Admin" );
		event.setView( "roles/index" );
	}

	private struct function getMockAuthUser() {
		return {
			"name"    : "Luis Majano",
			"email"   : "luis@ortussolutions.com",
			"role"    : "Super Admin",
			"initials": "LM"
		};
	}
}