/**
 * Mock global settings handler.
 */
class extends="coldbox.system.EventHandler" {

	function index( event, rc, prc ) {
		prc.title = "Settings";
		prc.authUser = getMockAuthUser();

		prc.settings = {
			"registration": {
				"allowPublicRegistration" : true,
				"requireEmailVerification": true,
				"defaultRole"             : "Viewer"
			},
			"security": {
				"require2FAForAdmins": true,
				"maxLoginAttempts"   : 5,
				"sessionTimeout"     : 60,
				"maintenanceMode"    : false
			},
			"email": {
				"smtpHost"   : "smtp.mailgun.org",
				"smtpPort"   : 587,
				"fromAddress": "noreply@yourapp.com"
			}
		};

		event.setLayout( "Admin" );
		event.setView( "settings/index" );
	}

	private struct function getMockAuthUser() {
		return {
			"name"    : "Luis Majano",
			"email"   : "luis@ortussolutions.com",
			"role"    : "Super Admin",
			"initials": "LM"
		};
	}
}