/**
 * Global settings handler.
 */
@secured( "settings:admin,settings:read" )
class extends="BaseSecureHandler" {

	@inject
	property name="securityService";

	@inject
	property name="auditLogService";

	/**
	 * This handler renders HTML and reports through flash, so a failed CSRF check
	 * redirects with a message rather than aborting with a bare 403. The non-GET rule
	 * this handler already used is now the application-wide default in
	 * BaseSecureHandler, so only the reporting behaviour is overridden here.
	 */
	private function onInvalidCSRF( event, rc, prc ) {
		flash.put( "messages", {
			type   : "error",
			message: "Invalid security token detected."
		} )
		return relocate( "settings" )
	}

	/**
	 * Render the main application settings page.
	 */
	function index( event, rc, prc ) {
		prc.title = "Settings"
		event.setView( "settings/index" )
	}

	/**
	 * Render the advanced settings registry page with empty initial result data.
	 */
	function registry( event, rc, prc ) {
		prc.title = "Settings Registry"
		prc.payload = { records: [], count: 0, counts: { active: 0, inactive: 0, all: 0 } }
		event.setView( "settings/registry" )
	}

	@remote( "Retrieve settings registry records remotely via AJAX" )
	@secured( "settings:admin,settings:read" )
	/**
	 * Search registry settings with filters and pagination for the settings UI.
	 */
	function registrySearch( event, rc, prc ) {
		var response = event.getResponse()
		var pagination = getPagination( rc.page ?: 1, rc.limit ?: 25 )
		prc.settings = settingService.search(
			search: rc.search ?: "",
			isActive: rc.isActive ?: "",
			sortOrder: rc.sortOrder ?: "name asc",
			max: pagination.limit,
			offset: pagination.offset,
			currentUser: securityService.getCurrentUser()
		)
		return response.setData( data: {
			records: prc.settings.records,
			count: prc.settings.count,
			counts: settingService.settingsCountsReport()
		} )
	}

	@remote( "Create a settings registry record remotely via AJAX" )
	@secured( "settings:admin,settings:write" )
	/**
	 * Validate and create a registry setting, then flush the settings cache.
	 */
	function createRegistry( event, rc, prc ) {
		var response = event.getResponse()
		try {
			var name = trim( rc.name ?: "" )
			var isActive = isBoolean( rc.isActive ?: "" ) ? booleanFormat( rc.isActive ) : false
			if ( !reFind( "^[A-Za-z][A-Za-z0-9_.-]{0,254}$", name ) ) throw( message: "Setting names may contain letters, numbers, dots, underscores, and hyphens." )
			prc.setting = settingService.new( { name: name, value: toString( rc.value ?: "" ), isActive: isActive } ).validateOrFail().save()
			settingService.flushSettingsCache()
			return response.setData( data: prc.setting.getMemento(), message: "Setting created successfully." )
		} catch ( ValidationException error ) {
			return response.failure( message: "Setting validation failed.", statusCode: 422, data: structKeyExists( prc, "setting" ) ? prc.setting.getValidationResults().getAllErrorsAsStruct() : {} )
		} catch ( any error ) {
			return response.failure( message: error.message, statusCode: 400 )
		}
	}

	@remote( "Update a settings registry record remotely via AJAX" )
	@secured( "settings:admin,settings:write" )
	/**
	 * Validate and update an existing registry setting, then flush the settings cache.
	 */
	function updateRegistry( event, rc, prc ) {
		var response = event.getResponse()
		try {
			var name = trim( rc.name ?: "" )
			if ( !reFind( "^[A-Za-z][A-Za-z0-9_.-]{0,254}$", name ) ) throw( message: "Setting names may contain letters, numbers, dots, underscores, and hyphens." )
			prc.setting = settingService.getOrFail( rc.settingId ?: "" ).setName( name ).setValue( toString( rc.value ?: "" ) ).validateOrFail().save()
			settingService.flushSettingsCache()
			return response.setData( data: prc.setting.getMemento(), message: "Setting updated successfully." )
		} catch ( ValidationException error ) {
			return response.failure( message: "Setting validation failed.", statusCode: 422, data: structKeyExists( prc, "setting" ) ? prc.setting.getValidationResults().getAllErrorsAsStruct() : {} )
		} catch ( any error ) {
			return response.failure( message: error.message, statusCode: 400 )
		}
	}

	@remote( "Toggle a settings registry record remotely via AJAX" )
	@secured( "settings:admin,settings:write" )
	/**
	 * Toggle a registry setting's active state and reload the settings cache.
	 */
	function toggleRegistryStatus( event, rc, prc ) {
		var response = event.getResponse()
		try {
			var setting = settingService.getOrFail( rc.settingId ?: "" )
			var updated = settingService.toggleStatus( setting, isBoolean( rc.isActive ?: "" ) ? booleanFormat( rc.isActive ) : false )
			settingService.flushSettingsCache()
			return response.setData( data: updated, message: "Setting status updated successfully." )
		} catch ( any error ) {
			return response.failure( message: error.message, statusCode: 400 )
		}
	}

	@remote( "Delete a settings registry record remotely via AJAX" )
	@secured( "settings:admin,settings:write" )
	/**
	 * Delete a registry setting and flush the settings cache.
	 */
	function deleteRegistry( event, rc, prc ) {
		var response = event.getResponse()
		try {
			settingService.getOrFail( rc.settingId ?: "" ).delete()
			settingService.flushSettingsCache()
			return response.setData( data: {}, message: "Setting deleted successfully." )
		} catch ( any error ) {
			return response.failure( message: error.message, statusCode: 400 )
		}
	}

	/**
	 * Upload (or replace) the application branding logo. Accepts the image as
	 * a base64 data URI in rc.logo - see BaseSecureHandler#decodeDataUri().
	 * Rewrites the cbAppLogo setting to point at the streamed logo route
	 * rather than storing a new setting key.
	 */
	@remote( "Upload the application branding logo remotely via AJAX" )
	@secured( "settings:admin,settings:write" )
	function uploadLogo( event, rc, prc ) {
		var response = event.getResponse()
		try {
			var bytes = decodeDataUri( rc.logo ?: "" )
			getInstance( "imageService" ).storeLogo( bytes )
			settingService.bulkSave( { cbAppLogo: "/branding/logo/lg" } )
			auditLogService.info(
				action  : "settings.logo_updated",
				message : "Application branding logo was updated.",
				category: "data"
			)
			return response.setData(
				data: { cbAppLogo: settingService.getSetting( "cbAppLogo" ) },
				message: "Logo updated successfully."
			)
		} catch ( "Image.TooLarge" error ) {
			return response.failure( message: error.message, statusCode: 422, data: { logo: error.message } )
		} catch ( "Image.InvalidFormat" error ) {
			return response.failure( message: error.message, statusCode: 422, data: { logo: error.message } )
		} catch ( any error ) {
			log.error( "Error uploading logo: #error.message#", error )
			return response.failure( message: "Logo could not be saved: #error.message#", statusCode: 500 )
		}
	}

	/**
	 * Permanently delete the application branding logo and restore the
	 * shipped default cbAppLogo setting value.
	 */
	@remote( "Delete the application branding logo remotely via AJAX" )
	@secured( "settings:admin,settings:write" )
	function deleteLogo( event, rc, prc ) {
		var response = event.getResponse()
		try {
			getInstance( "imageService" ).deleteLogo()
			settingService.bulkSave( { cbAppLogo: settingService.getDefaults().cbAppLogo } )
			auditLogService.info(
				action  : "settings.logo_removed",
				message : "Application branding logo was removed.",
				category: "data"
			)
			return response.setData(
				data: { cbAppLogo: settingService.getSetting( "cbAppLogo" ) },
				message: "Logo removed successfully."
			)
		} catch ( any error ) {
			log.error( "Error deleting logo: #error.message#", error )
			return response.failure( message: "Logo could not be removed: #error.message#", statusCode: 500 )
		}
	}

	@secured( "settings:admin,settings:write" )
	/**
	 * Save the submitted application settings and redirect back to the settings page.
	 */
	function save( event, rc, prc ) {
		try {
			settingService.bulkSave( rc )
			auditLogService.info(
				action  : "settings.updated",
				message : "Application settings were updated.",
				category: "data"
			)
			flash.put( "messages", {
				type   : "success",
				message: "Settings saved successfully."
			} )
		} catch ( any error ) {
			flash.put( "messages", { type: "error", message: error.message } )
		}

		relocate( "settings" )
	}

	@secured( "settings:admin" )
	/**
	 * Clear the template cache and return to the settings page.
	 */
	function clearTemplateCache( event, rc, prc ) {
		getCache( "template" ).clearAll()
		flash.put( "messages", { type: "success", message: "Action ran successfully: template cache cleared." } )
		relocate( "settings" )
	}

	@secured( "settings:admin" )
	/**
	 * Clear active sessions, flash state, and password-reset session data.
	 */
	function clearSessionsCache( event, rc, prc ) {
		getCache( "sessions" ).clearAll()
		flash.put( "messages", {
			type   : "success",
			message: "Action ran successfully: sessions cache cleared. Active sessions, flash messages, and password reset tokens were removed."
		} )
		relocate( "settings" )
	}

	@secured( "settings:admin" )
	/**
	 * Revoke all remembered-browser login tokens and report the number revoked.
	 */
	function revokeRememberTokens( event, rc, prc ) {
		var count = securityService.revokeAllRememberTokens()
		flash.put( "messages", {
			type   : "success",
			message: "Action ran successfully: revoked [#count#] remembered browser login(s)."
		} )
		relocate( "settings" )
	}

	@secured( "settings:admin" )
	/**
	 * Flush the settings cache and reload configuration overrides.
	 */
	function flushSettingsCache( event, rc, prc ) {
		settingService.flushSettingsCache()
		flash.put( "messages", { type: "success", message: "Action ran successfully: settings cache flushed and configuration overrides reloaded." } )
		relocate( "settings" )
	}

}
