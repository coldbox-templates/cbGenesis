/**
 * Views and manages the admin audit log.
 */
@secured( "auditlog:admin,auditlog:read" )
class extends="BaseSecureHandler" {

	@inject
	property name="auditLogService";



	/**
	 * Render the audit log management view with empty records and summary filters.
	 */
	function index( event, rc, prc ) {
		prc.title = "Audit Log"
		prc.payload = {
			records   : [],
			count     : 0,
			counts    : auditLogService.severityCountsReport(),
			severities: [ "debug", "info", "warn", "error", "fatal" ],
			categories: [ "auth", "security", "data", "system" ]
		}
		event.setView( "auditlog/index" )
	}

	/**
	 * Search audit log entries using the requested filters and pagination.
	 * Returns records, the total count, and severity counts for the audit log UI.
	 */
	@remote( "Retrieve audit log listings remotely via AJAX" )
	function search( event, rc, prc ) {
		var pagination = getPagination( rc.page ?: 1, rc.limit ?: 25 )
		prc.entries = auditLogService.search(
			searchTerm: rc.search ?: "",
			severity: rc.severity ?: "",
			category: rc.category ?: "",
			offset: pagination.offset,
			max: pagination.limit,
			sortOrder: rc.sortOrder ?: "",
			propertyList: [
				"auditLogId",
				"createdDate",
				"severity",
				"category",
				"action",
				"message",
				"actorEmail",
				"actorName",
				"targetType",
				"targetId",
				"targetLabel",
				"ipAddress"
			]
		)
		event.getResponse().withData( {
			records: prc.entries.records,
			count  : prc.entries.count,
			counts : auditLogService.severityCountsReport()
		} )
	}

	/**
	 * Retrieve one audit log entry with its serialized metadata for the detail drawer.
	 * Returns a 404 response when the requested entry does not exist.
	 */
	@remote( "Retrieve a single audit log entry remotely via AJAX" )
	function show( event, rc, prc ) {
		var response = event.getResponse()
		try {
			prc.entry = auditLogService.getOrFail( rc.auditLogId ?: "" )
			var detail = prc.entry.getMemento()
			detail[ "metadata" ] = prc.entry.getMetadataAsStruct()
			response.setData( data: detail )
		} catch ( any error ) {
			response.failure(
				message: "Audit log entry could not be found: #error.message#",
				statusCode: 404
			)
		}

		return response
	}

	/**
	 * Export the currently filtered audit log entries as a downloadable CSV file.
	 */
	@remote( "Export audit log entries as CSV" )
	@secured( "auditlog:admin,auditlog:export" )
	function export( event, rc, prc ) {
		var csv = auditLogService.exportCSV(
			searchTerm: rc.search ?: "",
			severity: rc.severity ?: "",
			category: rc.category ?: ""
		)

		bx:header name="Content-Disposition" value="attachment; filename=""audit-log-#dateFormat( now(), 'yyyy-mm-dd' )#.csv""";

		return event.renderData( type: "plain", data: csv, contentType: "text/csv" )
	}

	/**
	 * Permanently remove audit log entries older than the requested number of days.
	 * Returns the number of entries removed.
	 */
	@remote( "Purge old audit log entries remotely via AJAX" )
	@secured( "auditlog:admin,auditlog:delete" )
	function purge( event, rc, prc ) {
		var response = event.getResponse()
		try {
			var purgedCount = auditLogService.purgeOlderThan( rc.days ?: 90 )
			response.setData( data: { purgedCount: purgedCount }, message: "Purged #purgedCount# audit log #( purgedCount == 1 ? 'entry' : 'entries' )#." )
		} catch ( any error ) {
			log.error( "Error purging audit log entries: #error.message#", error )
			response.failure(
				message: "Audit log entries could not be purged: #error.message#",
				statusCode: 500
			)
		}

		return response
	}

	/**
	 * Permanently remove every audit log entry and report the number removed.
	 */
	@remote( "Clear all audit log entries remotely via AJAX" )
	@secured( "auditlog:admin" )
	function clear( event, rc, prc ) {
		var response = event.getResponse()
		try {
			var purgedCount = auditLogService.clearAll()
			response.setData( data: { purgedCount: purgedCount }, message: "Cleared #purgedCount# audit log #( purgedCount == 1 ? 'entry' : 'entries' )#." )
		} catch ( any error ) {
			log.error( "Error clearing audit log entries: #error.message#", error )
			response.failure(
				message: "Audit log could not be cleared: #error.message#",
				statusCode: 500
			)
		}

		return response
	}

}
