/**
 * Throttles the sensitive, unauthenticated Auth endpoints (login, register,
 * forgot/reset password, invitation activation) by client IP, so a single
 * caller cannot hammer credential or token checks indefinitely.
 *
 * Fires on preProcess -- before routing/dispatch and before Main.onRequestStart
 * loads prc.settings, so limits are read directly from SettingService rather
 * than prc.settings. A blocked request never reaches the handler action at all:
 * it is redirected with a flash message, the same way BaseSecureHandler's
 * deny-by-default CSRF check short-circuits a request.
 *
 * See RateLimitService for the counting logic and docs/guides/security.md#rate-limiting
 * for the configurable settings and how to distribute limits across instances.
 */
class extends="coldbox.system.Interceptor" {

	@inject( "provider:RateLimitService" )
	property name="rateLimitService";

	@inject( "provider:SettingService" )
	property name="settingService";

	@inject( "provider:AuditLogService" )
	property name="auditLogService";

	@inject( "provider:CBSecurity@cbsecurity" )
	property name="cbsecurity";

	static {
		// Events this interceptor throttles, and where to send a blocked request back to.
		// tokenParam, when present, is echoed onto the redirect so the form still has what
		// it needs to re-render (mirrors the existing error-handling redirects in Auth.bx).
		limitedActions = {
			"Auth.doLogin"             : { redirectEvent: "login" },
			"Auth.doRegister"          : { redirectEvent: "register" },
			"Auth.doForgotPassword"    : { redirectEvent: "forgot-password" },
			"Auth.doResetPassword"     : { redirectEvent: "reset-password", tokenParam: "token" },
			"Auth.doActivateInvitation": { redirectEvent: "activate-invitation", tokenParam: "token" },
			"Profile.startSSO"          : { redirectEvent: "profile" },
			"Profile.unlinkSSO"         : { redirectEvent: "profile" }
		}
	}

	/**
	 * Pre-processes requests to enforce rate limiting on sensitive actions.
	 *
	 * @event The ColdBox request context.
	 * @interceptData Interception data.
	 * @buffer The output buffer.
	 * @rc The request collection.
	 * @prc The private request collection.
	 *
	 * @return Nothing. Redirects and sets flash messages if the rate limit is exceeded.
	 */
	function preProcess( event, interceptData, buffer, rc, prc ) {
		var currentEvent = event.getCurrentEvent()
		var isSSOCallback = currentEvent.findNoCase( "cbsso" ) && currentEvent.findNoCase( "authorize" )
		if ( !static.limitedActions.keyExists( currentEvent ) && !isSSOCallback ) {
			return
		}
		var limitKey = isSSOCallback ? "SSO.callback" : currentEvent

		var result = variables.rateLimitService.attempt(
			// trustUpstream mirrors cbTrustProxyHeaders: a caller can set X-Forwarded-For
			// to anything, so trusting it without knowing the app sits behind a proxy that
			// sets it itself would let an attacker get a fresh rate-limit bucket on every
			// request just by changing the header. See SettingService's cbTrustProxyHeaders
			// doc comment for the deployment-side tradeoff.
			key          : "#limitKey#:#variables.cbsecurity.getRealIP( trustUpstream = variables.settingService.getSetting( 'cbTrustProxyHeaders', true ) )#",
			maxAttempts  : variables.settingService.getSetting( "cbRateLimitMaxAttempts", 5 ),
			windowSeconds: variables.settingService.getSetting( "cbRateLimitWindowSeconds", 300 )
		)

		if ( result.allowed ) {
			return
		}

		variables.auditLogService.warn(
			action     : "security.ratelimit.blocked",
			message    : "Rate limit exceeded for [#limitKey#].",
			category   : "security",
			targetType : "Event",
			targetLabel: limitKey
		)

		flash.put( "messages", {
			type   : "error",
			message: "Too many attempts. Please wait a few minutes and try again."
		} )

		var target = isSSOCallback ? { redirectEvent: "login" } : static.limitedActions[ currentEvent ]
		var redirectTo = target.redirectEvent
		if ( target.keyExists( "tokenParam" ) && len( rc[ target.tokenParam ] ?: "" ) ) {
			redirectTo &= "?#target.tokenParam#=#encodeForURL( rc[ target.tokenParam ] )#"
		}

		relocate( redirectTo )
	}

}
