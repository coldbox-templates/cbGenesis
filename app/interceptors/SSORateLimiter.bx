/**
 * Throttles the cbSSO authorization callback by client IP.
 *
 * Every other throttled endpoint is a route in app/config/Router.bx and uses the
 * "throttle" route middleware (AppThrottle). The callback is a route owned by the
 * cbsso module, so application middleware cannot be attached to it; this interceptor
 * covers that one endpoint with the same limits, counter region and IP rules.
 *
 * Fires on preProcess, before routing and before Main.onRequestStart loads
 * prc.settings, so limits are read directly from SettingService. A blocked request
 * never reaches cbsso: it is redirected to the login page with a flash message.
 *
 * See docs/guides/security.md#rate-limiting.
 */
class extends="coldbox.system.Interceptor" {

	@inject( "provider:RateLimiter@cbsecurity" )
	property name="rateLimiter";

	@inject( "provider:SettingService" )
	property name="settingService";

	@inject( "provider:AuditLogService" )
	property name="auditLogService";

	@inject( "provider:CBSecurity@cbsecurity" )
	property name="cbsecurity";

	static {
		LIMIT_KEY = "SSO.callback"
		CACHE_NAME = "rateLimit"
	}

	/**
	 * Rate limits the cbSSO authorization callback.
	 *
	 * @event         The ColdBox request context.
	 * @interceptData Interception data.
	 * @buffer        The output buffer.
	 * @rc            The request collection.
	 * @prc           The private request collection.
	 *
	 * @return Nothing. Redirects with a flash message when the limit is exceeded.
	 */
	function preProcess( event, interceptData, buffer, rc, prc ) {
		var currentEvent = event.getCurrentEvent()
		if ( !currentEvent.findNoCase( "cbsso" ) || !currentEvent.findNoCase( "authorize" ) ) {
			return
		}

		var maxAttempts = variables.settingService.getSetting( "cbRateLimitMaxAttempts", 5 )
		var windowSeconds = variables.settingService.getSetting( "cbRateLimitWindowSeconds", 300 )
		// A window or limit of 0 is how an admin switches rate limiting off.
		if ( windowSeconds <= 0 || maxAttempts <= 0 ) {
			return
		}

		// trustUpstream mirrors cbTrustProxyHeaders: see AppThrottle.getClientIP().
		var key = "#static.LIMIT_KEY#:#variables.cbsecurity.getRealIP( trustUpstream = variables.settingService.getSetting( 'cbTrustProxyHeaders', true ) )#"

		if ( !variables.rateLimiter.tooManyAttempts( key, maxAttempts, static.CACHE_NAME ) ) {
			variables.rateLimiter.hit( key, windowSeconds, static.CACHE_NAME )
			return
		}

		variables.auditLogService.warn(
			action     : "security.ratelimit.blocked",
			message    : "Rate limit exceeded for [#static.LIMIT_KEY#].",
			category   : "security",
			targetType : "Event",
			targetLabel: static.LIMIT_KEY
		)

		flash.put( "messages", {
			type   : "error",
			message: "Too many attempts. Please wait a few minutes and try again."
		} )

		relocate( "login" )
	}

}
