/**
 * Refuses requests from blocked IPs before anything else in the request runs.
 *
 * Fires on preProcess, ahead of routing, sessions-heavy work and the database. A blocked
 * request gets a bare 403 and the handler never runs. The check is an in-memory lookup
 * (RateLimitBlockService.isBlocked()), so it is cheap enough to run on every request.
 *
 * The block list still applies while rate limiting is paused from the admin page: pausing
 * only skips the attempt limits. The RATE_LIMITING_ENABLED environment variable is the
 * full break-glass and switches the block list off too.
 *
 * An excluded IP is never refused, even if it is on the block list (RateLimitExclusionService).
 *
 * Each refused request is tallied for the history under the endpoint "Blocked IP"; it is
 * never written to the audit log, which would let an attacker grow it.
 *
 * See docs/guides/security.md#blocked-ips.
 */
class extends="coldbox.system.Interceptor" {

	@inject( "provider:RateLimitBlockService" )
	property name="blockService";

	@inject( "provider:RateLimitControlService" )
	property name="rateLimitControl";

	@inject( "provider:RateLimitExclusionService" )
	property name="exclusions";

	@inject( "provider:RateLimitHistoryService" )
	property name="rateLimitHistory";

	@inject( "provider:SettingService" )
	property name="settingService";

	@inject( "provider:CBSecurity@cbsecurity" )
	property name="cbsecurity";

	/**
	 * Refuses the request when the client IP is blocked.
	 *
	 * @event         The ColdBox request context.
	 * @interceptData Interception data.
	 * @buffer        The output buffer.
	 * @rc            The request collection.
	 * @prc           The private request collection.
	 *
	 * @return Nothing. For a blocked IP it renders a 403 and stops the request.
	 */
	function preProcess( event, interceptData, buffer, rc, prc ) {
		if ( variables.rateLimitControl.isDisabledByEnvironment() ) {
			return
		}

		// trustUpstream mirrors cbTrustProxyHeaders: see AppThrottle.getClientIP().
		var ipAddress = variables.cbsecurity.getRealIP(
			trustUpstream = variables.settingService.getSetting( "cbTrustProxyHeaders", true )
		)

		if ( !variables.blockService.isBlocked( ipAddress ) ) {
			return
		}

		// An excluded address is never refused, even if it is on the block list.
		if ( variables.exclusions.isExcludedIp( ipAddress ) ) {
			return
		}

		variables.rateLimitHistory.record( ipAddress, "Blocked IP", 0, false )

		// Route middleware still runs after a preProcess interceptor stops the event, and
		// AppThrottle would count this request and answer it with its own redirect. Flag it so
		// the middleware leaves a request that is already refused alone.
		arguments.prc.rateLimitRefused = true

		event.renderData( type = "text", data = "Forbidden", statusCode = 403 ).noExecution()
	}

}
