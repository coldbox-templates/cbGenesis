<bx:output>
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>#( prc.keyExists( "title" ) ? prc.title & " — " : "" )##getSetting( "appName" )#</title>
    <meta name="description" content="#getSetting( "appName" )#">
    <base href="#event.getHTMLBaseURL()#" />
    #view( "_partials/includes" )#
</head>
<body x-data x-init="$store.theme.init()">

    <div id="app">
        #renderView()#
    </div>

</body>
</html>
</bx:output>
