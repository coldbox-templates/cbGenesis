<bx:output>
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>#( prc.keyExists( "title" ) ? prc.title & " — " : "" )##prc.settings.cbAppname#</title>
    <meta name="description" content="#prc.settings.cbAppname#">
    <base href="#event.getHTMLBaseURL()#" />
    #view( "_components/app/includes" )#
</head>
<body x-data x-init="$store.theme.init()">

    <!--- Global UI components --->
    #view( "_components/ui/globalProgress" )#
    #view( "_components/ui/globalToast" )#

    <div id="app">
        #view()#
    </div>

</body>
</html>
</bx:output>
