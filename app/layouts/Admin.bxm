<bx:output>
<!DOCTYPE html>
<html lang="en" data-bs-theme="#prc.settings[ "cbDefaultTheme" ]#">
<head>#view( "_components/app/includes" )#</head>

<!--- x-init initializes Alpine stores:
      $store.theme.init()   — syncs Alpine's mode with the FOUC-prevention script
      $store.sidebar.init() — restores collapse state from localStorage --->
<body
    class="cb-admin-body"
	x-data
	x-init="$store.theme.init()">

	<!--- Global UI components --->
    #view( "_components/ui/globalProgress" )#
    #view( "_components/ui/globalToast" )#

    <!--- ── Mobile sidebar backdrop ──────────────────────────────── --->
    <div class="cb-sidebar-overlay"
         x-cloak
         x-show="$store.sidebar.open"
         x-transition.opacity
         @click="$store.sidebar.close()"
         aria-hidden="true">
    </div>

    <!--- ════════════════════════════════════════════════════════════
          SIDEBAR
          ════════════════════════════════════════════════════════════ --->
    #view( "_components/app/sidebar" )#

    <!--- ════════════════════════════════════════════════════════════
          MAIN WRAPPER  (topbar + page content + footer)
          ════════════════════════════════════════════════════════════ --->
    <div
        class="cb-main-wrapper"
		id="main-wrapper"
        :class="{ 'cb-sidebar-collapsed-ml': $store.sidebar.collapsed }">

        <!--- ── Topbar ───────────────────────────────────────────── --->
        #view( "_components/app/topbar" )#

        <!--- ── Page content ─────────────────────────────────────── --->
        <!--- Red strip while rate limiting is paused, so a pause is never forgotten --->
        <bx:set pausedUntil = prc.settings[ "cbRateLimitPausedUntil" ] ?: "">
        <bx:set pausedNow = pausedUntil == "indefinite" || ( isNumeric( pausedUntil ) && val( pausedUntil ) > int( createObject( "java", "java.lang.System" ).currentTimeMillis() / 1000 ) )>
        <bx:if pausedNow && !event.routeIs( "ratelimiting" ) && prc.authUser.hasPermission( "settings:read,settings:admin" )>
        <div class="cb-ratelimit-paused-strip" role="status">
            <i class="ph-duotone ph-warning-octagon" aria-hidden="true"></i>
            <span>Rate limiting is paused.</span>
            <a href="#event.route( "ratelimiting" )#">Review</a>
        </div>
        </bx:if>

        <main class="cb-main-content" id="main-content" tabindex="-1">
            <div class="container-fluid">
                #view()#
            </div>
        </main>

        <!--- ── Footer ───────────────────────────────────────────── --->
        #view( "_components/app/footer" )#

    </div>
    <!--- ── /Main wrapper ────────────────────────────────────────── --->

</body>
</html>
</bx:output>
