<bx:output>
<!DOCTYPE html>
<html lang="en" data-bs-theme="#prc.settings[ "cbDefaultTheme" ]#">
<head>
    #view(
		view = "_components/app/includes",
		args = { title: "Authentication" }
	)#
</head>
<body class="cb-auth-body" x-data x-init="$store.theme.init()">

    <div class="cb-auth-split-wrapper">

        <!--- ── Left panel: brand illustration ───────────────────── --->
        <div class="cb-auth-split-brand" aria-hidden="true">
            <!--- Decorative glow orbs --->
            <div class="cb-auth-split-orb cb-orb-cyan"></div>
            <div class="cb-auth-split-orb cb-orb-blue"></div>

            <div class="cb-auth-split-brand-content">
                <!--- Logo mark (large) --->
                <div class="cb-auth-split-brand-logo">
                    #view(
						view = "_components/ui/logo",
						args = { variant: "full", size: 150 }
					)#
                </div>

				<!--- App name --->
                <h1 class="cb-auth-split-brand-title">
                    #prc.settings.cbAppname#
                </h1>

				<!--- App tagline --->
                <p class="cb-auth-split-brand-tagline">
                    Start building your applications faster with
					a modern, lightweight framework that is secure by default.
                </p>

                <!--- Feature highlights --->
                <ul class="cb-auth-split-features">
                    <li class="cb-auth-split-feature">
                        <span class="cb-feature-icon"><i class="ph-duotone ph-lightning"></i></span>
                        Fast and lightweight
                    </li>
                    <li class="cb-auth-split-feature">
                        <span class="cb-feature-icon"><i class="ph-duotone ph-shield-check"></i></span>
                        Secure by default
                    </li>
                    <li class="cb-auth-split-feature">
                        <span class="cb-feature-icon"><i class="ph-duotone ph-cloud"></i></span>
                        Ready to deploy anywhere
                    </li>
                </ul>
            </div>
        </div>
        <!--- ── /Left panel ──────────────────────────────────────── --->

        <!--- ── Right panel: form ────────────────────────────────── --->
        <div class="cb-auth-split-form">
            <div class="cb-auth-split-form-inner">

                <!--- Logo shown only on mobile (brand panel hidden) --->
                <div class="cb-auth-split-logo-mobile">
                    <a href="/" class="cb-auth-logo-link">
                        #view(
							view: "_components/ui/logo",
							args: { variant: "compact" }
						)#
                    </a>
                </div>

                <!--- View content — inject the login/register form --->
                #view()#

                <!--- Footer: theme toggle --->
                #view( view = "_components/auth/footer", args = { split: true } )#

            </div>
        </div>
        <!--- ── /Right panel ─────────────────────────────────────── --->

    </div>

</body>
</html>
</bx:output>
