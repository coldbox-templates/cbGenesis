<bx:output>
<!DOCTYPE html>
<html lang="en" data-bs-theme="#prc.settings[ "cbDefaultTheme" ]#">
<head>
    #view(
		view = "_components/app/includes",
		args = { title: "Authentication" }
	)#
</head>
<body
    class="cb-auth-body"
	x-data
	x-init="$store.theme.init()">

    <div class="cb-auth-center-wrapper">

        <!--- ── Card ─────────────────────────────────────────────── --->
        <div class="cb-auth-card">

            <!--- Logo --->
            <div class="cb-auth-card-logo">
                <a href="/" class="cb-auth-logo-link">
                    #view( "_components/ui/logo" )#
                </a>
            </div>

            <!--- View content — inject the login/register/forgot-password form --->
            <div class="cb-auth-card-body">
                #view()#
            </div>

        </div>
        <!--- ── /Card ────────────────────────────────────────────── --->

        <!--- Dark / light mode toggle --->
        #view( "_components/auth/footer" )#

    </div>

</body>
</html>
</bx:output>
