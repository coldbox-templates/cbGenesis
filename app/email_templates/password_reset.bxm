<bx:output>
	<!DOCTYPE html>
	<html lang="en">

	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Password updated</title>
	</head>

	<body
		style="margin:0;padding:0;background:#f4f8fb;color:#17253a;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;">
		<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#f4f8fb;">
			<tr>
				<td align="center" style="padding:40px 16px;">
					<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0"
						style="max-width:600px;background:#ffffff;border:1px solid #dce8f0;border-radius:12px;overflow:hidden;">
						<tr>
							<td style="height:5px;background:#16bfd1;font-size:0;line-height:0;">&nbsp;</td>
						</tr>
						<tr>
							<td style="padding:32px 40px 24px;">
								<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
									<tr>
										<td style="width:42px;vertical-align:middle;">
											<div
												style="width:36px;height:36px;border-radius:10px;background:#17253a;color:#ffffff;font-size:20px;font-weight:700;line-height:36px;text-align:center;">
												@companyInitial@</div>
										</td>
										<td
											style="padding-left:10px;color:#17253a;font-size:18px;font-weight:700;vertical-align:middle;">
											@company@</td>
									</tr>
								</table>
							</td>
						</tr>
						<tr>
							<td style="padding:8px 40px 40px;">
								<p
									style="margin:0 0 12px;color:#16aabb;font-size:13px;font-weight:700;letter-spacing:1px;text-transform:uppercase;">
									Security update</p>
								<h1
									style="margin:0 0 20px;color:#17253a;font-size:30px;line-height:1.2;font-weight:700;">
									Your password was updated</h1>
								<p style="margin:0 0 24px;color:#53657a;font-size:16px;line-height:1.65;">Hi
									@name@, the password for @email@ was successfully
									changed.</p>
								<table role="presentation" cellspacing="0" cellpadding="0" border="0">
									<tr>
										<td style="border-radius:7px;background:#16bfd1;"><a
												href="@linkLogin@"
												style="display:inline-block;padding:14px 22px;color:#ffffff;font-size:15px;font-weight:700;text-decoration:none;">Sign
												in to your account</a></td>
									</tr>
								</table>
								<p style="margin:24px 0 0;color:#718196;font-size:13px;line-height:1.6;">If you made
									this change, no further action is needed. If you did not change your password,
									contact @companyEmail@ immediately.</p>
							</td>
						</tr>
						<tr>
							<td
								style="padding:20px 40px;border-top:1px solid #e7eef3;color:#8290a1;font-size:12px;line-height:1.6;">
								This notification helps keep your account secure.</td>
						</tr>
					</table>
					<p style="margin:18px 0 0;color:#8b98a8;font-size:12px;">@company@</p>
				</td>
			</tr>
		</table>
	</body>

	</html>
</bx:output>