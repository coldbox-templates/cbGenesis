<bx:output>
<!DOCTYPE html>
<html lang="en">
<body style="margin:0;padding:32px;background:##f4f8fb;color:##17253a;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;">
    <div style="max-width:600px;margin:auto;padding:32px;background:##fff;border:1px solid ##dce8f0;border-radius:12px;">
        <p style="color:##16aabb;font-weight:700;text-transform:uppercase;">Confirm your new email</p>
        <h1>Hi @name@</h1>
        <p>Someone requested to change the email address on your @appName@ account to this address: <strong>@email@</strong>. Confirm below to complete the change.</p>
        <p><a href="@linkToken@" style="display:inline-block;padding:14px 22px;background:##16bfd1;color:##fff;text-decoration:none;border-radius:7px;">Confirm new email address</a></p>
        <p style="color:##718196;font-size:13px;">This link expires in @linkTimeout@. If you did not request this change, you can safely ignore this email - your account's email address will not change unless this link is clicked.</p>
        <p style="word-break:break-all;font-size:12px;color:##16aabb;">@linkToken@</p>
    </div>
</body>
</html>
</bx:output>
