<bx:output>
<!DOCTYPE html>
<html lang="en">
<body style="margin:0;padding:32px;background:##f4f8fb;color:##17253a;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;">
    <div style="max-width:600px;margin:auto;padding:32px;background:##fff;border:1px solid ##dce8f0;border-radius:12px;">
        <p style="color:##e0334d;font-weight:700;text-transform:uppercase;">Security notice</p>
        <h1>Hi @name@</h1>
        <p>Someone requested to change the email address on your @appName@ account from <strong>@oldEmail@</strong> to <strong>@newEmail@</strong>.</p>
        <p>The change only takes effect once the new address confirms it - this notice is sent either way so you know about the request.</p>
        <p style="color:##718196;font-size:13px;">If you did not request this, your account may be compromised. Sign in and change your password immediately.</p>
    </div>
</body>
</html>
</bx:output>
