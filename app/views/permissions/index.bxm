<bx:output>
<!--- Header --->
<div class="page-header admin-page-heading">
	<div>
		<p class="eyebrow">Security</p>
		<h2 class="page-title">Permissions</h2>
		<p class="page-subtitle">
			A permission is a specific action that can be performed in the system. Permissions are grouped into modules, which are then assigned to roles.
		</p>
	</div>
	<button
		type="button"
		class="btn btn-primary"
		@click="$dispatch( 'open-permission-modal' )"
	>
		<i class="ph-duotone ph-plus" aria-hidden="true"></i>
		New Permission
	</button>
</div>

<!--- Flash Messages--->
<bx:if flash.exists( "messages" )>
	#view(
		view = "_components/ui/messagebox",
		args = {
			type       : flash.get( "messages" ).type ?: "info",
			message    : flash.get( "messages" ).message ?: "",
			dismissible: true,
			classes    : "mb-4"
		}
	)#
</bx:if>

<!--- Permission Catalog --->
<div
	class="permission-catalog"
	x-data='permissionsForm( #forAttribute( prc.permissionCatalog )#, "#csrfToken()#" )'
	@open-permission-modal.window="openModal()"
>

	<!--- Filter/Search Bar --->
	<div class="content-card catalog-toolbar">
		<div class="admin-search wide">
			<i class="ph-duotone ph-magnifying-glass" aria-hidden="true"></i>
			<input
				x-model.debounce.150ms="query"
				type="search"
				placeholder="Filter permissions..."
				aria-label="Filter permissions">
		</div>
		<span
			class="muted-cell"
			x-text="filteredCount + (filteredCount === 1 ? ' permission' : ' permissions')"></span>
	</div>

	<!--- Permission Grid --->
	<div class="permission-grid">
		<template x-for="group in permissionGroups" :key="group.key">
			<section class="content-card permission-group-card">
				<!--- Permission Header --->
				<div class="content-card-header">
					<div>
						<span class="permission-icon"><i class="ph-duotone ph-key" aria-hidden="true"></i></span>
						<h3 class="content-card-title" x-text="group.label"></h3>
						<span class="count-pill" x-text="group.permissions.length" :aria-label="group.permissions.length + (group.permissions.length === 1 ? ' permission' : ' permissions')"></span>
					</div>
					<i class="ph-duotone ph-folder-open permission-group-icon" aria-hidden="true"></i>
				</div>
				<!--- Permission List --->
				<ul class="permission-list">
					<template x-for="permission in group.permissions" :key="permission.permission">
						<li>
							<span>
								<button
									type="button"
									class="permission-edit-trigger"
									:title="'Edit ' + permission.permission"
									@click="openEditModal( permission )"
									x-text="permission.slug"></button>
								<small x-text="permission.description || 'No description provided'"></small>
								<code x-text="permission.permission"></code>
							</span>
							<div class="permission-actions">
								<button
									type="button"
									class="permission-edit"
									title="Edit permission"
									:aria-label="'Edit ' + permission.permission"
									@click="openEditModal( permission )">
									<i class="ph-duotone ph-pencil-simple" aria-hidden="true"></i>
								</button>
								<button
									type="button"
									class="permission-delete"
									title="Delete permission"
									:aria-label="'Delete ' + permission.permission"
									@click="confirmDelete( permission )">
									<i class="ph-duotone ph-trash" aria-hidden="true"></i>
								</button>
							</div>
						</li>
					</template>
				</ul>
			</section>
		</template>

		<!--- No Permissions Tab --->
		<div class="content-card empty-state" x-show="permissionGroups.length === 0" x-cloak>
			<i class="ph-duotone ph-magnifying-glass" aria-hidden="true"></i>
			<strong>No permissions found</strong>
			<span>Try a different search term.</span>
		</div>
	</div>

	<!--- Create Permission Modal --->
	#view( view: "_components/ui/modal", args: {
		id            : "permission-create-modal",
		title         : "Permission",
		openExpression: "modalOpen",
		contentView   : "permissions/editForm"
	} )#

	<!--- Delete Permission Modal --->
	#view( view: "_components/ui/modal", args: {
		id            : "permission-delete-modal",
		title         : "Delete Permission",
		openExpression: "confirmModalOpen",
		closeExpression: "cancelDelete()",
		contentView   : "permissions/deleteConfirm"
	} )#
</div>
</bx:output>
