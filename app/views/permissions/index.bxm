<bx:output>
<div class="page-header admin-page-heading">
	<div>
		<p class="eyebrow">Security</p>
		<h2 class="page-title">Permissions</h2>
		<p class="page-subtitle">A browsable mock catalog for the permission objects the backend will own later.</p>
	</div>
	<button class="btn btn-outline-secondary"><i class="ph-duotone ph-download-simple"></i> Export CSV</button>
</div>

<div class="permission-catalog" x-data="{ query: '' }">
	<div class="content-card catalog-toolbar">
		<div class="admin-search wide"><i class="ph-duotone ph-magnifying-glass"></i><input x-model="query" type="search" placeholder="Filter permissions..."></div>
		<span class="muted-cell">#arrayLen( prc.permissionGroups )# modules</span>
	</div>

	<div class="permission-grid">
		<bx:loop array="#prc.permissionGroups#" item="group">
			<section class="content-card permission-group-card">
				<div class="content-card-header"><div><h3 class="content-card-title">#encodeForHTML( group.module )#</h3><p>#encodeForHTML( group.description )#</p></div></div>
				<ul class="permission-list">
					<bx:loop array="#group.permissions#" item="permission">
						<li x-show="query === '' || '#lCase( permission.permission )# #lCase( permission.description )#'.includes( query.toLowerCase() )">
							<span class="permission-icon"><i class="ph-duotone ph-key"></i></span>
							<span><strong>#encodeForHTML( permission.permission )#</strong><small>#encodeForHTML( permission.description )#</small></span>
							<code>#encodeForHTML( permission.permissionId )#</code>
						</li>
					</bx:loop>
				</ul>
			</section>
		</bx:loop>
	</div>
</div>
</bx:output>
