<bx:output>
<form
	method="post"
	:action="editingPermission ? '/permissions/' + encodeURIComponent( editingPermission.permissionId ) : '/permissions'"
	@submit="editingPermission ? updatePermission( $event ) : submitting = true">

	<!--- CSRF --->
	<input type="hidden" name="csrf" id="csrf" x-model="csrfToken">

	<!--- Modal Body --->
	<div class="ui-modal__body">
		<small x-show="formError" x-text="formError" class="delete-confirmation__error"></small>

		<!--- Permission --->
		<div class="form-field">
			<label for="permission-name" x-text="editingPermission ? 'Permission' : 'Permission'"></label>
			<input
				id="permission-name"
				name="permission"
				type="text"
				placeholder="users:read"
				required
				maxlength="255"
				x-model="form.permission">
			<small>Use a module and action separated by a colon.</small>
		</div>

		<!--- Description --->
		<div class="form-field">
			<label for="permission-description">Description <span>(optional)</span></label>
			<textarea
				id="permission-description"
				name="description"
				rows="3"
				placeholder="View and search users"
				x-model="form.description"></textarea>
		</div>
	</div>

	<!--- Modal Footer --->
	<div class="ui-modal__footer">
		<button type="button" class="btn btn-secondary" @click="closeModal()">Cancel</button>
		<button type="submit" class="btn btn-primary" :disabled="submitting || !form.permission.trim()">
			<i class="ph-duotone" :class="editingPermission ? 'ph-floppy-disk' : 'ph-plus'" aria-hidden="true"></i>
			<span x-text="editingPermission ? 'Save Permission' : 'Create Permission'"></span>
		</button>
	</div>
</form>
</bx:output>