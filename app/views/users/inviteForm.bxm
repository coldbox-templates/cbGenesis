<bx:output>
<form
	class="cb-drawer-form-body"
	@submit.prevent="inviteUser"
	x-init="$watch( 'inviteOpen', ( isOpen ) => isOpen && $nextTick( () => $refs.firstName?.focus() ) )">
	<!--- header --->
	<div>
		<h3 class="cb-drawer-section-title">New User</h3>
		<p class="cb-muted-cell">The user will receive an email with a link to finish setting up their account including their password.</p>
	</div>

	<!--- Form --->
	<div class="cb-form-grid">
		<label>
			First name
			<input type="text" x-ref="firstName" x-model="form.firstName" required autocomplete="given-name">
		</label>
		<label>
			Last name
			<input type="text" x-model="form.lastName" required autocomplete="family-name">
		</label>
		<label class="cb-span-2">
			Email address
			<input type="email" x-model="form.email" required autocomplete="email">
		</label>
		<label class="cb-span-2">
			Role
			<select x-model="form.roleId" required>
				<option value="">Select a role</option>
				<template x-for="role in roles" :key="role.roleId">
					<option :value="role.roleId" x-text="role.role"></option>
				</template>
			</select>
		</label>
	</div>

	<!--- Error Messages --->
	<p class="cb-form-error" x-show="error" x-text="error"></p>

	<!--- Actions --->
	<div class="cb-drawer-form-actions">
		<button
			type="button"
			class="btn btn-light"
			@click="closeInvite()">Cancel</button>
		<button
			type="submit"
			class="btn btn-primary"
			:disabled="submitting || !inviteReady"><i
			class="ph-duotone ph-paper-plane-tilt"
			aria-hidden="true"></i><span
			x-text="submitting ? 'Inviting...' : 'Send invitation'"></span></button>
	</div>
</form>
</bx:output>