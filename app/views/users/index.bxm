<bx:output>
<!--- Users Component --->
<div x-data='usersForm( #forAttribute( prc.payload )#, "#csrfToken()#" )' x-init="refreshUsers()">

	<!--- Header --->
	<div class="cb-page-header cb-admin-page-heading">
		<div>
			<p class="cb-eyebrow">Security</p>
			<h2 class="cb-page-title">User Management</h2>
			<p class="cb-page-subtitle">Manage users and their roles in the system. You can invite new users, assign roles, and manage their access.</p>
		</div>
		<!--- Invite a new user to the system --->
		<button type="button" class="btn btn-primary" @click="openInvite()">
			<i class="ph-duotone ph-plus" aria-hidden="true"></i>
			Invite User
		</button>
	</div>

	#view( view: "_components/ui/messagebox", args: {
		dynamic          : true,
		messageExpression: "feedbackMessage",
		typeExpression   : "feedbackType",
		dismissAction    : "clearFeedback()",
		classes          : "cb-users-feedback"
	} )#

	<!--- Users Table --->
	<section class="cb-content-card cb-admin-workbench">

		<!--- Users Table Header --->
		<div class="cb-content-card-header cb-admin-toolbar">
			<!--- User Filters --->
			<div class="cb-segmented-control" aria-label="User filters">
				<button
					type="button"
					:class="statusFilter === 'active' ? 'active' : ''"
					@click="setStatusFilter( 'active' )">Active <span class="cb-tab-count" x-text="counts.active"></span></button>
				<button
					type="button"
					:class="statusFilter === 'pending' ? 'active' : ''"
					@click="setStatusFilter( 'pending' )">Pending <span class="cb-tab-count" x-text="counts.pending"></span></button>
				<button
					type="button"
					:class="statusFilter === 'inactive' ? 'active' : ''"
					@click="setStatusFilter( 'inactive' )">Inactive <span class="cb-tab-count" x-text="counts.inactive"></span></button>
				<button
					type="button"
					:class="statusFilter === 'all' ? 'active' : ''"
					@click="setStatusFilter( 'all' )">All <span class="cb-tab-count" x-text="counts.all"></span></button>
			</div>
			<!--- Filter Users by Role --->
			<select
				class="cb-admin-role-filter"
				x-model="roleFilter"
				@change="setRoleFilter( $event.target.value )"
				aria-label="Filter users by role">
				<option value="">All Roles</option>
				<template x-for="role in roles" :key="role.roleId">
					<option :value="role.roleId" x-text="role.role"></option>
				</template>
			</select>
			<!--- Search Users --->
			<div class="cb-admin-search cb-wide">
				<i class="ph-duotone ph-magnifying-glass" aria-hidden="true"></i>
				<input x-model="query" @input.debounce.250ms="refreshUsers()" type="search" placeholder="Search users..." aria-label="Search users">
			</div>
			<!--- Search Totals --->
			<span
				class="cb-muted-cell"
				x-show="query.trim()"
				x-cloak
				x-text="$countLabel( total, 'matching user', 'matching users' )"></span>
		</div>

		<!--- Users Table --->
		<div class="cb-table-wrap">
			<table class="cb-table">
				<thead>
					<tr>
						<th scope="col" class="cb-users-info-column">
							<button
								type="button"
								class="cb-table-sort-button"
								:class="$sortClass( sortOrder, 'lastName' )"
								@click="sortBy( 'lastName' )">
								Name <i class="ph-duotone" :class="$sortIcon( sortOrder, 'lastName' )" aria-hidden="true"></i>
							</button>
						</th>
						<th scope="col" class="cb-users-secondary-column"><button
							type="button"
							class="cb-table-sort-button"
							:class="$sortClass( sortOrder, 'createdDate' )"
							@click="sortBy( 'createdDate' )">
							Created On <i class="ph-duotone" :class="$sortIcon( sortOrder, 'createdDate' )" aria-hidden="true"></i></button>
						</th>
						<th
							x-show="statusFilter !== 'pending'"
							x-cloak
							class="cb-users-secondary-column"
							scope="col"><button
							type="button"
							class="cb-table-sort-button"
							:class="$sortClass( sortOrder, 'verifiedAt' )"
							@click="sortBy( 'verifiedAt' )">
							Verified On <i class="ph-duotone" :class="$sortIcon( sortOrder, 'verifiedAt' )" aria-hidden="true"></i></button>
						</th>
						<th
							x-show="statusFilter !== 'active'"
							x-cloak
							class="cb-users-secondary-column"
							scope="col">Invitation</th>
						<th
							class="cb-users-secondary-column"
							scope="col"><button
							type="button"
							class="cb-table-sort-button"
							:class="$sortClass( sortOrder, 'isActive' )"
							@click="sortBy( 'isActive' )">
							Status <i class="ph-duotone" :class="$sortIcon( sortOrder, 'isActive' )" aria-hidden="true"></i></button>
						</th>
						<th scope="col" class="cb-users-actions-column">Actions</th>
					</tr>
				</thead>
				<tbody>
					<template x-for="user in users" :key="user.userId">
						<tr>
							<td class="cb-users-info-column">
								<div class="cb-identity-cell">
									<span class="cb-avatar-token" x-text="user.initials"></span>
									<span>
										<strong x-text="user.name"></strong>
										<small x-text="user.email"></small>
										<span class="cb-chip-row mt-1" x-show="user.roles.length" x-cloak>
											<template x-for="( role, roleIndex ) in user.roles" :key="user.userId + '-' + role + '-' + roleIndex">
												<span class="cb-chip cb-chip-info" x-text="role"></span>
											</template>
										</span>
									</span>
								</div>
							</td>
							<td class="cb-users-secondary-column">
								<span
									class="cb-muted-cell"
									:data-tooltip="user.createdDate ? $formatDateTime( user.createdDate ) : null"
									x-text="user.createdDate ? $formatDate( user.createdDate ) : '-' "></span>
							</td>
							<td
								class="cb-users-secondary-column"
								x-show="statusFilter !== 'pending'"
								x-cloak>
								<span
									class="cb-muted-cell"
									:data-tooltip="user.verifiedAt ? $formatDateTime( user.verifiedAt ) : null"
									x-text="user.verifiedAt ? $formatDate( user.verifiedAt ) : 'Pending'"></span>
							</td>
							<td
								class="cb-users-secondary-column"
								x-show="statusFilter !== 'active'"
								x-cloak>
								<div class="d-flex flex-column gap-1">
									<small
										class="cb-muted-cell"
										x-show="user.invitationInvitedAt"
										x-cloak>
										Invited:
										<span
											:data-tooltip="user.invitationInvitedAt ? $formatDateTime( user.invitationInvitedAt ) : null"
											x-text="user.invitationInvitedAt ? $formatDate( user.invitationInvitedAt ) : '-' "></span>
									</small>
									<small
										class="cb-muted-cell"
										x-show="user.invitationExpiresAt"
										x-cloak>
										Expires:
										<span
											:data-tooltip="user.invitationExpiresAt ? $formatDateTime( user.invitationExpiresAt ) : null"
											x-text="user.invitationExpiresAt ? $formatDate( user.invitationExpiresAt ) : '-' "></span>
									</small>
								</div>
							</td>
							<td class="cb-users-secondary-column">
								<span class="cb-chip" :class="'cb-chip-' + user.status.toLowerCase()" x-text="user.status"></span>
							</td>
							<td class="cb-users-actions-column">
								<div class="dropdown">
									<button
										type="button"
										class="btn btn-sm btn-light"
										data-bs-toggle="dropdown"
										aria-expanded="false"
										:aria-label="'Actions for ' + user.name">
										<i class="ph-duotone ph-dots-three-outline" aria-hidden="true"></i>
										<span class="visually-hidden">Actions</span>
									</button>
									<ul class="dropdown-menu dropdown-menu-end">
										<li>
											<a class="dropdown-item" :href="user.detailUrl">
												<i class="ph-duotone ph-arrow-square-out" aria-hidden="true"></i> Manage user
											</a>
										</li>
										<li x-show="user.canResendInvitation" x-cloak>
											<button
												type="button"
												class="dropdown-item"
												@click="resendInvitation( user )"
												:disabled="resendingUserId === user.userId"
											>
												<i class="ph-duotone ph-paper-plane-tilt" aria-hidden="true"></i>
												<span x-text="resendingUserId === user.userId ? 'Sending...' : 'Resend invitation'"></span>
											</button>
										</li>
										<li x-show="( statusFilter === 'active' || statusFilter === 'pending' ) && user.isActive" x-cloak>
											<button type="button" class="dropdown-item" @click="confirmStatusChange( user, false )">
												<i class="ph-duotone ph-user-minus" aria-hidden="true"></i> Disable user
											</button>
										</li>
										<li x-show="statusFilter === 'inactive' && !user.isActive" x-cloak>
											<button type="button" class="dropdown-item" @click="confirmStatusChange( user, true )">
												<i class="ph-duotone ph-user-plus" aria-hidden="true"></i> Enable user
											</button>
										</li>
										<li>
											<hr class="dropdown-divider">
										</li>
										<li>
											<button type="button" class="dropdown-item text-danger" @click="confirmDelete( user )"><i class="ph-duotone ph-trash" aria-hidden="true"></i> Delete user</button>
										</li>
									</ul>
								</div>
							</td>
						</tr>
					</template>

					<!--- Loading state --->
					<tr x-show="loading" x-cloak>
						<td :colspan="visibleColumnCount">
							#view( view: "_components/ui/progressbar", args: {
								label        : "Loading users...",
								ariaLabel    : "Loading users",
								indeterminate: true,
								variant      : "cyan",
								size         : "sm"
							} )#
						</td>
					</tr>

					<!--- If No Users Found --->
					<tr x-show="!loading && users.length === 0" x-cloak>
						<td
							:colspan="visibleColumnCount"
							class="cb-empty-state">No users found</td>
					</tr>
				</tbody>
			</table>
		</div>

		<!--- Pagination --->
		<div class="cb-pagination" x-show="total > 0" x-cloak>
			<button
				type="button"
				class="btn btn-light btn-sm"
				@click="previousPage()"
				:disabled="page <= 1">
				<i class="ph-bold ph-caret-left" aria-hidden="true"></i> Previous
			</button>
			<span x-text="'Page ' + page + ' of ' + pageCount"></span>
			<button
				type="button"
				class="btn btn-light btn-sm"
				@click="nextPage()"
				:disabled="page >= pageCount">
				Next <i class="ph-bold ph-caret-right" aria-hidden="true"></i>
			</button>
		</div>
	</section>

	<!--- Invite Drawer --->
	#view( view: "_components/ui/drawer", args: {
		id: "cb-user-invite-drawer",
		title: "Invite User",
		openExpression: "inviteOpen",
		closeExpression: "closeInvite()",
		contentView: "users/inviteForm"
	} )#

	<!--- Delete User Modal --->
	#view( view: "_components/ui/modal", args: {
		id            : "cb-user-delete-modal",
		title         : "Delete user?",
		openExpression: "deleteTarget",
		closeExpression: "cancelDelete()",
		contentView   : "users/deleteConfirm"
	} )#

	<!--- Enable/Disable User Modal --->
	#view( view: "_components/ui/modal", args: {
		id             : "cb-user-status-modal",
		title          : "Change user status?",
		openExpression : "statusTarget",
		closeExpression: "cancelStatusChange()",
		contentView    : "users/statusConfirm"
	} )#

	<!--- Resend Invitation Error Modal --->
	#view( view: "_components/ui/modal", args: {
		id             : "cb-user-invitation-error-modal",
		title          : "Invitation could not be sent",
		openExpression : "invitationError",
		closeExpression: "closeInvitationError()",
		contentView    : "users/invitationError"
	} )#
</div>
</bx:output>