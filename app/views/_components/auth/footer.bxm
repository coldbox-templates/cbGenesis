<!---
    Auth Footer Partial
	Renders the footer for auth pages (login/register) with a theme toggle button.

    Usage:
        #view( "_components/auth/footer" )#
		#view( "_components/auth/footer", args: { split: false } )#

    Args:
        split : boolean — whether to use the split layout (default: true)
--->
<bx:param name="args.split" default="true" />

<bx:output>
<div class="auth-#( args.split ? 'split-' : '' )#footer">
	<button class="btn-theme-toggle"
			x-cloak
			@click="$store.theme.toggle()"
			:aria-label="$store.theme.mode === 'dark' ? 'Switch to light mode' : 'Switch to dark mode'">
		<i class="ph-duotone ph-sun"  x-show="$store.theme.mode === 'dark'"></i>
		<i class="ph-duotone ph-moon" x-show="$store.theme.mode === 'light'"></i>
	</button>
</div>
</bx:output>