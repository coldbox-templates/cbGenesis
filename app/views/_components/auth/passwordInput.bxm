<!--- Password input component with inline Alpine visibility state.

    Usage:
        #view( view: "_components/auth/passwordInput", args: {
            id       : "password",
            name     : "password",
            model    : "password",
            label    : "Password"
        } )#

    Args:
        id            : string  — input id                       (default: "password")
        name          : string  — form field name                (default: args.id)
        model         : string  — Alpine x-model expression      (default: "password")
        label         : string  — visible label                  (default: "Password")
        helperLink    : string  — optional helper link URL       (default: "")
        helperText    : string  — optional helper link text      (default: "")
        classes       : string  — root wrapper classes           (default: "")
        labelClass    : string  — label classes                  (default: "form-label")
        inputClasses  : string  — input classes                  (default: "form-control")
        inputClassExpression : string — Alpine class expression  (default: "")
        placeholder   : string  — input placeholder              (default: "")
        autocomplete  : string  — autocomplete value             (default: "current-password")
        required      : boolean — add required attribute          (default: true)
        errorMessage  : string  — server-side validation message  (default: "") --->
<bx:param name="args.id" default="password"/>
<bx:param name="args.name" default="#args.id#"/>
<bx:param name="args.model" default="password"/>
<bx:param name="args.label" default="Password"/>
<bx:param name="args.helperLink" default=""/>
<bx:param name="args.helperText" default=""/>
<bx:param name="args.classes" default=""/>
<bx:param name="args.labelClass" default="form-label"/>
<bx:param name="args.inputClasses" default="form-control"/>
<bx:param name="args.inputClassExpression" default=""/>
<bx:param name="args.placeholder" default=""/>
<bx:param name="args.autocomplete" default="current-password"/>
<bx:param name="args.required" default="true"/>
<bx:param name="args.errorMessage" default=""/>

<bx:set localId = trim( args.id ?: "password" )>
<bx:set localName = trim( args.name ?: localId )>
<bx:set localModel = trim( args.model ?: "password" )>
<bx:set localErrorMessage = trim( args.errorMessage ?: "" )>

<bx:output>
<div
	class="password-input#( len( args.classes ) ? " " & args.classes : "" )#"
	x-data="{ showPassword: false }"
>
	<!--- Label --->
    <bx:if len( trim( args.label ) )>
        <div class="d-flex justify-content-between align-items-center mb-1">
			<!--- Input Label --->
            <label
				for="#encodeForHTMLAttribute( localId )#"
				class="#encodeForHTMLAttribute( args.labelClass )#">
                #encodeForHTML( args.label )#
            </label>
			<!--- Forgot Password or other helper info --->
            <bx:if len( trim( args.helperLink ) ) && len( trim( args.helperText ) )>
                <a href="#encodeForHTMLAttribute( args.helperLink )#" class="auth-link small" tabindex="-1">
                    #encodeForHTML( args.helperText )#
                </a>
            </bx:if>
        </div>
    </bx:if>

    <div class="input-group">
        <input
            :type="showPassword ? 'text' : 'password'"
            id="#encodeForHTMLAttribute( localId )#"
            name="#encodeForHTMLAttribute( localName )#"
            class="#encodeForHTMLAttribute( args.inputClasses )##( len( localErrorMessage ) ? " is-invalid" : "" )#"
			<bx:if len( trim( args.inputClassExpression ) )>:class="#encodeForHTMLAttribute( args.inputClassExpression )#"</bx:if>
            x-model="#encodeForHTMLAttribute( localModel )#"
            placeholder="#encodeForHTMLAttribute( args.placeholder )#"
            autocomplete="#encodeForHTMLAttribute( args.autocomplete )#"#( args.required ? " required" : "" )#>

		<button
            class="btn btn-outline-secondary"
            type="button"
            @click="showPassword = !showPassword"
            :aria-label="showPassword ? 'Hide password' : 'Show password'">
            <i class="ph-duotone"
               :class="showPassword ? 'ph-eye-slash' : 'ph-eye'"
               aria-hidden="true"></i>
        </button>

		<!--- Local Error Messages If Any --->
        <bx:if len( localErrorMessage )>
            <div class="invalid-feedback">#encodeForHTML( localErrorMessage )#</div>
        </bx:if>
    </div>
</div>
</bx:output>