<!--- Confirm Component
	Renders a configurable Alpine-powered confirmation dialog without requiring
	a separate content view.

	Usage:
		#view( view: "_components/ui/confirm", args: {
			id                 : "user-delete-confirm",
			title              : "Delete User",
			message            : "Are you sure you want to delete this user?",
			openExpression     : "confirmOpen",
			closeExpression    : "cancelConfirm()",
			confirmExpression  : "deleteUser()",
			confirmLabel       : "Delete",
			confirmClass       : "btn-danger",
			confirmIcon        : "ph-trash"
		} )#

	Args:
		id                : string — unique dialog id                    (default: "confirm")
		title             : string — visible dialog title                 (default: "Confirm Action")
		message           : string — visible confirmation message         (default: "Are you sure you want to continue?")
		icon              : string — Phosphor icon class                   (default: "ph-warning-circle")
		openExpression    : string — Alpine expression controlling state  (default: "false")
		closeExpression   : string — Alpine expression used to cancel     (default: "closeConfirm()")
		confirmExpression : string — Alpine expression used to confirm    (default: "confirmAction()")
		cancelLabel       : string — cancel button label                  (default: "Cancel")
		confirmLabel      : string — confirm button label                 (default: "Confirm")
		confirmClass      : string — button modifier class                (default: "btn-primary")
		confirmIcon       : string — optional confirm button icon class   (default: "")
		disabledExpression: string — Alpine expression disabling buttons  (default: "false") --->
<bx:param name="args.id" default="confirm"/>
<bx:param name="args.title" default="Confirm Action"/>
<bx:param name="args.message" default="Are you sure you want to continue?"/>
<bx:param name="args.messageExpression" default=""/>
<bx:param name="args.icon" default="ph-warning-circle"/>
<bx:param name="args.openExpression" default="false"/>
<bx:param name="args.closeExpression" default="closeConfirm()"/>
<bx:param name="args.confirmExpression" default="confirmAction()"/>
<bx:param name="args.cancelLabel" default="Cancel"/>
<bx:param name="args.confirmLabel" default="Confirm"/>
<bx:param name="args.confirmClass" default="btn-primary"/>
<bx:param name="args.confirmIcon" default=""/>
<bx:param name="args.disabledExpression" default="false"/>

<bx:output>
<div id="#encodeForHTMLAttribute( args.id )#"
	class="cb-ui-modal"
	x-data="{ submitting: false }"
	x-effect="if ( !#args.openExpression# ) submitting = false"
	x-show="#args.openExpression#"
	x-cloak
	x-transition.opacity
	role="dialog"
	aria-modal="true"
	aria-labelledby="#encodeForHTMLAttribute( args.id )#-title"
	aria-describedby="#encodeForHTMLAttribute( args.id )#-message"
	@click.self="#args.closeExpression#; submitting = false"
	@keydown.escape.window="#args.closeExpression#; submitting = false">
	<div class="cb-ui-modal__dialog" x-transition.scale.95>
		<div class="cb-ui-modal__header">
			<h2 id="#encodeForHTMLAttribute( args.id )#-title">#encodeForHTML( args.title )#</h2>
			<button
				type="button"
				class="cb-ui-modal__close"
				@click="#args.closeExpression#; submitting = false"
				:disabled="#args.disabledExpression# || submitting"
				aria-label="Close dialog">
				<i class="ph-duotone ph-x" aria-hidden="true"></i>
			</button>
		</div>
		<div class="cb-ui-modal__body cb-delete-confirmation">
			<i class="ph-duotone #encodeForHTMLAttribute( args.icon )#" aria-hidden="true"></i>
			<p id="#encodeForHTMLAttribute( args.id )#-message">
				<bx:if len( trim( args.messageExpression ) )>
					<span x-text="#args.messageExpression#"></span>
				<bx:else>
					#encodeForHTML( args.message )#
				</bx:if>
			</p>
		</div>
		<div class="cb-ui-modal__footer">
			<button
				type="button"
				class="btn btn-secondary"
				@click="#args.closeExpression#; submitting = false"
				:disabled="#args.disabledExpression# || submitting">#encodeForHTML( args.cancelLabel )#</button>
			<button
				type="button"
				class="btn #encodeForHTMLAttribute( args.confirmClass )#"
				@click.prevent="submitting = true; #args.confirmExpression#"
				:disabled="#args.disabledExpression# || submitting"
				:aria-busy="submitting">
				<span x-show="!submitting">
					<bx:if len( trim( args.confirmIcon ) )>
						<i class="ph-duotone #encodeForHTMLAttribute( args.confirmIcon )#" aria-hidden="true"></i>
					</bx:if>
					#encodeForHTML( args.confirmLabel )#
				</span>
				<span x-show="submitting" x-cloak>
					<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
					Processing...
				</span>
			</button>
		</div>
	</div>
</div>
</bx:output>