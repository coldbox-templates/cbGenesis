<!---
	Password Meter Component
	Renders a password input with the shared passwordStrength Alpine meter.

	Usage:
		#view( view: "_components/ui/passwordMeter", args: {
			id    : "password",
			name  : "password",
			label : "New password"
		} )#

	Args:
		id            : string  — input id                       (default: "password")
		name          : string  — input name                     (default: args.id)
		label         : string  — visible label                  (default: "Password")
		classes       : string  — root wrapper classes           (default: "")
		labelClass    : string  — label classes                  (default: "")
		inputClasses  : string  — input classes                  (default: "")
		placeholder   : string  — input placeholder              (default: "Min. 8 characters")
		autocomplete  : string  — autocomplete value             (default: "new-password")
		required      : boolean — add required attribute          (default: true)
		dispatchEvent : string  — event emitted on input          (default: "password-changed")
		errorMessage  : string  — server-side validation message  (default: "")
--->
<bx:param name="args.id"            default="password" />
<bx:param name="args.name"          default="#args.id#" />
<bx:param name="args.label"         default="Password" />
<bx:param name="args.classes"       default="" />
<bx:param name="args.labelClass"    default="" />
<bx:param name="args.inputClasses"  default="" />
<bx:param name="args.placeholder"   default="Min. 8 characters" />
<bx:param name="args.autocomplete"  default="new-password" />
<bx:param name="args.required"      default="true" />
<bx:param name="args.dispatchEvent" default="password-changed" />
<bx:param name="args.errorMessage"  default="" />

<bx:set localErrorMessage = trim( args.errorMessage ) />

<bx:output>
<div class="password-meter#( len( args.classes ) ? ' ' & args.classes : '' )#" x-data="passwordStrength">
	<label for="#encodeForHTMLAttribute( args.id )#"#( len( args.labelClass ) ? ' class="' & encodeForHTMLAttribute( args.labelClass ) & '"' : '' )#>#encodeForHTML( args.label )#</label>
	<div class="input-group">
		<input :type="showPassword ? 'text' : 'password'"
			   id="#encodeForHTMLAttribute( args.id )#"
			   name="#encodeForHTMLAttribute( args.name )#"
			   class="#encodeForHTMLAttribute( args.inputClasses )##( len( localErrorMessage ) ? ' is-invalid' : '' )#"
			   x-model="password"
			   @input="$dispatch( '#encodeForJavaScript( args.dispatchEvent )#', { value: password } )"
			   placeholder="#encodeForHTMLAttribute( args.placeholder )#"
			   autocomplete="#encodeForHTMLAttribute( args.autocomplete )#"#( args.required ? ' required' : '' )#>
		<button class="btn btn-outline-secondary"
				type="button"
				@click="showPassword = !showPassword"
				:aria-label="showPassword ? 'Hide password' : 'Show password'">
			<i class="ph-duotone"
			   :class="showPassword ? 'ph-eye-slash' : 'ph-eye'"
			   aria-hidden="true"></i>
		</button>
		<bx:if len( localErrorMessage )>
			<div class="invalid-feedback">#encodeForHTML( localErrorMessage )#</div>
		</bx:if>
	</div>

	<div class="password-strength" x-show="password.length > 0" x-cloak>
		<div class="password-strength-bars" role="meter" :aria-valuenow="score" aria-valuemin="0" aria-valuemax="4">
			<div class="password-strength-bar" :class="score >= 1 ? 'active-' + score : ''"></div>
			<div class="password-strength-bar" :class="score >= 2 ? 'active-' + score : ''"></div>
			<div class="password-strength-bar" :class="score >= 3 ? 'active-' + score : ''"></div>
			<div class="password-strength-bar" :class="score >= 4 ? 'active-' + score : ''"></div>
		</div>
		<span class="password-strength-label" :class="labelClass" x-text="label"></span>
	</div>

	<div class="password-requirements mt-2" x-show="password.length > 0" x-cloak>
		<div class="password-requirement" :class="{ met: requirements.length }">
			<i class="ph-duotone req-icon" :class="requirements.length ? 'ph-check-circle' : 'ph-circle'" aria-hidden="true"></i>
			At least 8 characters
		</div>
		<div class="password-requirement" :class="{ met: requirements.uppercase }">
			<i class="ph-duotone req-icon" :class="requirements.uppercase ? 'ph-check-circle' : 'ph-circle'" aria-hidden="true"></i>
			Uppercase letter
		</div>
		<div class="password-requirement" :class="{ met: requirements.lowercase }">
			<i class="ph-duotone req-icon" :class="requirements.lowercase ? 'ph-check-circle' : 'ph-circle'" aria-hidden="true"></i>
			Lowercase letter
		</div>
		<div class="password-requirement" :class="{ met: requirements.number }">
			<i class="ph-duotone req-icon" :class="requirements.number ? 'ph-check-circle' : 'ph-circle'" aria-hidden="true"></i>
			Number
		</div>
		<div class="password-requirement" :class="{ met: requirements.special }">
			<i class="ph-duotone req-icon" :class="requirements.special ? 'ph-check-circle' : 'ph-circle'" aria-hidden="true"></i>
			Special character
		</div>
	</div>
</div>
</bx:output>