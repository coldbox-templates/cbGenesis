<!--- Main Navigation Sidebar Component
    Renders the fixed cb-sidebar with brand logo, nav sections, and user footer.
    Alpine detects the active link from window.location.pathname (client-side).

    Usage (from Admin layout):
        #view( "_components/app/sidebar" )#

    Reads from prc (populated by protected handlers):
        prc.authUser.initials — user avatar letter
        prc.authUser.name     — display name
        prc.authUser.role     — role label --->
<bx:output>
<aside
	class="cb-sidebar"
	id="cb-sidebar"
    :class="{ 'cb-sidebar-collapsed': $store.sidebar.collapsed,
                'cb-sidebar-open':       $store.sidebar.open }"
    aria-label="Main navigation">

    <!--- ── Brand ──────────────────────────────────────────── --->
    <div class="cb-sidebar-header" id="cb-sidebar-header">
        #view( "_components/app/sidebar-brand" )#
    </div>

    <!--- ── Navigation ─────────────────────────────────────── --->
    <!--- Alpine x-data tracks the current path so nav items can be marked active
        without a round-trip to the server. Add :class="isActive('/path')" to
        each anchor for automatic highlighting. --->
    <nav
		class="cb-sidebar-nav"
		id="cb-sidebar-nav"
        x-data="{ path: window.location.pathname }"
        aria-label="Main navigation">

        <!--- Main Group --->
        <div class="cb-sidebar-nav-section">
            <ul class="cb-sidebar-nav-list">
                <li>
                    <a href="#event.route( "dashboard" )#"
                       class="cb-sidebar-nav-item"
                        @click="$store.sidebar.close()"
                       :class="path === '/' || #event.routeIs( "dashboard" )# ? 'active' : ''"
                       title="Dashboard"
					>
                        <i class="ph-duotone ph-house cb-sidebar-nav-icon" aria-hidden="true"></i>
                        <span class="cb-sidebar-nav-text">Dashboard</span>
                    </a>
                </li>
            </ul>
        </div>

		<!--- Access Group --->
        <bx:if prc.authUser.hasPermission( "users:read,users:admin,roles:read,roles:admin,permissions:read,permissions:admin" )>
        <div class="cb-sidebar-nav-section">
            <span class="cb-sidebar-nav-label">Access</span>
            <ul class="cb-sidebar-nav-list">
                <bx:if prc.authUser.hasPermission( "users:read,users:admin" )>
                <li>
                    <a href="#event.route( "users" )#"
                       class="cb-sidebar-nav-item"
                        @click="$store.sidebar.close()"
                       :class="#event.routeIs( "users" )# ? 'active' : ''"
                       title="Users">
                        <i class="ph-duotone ph-users cb-sidebar-nav-icon" aria-hidden="true"></i>
                        <span class="cb-sidebar-nav-text">Users</span>
                    </a>
                </li>
                </bx:if>
                <bx:if prc.authUser.hasPermission( "roles:read,roles:admin" )>
                <li>
                    <a href="#event.route( "roles" )#"
                       class="cb-sidebar-nav-item"
                        @click="$store.sidebar.close()"
                       :class="#event.routeIs( "roles" )# ? 'active' : ''"
                       title="Roles">
                        <i class="ph-duotone ph-identification-badge cb-sidebar-nav-icon" aria-hidden="true"></i>
                        <span class="cb-sidebar-nav-text">Roles</span>
                    </a>
                </li>
                </bx:if>
                <bx:if prc.authUser.hasPermission( "permissions:read,permissions:admin" )>
                <li>
                    <a href="#event.route( "permissions" )#"
                       class="cb-sidebar-nav-item"
                        @click="$store.sidebar.close()"
                       :class="#event.routeIs( "permissions" )# ? 'active' : ''"
                       title="Permissions">
                        <i class="ph-duotone ph-key cb-sidebar-nav-icon" aria-hidden="true"></i>
                        <span class="cb-sidebar-nav-text">Permissions</span>
                    </a>
                </li>
                </bx:if>
            </ul>
        </div>
        </bx:if>

		<!--- System Group --->
		<bx:if prc.authUser.hasPermission( "settings:read,settings:admin" )>
		<div class="cb-sidebar-nav-section">
			<span class="cb-sidebar-nav-label">System</span>
            <ul class="cb-sidebar-nav-list">
                <li x-data="{ expanded: #event.routeIs( "settings" )# || #event.routeIs( "settings/registry" )# }">
                    <div class="cb-sidebar-nav-item-row">
                        <a href="#event.route( "settings" )#"
                           class="cb-sidebar-nav-item"
                            @click="$store.sidebar.close()"
                           :class="#event.routeIs( "settings" )# || #event.routeIs( "settings/registry" )# ? 'active' : ''"
                           title="Settings">
                            <i class="ph-duotone ph-gear cb-sidebar-nav-icon" aria-hidden="true"></i>
                            <span class="cb-sidebar-nav-text">Settings</span>
                        </a>
                        <button type="button"
                                class="cb-sidebar-nav-submenu-toggle"
                                @click="expanded = !expanded"
                                :aria-expanded="expanded.toString()"
                                aria-controls="settings-submenu"
                                aria-label="Toggle Settings submenu">
                            <i class="ph-duotone" :class="expanded ? 'ph-caret-up' : 'ph-caret-down'" aria-hidden="true"></i>
                        </button>
                    </div>
                    <ul id="settings-submenu" class="cb-sidebar-nav-submenu" x-show="expanded" x-cloak>
                        <li><a href="#event.route( "settings" )#" class="cb-sidebar-nav-subitem" :class="#event.routeIs( "settings" )# ? 'active' : ''"><i class="ph-duotone ph-sliders-horizontal" aria-hidden="true"></i><span>Manage</span></a></li>
                        <li><a href="#event.route( "settings/registry" )#" class="cb-sidebar-nav-subitem" :class="#event.routeIs( "settings/registry" )# ? 'active' : ''"><i class="ph-duotone ph-list-dashes" aria-hidden="true"></i><span>Registry</span></a></li>
                    </ul>
                </li>
            </ul>
		</div>
		</bx:if>

    </nav>
    <!--- ── /Navigation ─────────────────────────────────────── --->

    <!--- ── User footer ─────────────────────────────────────── --->
    <!--- Sidebar has overflow:hidden for the collapse transition, so Bootstrap
        dropdowns clip here. Use a link to a dedicated profile page instead. --->
    #view( "_components/app/sidebar-footer" )#

</aside>
</bx:output>
