<!--- Admin Header / Topbar Component
    Renders the sticky top bar: sidebar toggle, breadcrumb, theme toggle,
    notifications, and user dropdown.

    Usage (from Admin layout, inside .main-wrapper):
        #view( "_components/app/topbar" )#

    Reads from prc (populated by protected handlers):
        prc.title               — page title shown in breadcrumb (default: "Dashboard")
        prc.authUser.initials   — avatar letter in user button
        prc.authUser.name       — display name in dropdown
        prc.authUser.email      — email shown below name in dropdown --->  
<bx:output>
<header class="topbar" id="topbar">

    <!--- ── Left: sidebar toggle + breadcrumb ──────────────── --->  
    <div class="topbar-left" id="topbar-left">
        <button class="topbar-toggle"
                @click="$store.sidebar.toggle()"
                :aria-label="$store.sidebar.collapsed ? 'Expand sidebar' : 'Collapse sidebar'"
                :title="$store.sidebar.collapsed ? 'Expand sidebar' : 'Collapse sidebar'">
            <i class="ph-duotone ph-sidebar" aria-hidden="true"></i>
        </button>

		<!--- Breadcrumbs --->  
        #view( "_components/app/topbar-breadcrumbs" )#
    </div>

    <!--- ── Right: action buttons + user dropdown ───────────── --->  
    <!--- Using <ul>/<li> so sub-components (notificationBell etc.) can each
        return a <li> and slot in without breaking the flex layout. --->  
    <ul class="topbar-right" id="topbar-right">

        <!--- Theme toggle --->  
        <li>
            <button class="topbar-btn"
                    x-cloak
                    @click="$store.theme.toggle()"
                    :aria-label="$store.theme.mode === 'dark' ? 'Switch to light mode' : 'Switch to dark mode'"
                    :title="$store.theme.mode === 'dark' ? 'Switch to light mode' : 'Switch to dark mode'">
                <i class="ph-duotone ph-sun" x-show="$store.theme.mode === 'dark'" aria-hidden="true"></i>
                <i class="ph-duotone ph-moon" x-show="$store.theme.mode === 'light'" aria-hidden="true"></i>
            </button>
        </li>

        <!--- Vertical divider --->  
        <li class="topbar-divider-item" role="separator" aria-hidden="true">
            <span class="topbar-divider"></span>
        </li>

        <!--- User dropdown --->  
        <li>
            <div class="dropdown">

				<!--- User button --->  
                <button class="topbar-user-btn"
                        id="topbarUserMenu"
                        data-bs-toggle="dropdown"
                        aria-expanded="false">

                    <span class="topbar-user-avatar">
                        #( prc.authUser.getInitials() ?: "LF" )#
                    </span>

                    <i class="ph-duotone ph-caret-down topbar-user-chevron" aria-hidden="true"></i>
                </button>

				<!--- User dropdown menu --->  
                <ul class="dropdown-menu dropdown-menu-end"
                    aria-labelledby="topbarUserMenu">

					<!--- Preview User Info --->  
                    <li>
                        <span class="dropdown-header">
                            #( prc.authUser.getEmail() ?: "admin@example.com" )#
                        </span>
                    </li>

                    <li><hr class="dropdown-divider"></li>

					<!--- Profile Link --->  
                    <li>
                        <a class="dropdown-item" href="#event.route( "profile" )#">
                            <i class="ph-duotone ph-user" aria-hidden="true"></i>
                            Profile
                        </a>
                    </li>

					<li><hr class="dropdown-divider"></li>

					<!--- Logout Link --->  
					<li>
                        <form method="POST" action="#event.route( "logout" )#" style="display:contents">
                            <button type="submit" class="dropdown-item text-danger">
                                <i class="ph-duotone ph-sign-out" aria-hidden="true"></i>
                                Sign out
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        </li>

    </ul>
</header>
</bx:output>
