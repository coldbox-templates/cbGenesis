<!--- Top Bar Breadcrumbs Component
	This component renders the breadcrumb navigation in the top bar of the application.

	Usage (from within the top bar component):
			#view( "_components/app/topbar-breadcrumbs" )# --->
<bx:output>
<nav aria-label="Breadcrumb">
	<ol class="cb-topbar-breadcrumb">

		<li class="cb-topbar-breadcrumb-item">
			<a href="#event.route( "dashboard" )#">
				Dashboard
			</a>
		</li>
	</ol>
</nav>
</bx:output>