<!--- Sidebar Brand Component
    App-specific cb-sidebar brand wrapper. Uses the reusable UI logo primitive and
    owns the cb-sidebar link/name behavior.

    Usage:
		#view( "_components/app/sidebar-brand" )#

    Args:
        href    : string — brand link target (default: "/dashboard")
        variant : string — logo variant passed to ui/logo (default: "compact") --->
<bx:param name="args.href" default="/dashboard"/>
<bx:param name="args.variant" default="compact"/>

<bx:output>
<a
	href="#encodeForHTMLAttribute( args.href )#"
	class="cb-sidebar-brand"
	aria-label="#encodeForHTMLAttribute( prc.settings.cbAppname )# dashboard"
>
	#view(
		view: "_components/ui/logo",
		args: { variant: args.variant, classes: "cb-sidebar-brand-logo" }
	)#
	<span class="cb-sidebar-brand-name">#encodeForHTML( prc.settings.cbAppname )#</span>
</a>
</bx:output>