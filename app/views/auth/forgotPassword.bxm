<bx:output>
<div>

    <div class="text-center mb-4">
        <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3"
             style="width:56px;height:56px;background:var(--bl-gradient-soft);">
            <i class="ph-duotone ph-key" style="font-size:1.5rem;color:var(--bl-cyan-dark);" aria-hidden="true"></i>
        </div>
        <h1 class="auth-heading">Forgot your password?</h1>
        <p class="auth-subheading">Enter your email and we'll send you a reset link</p>
    </div>

    <!--- Success state: hide form, show confirmation --->
    <bx:if prc.keyExists( 'emailSent' ) && prc.emailSent>

        #view( view: "_partials/messagebox", args: {
            type       : "success",
            title      : "Check your inbox",
            message    : prc.success,
            dismissible: false
        } )#

        <div class="mt-4 text-center">
            <p style="font-size:0.875rem;color:var(--app-text-muted);">
                Didn't receive an email? Check your spam folder or
            </p>
            <form method="post" action="#event.buildLink( 'auth/forgotPassword' )#">
                <input type="hidden" name="email"
                       value="#encodeForHTMLAttribute( rc.email ?: '' )#">
                <input type="hidden" name="_token" value="#csrfToken()#">
                <button type="submit" class="btn btn-outline-secondary btn-sm">
                    Resend reset link
                </button>
            </form>
        </div>

    <bx:else>

        <!--- Inline error --->
        #view( view: "_partials/messagebox", args: { type: "error", message: prc.error ?: "", dismissible: false } )#

        <form method="post"
              action="#event.buildLink( 'auth/forgotPassword' )#"
              x-data="authForm"
              @submit="onSubmit"
              novalidate>

            <div class="mb-4">
                <label for="email" class="form-label">Email address</label>
                <input type="email"
                       id="email"
                       name="email"
                       class="form-control"
                       value="#encodeForHTMLAttribute( rc.email ?: '' )#"
                       autocomplete="email"
                       placeholder="you@example.com"
                       required>
            </div>

            <input type="hidden" name="_token" value="#csrfToken()#">

            <button type="submit"
                    class="btn btn-primary w-100 mb-3"
                    :disabled="loading">
                <span x-show="!loading">Send reset link</span>
                <span x-show="loading" x-cloak>
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                    Sending…
                </span>
            </button>

        </form>

    </bx:if>

    <p class="text-center mb-0 mt-3" style="font-size:0.9rem;color:var(--app-text-muted);">
        <a href="#event.buildLink( 'auth/login' )#" class="auth-link">
            <i class="ph-duotone ph-arrow-left me-1" aria-hidden="true"></i>
            Back to sign in
        </a>
    </p>

</div>
</bx:output>
