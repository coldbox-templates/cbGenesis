<bx:output>
<div x-data="forgetPasswordForm">

	<!--- Title --->
    <div class="text-center mb-4">
        <h1 class="auth-heading">Forgot your password?</h1>
        <p class="auth-subheading">Enter your email and we'll send you a reset link</p>
    </div>

	<!--- Flash Messages--->
	<bx:if flash.exists( "messages" )>
		#view(
			view = "_components/ui/messagebox",
			args = {
				type       : flash.get( "messages" ).type ?: "info",
				message    : flash.get( "messages" ).message ?: "",
				dismissible: true,
				classes    : "mb-4"
			}
		)#
	</bx:if>

	<form
		method="post"
        action="#event.buildLink( "auth/forgotPassword" )#"
        @submit="onSubmit"
        novalidate
	>

        <!--- CSRF token --->
        #csrfField()#

		<!--- Email Address --->
		<div class="mb-4">
			<label for="email" class="form-label">Email address</label>
			<input
				type="email"
				id="email"
				name="email"
				class="form-control"
				x-model="email"
				placeholder="you@example.com"
				required
				autofocus
			>
		</div>

		<!--- Submit Button --->
		<button
			type="submit"
			class="btn btn-primary w-100 mb-3"
			:disabled="loading || !canSubmit"
		>
			<span x-show="!loading">Send reset link</span>
			<span x-show="loading" x-cloak>
				<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
				Sending…
			</span>
		</button>

	</form>

	<!--- Back to sign in link --->
    <p class="text-center mb-0 mt-3">
        <a href="#event.buildLink( "auth/login" )#" class="auth-link">
            <i class="ph-duotone ph-arrow-left me-1" aria-hidden="true"></i>
            Back to sign in
        </a>
    </p>

</div>
</bx:output>
