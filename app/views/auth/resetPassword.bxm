<bx:output>
<div x-data="authForm">

    <div class="text-center mb-4">
        <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3"
             style="width:56px;height:56px;background:var(--bl-gradient-soft);">
            <i class="ph-duotone ph-lock-key-open" style="font-size:1.5rem;color:var(--bl-cyan-dark);" aria-hidden="true"></i>
        </div>
        <h1 class="auth-heading">Set new password</h1>
        <p class="auth-subheading">Choose a strong password for your account</p>
    </div>

    <!--- General error (e.g. CSRF expiry) --->  
    #view(
	view = "_components/ui/messagebox",
	args = {
		type       : "error",
		message    : prc.error ?: "",
		dismissible: false
	}
)#

    <!--- Server-side field validation errors --->  
    <bx:if prc.keyExists( "errors" ) && !structIsEmpty( prc.errors )>
        #view(
	view = "_components/ui/messagebox",
	args = {
		type       : "error",
		message    : "Please fix the errors below and try again.",
		dismissible: false
	}
)#
    </bx:if>

    <form method="post"
          action="#event.buildLink( "auth/resetPassword" )#"
          @submit="onSubmit"
          novalidate>

        <!--- Reset token (from email link) + CSRF token --->  
        <input type="hidden" name="token"  value="#encodeForHTMLAttribute( prc.token )#">
        <input type="hidden" name="_token" value="#csrfToken()#">

        #view(
	view = "_components/ui/passwordMeter",
	args = {
		id          : "password",
		name        : "password",
		label       : "New password",
		classes     : "mb-3",
		labelClass  : "form-label",
		inputClasses: "form-control",
		errorMessage: ( prc.keyExists( "errors" ) && structKeyExists( prc.errors, "password" ) )
			? prc.errors.password
			: ""
	}
)#

        <!--- Confirm password --->  
        <div class="mb-4">
            <label for="passwordConfirm" class="form-label">Confirm new password</label>
            <div class="input-group">
                <input :type="showConfirm ? 'text' : 'password'"
                       id="passwordConfirm"
                       name="passwordConfirm"
                       class="form-control#(
	( prc.keyExists( "errors" ) && structKeyExists( prc.errors, "passwordConfirm" ) ) ? " is-invalid" : ""
)#"
                       x-model="confirmValue"
                       @input="checkConfirm"
                       @blur="checkConfirm"
                       @password-changed.window="passwordRef = $event.detail.value; checkConfirm()"
                       placeholder="••••••••"
                       autocomplete="new-password">
                <button class="btn btn-outline-secondary"
                        type="button"
                        @click="showConfirm = !showConfirm"
                        :aria-label="showConfirm ? 'Hide password' : 'Show password'">
                    <i class="ph-duotone"
                       :class="showConfirm ? 'ph-eye-slash' : 'ph-eye'"
                       aria-hidden="true"></i>
                </button>
                <bx:if prc.keyExists( "errors" ) && structKeyExists( prc.errors, "passwordConfirm" )>
                    <div class="invalid-feedback">#encodeForHTML( prc.errors.passwordConfirm )#</div>
                </bx:if>
            </div>
            <div class="invalid-feedback d-block"
                 x-show="confirmError"
                 x-cloak
                 x-text="confirmError"
                 role="alert"></div>
        </div>

        <!--- Submit --->  
        <button type="submit"
                class="btn btn-primary w-100"
                :disabled="loading">
            <span x-show="!loading">Reset password</span>
            <span x-show="loading" x-cloak>
                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                Resetting…
            </span>
        </button>

    </form>

    <p class="text-center mb-0 mt-3" style="font-size:0.9rem;color:var(--app-text-muted);">
        <a href="#event.buildLink( "auth/login" )#" class="auth-link">
            <i class="ph-duotone ph-arrow-left me-1" aria-hidden="true"></i>
            Back to sign in
        </a>
    </p>

</div>
</bx:output>
