<bx:output>
<div x-data="passwordResetForm">

	<!--- Form Title --->
    <div class="text-center mb-4">
        <h1 class="cb-auth-heading">Reset Password</h1>
        <p class="cb-auth-subheading">Choose a strong password for your account</p>
    </div>

   <!--- Flash Messages --->
	<bx:if flash.exists( "messages" )>
		#view(
            view = "_components/ui/messagebox",
			args = {
				type       : flash.get( "messages" ).type ?: "info",
				message    : flash.get( "messages" ).message ?: "",
				dismissible: true,
				classes    : "mb-4"
			}
		)#
	</bx:if>

    <form
		method="post"
        action="#event.buildLink( "reset-password" )#"
        @submit="onSubmit"
		@password-changed.window="setPassword( $event.detail.value )"
        novalidate
	>

		<!--- CSRF token --->
        #csrfField()#

        <!--- Reset token (from email link) + CSRF token --->
        <input type="hidden" name="token"  value="#encodeForHTMLAttribute( prc.tokenResults.token )#">

        <!--- Password Meter --->
        #view(
			view = "_components/ui/passwordMeter",
			args = {
				id          : "password",
				name        : "password",
				label       : "Password",
				classes     : "mb-3",
				labelClass  : "form-label",
				inputClasses: "form-control",
                errorMessage: ( prc.keyExists( "validationErrors" ) && structKeyExists( prc.validationErrors, "password" ) )
                    ? prc.validationErrors.password
					: ""
			}
		)#

        <!--- Confirm password --->
        <div class="mb-4">
            <label for="passwordConfirm" class="form-label">Confirm password</label>
            <div class="input-group">
                <input
					:type="showConfirm ? 'text' : 'password'"
					id="passwordConfirm"
					name="passwordConfirm"
					x-model="confirmValue"
					required
					class="form-control"
					@input="checkConfirm"
					@blur="checkConfirm"
					placeholder="••••••••"
					autocomplete="new-password"
				>
                <button
					class="btn btn-outline-secondary"
					type="button"
					@click="showConfirm = !showConfirm"
					:aria-label="showConfirm ? 'Hide password' : 'Show password'">
                    <i class="ph-duotone"
                       :class="showConfirm ? 'ph-eye-slash' : 'ph-eye'"
                       aria-hidden="true"></i>
                </button>
            </div>

            <div class="invalid-feedback d-block"
                 x-show="confirmError"
                 x-cloak
                 x-text="confirmError"
                 role="alert"></div>
        </div>

        <!--- Submit --->
        <button
			type="submit"
            class="btn btn-primary w-100"
            :disabled="loading || !canSubmit"
		>
            <span x-show="!loading">Reset password</span>
            <span x-show="loading" x-cloak>
                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                Resetting…
            </span>
        </button>

    </form>

    <p class="text-center mb-0 mt-3" style="font-size:0.9rem;color:var(--app-text-muted);">
        <a href="#event.buildLink( "login" )#" class="cb-auth-link">
            <i class="ph-duotone ph-arrow-left me-1" aria-hidden="true"></i>
            Back to sign in
        </a>
    </p>

</div>
</bx:output>
