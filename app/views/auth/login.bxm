<bx:output>
<div x-data="authForm">

	<!--- Title --->
    <div class="text-center mb-4">
        <h1 class="cb-auth-heading">Welcome back</h1>
        <p class="cb-auth-subheading">Sign in to your account to continue</p>
    </div>

	<!--- Flash Messages--->
	<bx:if flash.exists( "messages" )>
		#view(
			view = "_components/ui/messagebox",
			args = {
				type       : flash.get( "messages" ).type ?: "info",
				message    : flash.get( "messages" ).message ?: "",
				dismissible: true,
				classes    : "mb-4"
			}
		)#
	</bx:if>

    <form method="post"
          action="#event.buildLink( "auth/doLogin" )#"
          @submit="onSubmit"
          novalidate>

        <!--- CSRF token --->
        #csrfField()#

        <!--- Email --->
        <div class="mb-3">
            <label for="email" class="form-label">Email address</label>
            <input
				type="email"
				id="email"
				name="email"
				class="form-control"
                x-model="email"
				placeholder="you@cbGenesis.com"
				autocomplete="username webauthn"
				required
				autofocus
			>
        </div>

        <!--- Password --->
        <div class="mb-3">
			#view(
				view = "_components/auth/passwordInput",
				args = {
					id         : "password",
					name       : "password",
					model      : "password",
					classes    : "mb-3",
					label      : "Password",
					helperLink : prc.settings.cbAllowForgotPassword ? event.buildLink( "auth/forgotPassword" ) : "",
					helperText : prc.settings.cbAllowForgotPassword ? "Forgot password?" : "",
					placeholder: "••••••••"
				}
			)#
        </div>

        <!--- Remember Me --->
		<bx:if prc.settings.cbAllowRememberMe>
        <div class="mb-4 form-check">
            <input type="checkbox" class="form-check-input" id="rememberMe" name="rememberMe" value="1">
            <label class="form-check-label" for="rememberMe">Keep me signed in</label>
        </div>
		</bx:if>

        <!--- Submit --->
        <button
			type="submit"
            class="btn btn-primary w-100 mb-3"
            :disabled="loading || !canSubmit"
		>
            <span x-show="!loading">Sign in</span>
            <span x-show="loading" x-cloak>
                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                Signing in…
            </span>
        </button>

		<button
			type="button"
			class="btn btn-outline-secondary w-100 mb-3"
			@click="loginWithPasskey()"
			:disabled="loading || passkeyLoading"
		>
			<span x-show="!passkeyLoading"><i class="ph-duotone ph-fingerprint" aria-hidden="true"></i> Sign in with a passkey</span>
			<span x-show="passkeyLoading" x-cloak><span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Waiting for device...</span>
		</button>

    </form>

	<bx:if prc.settings.cbAllowRegistration>
    <p class="text-center mb-0">
        Don't have an account?
        <a href="#event.buildLink( "auth/register" )#" class="cb-auth-link">Create one</a>
    </p>
	</bx:if>

</div>
</bx:output>
