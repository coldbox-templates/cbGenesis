<bx:output>
<div
	x-data="registerForm"
	data-email-check-url="#encodeForHTMLAttribute( event.buildLink( "register/check-email" ) )#">

	<!--- Form Title --->
    <div class="text-center mb-4">
        <h1 class="cb-auth-heading">Create your account</h1>
        <p class="cb-auth-subheading">Join us today — it only takes a minute</p>
    </div>

    <!--- Flash Messages --->
	<bx:if flash.exists( "messages" )>
		#view(
			view = "_components/ui/messagebox",
			args = {
				type       : flash.get( "messages" ).type ?: "info",
				message    : flash.get( "messages" ).message ?: "",
				dismissible: true,
				classes    : "mb-4"
			}
		)#
	</bx:if>

    <form
		method="post"
        action="#event.buildLink( "register" )#"
        @submit="onSubmit"
    	@password-changed.window="setPassword( $event.detail.value )"
        novalidate
	>

		<!--- CSRF token --->
        #csrfField()#

        <!--- First + Last name --->
        <div class="row g-3 mb-3">
            <div class="col-6">
                <label for="firstName" class="form-label">First name</label>
                <input
					type="text"
                    id="firstName"
                    name="firstName"
                    x-model="firstName"
                    class="form-control#(
	( prc.keyExists( "validationErrors" ) && structKeyExists( prc.validationErrors, "firstName" ) ) ? " is-invalid" : ""
)#"
					value="#encodeForHTMLAttribute( rc.firstName ?: "" )#"
					autocomplete="given-name"
					placeholder="Jane"
					required
				>
            </div>

            <div class="col-6">
                <label for="lastName" class="form-label">Last name</label>
                <input
					type="text"
                    id="lastName"
                    name="lastName"
                    x-model="lastName"
					class="form-control"
					value="#encodeForHTMLAttribute( rc.lastName ?: "" )#"
					autocomplete="family-name"
					placeholder="Smith"
					required
				>
            </div>
        </div>

        <!--- Email --->
        <div class="mb-3">
            <label for="email" class="form-label">Email address</label>
            <input
				type="email"
				id="email"
				name="email"
				class="form-control"
				:class="emailClass"
				x-model="email"
				@input="emailChanged"
				@blur="checkEmailAvailability"
				value="#encodeForHTMLAttribute( rc.email ?: "" )#"
				autocomplete="email"
				placeholder="you@example.com"
				required
				>
			<div class="form-text" x-show="emailChecking" x-cloak>
				<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
				Checking email availability…
			</div>
			<div
				class="valid-feedback"
				x-show="emailAvailable"
				x-cloak
				role="status">
				<i class="ph-duotone ph-check-circle me-1" aria-hidden="true"></i>
				Email is available.
			</div>
			<div
				class="invalid-feedback"
				x-show="emailUnavailable"
				x-cloak
				role="alert">
				Email is already in use.
			</div>
			<div
				class="invalid-feedback"
				x-show="emailCheckError"
				x-cloak
				x-text="emailCheckError"
				role="alert"></div>
        </div>

		<!--- Password Meter --->
        #view(
			view = "_components/ui/passwordMeter",
			args = {
				id          : "password",
				name        : "password",
				label       : "Password",
				classes     : "mb-3",
				labelClass  : "form-label",
				inputClasses: "form-control",
                errorMessage: ( prc.keyExists( "validationErrors" ) && structKeyExists( prc.validationErrors, "password" ) )
                    ? prc.validationErrors.password.map( ( e ) => e.message ).toList( ", " )
					: ""
			}
		)#

        <!--- Confirm password --->
        <div class="mb-4">
            <label for="passwordConfirm" class="form-label">Confirm password</label>
            <div class="input-group">
                <input
					:type="showConfirm ? 'text' : 'password'"
					id="passwordConfirm"
					name="passwordConfirm"
					x-model="confirmValue"
					required
					class="form-control"
					@input="checkConfirm"
					@blur="checkConfirm"
					placeholder="••••••••"
					autocomplete="new-password"
				>
                <button
					class="btn btn-outline-secondary"
					type="button"
					@click="showConfirm = !showConfirm"
					:aria-label="showConfirm ? 'Hide password' : 'Show password'">
                    <i class="ph-duotone"
                       :class="showConfirm ? 'ph-eye-slash' : 'ph-eye'"
                       aria-hidden="true"></i>
                </button>
            </div>

            <div class="invalid-feedback d-block"
                 x-show="confirmError"
                 x-cloak
                 x-text="confirmError"
                 role="alert"></div>
        </div>

        <!--- Submit --->
        <button
			type="submit"
            class="btn btn-primary w-100 mb-3"
            :disabled="loading || !canSubmit"
		>
            <span x-show="!loading">Create account</span>
            <span x-show="loading" x-cloak>
                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                Creating account…
            </span>
        </button>

    </form>

    <p class="text-center mb-0">
        Already have an account?
        <a href="#event.buildLink( "login" )#" class="cb-auth-link">Sign in</a>
    </p>

</div>
</bx:output>
