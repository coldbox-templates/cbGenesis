<bx:output>
<div x-data="authForm">

    <div class="text-center mb-4">
        <h1 class="auth-heading">Create your account</h1>
        <p class="auth-subheading">Join us today — it only takes a minute</p>
    </div>

    <!--- General error (e.g. CSRF expiry) --->
    #view( view: "_components/ui/messagebox", args: { type: "error", message: prc.error ?: "", dismissible: false } )#

    <!--- Server-side field validation errors --->
    <bx:if prc.keyExists( 'errors' ) && !structIsEmpty( prc.errors )>
        #view( view: "_components/ui/messagebox", args: { type: "error", message: "Please fix the errors below and try again.", dismissible: false } )#
    </bx:if>

    <form method="post"
          action="#event.buildLink( 'auth/register' )#"
          @submit="onSubmit"
          novalidate>

        <!--- First + Last name --->
        <div class="row g-3 mb-3">
            <div class="col-6">
                <label for="firstName" class="form-label">First name</label>
                <input type="text"
                       id="firstName"
                       name="firstName"
                       class="form-control#( ( prc.keyExists( 'errors' ) && structKeyExists( prc.errors, 'firstName' ) ) ? ' is-invalid' : '' )#"
                       value="#encodeForHTMLAttribute( prc.keyExists( 'oldInput' ) ? ( prc.oldInput.firstName ?: '' ) : '' )#"
                       autocomplete="given-name"
                       placeholder="Jane"
                       required>
                <bx:if prc.keyExists( 'errors' ) && structKeyExists( prc.errors, 'firstName' )>
                    <div class="invalid-feedback">#encodeForHTML( prc.errors.firstName )#</div>
                </bx:if>
            </div>
            <div class="col-6">
                <label for="lastName" class="form-label">Last name</label>
                <input type="text"
                       id="lastName"
                       name="lastName"
                       class="form-control#( ( prc.keyExists( 'errors' ) && structKeyExists( prc.errors, 'lastName' ) ) ? ' is-invalid' : '' )#"
                       value="#encodeForHTMLAttribute( prc.keyExists( 'oldInput' ) ? ( prc.oldInput.lastName ?: '' ) : '' )#"
                       autocomplete="family-name"
                       placeholder="Smith"
                       required>
                <bx:if prc.keyExists( 'errors' ) && structKeyExists( prc.errors, 'lastName' )>
                    <div class="invalid-feedback">#encodeForHTML( prc.errors.lastName )#</div>
                </bx:if>
            </div>
        </div>

        <!--- Email --->
        <div class="mb-3">
            <label for="email" class="form-label">Email address</label>
            <input type="email"
                   id="email"
                   name="email"
                   class="form-control#( ( prc.keyExists( 'errors' ) && structKeyExists( prc.errors, 'email' ) ) ? ' is-invalid' : '' )#"
                   value="#encodeForHTMLAttribute( prc.keyExists( 'oldInput' ) ? ( prc.oldInput.email ?: '' ) : '' )#"
                   autocomplete="email"
                   placeholder="you@example.com"
                   required>
            <bx:if prc.keyExists( 'errors' ) && structKeyExists( prc.errors, 'email' )>
                <div class="invalid-feedback">#encodeForHTML( prc.errors.email )#</div>
            </bx:if>
        </div>

        #view( view: "_components/ui/passwordMeter", args: {
            id           : "password",
            name         : "password",
            label        : "Password",
            classes      : "mb-3",
            labelClass   : "form-label",
            inputClasses : "form-control",
            errorMessage : ( prc.keyExists( 'errors' ) && structKeyExists( prc.errors, 'password' ) ) ? prc.errors.password : ""
        } )#

        <!--- Confirm password --->
        <div class="mb-4">
            <label for="passwordConfirm" class="form-label">Confirm password</label>
            <div class="input-group">
                <input :type="showConfirm ? 'text' : 'password'"
                       id="passwordConfirm"
                       name="passwordConfirm"
                       class="form-control#( ( prc.keyExists( 'errors' ) && structKeyExists( prc.errors, 'passwordConfirm' ) ) ? ' is-invalid' : '' )#"
                       x-model="confirmValue"
                       @input="checkConfirm"
                       @blur="checkConfirm"
                       @password-changed.window="passwordRef = $event.detail.value; checkConfirm()"
                       placeholder="••••••••"
                       autocomplete="new-password">
                <button class="btn btn-outline-secondary"
                        type="button"
                        @click="showConfirm = !showConfirm"
                        :aria-label="showConfirm ? 'Hide password' : 'Show password'">
                    <i class="ph-duotone"
                       :class="showConfirm ? 'ph-eye-slash' : 'ph-eye'"
                       aria-hidden="true"></i>
                </button>
                <bx:if prc.keyExists( 'errors' ) && structKeyExists( prc.errors, 'passwordConfirm' )>
                    <div class="invalid-feedback">#encodeForHTML( prc.errors.passwordConfirm )#</div>
                </bx:if>
            </div>
            <div class="invalid-feedback d-block"
                 x-show="confirmError"
                 x-cloak
                 x-text="confirmError"
                 role="alert"></div>
        </div>

        <!--- CSRF token --->
        <input type="hidden" name="_token" value="#csrfToken()#">

        <!--- Submit --->
        <button type="submit"
                class="btn btn-primary w-100 mb-3"
                :disabled="loading">
            <span x-show="!loading">Create account</span>
            <span x-show="loading" x-cloak>
                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                Creating account…
            </span>
        </button>

    </form>

    <p class="text-center mb-0" style="font-size:0.9rem; color:var(--app-text-muted);">
        Already have an account?
        <a href="#event.buildLink( 'auth/login' )#" class="auth-link">Sign in</a>
    </p>

</div>
</bx:output>
