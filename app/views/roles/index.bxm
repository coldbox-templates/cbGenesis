<bx:output>
<div
	x-data='rolesForm(
		#forAttribute( prc.roles )#,
		#forAttribute( prc.permissionCatalog )#,
		"#csrfToken()#"
	)'>
	<div class="page-header admin-page-heading">
		<div>
			<p class="eyebrow">Security</p>
			<h2 class="page-title">Roles</h2>
			<p class="page-subtitle">Define role bundles and tune their exact permissions.</p>
		</div>
		<button
			type="button"
			class="btn btn-primary"
			@click="openCreate()"><i
			class="ph-duotone ph-plus"
			aria-hidden="true"></i>
			New
			Role</button>
	</div>

	<!--- Roles Layout --->
	<div class="roles-layout">
		<section class="content-card role-list-panel">

			<!--- Roles Header --->
			<div class="content-card-header">
				<h3 class="content-card-title">Roles</h3>
				<span class="count-pill" x-text="filteredCount"></span>
			</div>

			<!--- Roles Toolbar --->
			<div class="catalog-toolbar">
				<div class="admin-search wide">
					<i class="ph-duotone ph-magnifying-glass" aria-hidden="true"></i>
					<input x-model.debounce.150ms="query" type="search" placeholder="Filter roles..." aria-label="Filter roles">
				</div>
			</div>

			<!--- Role Listing --->
			<div class="role-list">
				<template x-for="role in filteredRoles" :key="role.roleId">
					<button
						type="button"
						class="role-list-item"
						:class="selectedRole?.roleId === role.roleId ? 'active' : ''"
						@click="selectRole( role )"
						>
						<strong x-text="role.role"></strong>
						<span x-text="role.usersCount + ' users · ' + role.permissions.length + ' permissions'"></span>
					</button>
				</template>
				<div
					class="empty-state"
					x-show="filteredRoles.length === 0"
					x-cloak
				>
					<i class="ph-duotone ph-magnifying-glass" aria-hidden="true"></i>
					<strong>No roles found</strong>
				</div>
			</div>
		</section>

		<!--- Role Details Section when Clicked --->
		<section
			class="content-card role-summary-panel"
			x-show="selectedRole"
			x-cloak
		>
			<div class="content-card-header matrix-heading">
				<!--- Role Header Section --->
				<div>
					<h3 class="content-card-title" x-text="selectedRole?.role"></h3>
					<p x-text="selectedRole?.description || 'No description provided'"></p>
				</div>
				<!--- Role Actions --->
				<div class="page-actions">
					<!--- Edit Role --->
					<button
						type="button"
						class="btn btn-light"
						@click="openEdit( selectedRole )"
					>
						<i class="ph-duotone ph-pencil-simple" aria-hidden="true"></i>
						Edit
					</button>
					<!--- Delete Role --->
					<button
						type="button"
						class="btn btn-light"
						@click="confirmDelete( selectedRole )"
					>
						<i class="ph-duotone ph-trash" aria-hidden="true"></i>
						Delete
					</button>
				</div>
			</div>

			<!--- Role Permissions --->
			<div class="role-detail-section role-permissions-section">
				<div class="role-section-header">
					<h4>Permissions</h4>
					<span class="count-pill" x-text="selectedRole?.permissions.length"></span>
				</div>
				<div class="chip-row">
					<template
						x-for="permission in ( selectedRole?.permissions || [] )"
						:key="permission.permissionId">
						<span class="chip chip-info" x-text="permission.permission"></span>
					</template>
				</div>
			</div>

			<!--- Assigned Users --->
			<div class="role-detail-section role-users-section">
				<div class="role-section-header role-users-header">
					<div>
						<h4>Assigned users</h4>
						<span x-text="filteredUsers.length + ' of ' + assignedUsers.length"></span>
					</div>
					<div class="admin-search role-users-search">
						<i class="ph-duotone ph-magnifying-glass" aria-hidden="true"></i>
						<input
							x-model.debounce.150ms="userQuery"
							type="search"
							placeholder="Filter users..."
							aria-label="Filter assigned users">
					</div>
				</div>

				<div class="role-users-loading" x-show="loadingUsers" x-cloak>
					#view( view: "_components/ui/progressbar", args: {
						label        : "Loading users...",
						ariaLabel    : "Loading assigned users",
						indeterminate: true,
						variant      : "cyan",
						size         : "sm"
					} )#
				</div>

				<!--- Role Users Error --->
				<div
					class="role-users-status role-users-error"
					x-show="usersError"
					x-text="usersError"
					x-cloak></div>

				<!--- Role Users --->
				<div
					class="role-users-list"
					x-show="!loadingUsers && !usersError"
					x-cloak>
					<template x-for="user in filteredUsers" :key="user.userId">
						<div class="role-user-row">
							<div>
								<strong x-text="user.firstName + ' ' + user.lastName"></strong>
								<span x-text="user.email"></span>
							</div>
							<button
								type="button"
								class="btn btn-light btn-sm"
								@click="removeUser( user )"
								:disabled="removingUserId === user.userId"
								:title="'Remove ' + ( user.firstName + ' ' + user.lastName )"
								:aria-label="'Remove ' + ( user.firstName + ' ' + user.lastName )">
								<i class="ph-duotone ph-user-minus" aria-hidden="true"></i>
								<span x-text="removingUserId === user.userId ? 'Removing...' : 'Remove'"></span>
							</button>
						</div>
					</template>
					<div
						class="role-users-status"
						x-show="filteredUsers.length === 0">
						<span x-text="assignedUsers.length ? 'No users match this filter.' : 'No users are assigned to this role.'"></span>
					</div>
				</div>
			</div>
		</section>

		<!--- User Edit Drawer --->
		#view(
			view: "_components/ui/drawer",
			args: {
				id: "role-editor-drawer",
				title: "Role",
				openExpression: "drawerOpen",
				closeExpression: "closeDrawer()",
				contentView: "roles/editForm"
			}
		)#

		<!--- Cancel Delete Confirm --->
		#view( view: "_components/ui/modal", args: {
			id             : "role-delete-modal",
			title          : "Delete Role",
			openExpression : "confirmDeleteOpen",
			closeExpression: "cancelDelete()",
			contentView    : "roles/deleteConfirm"
		} )#
	</div>
</div>
</bx:output>
