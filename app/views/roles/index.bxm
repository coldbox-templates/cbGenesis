<bx:output>
<div class="page-header admin-page-heading">
	<div>
		<p class="eyebrow">Security</p>
		<h2 class="page-title">Role Management</h2>
		<p class="page-subtitle">Define role bundles, then tune exact permissions in the matrix.</p>
	</div>
	<button class="btn btn-primary"><i class="ph-duotone ph-plus"></i> New Role</button>
</div>

<div class="roles-layout" x-data="{ selected: 1 }">
	<section class="content-card role-list-panel">
		<div class="content-card-header"><h3 class="content-card-title">Roles</h3><span class="count-pill">#arrayLen( prc.roles )#</span></div>
		<div class="role-list">
			<bx:loop array="#prc.roles#" item="role" index="roleIndex">
				<button type="button" class="role-list-item" :class="selected === #roleIndex# ? 'active' : ''" @click="selected = #roleIndex#">
					<strong>#encodeForHTML( role.role )#</strong>
					<span>#encodeForHTML( role.users )# users &middot; #arrayLen( role.permissions )# permissions</span>
					<bx:if condition = "#role.system#"><em>System</em></bx:if>
				</button>
			</bx:loop>
		</div>
	</section>

	<section class="content-card permission-matrix-panel">
		<bx:loop array="#prc.roles#" item="role" index="roleIndex">
			<div x-show="selected === #roleIndex#" <bx:if condition = "#roleIndex != 1#">x-cloak</bx:if>>
				<div class="content-card-header matrix-heading">
					<div><h3 class="content-card-title">#encodeForHTML( role.role )# &mdash; Permission Matrix</h3><p>#encodeForHTML( role.description )#</p></div>
					<bx:if condition = "#role.system#"><span class="chip chip-success">System Role</span></bx:if>
				</div>
				<div class="responsive-table-wrap">
					<table class="admin-table permission-matrix">
						<thead><tr><th>Module</th><bx:loop array="#prc.permissionActions#" item="action"><th>#encodeForHTML( action )#</th></bx:loop></tr></thead>
						<tbody>
							<bx:loop array="#prc.permissionModules#" item="moduleName">
								<tr>
									<td><strong>#encodeForHTML( moduleName )#</strong></td>
									<bx:loop array="#prc.permissionActions#" item="action">
										<td><label class="matrix-check"><input type="checkbox" <bx:if condition = "#role.permissions.findNoCase( moduleName & ":" & action ) ||
	role.permissions.findNoCase( moduleName & ":*" )#">checked</bx:if> <bx:if condition = "#role.system#">disabled</bx:if>><span></span></label></td>
									</bx:loop>
								</tr>
							</bx:loop>
						</tbody>
					</table>
				</div>
			</div>
		</bx:loop>
	</section>
</div>
</bx:output>
