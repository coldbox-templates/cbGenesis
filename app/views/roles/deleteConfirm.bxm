<bx:output>
<div class="ui-modal__body delete-confirmation">
	<i class="ph-duotone ph-warning-circle" aria-hidden="true"></i>
	<p>
		Are you sure you want to delete
		<strong x-text="selectedRole?.role"></strong>?
		Users will be unassigned from this role. This action cannot be undone.
	</p>
	<small x-show="error" x-text="error" class="delete-confirmation__error"></small>
</div>

<div class="ui-modal__footer">
	<button
		type="button"
		class="btn btn-secondary"
		@click="cancelDelete()"
		:disabled="deleting">Cancel</button>
	<button
		type="button"
		class="btn btn-danger"
		@click.prevent="deleteRole()"
		:disabled="deleting">
		<i class="ph-duotone ph-trash" aria-hidden="true"></i>
		<span x-text="deleting ? 'Deleting...' : 'Delete Role'"></span>
	</button>
</div>
</bx:output>
