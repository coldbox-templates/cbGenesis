<bx:output>
<form
	class="cb-role-editor"
	@submit="saveRole( $event )"
>
	<!--- Form Body --->
	<div class="cb-drawer-form-body">
		<!--- Role Name --->
		<div class="cb-form-field">
			<label for="role-name">Role name</label>
			<input id="role-name" type="text" x-model.trim="form.role" required maxlength="255" autocomplete="off">
		</div>
		<!--- Role Description --->
		<div class="cb-form-field">
			<label for="role-description">Description</label>
			<textarea id="role-description" rows="3" x-model.trim="form.description"></textarea>
		</div>
		<!--- Permissions Chooser --->
		<div class="cb-drawer-section-heading">
			<div>
				<strong>Permissions</strong><small x-text="form.permissionIds.length + ' selected'"></small>
			</div>
		</div>
		<div class="cb-role-permission-groups">
			<template x-for="group in permissionGroups" :key="group.key">
				<section class="cb-role-permission-group">
					<!--- Group Label --->
					<button
						type="button"
						title="Check/Uncheck all permissions in this group"
						class="cb-role-permission-group__toggle"
						@click="togglePermissionGroup( group )"
						x-text="group.label"></button>

					<!--- Permissions in the group --->
					<template x-for="permission in group.permissions" :key="permission.permissionId">
						<label class="cb-permission-choice">
							<input
								type="checkbox"
								:checked="hasPermission( permission.permissionId )"
								@change="togglePermission( permission.permissionId )">
							<span>
								<strong x-text="permission.slug || permission.permission"></strong>
								<small x-text="permission.description || 'No description provided'"></small>
							</span>
						</label>
					</template>
				</section>
			</template>
		</div>

		<!--- Form Errors Show Up Here --->
		<p class="form-error" x-show="error" x-text="error" x-cloak></p>
	</div>

	<!--- Form Actions on Drawer --->
	<div class="cb-drawer-form-actions">
		<button
			type="button"
			class="btn btn-light"
			@click="closeDrawer()">Cancel</button>
		<button
			type="submit"
			class="btn btn-primary"
			:disabled="submitting">
			<i class="ph-duotone ph-floppy-disk" aria-hidden="true"></i>
			<span x-text="submitting ? 'Saving...' : 'Save role'"></span>
		</button>
	</div>
</form>
</bx:output>
