<!---
    Logo Partial
    Renders the application brand mark (inline SVG gradient) and optional name.
    Replace the SVG in this file with your own logo image or mark.

    Usage:
        #view( "_partials/logo" )#
        #view( view: "_partials/logo", args: { variant: "compact" } )#
        #view( view: "_partials/logo", args: { variant: "icon-only", size: 28 } )#

    Args:
        variant  : full | compact | icon-only   (default: "full")
                   full      — mark (40px) + app name at 1.0625rem
                   compact   — mark (32px) + app name at 0.9375rem
                   icon-only — mark only, no name text
        size     : number — override mark pixel size (default: derived from variant)
        classes  : string — extra CSS classes on root <span> (default: "")
--->
<bx:param name="args.variant" default="full" />
<bx:param name="args.classes" default="" />

<bx:set localSizes = { "full": 40, "compact": 32, "icon-only": 28 } />
<bx:set localSize  = structKeyExists( localSizes, args.variant ) ? localSizes[ args.variant ] : 40 />
<bx:param name="args.size" default="#localSize#" />

<!--- Unique gradient ID prevents SVG <defs> conflicts when multiple logos appear on the same page --->
<bx:set localGradId = "blGrad_" & replace( createUUID(), "-", "", "all" ) />

<bx:output>
<span class="brand-logo brand-logo--#encodeForHTMLAttribute( args.variant )##( len( args.classes ) ? ' ' & args.classes : '' )#"
      aria-label="#encodeForHTMLAttribute( getSetting( 'appName' ) )#">

    <svg width="#encodeForHTMLAttribute( args.size )#"
         height="#encodeForHTMLAttribute( args.size )#"
         viewBox="0 0 40 40"
         fill="none"
         xmlns="http://www.w3.org/2000/svg"
         aria-hidden="true"
         focusable="false"
         class="brand-logo__mark">
        <rect width="40" height="40" rx="9" fill="url(###encodeForHTMLAttribute( localGradId )#)"/>
        <path d="M11 20h18M20 11v18" stroke="white" stroke-width="2.8" stroke-linecap="round"/>
        <defs>
            <linearGradient id="#encodeForHTMLAttribute( localGradId )#"
                            x1="0" y1="0" x2="40" y2="40"
                            gradientUnits="userSpaceOnUse">
                <stop offset="0%"   stop-color="##00D4F0"/>
                <stop offset="100%" stop-color="##2563EB"/>
            </linearGradient>
        </defs>
    </svg>

    <bx:if args.variant != "icon-only">
        <span class="brand-logo__name">#encodeForHTML( getSetting( "appName" ) )#</span>
    </bx:if>

</span>
</bx:output>
