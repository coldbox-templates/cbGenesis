<bx:output>

<div class="cb-passkey-required" x-data="passkeyOnboarding( '#csrfToken()#' )">
	<div class="cb-auth-card">
	<div class="text-center mb-4">
		<i class="ph-duotone ph-fingerprint display-4" aria-hidden="true"></i>
		<h1 class="cb-auth-heading">Passkey enrollment required</h1>
		<p class="cb-auth-subheading">Register a passkey to continue using the application.</p>
	</div>

	<div class="alert alert-danger" x-show="notice.message" x-text="notice.message" x-cloak></div>

	<form @submit.prevent="register">
		<div class="mb-3">
			<label for="required-passkey-label" class="form-label">Passkey label</label>
			<input id="required-passkey-label" type="text" class="form-control" maxlength="100" x-model.trim="label" placeholder="MacBook Touch ID" required autofocus>
		</div>
		<button type="submit" class="btn btn-primary w-100" :disabled="loading || !label.trim()">
			<span x-show="!loading"><i class="ph-duotone ph-fingerprint" aria-hidden="true"></i> Register passkey</span>
			<span x-show="loading" x-cloak><span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Waiting for device...</span>
		</button>
	</form>
	<form method="post" action="#event.buildLink( 'auth/logout' )#" class="mt-3 text-center">
		#csrfField()#
		<button type="submit" class="btn btn-link">Sign out</button>
	</form>
	</div>
</div>
</bx:output>
