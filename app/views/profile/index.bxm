<bx:output>
<div
	class="profile-page"
	x-data='profileForm( #forAttribute( prc.profile.getMemento() )#, "#csrfToken()#", #prc.apiTokenMaxValidityMonths# )'
	@profile-password-changed.window="setNewPassword( $event.detail.value )"
	@preferences-submit.window="submitPreferences( $event.detail )"
>

	<!--- Header --->
	<div class="cb-page-header cb-admin-page-heading">
		<div>
			<p class="cb-eyebrow">My Profile</p>
			<h2 class="cb-page-title">Account Settings</h2>
			<p class="cb-page-subtitle">My profile information and preferences.</p>
		</div>
	</div>

	<div class="cb-profile-layout">

		<!--- Profile Hero --->
		<section class="cb-content-card cb-profile-hero">
			<div class="cb-profile-hero-cover"></div>
			<div class="cb-profile-hero-body">
				<div class="cb-profile-orb small" data-profile-initials>#encodeForHTML( prc.authUser.getInitials() )#</div>
				<h3 data-profile-name>#encodeForHTML( prc.authUser.getFullName() )#</h3>
			</div>
		</section>

		<!--- Access Summary --->
		<section class="cb-content-card form-card cb-access-summary-card">
			<div class="cb-content-card-header">
				<div>
					<h3 class="cb-content-card-title">
						<i class="ph-duotone ph-shield-check" aria-hidden="true"></i>
						Assigned Access
					</h3>
					<p class="cb-content-card-subtitle">Roles and direct permissions assigned to your account.</p>
				</div>
			</div>
			<div class="cb-access-summary-grid">
				<div>
					<h4>Roles</h4>
					<div class="cb-chip-row">
						<bx:if prc.authUser.getRoles().len()>
							<bx:loop array="#prc.authUser.getRoles()#" item="role">
								<span class="cb-chip cb-chip-info">#encodeForHTML( role.getRole() )#</span>
							</bx:loop>
						<bx:else>
							<span class="text-muted">No roles assigned.</span>
						</bx:if>
					</div>
				</div>
				<div>
					<h4>Direct Permissions</h4>
					<div class="cb-chip-row">
						<bx:if prc.authUser.getPermissions().len()>
							<bx:loop array="#prc.authUser.getPermissions()#" item="permission">
								<span class="cb-chip cb-chip-cyan">#encodeForHTML( permission.getPermission() )#</span>
							</bx:loop>
						<bx:else>
							<span class="text-muted">No direct permissions assigned.</span>
						</bx:if>
					</div>
				</div>
			</div>
		</section>

		<!--- Profile Tabs --->
		<div class="cb-segmented-control profile-tabs" role="tablist" aria-label="Profile settings">
			<!--- PII --->
			<button
				type="button"
				role="tab"
				:class="activeTab === 'profile' ? 'active' : ''"
				:aria-selected="activeTab === 'profile'"
				@click="activeTab = 'profile'"
			>
				<i class="ph-duotone ph-user" aria-hidden="true"></i>
				Profile
			</button>

			<!--- Preferences --->
			<button
				type="button"
				role="tab"
				:class="activeTab === 'preferences' ? 'active' : ''"
				:aria-selected="activeTab === 'preferences'"
				@click="activeTab = 'preferences'"
			>
				<i class="ph-duotone ph-sliders-horizontal" aria-hidden="true"></i>
				Preferences
			</button>

			<!--- Password --->
			<button
				type="button"
				role="tab"
				:class="activeTab === 'password' ? 'active' : ''"
				:aria-selected="activeTab === 'password'"
				@click="activeTab = 'password'"
				>
				<i class="ph-duotone ph-lock-key" aria-hidden="true"></i>
				Password
			</button>

			<!--- API Tokens --->
			<button
				type="button"
				role="tab"
				:class="activeTab === 'api-tokens' ? 'active' : ''"
				:aria-selected="activeTab === 'api-tokens'"
				@click="activeTab = 'api-tokens'"
				>
				<i class="ph-duotone ph-key" aria-hidden="true"></i>
				API Tokens
			</button>

			<button type="button" role="tab" :class="activeTab === 'passkeys' ? 'active' : ''" :aria-selected="activeTab === 'passkeys'" @click="activeTab = 'passkeys'">
				<i class="ph-duotone ph-fingerprint" aria-hidden="true"></i>
				Passkeys
			</button>
		</div>

		<!--- MessageBox --->
		#view(
					view = "_components/ui/messagebox",
			args = {
				dynamic          : true,
				messageExpression: "notice.message",
				typeExpression   : "notice.type",
				dismissAction    : "clearNotice()"
			}
		)#

		<!--- Profile Tab --->
		<section class="cb-content-card form-card" x-show="activeTab === 'profile'" x-cloak>

			<!--- Content Header --->
			<div class="cb-content-card-header">
				<h3 class="cb-content-card-title">Personal Information</h3>
			</div>

			<!--- Profile Form --->
			<form method="post" action="#event.buildLink( "profile" )#" @submit="submitProfile">

				<!--- CSRF Token --->
				<input type="hidden" name="csrf" :value="csrfToken">

				<!--- Grid --->
				<div class="cb-form-grid">
					<label for="firstName">
						<span class="cb-field-label">First Name <span class="required-mark" aria-hidden="true">*</span></span>
						<input
							id="firstName"
							name="firstName"
							type="text"
							x-model.trim="profile.firstName"
							:class="{ 'is-invalid': !profile.firstName.trim() || profile.errors.firstName }"
							required
							autocomplete="given-name">
						<span class="invalid-feedback" x-show="profile.errors.firstName" x-text="profile.errors.firstName"></span>
					</label>
					<label for="lastName">
						<span class="cb-field-label">Last Name <span class="required-mark" aria-hidden="true">*</span></span>
						<input
							id="lastName"
							name="lastName"
							type="text"
							x-model.trim="profile.lastName"
							:class="{ 'is-invalid': !profile.lastName.trim() || profile.errors.lastName }"
							required
							autocomplete="family-name">
						<span class="invalid-feedback" x-show="profile.errors.lastName" x-text="profile.errors.lastName"></span>
					</label>
					<div class="cb-span-2 cb-email-field">
						<span class="cb-field-label">Email Address</span>
						<input type="email" x-bind:value="profile.email" disabled autocomplete="email">
						<template x-if="!profile.pendingEmail && !emailChangeForm.open">
							<button type="button" class="btn btn-link btn-sm cb-email-change-toggle" @click="openEmailChangeForm()">Change email address</button>
						</template>
						<template x-if="profile.pendingEmail">
							<p class="text-muted cb-pending-email-notice">
								Confirmation sent to <strong x-text="profile.pendingEmail"></strong>.
								<button type="button" class="btn btn-link btn-sm" @click="cancelEmailChange()" :disabled="emailChangeLoading">Cancel request</button>
							</p>
						</template>
						<template x-if="emailChangeForm.open">
							<form class="cb-email-change-form" @submit="submitEmailChange">
								<label for="newEmail">
									<span class="visually-hidden">New email address</span>
									<input
										id="newEmail"
										name="newEmail"
										type="email"
										x-model.trim="emailChangeForm.newEmail"
										:class="{ 'is-invalid': emailChangeForm.errors.email }"
										placeholder="New email address"
										required
										autocomplete="email">
									<span class="invalid-feedback" x-show="emailChangeForm.errors.email" x-text="emailChangeForm.errors.email"></span>
								</label>
								<button type="submit" class="btn btn-primary btn-sm" :disabled="emailChangeForm.loading || !$isEmail( emailChangeForm.newEmail )">
									<span x-show="!emailChangeForm.loading">Send confirmation</span>
									<span x-show="emailChangeForm.loading" x-cloak>Sending...</span>
								</button>
								<button type="button" class="btn btn-link btn-sm" @click="closeEmailChangeForm()" :disabled="emailChangeForm.loading">Cancel</button>
							</form>
						</template>
					</div>
					<label class="cb-span-2" for="biography">Biography <span class="optional-label"></span>
						<textarea
							id="biography"
							name="biography"
							rows="4"
							x-model="profile.biography"
							:class="{ 'is-invalid': profile.errors.biography }"></textarea>
						<span class="invalid-feedback" x-show="profile.errors.biography" x-text="profile.errors.biography"></span>
					</label>
				</div>
				<div class="cb-form-actions">
					<button type="submit" class="btn btn-primary" :disabled="loading || !profileDirty || !profileValid">
						<span x-show="loading !== 'profile'"><i class="ph-duotone ph-check"></i> Save Profile</span>
						<span x-show="loading === 'profile'" x-cloak><span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Saving...</span>
					</button>
				</div>
			</form>
		</section>

		<!--- Preferences --->
		<section
			class="cb-content-card form-card cb-preferences-card"
			x-data='preferencesForm( #forAttribute( prc.authUser.getAllPreferences() )# )'
			x-show="activeTab === 'preferences'"
			x-cloak
		>
			<div class="cb-content-card-header">
				<div>
					<h3 class="cb-content-card-title">
						<i class="ph-duotone ph-sliders-horizontal" aria-hidden="true"></i>
						Preferences
					</h3>
					<p class="cb-content-card-subtitle">Store personal settings as editable name and value pairs.</p>
				</div>
				<button type="button" class="btn btn-primary btn-sm" @click="addPreference()">
					<i class="ph-duotone ph-plus" aria-hidden="true"></i>
					Add Preference
				</button>
			</div>

			<form method="post" action="#event.buildLink( "profile" )#" @submit="submit">
				<input type="hidden" name="csrf" value="#csrfToken()#">
				<div class="cb-preferences-list" x-show="preferences.length" x-cloak>
					<div class="cb-preferences-heading" aria-hidden="true">
						<span>Name</span>
						<span>Value</span>
						<span class="visually-hidden">Actions</span>
					</div>
					<template x-for="preference in preferences" :key="preference.id">
						<div class="cb-preference-row" :data-preference-id="preference.id">
							<label>
								<span class="visually-hidden">Preference name</span>
								<input
									class="cb-preference-input"
									type="text"
									x-model.trim="preference.name"
									placeholder="e.g. theme"
									autocomplete="off">
							</label>
							<label>
								<span class="visually-hidden">Preference value</span>
								<input
									class="cb-preference-input"
									type="text"
									x-model="preference.value"
									placeholder="e.g. dark">
							</label>
							<button
								type="button"
								class="cb-icon-button cb-preference-remove danger"
								title="Remove preference"
								aria-label="Remove preference"
								@click="removePreference( preference.id )">
								<i class="ph-duotone ph-trash" aria-hidden="true"></i>
							</button>
						</div>
					</template>
				</div>
				<p class="text-muted cb-preferences-empty" x-show="!preferences.length">No preferences have been added.</p>
				<p class="invalid-feedback d-block" x-show="error" x-text="error"></p>
				<div class="cb-form-actions">
					<button type="submit" class="btn btn-primary" :disabled="submitting || !preferencesDirty">
						<span x-show="!submitting"><i class="ph-duotone ph-check"></i> Save Preferences</span>
						<span x-show="submitting" x-cloak>
							<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Saving...
						</span>
					</button>
				</div>
			</form>
		</section>

		<!--- Password --->
		<section class="cb-content-card form-card cb-profile-password-card" x-show="activeTab === 'password'" x-cloak>
			<div class="cb-content-card-header"><h3 class="cb-content-card-title">Change Password</h3></div>

			<form
				method="post"
				action="#event.buildLink( "profile/password" )#"
				@submit="submitPassword">

				<!--- CSRF Field --->
				<input type="hidden" name="csrf" :value="csrfToken">

				<div class="cb-form-grid password-form-grid">

					#view(
						view = "_components/auth/passwordInput",
						args = {
							id          : "currentPassword",
							name        : "currentPassword",
							model       : "password.currentPassword",
							label       : "Current Password",
							classes     : "cb-span-2",
							inputClassExpression: "password.errors.currentPassword ? 'is-invalid' : ''",
							errorMessage: ""
						}
					)#

					<span
						class="invalid-feedback"
						x-show="password.errors.currentPassword"
						x-text="password.errors.currentPassword"></span>

					<div class="cb-span-2">
						#view(
							view = "_components/ui/passwordMeter",
							args = {
								id           : "newPassword",
								name         : "password",
								label        : "New Password",
								dispatchEvent: "profile-password-changed"
							}
						)#
						<span class="invalid-feedback" x-show="password.errors.password" x-text="password.errors.password"></span>
					</div>

					<!--- Confirm New Password --->
					<label class="cb-span-2" for="passwordConfirm">Confirm New Password
						<input
							id="passwordConfirm"
							name="passwordConfirm"
							type="password"
							x-model="password.passwordConfirm"
							@input="setPasswordConfirmation($event.target.value)"
							:class="{ 'is-invalid': passwordConfirmationError || password.errors.passwordConfirm }"
							required>
						<span
							class="invalid-feedback"
							x-show="passwordConfirmationError || password.errors.passwordConfirm"
							x-text="passwordConfirmationError || password.errors.passwordConfirm"></span>
					</label>
				</div>
				<!--- Form Actions --->
				<div class="cb-form-actions">
					<button type="submit" class="btn btn-primary" :disabled="loading || !passwordValid">
						<span x-show="loading !== 'password'"><i class="ph-duotone ph-lock"></i> Change Password</span>
						<span x-show="loading === 'password'" x-cloak>
							<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Changing...
						</span>
					</button>
				</div>
			</form>
		</section>

		<!--- API Tokens --->
		<section class="cb-content-card form-card cb-api-tokens-card" x-show="activeTab === 'api-tokens'" x-cloak>

			<!--- Header --->
			<div class="cb-content-card-header">
				<div>
					<h3 class="cb-content-card-title">
						<i class="ph-duotone ph-key" aria-hidden="true"></i>
						API Tokens
						<span class="cb-count-pill" x-text="apiTokens.length" aria-label="API token count"></span>
					</h3>
					<p class="cb-content-card-subtitle">Create tokens for integrations that access your account.</p>
				</div>
				<button
					type="button"
					class="btn btn-primary btn-sm"
					@click="openCreateTokenModal()">
					<i class="ph-duotone ph-plus" aria-hidden="true"></i>
					Create Token
				</button>
			</div>

			<!--- Token Table --->
			<div class="cb-table-wrap" x-show="apiTokens.length" x-cloak>
				<table class="cb-table cb-token-table">
					<thead>
						<tr>
							<th scope="col" :aria-sort="tokenSortKey === 'label' ? tokenSortDirection + 'ending' : 'none'">
								<button
									type="button"
									class="cb-table-sort-button"
									:class="$sortClass( tokenSortKey + ' ' + tokenSortDirection, 'label' )"
									:title="'Sort by label ' + ( tokenSortKey === 'label' && tokenSortDirection === 'desc' ? 'ascending' : 'descending' )"
									@click="sortTokens( 'label' )">
									Label
									<i
										class="ph-duotone"
										:class="$sortIcon( tokenSortKey + ' ' + tokenSortDirection, 'label' )"
										aria-hidden="true"></i>
								</button>
							</th>
							<th scope="col">Token</th>
							<th scope="col" :aria-sort="tokenSortKey === 'expiration' ? tokenSortDirection + 'ending' : 'none'">
								<button
									type="button"
									class="cb-table-sort-button"
									:class="$sortClass( tokenSortKey + ' ' + tokenSortDirection, 'expiration' )"
									:title="'Sort by expiration ' + ( tokenSortKey === 'expiration' && tokenSortDirection === 'desc' ? 'ascending' : 'descending' )"
									@click="sortTokens( 'expiration' )">
									Expiration
									<i
										class="ph-duotone"
										:class="$sortIcon( tokenSortKey + ' ' + tokenSortDirection, 'expiration' )"
										aria-hidden="true"></i>
								</button>
							</th>
							<th scope="col" :aria-sort="tokenSortKey === 'lastUsed' ? tokenSortDirection + 'ending' : 'none'">
								<button
									type="button"
									class="cb-table-sort-button"
									:class="$sortClass( tokenSortKey + ' ' + tokenSortDirection, 'lastUsed' )"
									:title="'Sort by last used ' + ( tokenSortKey === 'lastUsed' && tokenSortDirection === 'desc' ? 'ascending' : 'descending' )"
									@click="sortTokens( 'lastUsed' )">
									Last Used
									<i
										class="ph-duotone"
										:class="$sortIcon( tokenSortKey + ' ' + tokenSortDirection, 'lastUsed' )"
										aria-hidden="true"></i>
								</button>
							</th>
							<th scope="col" :aria-sort="tokenSortKey === 'createdDate' ? tokenSortDirection + 'ending' : 'none'">
								<button
									type="button"
									class="cb-table-sort-button"
									:class="$sortClass( tokenSortKey + ' ' + tokenSortDirection, 'createdDate' )"
									:title="'Sort by created date ' + ( tokenSortKey === 'createdDate' && tokenSortDirection === 'desc' ? 'ascending' : 'descending' )"
									@click="sortTokens( 'createdDate' )">
									Created
									<i
										class="ph-duotone"
										:class="$sortIcon( tokenSortKey + ' ' + tokenSortDirection, 'createdDate' )"
										aria-hidden="true"></i>
								</button>
							</th>
							<th scope="col" class="actions-column"><span class="visually-hidden">Actions</span></th>
						</tr>
					</thead>
					<tbody>
						<template x-for="( token, index ) in sortedApiTokens" :key="`${ token.tokenId || 'token' }-${ index }`">
							<tr>
								<td><strong x-text="token.label"></strong></td>
								<td><code x-text="token.tokenSnapshot"></code></td>
								<td>
									<span
										class="cb-chip"
										:class="tokenExpiringSoon( token.expiration ) ? 'cb-chip-locked' : ''"
										x-text="token.expiration ? formatTokenDate( token.expiration ) : 'Never expires'"></span>
								</td>
								<td class="cb-muted-cell" x-text="token.lastUsed ? formatTokenDate( token.lastUsed ) : 'Never used'"></td>
								<td class="cb-muted-cell" x-text="formatTokenDate( token.createdDate )"></td>
								<td>
									<div class="cb-api-token-actions">
										<button
											type="button"
											class="cb-icon-button"
											title="Edit token"
											aria-label="Edit token"
											@click="openEditTokenModal( token )">
											<i class="ph-duotone ph-pencil-simple" aria-hidden="true"></i>
										</button>
										<button
											type="button"
											class="cb-icon-button danger"
											title="Delete token"
											aria-label="Delete token"
											@click="confirmDeleteToken( token )">
											<i class="ph-duotone ph-trash" aria-hidden="true"></i>
										</button>
									</div>
								</td>
							</tr>
						</template>
					</tbody>
				</table>
			</div>
			<p class="text-muted cb-api-token-empty" x-show="!apiTokens.length" x-cloak>No API tokens have been created.</p>
		</section>

		<!--- Passkeys Section --->
		<section class="cb-content-card form-card" x-show="activeTab === 'passkeys'" x-cloak>
			<div class="cb-content-card-header">
				<div>
					<h3 class="cb-content-card-title"><i class="ph-duotone ph-fingerprint" aria-hidden="true"></i> Passkeys <span class="cb-count-pill" x-text="passkeys.length"></span></h3>
					<p class="cb-content-card-subtitle">Use a fingerprint, face scan, or device security key to sign in securely.</p>
				</div>
				<button type="button" class="btn btn-primary btn-sm" @click="openPasskeyModal()" :disabled="passkeyRegistering">
					<span x-show="!passkeyRegistering"><i class="ph-duotone ph-plus" aria-hidden="true"></i> Register Passkey</span>
					<span x-show="passkeyRegistering" x-cloak><span class="spinner-border spinner-border-sm me-1" role="status"></span> Waiting for device...</span>
				</button>
			</div>
			<div class="cb-table-wrap" x-show="passkeys.length" x-cloak>
				<table class="cb-table">
					<thead><tr><th>Passkey</th><th>Last Used</th><th>Created</th><th class="actions-column"><span class="visually-hidden">Actions</span></th></tr></thead>
					<tbody>
						<template x-for="( passkey, index ) in passkeys" :key="`${ passkey.passkeyId || 'passkey' }-${ index }`">
							<tr>
								<td><strong x-text="passkey.label"></strong></td>
								<td class="cb-muted-cell" x-text="formatTokenDate( passkey.lastUsed, 'Never used' )"></td>
								<td class="cb-muted-cell" x-text="formatTokenDate( passkey.createdDate )"></td>
								<td><button type="button" class="cb-icon-button danger" title="Remove passkey" aria-label="Remove passkey" @click="confirmDeletePasskey( passkey )"><i class="ph-duotone ph-trash" aria-hidden="true"></i></button></td>
							</tr>
						</template>
					</tbody>
				</table>
			</div>
			<p class="text-muted cb-api-token-empty" x-show="!passkeys.length" x-cloak>No passkeys have been registered.</p>
		</section>

		#view(
			view = "_components/ui/modal",
			args = {
				id            : "passkey-label-modal",
				title         : "Name Passkey",
				openExpression: "passkeyModalOpen",
				closeExpression: "closePasskeyModal()",
				contentView   : "profile/passkeyForm"
			}
		)#

		#view(
			view = "_components/ui/modal",
			args = {
				id            : "api-token-modal",
				title         : "API Token",
				openExpression: "tokenModalOpen",
				closeExpression: "closeTokenModal()",
				contentView   : "profile/apiTokenForm"
			}
		)#

		#view(
			view = "_components/ui/confirm",
			args = {
				id                 : "api-token-delete-confirm",
				title              : "Delete API Token",
				messageExpression  : "'Delete ' + ( selectedToken?.label || 'this token' ) + '?'",
				openExpression     : "confirmTokenOpen",
				closeExpression    : "cancelDeleteToken()",
				confirmExpression  : "deleteApiToken()",
				confirmLabel       : "Delete Token",
				confirmClass       : "btn-danger",
				confirmIcon        : "ph-trash",
				disabledExpression : "deleteTokenLoading"
			}
		)#

		#view(
			view = "_components/ui/confirm",
			args = {
				id: "passkey-delete-confirm",
				title: "Remove Passkey",
				messageExpression: "'Remove ' + ( selectedPasskey?.label || 'this passkey' ) + '?'",
				openExpression: "confirmPasskeyOpen",
				closeExpression: "cancelDeletePasskey()",
				confirmExpression: "deletePasskey()",
				confirmLabel: "Remove Passkey",
				confirmClass: "btn-danger",
				confirmIcon: "ph-trash",
				disabledExpression: "deletePasskeyLoading"
			}
		)#
	</div>
</div>
</bx:output>