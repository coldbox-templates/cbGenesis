<bx:output>
<div
	class="profile-page"
	x-data='profileForm( #forAttribute( prc.profile.getMemento() )#, "#csrfToken()#" )'
	@profile-password-changed.window="setNewPassword( $event.detail.value )"
>

	<!--- Header --->
	<div class="page-header admin-page-heading">
		<div>
			<p class="eyebrow">My Profile</p>
			<h2 class="page-title">Account Settings</h2>
			<p class="page-subtitle">My profile information and preferences.</p>
		</div>
	</div>

	<div class="profile-layout">

		<!--- Profile Hero --->
		<section class="content-card profile-hero">
			<div class="profile-hero-cover"></div>
			<div class="profile-hero-body">
				<div class="profile-orb small" data-profile-initials>#encodeForHTML( prc.authUser.getInitials() )#</div>
				<h3 data-profile-name>#encodeForHTML( prc.authUser.getFullName() )#</h3>
			</div>
		</section>

		<!--- Access Summary --->
		<section class="content-card form-card access-summary-card">
			<div class="content-card-header">
				<div>
					<h3 class="content-card-title">
						<i class="ph-duotone ph-shield-check" aria-hidden="true"></i>
						Assigned Access
					</h3>
					<p class="content-card-subtitle">Roles and direct permissions assigned to your account.</p>
				</div>
			</div>
			<div class="access-summary-grid">
				<div>
					<h4>Roles</h4>
					<div class="chip-row">
						<bx:if prc.authUser.getRoles().len()>
							<bx:loop array="#prc.authUser.getRoles()#" item="role">
								<span class="chip chip-info">#encodeForHTML( role.getRole() )#</span>
							</bx:loop>
						<bx:else>
							<span class="text-muted">No roles assigned.</span>
						</bx:if>
					</div>
				</div>
				<div>
					<h4>Direct Permissions</h4>
					<div class="chip-row">
						<bx:if prc.authUser.getPermissions().len()>
							<bx:loop array="#prc.authUser.getPermissions()#" item="permission">
								<span class="chip chip-cyan">#encodeForHTML( permission.getPermission() )#</span>
							</bx:loop>
						<bx:else>
							<span class="text-muted">No direct permissions assigned.</span>
						</bx:if>
					</div>
				</div>
			</div>
		</section>

		<!--- Profile Tabs --->
		<div class="segmented-control profile-tabs" role="tablist" aria-label="Profile settings">
			<!--- PII --->
			<button
				type="button"
				role="tab"
				:class="activeTab === 'profile' ? 'active' : ''"
				:aria-selected="activeTab === 'profile'"
				@click="activeTab = 'profile'"
			>
				<i class="ph-duotone ph-user" aria-hidden="true"></i>
				Profile
			</button>

			<!--- Password --->
			<button
				type="button"
				role="tab"
				:class="activeTab === 'password' ? 'active' : ''"
				:aria-selected="activeTab === 'password'"
				@click="activeTab = 'password'"
				>
				<i class="ph-duotone ph-lock-key" aria-hidden="true"></i>
				Password
			</button>

			<!--- API Tokens --->
			<button
				type="button"
				role="tab"
				:class="activeTab === 'api-tokens' ? 'active' : ''"
				:aria-selected="activeTab === 'api-tokens'"
				@click="activeTab = 'api-tokens'"
				>
				<i class="ph-duotone ph-key" aria-hidden="true"></i>
				API Tokens
			</button>
		</div>

		<!--- MessageBox --->
		#view(
			view = "_components/ui/messagebox",
			args = {
				dynamic          : true,
				messageExpression: "notice.message",
				typeExpression   : "notice.type",
				dismissAction    : "clearNotice()"
			}
		)#

		<!--- Profile Form --->
		<section class="content-card form-card" x-show="activeTab === 'profile'" x-cloak>
			<div class="content-card-header"><h3 class="content-card-title">Personal Information</h3></div>
			<form method="post" action="#event.buildLink( "profile" )#" @submit="submitProfile">
				<input type="hidden" name="csrf" :value="csrfToken">
				<div class="form-grid">
					<label for="firstName"><span class="field-label">First Name <span class="required-mark" aria-hidden="true">*</span></span>
						<input
							id="firstName"
							name="firstName"
							type="text"
							x-model.trim="profile.firstName"
							:class="{ 'is-invalid': !profile.firstName.trim() || profile.errors.firstName }"
							required
							autocomplete="given-name">
						<span class="invalid-feedback" x-show="profile.errors.firstName" x-text="profile.errors.firstName"></span>
					</label>
					<label for="lastName"><span class="field-label">Last Name <span class="required-mark" aria-hidden="true">*</span></span>
						<input
							id="lastName"
							name="lastName"
							type="text"
							x-model.trim="profile.lastName"
							:class="{ 'is-invalid': !profile.lastName.trim() || profile.errors.lastName }"
							required
							autocomplete="family-name">
						<span class="invalid-feedback" x-show="profile.errors.lastName" x-text="profile.errors.lastName"></span>
					</label>
					<label class="span-2" for="email"><span class="field-label">Email Address <span class="required-mark" aria-hidden="true">*</span></span>
						<input
							id="email"
							name="email"
							type="email"
							x-model.trim="profile.email"
							:class="{ 'is-invalid': !profile.email.trim() || profile.errors.email }"
							required
							autocomplete="email">
						<span class="invalid-feedback" x-show="profile.errors.email" x-text="profile.errors.email"></span>
					</label>
					<label class="span-2" for="biography">Biography <span class="optional-label"></span>
						<textarea
							id="biography"
							name="biography"
							rows="4"
							x-model="profile.biography"
							:class="{ 'is-invalid': profile.errors.biography }"></textarea>
						<span class="invalid-feedback" x-show="profile.errors.biography" x-text="profile.errors.biography"></span>
					</label>
				</div>
				<div class="form-actions">
					<button type="submit" class="btn btn-primary" :disabled="loading || !profileDirty || !profileValid">
						<span x-show="loading !== 'profile'"><i class="ph-duotone ph-check"></i> Save Profile</span>
						<span x-show="loading === 'profile'" x-cloak><span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Saving...</span>
					</button>
				</div>
			</form>
		</section>

		<!--- Password --->
		<section class="content-card form-card profile-password-card" x-show="activeTab === 'password'" x-cloak>
			<div class="content-card-header"><h3 class="content-card-title">Change Password</h3></div>

			<form
				method="post"
				action="#event.buildLink( "profile/password" )#"
				@submit="submitPassword">

				<!--- CSRF Field --->
				<input type="hidden" name="csrf" :value="csrfToken">

				<div class="form-grid password-form-grid">

					#view(
						view = "_components/auth/passwordInput",
						args = {
							id          : "currentPassword",
							name        : "currentPassword",
							model       : "password.currentPassword",
							label       : "Current Password",
							classes     : "span-2",
							inputClassExpression: "!password.currentPassword || password.errors.currentPassword ? 'is-invalid' : ''",
							errorMessage: ""
						}
					)#

					<span
						class="invalid-feedback"
						x-show="password.errors.currentPassword"
						x-text="password.errors.currentPassword"></span>

					<div class="span-2">
						#view(
							view = "_components/ui/passwordMeter",
							args = {
								id           : "newPassword",
								name         : "password",
								label        : "New Password",
								dispatchEvent: "profile-password-changed"
							}
						)#
						<span class="invalid-feedback" x-show="password.errors.password" x-text="password.errors.password"></span>
					</div>

					<!--- Confirm New Password --->
					<label class="span-2" for="passwordConfirm">Confirm New Password
						<input
							id="passwordConfirm"
							name="passwordConfirm"
							type="password"
							x-model="password.passwordConfirm"
							@input="setPasswordConfirmation($event.target.value)"
							:class="{ 'is-invalid': passwordConfirmationError || password.errors.passwordConfirm }"
							required>
						<span
							class="invalid-feedback"
							x-show="passwordConfirmationError || password.errors.passwordConfirm"
							x-text="passwordConfirmationError || password.errors.passwordConfirm"></span>
					</label>
				</div>
				<!--- Form Actions --->
				<div class="form-actions">
					<button type="submit" class="btn btn-primary" :disabled="loading || !passwordValid">
						<span x-show="loading !== 'password'"><i class="ph-duotone ph-lock"></i> Change Password</span>
						<span x-show="loading === 'password'" x-cloak>
							<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Changing...
						</span>
					</button>
				</div>
			</form>
		</section>

		<!--- API Tokens --->
		<section class="content-card form-card api-tokens-card" x-show="activeTab === 'api-tokens'" x-cloak>

			<!--- Header --->
			<div class="content-card-header">
				<div>
					<h3 class="content-card-title">
						<i class="ph-duotone ph-key" aria-hidden="true"></i>
						API Tokens
					</h3>
					<p class="content-card-subtitle">Create tokens for integrations that access your account.</p>
				</div>
				<span class="count-pill" x-text="apiTokens.length"></span>
				<button
					type="button"
					class="btn btn-primary btn-sm"
					@click="openCreateTokenModal()">
					<i class="ph-duotone ph-plus" aria-hidden="true"></i>
					Create Token
				</button>
			</div>

			<!--- Token List --->
			<div class="api-token-list" x-show="apiTokens.length" x-cloak>
				<template x-for="( token, index ) in apiTokens" :key="`${ token.tokenId || 'token' }-${ index }`">
					<div class="api-token-row">
						<div class="api-token-details">
							<strong x-text="token.label"></strong>
							<code x-text="token.tokenSnapshot"></code>
						</div>
						<div class="api-token-actions">
							<button
								type="button"
								class="icon-button"
								title="Edit token"
								aria-label="Edit token"
								@click="openEditTokenModal( token )">
								<i class="ph-duotone ph-pencil-simple" aria-hidden="true"></i>
							</button>
							<button
								type="button"
								class="icon-button danger"
								title="Delete token"
								aria-label="Delete token"
								@click="confirmDeleteToken( token )">
								<i class="ph-duotone ph-trash" aria-hidden="true"></i>
							</button>
						</div>
					</div>
				</template>
			</div>
			<p class="text-muted api-token-empty" x-show="!apiTokens.length" x-cloak>No API tokens have been created.</p>
		</section>

		#view(
			view = "_components/ui/modal",
			args = {
				id            : "api-token-modal",
				title         : "API Token",
				openExpression: "tokenModalOpen",
				closeExpression: "closeTokenModal()",
				contentView   : "profile/apiTokenForm"
			}
		)#

		#view(
			view = "_components/ui/confirm",
			args = {
				id                 : "api-token-delete-confirm",
				title              : "Delete API Token",
				messageExpression  : "'Delete ' + ( selectedToken?.label || 'this token' ) + '?'",
				openExpression     : "confirmTokenOpen",
				closeExpression    : "cancelDeleteToken()",
				confirmExpression  : "deleteApiToken()",
				confirmLabel       : "Delete Token",
				confirmClass       : "btn-danger",
				confirmIcon        : "ph-trash",
				disabledExpression : "deleteTokenLoading"
			}
		)#
	</div>
</div>
</bx:output>