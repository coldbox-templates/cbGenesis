<bx:output>
<!--- User Header --->
<div class="page-header admin-page-heading">
	<div>
		<p class="eyebrow">My Profile</p>
		<h2 class="page-title">Account Settings</h2>
		<p class="page-subtitle">My profile information and preferences.</p>
	</div>
</div>

<div class="profile-layout">

	<!--- Flash Messages --->
	<bx:if flash.exists( "messages" )>
		#view(
			view = "_components/ui/messagebox",
			args = {
				type       : flash.get( "messages" ).type ?: "info",
				message    : flash.get( "messages" ).message ?: "",
				dismissible: true,
				classes    : "mb-4"
			}
		)#
	</bx:if>

	<!--- Profile Hero --->
	<section class="content-card profile-hero">
		<div class="profile-hero-cover"></div>
		<div class="profile-hero-body">
			<div class="profile-orb small">#encodeForHTML( prc.authUser.getInitials() )#</div>
			<h3>#encodeForHTML( prc.authUser.getFullName() )#</h3>
		</div>
	</section>

	<!--- Profile Form --->
	<section class="content-card form-card">

		<!--- Personal Information Header --->
		<div class="content-card-header">
			<h3 class="content-card-title">Personal Information</h3>
		</div>

		<!--- Profile Form --->
		<form method="post" action="#event.buildLink( "profile/update" )#">
			<!--- CSRF Token --->
			#csrfField()#

			<!--- Profile Form --->
			<div class="form-grid">
				<label for="firstName">
					First Name
					<input
						id="firstName"
						name="firstName"
						type="text"
						value="#encodeForHTMLAttribute( prc.profile.firstName )#"
						autocomplete="given-name">
				</label>
				<label for="lastName">
					Last Name
					<input
						id="lastName"
						name="lastName"
						type="text"
						value="#encodeForHTMLAttribute( prc.profile.lastName )#"
						autocomplete="family-name">
				</label>
				<label class="span-2" for="email">
					Email Address
					<input
						id="email"
						name="email"
						type="email"
						value="#encodeForHTMLAttribute( prc.profile.email )#"
						autocomplete="email">
				</label>
				<label class="span-2" for="biography">
					Biography
					<textarea
						id="biography"
						name="biography"
						rows="4">#encodeForHTML(
						prc.profile.getBiography()
						)#</textarea>
				</label>
			</div>

			<!--- Form Actions --->
			<div class="form-actions">
				<button type="submit" class="btn btn-primary">
					<i class="ph-duotone ph-check"></i> Save Profile
				</button>
			</div>
		</form>
	</section>
</div>
</bx:output>
