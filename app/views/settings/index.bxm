<bx:output>
<form
	method="post"
	action="#event.route( 'Settings' )#"
	x-data="settingsForm( #forAttribute( prc.settings )# )"
	@submit="onSubmit"
	@input="markDirty"
	@change="markDirty"
	@click="markDirty"
>

	<!--- CSRF Field --->
	#csrfField()#

	<!--- Page Heading  --->
	<div class="page-header admin-page-heading">
		<div>
			<p class="eyebrow">Settings</p>
			<h2 class="page-title">Global Settings</h2>
			<p class="page-subtitle">Manage application branding, security, and email configuration.</p>
		</div>
		<button
			type="submit"
			class="btn btn-primary"
			:disabled="loading || !dirty"
		>
			<span x-show="!loading"><i class="ph-duotone ph-check"></i> Save All</span>
			<span x-show="loading" x-cloak>
				<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
				Saving...
			</span>
		</button>
	</div>

	<!--- Flash Messages--->
	<bx:if flash.exists( "messages" )>
		#view(
			view = "_components/ui/messagebox",
			args = {
				type       : flash.get( "messages" ).type ?: "info",
				message    : flash.get( "messages" ).message ?: "",
				dismissible: true,
				classes    : "mb-4"
			}
		)#
	</bx:if>

	<div class="settings-stack">

		<!--- Branding --->
		<section class="content-card settings-card">
			<div class="content-card-header">
				<h3 class="content-card-title">
					<i class="ph-duotone ph-palette"></i> Branding
				</h3>
			</div>
			<div class="form-grid">
				<label
					x-data="{ logoPath: '' }"
					x-init="logoPath = $refs.logoInput.value"
				>
					App Logo Path
					<input
						type="text"
						name="cbAppLogo"
						x-ref="logoInput"
						x-model="logoPath"
						x-on:input="$refs.logoPreview.hidden = false"
						value="#encodeForHTMLAttribute( prc.settings.cbAppLogo )#">
					<span class="logo-preview" x-show="logoPath">
						<img
							x-ref="logoPreview"
							x-bind:src="logoPath"
							x-on:load="$refs.logoPreview.hidden = false"
							x-on:error="$refs.logoPreview.hidden = true"
							alt="App logo preview">
					</span>
				</label>
				<label>App Name
					<input
						type="text"
						name="cbAppName"
						value="#encodeForHTMLAttribute( prc.settings.cbAppName )#">
				</label>
				<label>Tagline
					<input
						type="text"
						name="cbAppTagline"
						value="#encodeForHTMLAttribute( prc.settings.cbAppTagline )#">
				</label>
				<label>Brand Tagline
					<input
						type="text"
						name="cbAppBrandTagline"
						value="#encodeForHTMLAttribute( prc.settings.cbAppBrandTagline )#">
				</label>
				<label class="span-2">Copyright Notice
					<input
						type="text"
						name="cbCopyrightNotice"
						value="#encodeForHTMLAttribute( prc.settings.cbCopyrightNotice )#">
				</label>
			</div>
		</section>

		<!--- Theme & Layout --->
		<section class="content-card settings-card">
			<div class="content-card-header">
				<h3 class="content-card-title">
					<i class="ph-duotone ph-paint-brush"></i> Theme & Layout
				</h3>
			</div>
			<div class="settings-list">
				<div class="setting-row">
					<div>
						<strong>Default Theme</strong>
						<small>App-wide color scheme for all users</small>
					</div>
					<select name="cbDefaultTheme">
						<option value="light" #prc.settings.cbDefaultTheme == "light" ? "selected" : ""#>Light</option>
						<option value="dark" #prc.settings.cbDefaultTheme == "dark" ? "selected" : ""#>Dark</option>
					</select>
				</div>
				<div class="setting-row">
					<div>
						<strong>Login Layout</strong>
						<small>Layout used on authentication pages</small>
					</div>
					<select name="cbLoginLayout">
						<option value="AuthCenter" #prc.settings.cbLoginLayout == "AuthCenter" ? "selected" : ""#>Auth Center</option>
						<option value="AuthSplit" #prc.settings.cbLoginLayout == "AuthSplit" ? "selected" : ""#>Auth Split</option>
					</select>
				</div>
			</div>
		</section>

		<!--- Registration --->
		<section class="content-card settings-card">
			<div class="content-card-header">
				<h3 class="content-card-title">
					<i class="ph-duotone ph-user-plus"></i> Account Access
				</h3>
			</div>
			<div class="settings-list">
				<div class="setting-row">
					<div>
						<strong>Allow Registration</strong>
						<small>Let anyone create an account on the login page</small>
					</div>
					#view(
						view = "_components/ui/switch",
						args = {
							name : "cbAllowRegistration",
							value: prc.settings.cbAllowRegistration
						}
					)#
				</div>
				<div class="setting-row">
					<div>
						<strong>Allow Forgot Password</strong>
						<small>Enable the password reset flow on the login page</small>
					</div>
					#view(
						view = "_components/ui/switch",
						args = {
							name : "cbAllowForgotPassword",
							value: prc.settings.cbAllowForgotPassword
						}
					)#
				</div>
				<div class="setting-row">
					<div>
						<strong>Allow Remember Me</strong>
						<small>Enable the "Remember Me" functionality on the login page</small>
					</div>
					#view(
						view = "_components/ui/switch",
						args = {
							name : "cbAllowRememberMe",
							value: prc.settings.cbAllowRememberMe
						}
					)#
				</div>
			</div>
		</section>

		<!--- Security --->
		<section class="content-card settings-card">
			<div class="content-card-header">
				<h3 class="content-card-title">
					<i class="ph-duotone ph-shield-check"></i> Security
				</h3>
			</div>
			<div class="form-grid">
				<label>Minimum Password Length
					<input type="number" name="cbMinPasswordLength" value="#encodeForHTMLAttribute( prc.settings.cbMinPasswordLength )#">
				</label>
				<label>Password Reset Expiration (minutes)
					<input type="number" name="cbPasswordResetExpiration" value="#encodeForHTMLAttribute( prc.settings.cbPasswordResetExpiration )#">
				</label>
				<label>Keep Me Signed In (days)
					<input type="number" name="cbRememberMeDays" min="1" max="365" step="1" value="#encodeForHTMLAttribute( prc.settings.cbRememberMeDays )#">
				</label>
				<label>Encryption Key
					<input type="password" name="cbEncryptionKey" value="#encodeForHTMLAttribute( prc.settings.cbEncryptionKey )#" readonly>
					<small>Generated at first run. Change only if you know what you are doing.</small>
				</label>
				<label>Salting Key
					<input type="password" name="cbSaltingKey" value="#encodeForHTMLAttribute( prc.settings.cbSaltingKey )#" readonly>
					<small>Generated at first run. Change only if you know what you are doing.</small>
				</label>
			</div>
		</section>

		<!--- Email Configuration --->
		<section class="content-card settings-card">
			<div class="content-card-header">
				<h3 class="content-card-title">
					<i class="ph-duotone ph-envelope-simple"></i> Email Configuration
				</h3>
			</div>
			<div class="form-grid">
				<label>Default From Address
					<input type="email" name="cbDefaultEmail" value="#encodeForHTMLAttribute( prc.settings.cbDefaultEmail )#">
				</label>
				<label>SMTP Host
					<input type="text" name="cbMailHost" value="#encodeForHTMLAttribute( prc.settings.cbMailHost )#">
				</label>
				<label>SMTP Port
					<input type="number" name="cbMailPort" value="#encodeForHTMLAttribute( prc.settings.cbMailPort )#">
				</label>
				<label>SMTP Username
					<input type="text" name="cbMailUsername" value="#encodeForHTMLAttribute( prc.settings.cbMailUsername )#">
				</label>
				<label>SMTP Password
					<input type="password" name="cbMailPassword" value="#encodeForHTMLAttribute( prc.settings.cbMailPassword )#">
				</label>
			</div>
			<div class="settings-list" style="margin-top:1rem;">
				<div class="setting-row">
					<div>
						<strong>Use TLS</strong>
						<small>Enable STARTTLS for SMTP connection</small>
					</div>
					#view(
						view = "_components/ui/switch",
						args = {
							name : "cbMailTLS",
							value: prc.settings.cbMailTLS
						}
					)#
				</div>
				<div class="setting-row">
					<div>
						<strong>Use SSL</strong>
						<small>Enable SSL for SMTP connection</small>
					</div>
					#view(
						view = "_components/ui/switch",
						args = {
							name : "cbMailSSL",
							value: prc.settings.cbMailSSL
						}
					)#
				</div>
			</div>
		</section>

		<!--- Maintenance --->
		<section class="content-card settings-card">
			<div class="content-card-header">
				<h3 class="content-card-title">
					<i class="ph-duotone ph-wrench"></i> Maintenance Actions
				</h3>
			</div>
			<div class="settings-list">
				<div class="setting-row">
					<div>
						<strong>Template Cache</strong>
						<small>Clear cached views and event output.</small>
					</div>
					<button
						type="submit"
						class="btn btn-outline-secondary"
						formaction="#event.buildLink( "settings/clear-template-cache" )#">Clear</button>
				</div>
				<div class="setting-row">
					<div>
						<strong>Sessions Cache</strong>
						<small>Ends active sessions and clears flash messages and password reset tokens.</small>
					</div>
					<button
						type="submit"
						class="btn btn-outline-danger"
						formaction="#event.buildLink( "settings/clear-sessions-cache" )#">Clear</button>
				</div>
				<div class="setting-row">
					<div>
						<strong>Remembered Browsers</strong>
						<small>Require every remembered browser to sign in again.</small>
					</div>
					<button
						type="submit"
						class="btn btn-outline-danger"
						formaction="#event.buildLink( "settings/revoke-remember-tokens" )#">Revoke
						All</button>
				</div>
			</div>
		</section>
	</div>
</form>
</bx:output>
