/**
 * Route middleware that throttles sensitive endpoints by client IP.
 *
 * Extends cbsecurity's Throttle so the 429 handling, the X-RateLimit headers and the
 * fixed-window counting come from the module, and overrides only what this application
 * does differently:
 *
 * - Limits are the admin-editable settings cbRateLimitMaxAttempts and
 *   cbRateLimitWindowSeconds rather than static route meta.
 * - Counters live in the "rateLimit" CacheBox region (app/config/CacheBox.bx).
 * - The client IP honors the cbTrustProxyHeaders setting.
 * - A route that sets the "throttleRedirect" meta key answers a blocked request with a
 *   flash message and a redirect, so HTML forms get a page instead of bare JSON. Routes
 *   without it get the module's JSON 429 with a Retry-After header.
 *
 * Route meta keys:
 * - throttleRedirect: event or URL to send a blocked HTML request back to.
 * - throttleTokenParam: request key echoed onto that redirect so the form can re-render.
 *
 * See docs/guides/security.md#rate-limiting.
 */
@singleton
class extends="cbsecurity.models.middleware.Throttle" {

	@inject( "provider:SettingService" )
	property name="settingService";

	@inject( "provider:AuditLogService" )
	property name="auditLogService";

	@inject( "coldbox:flash" )
	property name="flash";

	/**
	 * Skips throttling entirely when the window or the attempt limit is set to 0 or less,
	 * which is how an admin switches rate limiting off, then defers to the module.
	 *
	 * @event The request context.
	 * @rc    The request collection.
	 * @prc   The private request collection.
	 *
	 * @return True when the request was blocked and the remaining middleware must be skipped.
	 */
	boolean function preProcess( required event, rc, prc ) {
		var limit = resolveLimit( arguments.event )
		if ( limit.decaySeconds <= 0 || limit.maxAttempts <= 0 ) {
			return false
		}
		return super.preProcess( argumentCollection = arguments )
	}

	/**
	 * Builds the limit from the settings registry instead of route meta.
	 *
	 * The counter is named after the current event, so each endpoint keeps its own
	 * count and exhausting the login limit does not affect registration.
	 *
	 * @event The request context.
	 *
	 * @return The limit struct the module's Throttle expects.
	 */
	private struct function resolveLimit( required event ) {
		return {
			maxAttempts  : variables.settingService.getSetting( "cbRateLimitMaxAttempts", 5 ),
			decaySeconds : variables.settingService.getSetting( "cbRateLimitWindowSeconds", 300 ),
			cacheProvider: "rateLimit",
			by           : "ip",
			name         : arguments.event.getCurrentEvent()
		}
	}

	/**
	 * Resolves the client IP.
	 *
	 * trustUpstream mirrors cbTrustProxyHeaders: a caller can set X-Forwarded-For to
	 * anything, so trusting it without knowing the app sits behind a proxy that sets it
	 * itself would let an attacker get a fresh bucket on every request just by changing
	 * the header. See SettingService's cbTrustProxyHeaders doc comment for the tradeoff.
	 *
	 * @event The request context.
	 *
	 * @return The client IP address.
	 */
	string function getClientIP( required event ) {
		return variables.cbSecurity.getRealIP(
			trustUpstream = variables.settingService.getSetting( "cbTrustProxyHeaders", true )
		)
	}

	/**
	 * Audits the block, then answers it: a redirect with a flash message when the route
	 * opted in through "throttleRedirect", otherwise the module's JSON 429.
	 *
	 * @event      The request context.
	 * @statusCode The HTTP status code.
	 * @message    The error message.
	 * @headers    Extra response headers as name-value pairs.
	 *
	 * @return Always true, so callers can return it to stop the remaining middleware.
	 */
	boolean function deny(
		required event,
		numeric statusCode = 403,
		string message     = "Forbidden",
		struct headers     = {}
	) {
		var currentEvent = arguments.event.getCurrentEvent()

		variables.auditLogService.warn(
			action     : "security.ratelimit.blocked",
			message    : "Rate limit exceeded for [#currentEvent#].",
			category   : "security",
			targetType : "Event",
			targetLabel: currentEvent
		)

		var redirectTo = getMetaValue( arguments.event, "throttleRedirect", "" )
		if ( !len( redirectTo ) ) {
			return super.deny( argumentCollection = arguments )
		}

		variables.flash.put( "messages", {
			type   : "error",
			message: "Too many attempts. Please wait a few minutes and try again."
		} )

		var tokenParam = getMetaValue( arguments.event, "throttleTokenParam", "" )
		var tokenValue = len( tokenParam ) ? arguments.event.getValue( tokenParam, "" ) : ""
		if ( len( tokenValue ) ) {
			redirectTo &= "?#tokenParam#=#encodeForURL( tokenValue )#"
		}

		arguments.event.relocate( redirectTo )
		return true
	}

}
