/**
 * A cbgenesis basic entity which provides uniformity to all persistent objects
 */
@mappedsuperclass( true )
class extends="cborm.models.ActiveEntity" {

	/**
	 * --------------------------------------------------------------------------
	 * Non-Persisted Properties
	 * --------------------------------------------------------------------------
	 */
	property name="primaryKey" type="string";

	property name="entityName" type="string";

	/**
	 * --------------------------------------------------------------------------
	 * Persisted Properties
	 * --------------------------------------------------------------------------
	 */

	@ormtype( "timestamp" )
	@notnull( "true" )
	@update( "false" )
	property
		name="createdDate"
		type="date";

	@ormtype( "timestamp" )
	@notnull( "true" )
	property
		name="modifiedDate"
		type="date";

	@ormtype( "boolean" )
	@sqltype( "boolean" )
	@notnull( "true" )
	property
		name="isActive"
		default="true";

	/**
	 * Constructor
	 *
	 * @primaryKey - The primary key of the entity, defaults to id
	 * @entityName - The name of the entity, defaults to the class name
	 *
	 */
	function init( primaryKey = "id", entityName ) {
		variables.isActive = true
		variables.createdDate = now()
		variables.modifiedDate = now()
		variables.primaryKey = arguments.primaryKey
		variables.entityName = arguments.entityName ?: this.$bx.meta.name

		// init the active entity
		super.init()

		// Incorporate default includes for the base class.
		if ( !isNull( this.memento.defaultIncludes ) && isNull( this.memento.baseIncluded ) ) {
			this
				.memento
				.defaultIncludes
				.append(
					[ variables.primaryKey, "createdDate", "modifiedDate", "isActive" ],
					true
				)
			this.memento.baseIncluded = true
		}

		return this
	}

	/**
	 * Returns the primary key value of the entity
	 */
	string function getId(){
		return variables[ variables.primaryKey ]
	}

	/**
	 * Do we have a new or loaded entity
	 */
	boolean function isLoaded() {
		return ( !isNull( variables[ variables.primaryKey ] ) && len( variables[ variables.primaryKey ] ) )
	}

	/**
	 * This method appends items to a memento list, the "defaultIncludes" is the default target
	 *
	 * @collection The array to append
	 * @target     The target to append to: defaultIncludes, defaultExcludes, neverInclude, defaults, etc.
	 */
	function appendToMemento( required collection, target = "defaultIncludes" ) {
		var filtered = arguments.collection.filter( ( item ) => !this.memento[ target ].containsNoCase( item ) )
		this.memento[ arguments.target ].append( filtered, true )
		return this
	}

	/***** Persistence Events : Modeled After ORM Events ******/

	/**
	 * Called before an entity is inserted
	 */
	function preInsert() {
		var rightNow = now();
		// prevent override of explicit stamps from imports
		if ( isNull( variables.createdDate ) ) {
			variables.createdDate = rightNow;
		}
		if ( isNull( variables.modifiedDate ) ) {
			variables.modifiedDate = rightNow;
		}
	}

	/**
	 * Called before an entity is updated
	 */
	function preUpdate( struct oldData ) {
		variables.modifiedDate = now();
	}

}