/**
 * Permission Service for managing system permissions
 */
@singleton
@threadSafe
class extends="app.models.BaseService" {

	/**
	 * Constructor
	 */
	function init() {
		super.init( entityName: "Permission" )
		return this;
	}

	/**
	 * Retrieves all permissions for use in lookups, returning only the permissionId and permission properties.
	 *
	 * @return array An array of structs containing permissionId and permission properties for each permission.
	 */
	array function getAllForLookup(){
		return getAll( properties: "permissionId as permissionId,permission as permission" )
	}

}