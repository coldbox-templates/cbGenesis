/**
 * Permission Service for managing system permissions
 */
class extends="app.models.BaseService" {

	/**
	 * Constructor
	 */
	function init() {
		return this;
	}

	/**
	 * New Permission Dispenser
	 */
	@provider( "Permission" )
	Permission function new() {
	}

	/**
	 * Get a permission by id
	 *
	 * @permissionId The id of the permission to retrieve
	 *
	 * @return The located permission or a new un-loaded permission object
	 */
	Permission function getById( required permissionId ) {
		return populator.populateFromStruct(
				target            = new(),
				memento           = qb
					.from( "permissions" )
					.where( "permissionId", arguments.permissionId )
					.first(),
				ignoreTargetLists = true
			)
	}

	/**
	 * Get a permission by its permission name
	 *
	 * @permission The permission name to look up
	 *
	 * @return The located permission or a new un-loaded permission object
	 */
	Permission function getByName( required permission ) {
		return populator.populateFromStruct(
				target            = new(),
				memento           = qb
					.from( "permissions" )
					.where( "permission", arguments.permission )
					.first(),
				ignoreTargetLists = true
			)
	}

	/**
	 * List all permissions
	 *
	 * @sortOrder The sort order for the listing
	 * @sortDirection The sort direction for the listing
	 *
	 * @return Array of Permission entities
	 */
	any function list(
		string sortOrder = "permission",
		string sortDirection = "asc"
	) {
		arguments.sortDirection = ensureSortOrder( arguments.sortDirection )

		return qb
			.from( "permissions" )
			.orderBy( arguments.sortOrder )
			.get()
			.map(
				( item ) => {
					return populator.populateFromStruct(
						target            = new(),
						memento           = item,
						ignoreTargetLists = true
					)
				}
			)
	}

	/**
	 * Save a permission in the database
	 *
	 * @permission The permission to save
	 *
	 * @return The persisted permission
	 */
	Permission function save( required permission ) {
		var qResults = qb
			.from( "permissions" )
			.where( "permissionId", arguments.permission.getId() )
			.updateOrInsert(
				{
					"permissionId": arguments.permission.getId(),
					"isActive"   : arguments.permission.getIsActive(),
					"permission" : arguments.permission.getPermission(),
					"description": arguments.permission.getDescription()
				}
			)

		// populate the id if newly created
		if ( !arguments.permission.isLoaded() ) {
			arguments.permission.setId( qResults.result.generatedKey )
		}

		return arguments.permission
	}

	/**
	 * Delete a permission
	 *
	 * @permission The permission to delete
	 *
	 * @return true if deleted, false if not found
	 */
	boolean function delete( required permission ) {
		return this.deleteById( arguments.permission.getId() )
	}

	/**
	 * Delete a permission
	 *
	 * @permissionId The id of the permission to delete
	 *
	 * @return true if deleted, false if not found
	 */
	boolean function deleteById( required permissionId ) {
		var result = qb
			.from( "permissions" )
			.where( "permissionId", arguments.permissionId )
			.delete()
		return result > 0
	}

	/**
	 * Check if a permission exists by id
	 *
	 * @permissionId The id of the permission to check
	 *
	 * @return true if it exists, false otherwise
	 */
	boolean function exists( required permissionId ) {
		return qb
				.from( "permissions" )
				.where( "permissionId", arguments.permissionId )
				.where( "isActive", true )
				.exists()
	}

	/**
	 * Get all roles that have this permission assigned
	 *
	 * @permissionId The id of the permission
	 *
	 * @return Array of Role entities
	 */
	array function getRolesForPermission( required permissionId ) {
		var results = qb
			.from( "roles" )
			.join(
				"role_permissions",
				"roles.roleId",
				"=",
				"role_permissions.roleId"
			)
			.where( "role_permissions.permissionId", arguments.permissionId )
			.where( "roles.isActive", true )
			.get()

		return results.map(
				( item ) => {
					return populator.populateFromStruct(
							target            = wirebox.getInstance( "Role" ),
							memento           = item,
							ignoreTargetLists = true
						)
				}
			)
	}
}