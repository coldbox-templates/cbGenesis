/**
 * A system role that groups permissions together.
 */
@persistent( true )
@table( "roles" )
class extends="app.models.BaseEntity" {

	/**
	 * --------------------------------------------------------------------------
	 * Properties
	 * --------------------------------------------------------------------------
	 */

	/**
	 * The role ID (uuid) for this role.
	 */
	@fieldType( "id" )
	@generator( "uuid" )
	property
		name="roleId"
		setter="false";

	/**
	 * The role name for this role.
	 */
	@notNull( true )
	@unique( true )
	property name="role" default="";

	/**
	 * The description for this role.
	 */
	@ormType( "text" )
	property name="description" default="";

	/**
	 * --------------------------------------------------------------------------
	 * Relationships
	 * --------------------------------------------------------------------------
	 */

	/**
	 * Permissions that belong to this role.
	 */
	@fieldtype( "many-to-many" )
	@lazy( "true" )
	@orderby( "permission" )
	@cascade( "save-update" )
	@class( "app.models.security.Permission" )
	@fkcolumn( "FK_roleId" )
	@linktable( "role_permissions" )
	@inversejoincolumn( "FK_permissionId" )
	property
		name="permissions"
		type="array";

	/**
	 * Users that have this role.
	 */
	@fieldtype( "many-to-many" )
	@lazy( true )
	@orderby( "email" )
	@cascade( "save-update" )
	@class( "app.models.system.User" )
	@fkcolumn( "FK_roleId" )
	@linktable( "user_roles" )
	@inversejoincolumn( "FK_userId" )
	@inverse( true )
	@singularName( "user" )
	property
		name="users"
		type="array";

	/**
	 * --------------------------------------------------------------------------
	 * Validation Constraints
	 * --------------------------------------------------------------------------
	 * https://coldbox-validation.ortusbooks.com/overview/valid-constraints
	 */
	this.constraints = {
		role: {
			required: true,
			size    : "1..255",
			validator: "UniqueValidator@cborm"
		},
		description: { required: false }
	}

	/**
	 * --------------------------------------------------------------------------
	 * Population Options
	 * --------------------------------------------------------------------------
	 */
	this.population = {}

	/**
	 * --------------------------------------------------------------------------
	 * Mementifier Options
	 * --------------------------------------------------------------------------
	 * https://forgebox.io/view/mementifier
	 */
	this.memento = {
		defaultIncludes: [
			"role",
			"description",
			"permissions",
			"usersCount"
		],
		defaultExcludes: [],
		neverInclude   : []
	}

	/**
	 * Constructor
	 */
	function init() {
		super.init( "roleId" )
		variables.role = ""
		variables.description = ""
		variables.permissions = []
		variables.users = []

		return this;
	}

	/**
	 * Check how many users are assigned to this role.
	 *
	 * @return The number of users assigned to this role.
	 */
	numeric function getUsersCount() {
		if( !hasUser() ) {
			return 0
		}
		return newCriteria()
			.eq( "roleId", getRoleId() )
			.count( "users" )
	}

	/**
	 * Clear all permissions
	 */
	Role function clearPermissions() {
		variables.permissions = []
		return this
	}

	/**
	 * Override the setPermissions
	 * So hibernate can handle the many to many relationship properly
	 */
	Role function setPermissions( required array permissions ) {
		if ( !isNull( variables.permissions ) && !variables.permissions.isEmpty() ) {
			variables.permissions.clear();
			variables.permissions.addAll( arguments.permissions );
		} else {
			variables.permissions = arguments.permissions;
		}
		return this;
	}

	/**
	 * Clear all users
	 */
	Role function clearUsers() {
		variables.users = []
		return this
	}

	/**
	 * Override the setUsers
	 * So hibernate can handle the many to many relationship properly
	 */
	Role function setUsers( required array users ) {
		if ( !isNull( variables.users ) && !variables.users.isEmpty() ) {
			variables.users.clear()
			variables.users.addAll( arguments.users )
		} else {
			variables.users = arguments.users
		}
		return this
	}

	/**
	 * Check for specific permission by slug, one, list or an array of slugs.
	 *
	 * @slug A permission slug, list of slugs or an array of slugs to check for.
	 *
	 * @return True if the role has the specified permission(s), false otherwise.
	 */
	boolean function hasPermission( required slug ) {
		// no perms, just return false
		if ( isNull( variables.permissions ) || variables.permissions.isEmpty() ) {
			return false
		}

		if( isSimpleValue( arguments.slug ) ) {
			arguments.slug = listToArray( arguments.slug )
		}

		// check for any incoming matching permission
		for( var thisSlug in arguments.slug ){
			if( variables.permissions.some( perm => perm.getPermission() == thisSlug ) ) {
				return true
			}
		}

		// no matches found
		return false
	}

}