/**
 * A system role that groups permissions together.
 */
class extends="app.models.BaseEntity" {
	/**
	 * --------------------------------------------------------------------------
	 * Properties
	 * --------------------------------------------------------------------------
	 */

	/**
	 * The role ID (UUID) for this role.
	 */
	property name="roleId" type="uuid" default="";

	/**
	 * The role name for this role.
	 */
	property name="role" default="";

	/**
	 * The description for this role.
	 */
	property name="description" default="";

	/**
	 * --------------------------------------------------------------------------
	 * Validation Constraints
	 * --------------------------------------------------------------------------
	 * https://coldbox-validation.ortusbooks.com/overview/valid-constraints
	 */
	this.constraints = {
		role: {
			required: true,
			size    : "1..255",
			unique  : { table: "roles", column: "role" }
		},
		description: { required: false }
	}

	/**
	 * --------------------------------------------------------------------------
	 * Population Options
	 * --------------------------------------------------------------------------
	 */
	this.population = {}

	/**
	 * --------------------------------------------------------------------------
	 * Mementifier Options
	 * --------------------------------------------------------------------------
	 * https://forgebox.io/view/mementifier
	 */
	this.memento = {
		defaultIncludes: [ "*"],
		defaultExcludes: [],
		neverInclude   : []
	}

	/**
	 * Constructor
	 */
	function init() {
		super.init( "roleId" )
		variables.role = ""
		variables.description = ""

		return this;
	}

}