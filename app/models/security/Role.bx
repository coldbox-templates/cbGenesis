/**
 * A system role that groups permissions together.
 */
@persistent( true )
@table( "roles" )
class extends="app.models.BaseEntity" {

	/**
	 * --------------------------------------------------------------------------
	 * Properties
	 * --------------------------------------------------------------------------
	 */

	/**
	 * The role ID (UUID) for this role.
	 */
	@fieldType( "id" )
	@generator( "uuid" )
	property
		name="roleId"
		setter="false";

	/**
	 * The role name for this role.
	 */
	@notNull( true )
	@unique( true )
	property name="role" default="";

	/**
	 * The description for this role.
	 */
	@ormType( "text" )
	property name="description" default="";

	/**
	 * --------------------------------------------------------------------------
	 * Relationships
	 * --------------------------------------------------------------------------
	 */

	property
		name="permissions"
		fieldtype="many-to-many"
		type="array"
		lazy="extra"
		orderby="permission"
		cascade="save-update"
		class="app.models.security.Permission"
		fkcolumn="FK_roleId"
		linktable="role_permissions"
		inversejoincolumn="FK_permissionId";

	property
		name="users"
		fieldtype="many-to-many"
		type="array"
		lazy="extra"
		orderby="email"
		cascade="save-update"
		class="app.models.system.User"
		fkcolumn="FK_roleId"
		linktable="user_roles"
		inversejoincolumn="FK_userId";

	/**
	 * --------------------------------------------------------------------------
	 * Validation Constraints
	 * --------------------------------------------------------------------------
	 * https://coldbox-validation.ortusbooks.com/overview/valid-constraints
	 */
	this.constraints = {
		role: {
			required: true,
			size    : "1..255",
			validator: "UniqueValidator@cborm"
		},
		description: { required: false }
	}

	/**
	 * --------------------------------------------------------------------------
	 * Population Options
	 * --------------------------------------------------------------------------
	 */
	this.population = {}

	/**
	 * --------------------------------------------------------------------------
	 * Mementifier Options
	 * --------------------------------------------------------------------------
	 * https://forgebox.io/view/mementifier
	 */
	this.memento = {
		defaultIncludes: [ "*"],
		defaultExcludes: [],
		neverInclude   : []
	}

	/**
	 * Constructor
	 */
	function init() {
		super.init( "roleId" )
		variables.role = ""
		variables.description = ""
		variables.permissions = []
		variables.users = []

		return this;
	}

}