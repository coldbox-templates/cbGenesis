/**
 * Role Service for managing system roles and their permissions
 */
@singleton
@threadSafe
class extends="app.models.BaseService" {

	@inject( "provider:UserService" )
	property name="userService";

	/**
	 * Constructor
	 */
	function init() {
		super.init( entityName: "Role" )
		return this
	}

	/**
	 * Retrieves all roles for use in lookups, returning only the roleId and role properties.
	 *
	 * @return array An array of structs containing roleId and role properties for each role.
	 */
	array function getAllForLookup(){
		return getAll( properties: "roleId as roleId,role as role" )
	}

	/**
	 * Deletes a role and removes it from all users.
	 *
	 * @role The role to be deleted.
	 *
	 * @return RoleService The current instance of the RoleService for method chaining.
	 */
	RoleService function deleteRole( required Role role ) {
		transaction {
			userService.removeRoleFromUsers( arguments.role )
			arguments.role.clearUsers().clearPermissions()
			super.delete( arguments.role )
		}
		return this
	}

}