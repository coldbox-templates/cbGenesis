/**
 * Role Service for managing system roles and their permissions
 */

class {

	/**
	 * Constructor
	 */
	function init() {
		return this;
	}

	/**
	 * New Role Dispenser
	 */
	@provider( "Role" )
	Role function new() {

	}

	/**
	 * Get a role by id
	 *
	 * @roleId The id of the role to retrieve
	 *
	 * @return The located role or a new un-loaded role object
	 */
	Role function getById( required roleId ) {
		return populator.populateFromStruct(
				target            = new(),
				memento           = qb
					.from( "roles" )
					.where( "roleId", arguments.roleId )
					.first(),
				ignoreTargetLists = true
			)
	}

	/**
	 * Get a role by its role name
	 *
	 * @role The role name to look up
	 *
	 * @return The located role or a new un-loaded role object
	 */
	Role function getByName( required role ) {
		return populator.populateFromStruct(
				target            = new(),
				memento           = qb
					.from( "roles" )
					.where( "role", arguments.role )
					.first(),
				ignoreTargetLists = true
			)
	}

	/**
	 * List all roles
	 *
	 * @sortOrder The sort order for the listing
	 * @sortDirection The sort direction for the listing
	 *
	 * @return Array of Role entities
	 */
	any function list(
		string sortOrder = "role",
		string sortDirection = "asc"
	) {
		arguments.sortDirection = ensureSortOrder( arguments.sortDirection )

		return qb
			.from( "roles" )
			.orderBy( arguments.sortOrder )
			.get()
			.map(
				( item ) => {
					return populator.populateFromStruct(
						target            = new(),
						memento           = item,
						ignoreTargetLists = true
					)
				}
			)
	}

	/**
	 * Save a role in the database
	 *
	 * @role The role to save
	 *
	 * @return The persisted role
	 */
	Role function save( required role ) {
		var qResults = qb
			.from( "roles" )
			.where( "roleId", arguments.role.getId() )
			.updateOrInsert(
				values = {
					"roleId"     : arguments.role.getId(),
					"isActive"   : arguments.role.getIsActive(),
					"role"       : arguments.role.getRole(),
					"description": arguments.role.getDescription()
				}
			)

		// populate the id if newly created
		if ( !arguments.role.isLoaded() ) {
			arguments.role.setId( qResults.result.generatedKey )
		}

		return arguments.role
	}

	/**
	 * Delete a role
	 *
	 * @role The role to delete
	 *
	 * @return true if deleted, false if not found
	 */
	boolean function delete( required role ) {
		return this.deleteById( arguments.role.getId() )
	}

	/**
	 * Delete a role
	 *
	 * @roleId The id of the role to delete
	 *
	 * @return true if deleted, false if not found
	 */
	boolean function deleteById( required roleId ) {
		var result = qb
			.from( "roles" )
			.where( "roleId", arguments.roleId )
			.delete()
		return result > 0
	}

	/**
	 * Check if a role exists by id
	 *
	 * @roleId The id of the role to check
	 *
	 * @return true if it exists, false otherwise
	 */
	boolean function exists( required roleId ) {
		return qb
				.from( "roles" )
				.where( "roleId", arguments.roleId )
				.where( "isActive", true )
				.exists()
	}

	/**
	 * Get all permissions assigned to a role
	 *
	 * @roleId The id of the role
	 *
	 * @return Array of Permission entities
	 */
	array function getPermissionsForRole( required roleId ) {
		var results = qb
			.from( "permissions" )
			.join(
				"role_permissions",
				"permissions.permissionId",
				"=",
				"role_permissions.permissionId"
			)
			.where( "role_permissions.roleId", arguments.roleId )
			.where( "permissions.isActive", true )
			.get()

		return results.map(
				( item ) => {
					return populator.populateFromStruct(
							target            = wirebox.getInstance( "Permission" ),
							memento           = item,
							ignoreTargetLists = true
						)
				}
			)
	}

	/**
	 * Assign a permission to a role
	 *
	 * @roleId       The id of the role
	 * @permissionId The id of the permission to assign
	 *
	 * @return This role service
	 */
	RoleService function assignPermission( required roleId, required permissionId ) {
		var existing = qb
			.from( "role_permissions" )
			.where( "roleId", arguments.roleId )
			.where( "permissionId", arguments.permissionId )
			.first();

		if ( isNull( existing ) ) {
			qb.from( "role_permissions" ).insert(
					{
						"roleId"      : arguments.roleId,
						"permissionId": arguments.permissionId,
						"createdDate" : now(),
						"modifiedDate": now()
					}
				);
		}

		return this;
	}

	/**
	 * Remove a permission from a role
	 *
	 * @roleId       The id of the role
	 * @permissionId The id of the permission to remove
	 *
	 * @return This role service
	 */
	RoleService function removePermission( required roleId, required permissionId ) {
		qb
			.from( "role_permissions" )
			.where( "roleId", arguments.roleId )
			.where( "permissionId", arguments.permissionId )
			.delete();

		return this;
	}

	/**
	 * Check if a role has a specific permission
	 *
	 * @roleId       The id of the role
	 * @permissionId The id of the permission to check
	 *
	 * @return true if the role has the permission, false otherwise
	 */
	boolean function hasPermission( required roleId, required permissionId ) {
		return qb
				.from( "role_permissions" )
				.where( "roleId", arguments.roleId )
				.where( "permissionId", arguments.permissionId )
				.count() >
			0;
	}

	/**
	 * Sync a role's permissions by replacing the entire set in a transaction
	 *
	 * @roleId        The id of the role
	 * @permissionIds An array of permission ids to assign
	 *
	 * @return This role service
	 */
	RoleService function syncPermissions( required roleId, required array permissionIds ) {
		transaction {
			// Remove all existing permissions for this role
			qb
				.from( "role_permissions" )
				.where( "roleId", arguments.roleId )
				.delete();

			// Insert the new set
			arguments.permissionIds.each(
					( permissionId ) => {
						qb.from( "role_permissions" ).insert(
								{
									"roleId"      : arguments.roleId,
									"permissionId": permissionId,
									"createdDate" : now(),
									"modifiedDate": now()
								}
							);
					}
				);
		}

		return this;
	}
}