/**
 * Service for managing user API tokens.
 *
 * Tokens are SHA-256 hashed before storage. The raw token value is returned
 * only once from createToken(). Use validateToken() to authenticate
 * incoming requests by their raw token value.
 */
class extends="app.models.BaseService" {

	/**
	 * Constructor
	 */
	function init() {
		return this;
	}

	/**
	 * WireBox provider for creating new APIToken instances.
	 */
	@provider( "APIToken" )
	APIToken function new() {
	}

	/**
	 * Retrieve a single token by its ID.
	 *
	 * @tokenId The UUID of the token to retrieve.
	 */
	APIToken function getById( required tokenId ) {
		return populator.populateFromStruct(
			target : new(),
			memento: qb
				.from( "user_api_tokens" )
				.where( "tokenId", arguments.tokenId )
				.first(),
			ignoreTargetLists: true
		)
	}

	/**
	 * List all API tokens for a given user, ordered by creation date (newest first).
	 *
	 * @userId  The user UUID whose tokens to list.
	 * @orderBy The column to order by. Defaults to "createdDate".
	 * @orderDirection The order direction, either "asc" or "desc". Defaults to "desc".
	 *
	 * @return An array of APIToken entities.
	 */
	array function getTokensForUser( required userId, orderBy = "createdDate", orderDirection = "desc" ) {
		arguments.orderDirection = ensureSortOrder( arguments.orderDirection )

		return qb.from( "user_api_tokens" )
			.where( "FK_userId", arguments.userId )
			.orderBy( arguments.orderBy, arguments.orderDirection )
			.get()
			.map( ( item ) => populator.populateFromStruct(
				target           = new(),
				memento          = item,
				ignoreTargetLists = true
			) )
	}

	/**
	 * Create a new API token for a user.
	 *
	 * Generates a random prefixed token, hashes it with SHA-256 for storage,
	 * and returns the raw token value. The raw value is NOT stored and cannot
	 * be retrieved again.
	 *
	 * @token An APIToken entity with the userId, label, and optional expiration set.
	 *
	 * @return     The raw token string (e.g., "cbg_a3f8b2c..."). Returned once.
	 */
	string function createToken( required APIToken token ) {
		// Generate a cryptographically-random raw token with a readable prefix
		var rawToken = "cbg_" & hash( createUUID(), "SHA-256" )

		// Hash the raw token for database storage (64-char hex digest)
		var hashedToken = hash( rawToken, "SHA-256" )

		qb.from( "user_api_tokens" ).insert( {
			"isActive"    : true,
			"FK_userId"   : arguments.token.getFK_userId(),
			"label"       : arguments.token.getLabel(),
			"token"       : hashedToken,
			"expiration"  : arguments.token.hasExpiration() ? arguments.token.getExpiration() : null
		} )

		return rawToken
	}

	/**
	 * Update an existing token's label, expiration, or isActive status.
	 *
	 * @token An APIToken entity with the tokenId, label, and optional expiration set.
	 */
	string function updateToken( required APIToken token ) {
		qb.from( "user_api_tokens" )
			.where( "tokenId", arguments.token.getTokenId() )
			.update( {
				"label"      : arguments.token.getLabel(),
				"expiration" : arguments.token.hasExpiration() ? arguments.token.getExpiration() : null,
				"isActive"   : arguments.token.getIsActive()
			} )
	}

	/**
	 * Validate a raw token value.
	 *
	 * Hashes the raw token, looks up the hash in the database, checks that
	 * the token is active and not expired, then updates the lastUsed timestamp.
	 *
	 * @rawToken The raw token string to validate (e.g., "cbg_a3f8b2c...").
	 *
	 * @return   The populated APIToken entity if valid, or an unloaded entity if invalid.
	 */
	APIToken function validateToken( required rawToken ) {
		var hashedToken = hash( arguments.rawToken, "SHA-256" )
		var oToken = populator.populateFromStruct(
			memento = qb.from( "user_api_tokens" )
				.whereToken( hashedToken )
				.whereIsActive( true )
				.first(),
			target = new(),
			ignoreTargetLists = true
		)

		// If the token is not found or inactive, return an unloaded entity
		if ( !oToken.isLoaded() ) {
			return oToken
		}

		// If expired, revoke it and return an unloaded entity
		if ( oToken.isExpired() ) {
			// Token is expired — revoke it
			qb.table( "user_api_tokens" )
				.where( "tokenId", oToken.getTokenId() )
				.update( { "isActive": false } )
			return new()
		}

		// Update lastUsed timestamp
		qb.table( "user_api_tokens" )
			.where( "tokenId", oToken.getTokenId() )
			.update( { "lastUsed": now() } )

		return oToken
	}

	/**
	 * Validate a raw token value and throw an exception if invalid.
	 *
	 * @rawToken The raw token string to validate (e.g., "cbg_a3f8b2c...").
	 *
	 * @return   The populated APIToken entity if valid.
	 *
	 * @throws ValidationException if the token is invalid or expired.
	 */
	APIToken function validateOrFail( required rawToken ) {
		var oToken = this.validateToken( arguments.rawToken )
		if ( !oToken.isLoaded() ) {
			throw( type="ValidationException", message="Invalid or expired API token." )
		}
		return oToken
	}

	/**
	 * Revoke (soft-delete) a single token by its ID.
	 *
	 * @tokenId The UUID of the token to revoke.
	 */
	void function revokeToken( required tokenId ) {
		qb.table( "user_api_tokens" )
			.where( "tokenId", arguments.tokenId )
			.update( { "isActive": false } )
	}

	/**
	 * Revoke all tokens for a given user.
	 *
	 * @userId The user UUID whose tokens to revoke.
	 */
	void function revokeAllForUser( required userId ) {
		qb.table( "user_api_tokens" )
			.where( "FK_userId", arguments.userId )
			.update( { "isActive": false } )
	}

	/**
	 * Hard-delete all expired tokens from the database.
	 *
	 * Useful for periodic cleanup via a scheduled task.
	 */
	void function deleteExpired() {
		qb.table( "user_api_tokens" )
			.whereNotNull( "expiration" )
			.where( "expiration", "<=", now() )
			.delete()
	}

}
