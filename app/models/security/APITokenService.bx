/**
 * Service for managing user API tokens.
 *
 * Tokens are SHA-256 hashed before storage. The raw token value is returned
 * only once from createToken(). Use validateToken() to authenticate
 * incoming requests by their raw token value.
 */
@singleton
@threadSafe
class extends="app.models.BaseService" {

	@inject( "SettingService" )
	property name="settingService";

	/**
	 * Initialize the API token service.
	 *
	 * @return The initialized service.
	 */
	function init() {
		super.init( entityName: "APIToken" )
		return this
	}

	/**
	 * --------------------------------------------------------------------------
	 * Public Methods
	 * --------------------------------------------------------------------------
	 */

	/**
	 * Create a new API token for a user.
	 * The raw token is returned only in this response.
	 *
	 * @apiToken The API token entity to create.
	 *
	 * @return The raw token and safe token metadata: rawToken:string, token:APIToken
	 */
	struct function createToken( required APIToken apiToken ) {
		validateExpiration( arguments.apiToken.getExpiration() )
		var rawToken = arguments.apiToken.getToken()
		arguments.apiToken.setToken( hashToken( rawToken ) )

		super.save( arguments.apiToken )

		return {
			rawToken: rawToken,
			token: arguments.apiToken
		}
	}

	/**
	 * Create the deterministic digest used for indexed token lookup.
	 *
	 * @rawToken The raw token value.
	 * @return The SHA-256 digest of the raw token.
	 */
	private string function hashToken( required string rawToken ) {
		return hash( arguments.rawToken, "SHA-256" )
	}

	/**
	 * Ensure a token expiration does not exceed the configured maximum validity.
	 *
	 * @expiration The expiration date to validate.
	 *
	 * @throws APIToken.InvalidExpiration when the expiration exceeds the maximum validity.
	 */
	private void function validateExpiration( any expiration ) {
		if ( isNull( arguments.expiration ) ) {
			return
		}

		var maxMonths = settingService.getSetting( "cbApiTokenMaxValidityMonths" )
		var maxDate = dateAdd( "m", maxMonths, now() )
		if ( dateCompare( arguments.expiration, maxDate, "d" ) > 0 ) {
			throw(
				type    = "APIToken.InvalidExpiration",
				message = "API token expiration cannot be more than #maxMonths# months from today."
			)
		}
	}

	/**
	 * List all API tokens for a user.
	 *
	 * @userId The user identifier
	 *
	 * @return An array of API token entities belonging to the user.
	 */
	array function listForUser( required string userId ) {
		return findAllWhere(
			criteria: { "user": arguments.userId },
			sortOrder: "label"
		)
	}

	/**
	 * Validate a raw API token and update its last-used timestamp.
	 * This is used to authenticate incoming requests that supply a raw token value.
	 *
	 * @rawToken The raw token supplied by the caller.
	 *
	 * @throws APIToken.Invalid when the token is missing, inactive, expired, or has no user.
	 *
	 * @return The active, non-expired API token entity.
	 */
	APIToken function validateToken( required string rawToken ) {
		var token = findWhere( {
			token   : hashToken( arguments.rawToken ),
			isActive: true
		} )

		// If the token is not found or not active
		if ( isNull( token ) || !token.getIsActive() ) {
			throw( type = "APIToken.Invalid", message = "Invalid API token" )
		}

		// Expired tokens
		if ( token.isExpired() || isNull( token.getUser() ) ) {
			throw( type = "APIToken.Invalid", message = "Invalid API token" )
		}

		token.setLastUsed( now() )
		return save( token )
	}

	/**
	 * Check whether a raw API token is valid without throwing an exception.
	 *
	 * @rawToken The raw token supplied by the caller.
	 *
	 * @return True when the token can be authenticated.
	 */
	boolean function isValidToken( required string rawToken ) {
		try {
			validateToken( arguments.rawToken )
			return true
		} catch ( any exception ) {
			return false
		}
	}

	/**
	 * Revoke one API token by marking it inactive.
	 *
	 * @tokenId The token identifier.
	 *
	 * @return True if the token was found and revoked, false if it was not found or already revoked.
	 *
	 * @throws APIToken.NotFound when no token matches the identifier.
	 */
	boolean function revokeToken( required string tokenId ) {
		var updateResult = variables.qb
			.table( "user_api_tokens" )
			.where( "tokenId", "=", arguments.tokenId )
			.where( "isActive", "=", true )
			.update( { isActive: false } )

		ormClearSession()
		return updateResult.result.recordcount == 1
	}

	/**
	 * Revoke every API token belonging to a user.
	 *
	 * @userId The user identifier.
	 *
	 * @return The number of affected token records.
	 */
	numeric function revokeAllForUser( required string userId ) {
		var updateResult = variables.qb
			.table( "user_api_tokens" )
			.where( "FK_userId", "=", arguments.userId )
			.update( { isActive: false } )

		return updateResult.result.recordcount
	}

	/**
	 * Delete tokens that have passed their expiration date.
	 *
	 * @return The number of expired tokens deleted.
	 */
	numeric function purgeExpiredTokens() {
		var result = variables.qb
			.table( "user_api_tokens" )
			.where( "expiration", "<", now() )
			.delete()

		return result?.result?.recordcount ?: 0
	}

}