/**
 * A system permission that can be assigned to roles.
 */
@persistent( true )
@table( "permissions" )
class extends="app.models.BaseEntity" {

	/**
	 * --------------------------------------------------------------------------
	 * Properties
	 * --------------------------------------------------------------------------
	 */

	/**
	 * The unique identifier for the permission.
	 */
	@fieldType( "id" )
	@generator( "uuid" )
	property
		name="permissionId"
		setter="false";

	/**
	 * The unique permission string (slug) that identifies the permission.
	 */
	@notNull( true )
	@unique( true )
	property name="permission" default="";

	/**
	 * A brief description of the permission.
	 */
	@ormType( "text" )
	property name="description" default="";

	/**
	 * --------------------------------------------------------------------------
	 * Relationships
	 * --------------------------------------------------------------------------
	 */

	/**
	 * Roles that have this permission.
	 */
	@fieldtype( "many-to-many" )
	@lazy( "true" )
	@orderby( "role" )
	@cascade( "save-update" )
	@class( "app.models.security.Role" )
	@fkcolumn( "FK_permissionId" )
	@linktable( "role_permissions" )
	@inversejoincolumn( "FK_roleId" )
	property
		name="roles"
		type="array";

	/**
	 * Users that have this permission.
	 */
	@fieldtype( "many-to-many" )
	@lazy( "true" )
	@cascade( "save-update" )
	@class( "app.models.system.User" )
	@fkcolumn( "FK_permissionId" )
	@linktable( "user_permissions" )
	@inversejoincolumn( "FK_userId" )
	property
		name="users"
		type="array";

	/**
	 * --------------------------------------------------------------------------
	 * Validation Constraints
	 * --------------------------------------------------------------------------
	 * https://coldbox-validation.ortusbooks.com/overview/valid-constraints
	 */
	this.constraints = {
		permission: {
			required: true,
			size    : "1..255",
			validator: "UniqueValidator@cborm"
		},
		description: { required: false }
	}

	/**
	 * --------------------------------------------------------------------------
	 * Population Control Options
	 * --------------------------------------------------------------------------
	 * https://coldbox.ortusbooks.com/the-basics/event-handlers/model-integration/model-data-binding#mass-population-control-this.population
	 */
	this.population = {}

	/**
	 * --------------------------------------------------------------------------
	 * Mementifier Options
	 * --------------------------------------------------------------------------
	 * https://forgebox.io/view/mementifier
	 */
	this.memento = {
		defaultIncludes: [
			"permission",
			"description",
			"prefix",
			"slug"
		],
		defaultExcludes: [],
		neverInclude   : []
	}

	/**
	 * Constructor
	 */
	function init() {
		super.init( "permissionId" )
		variables.permission = ""
		variables.description = ""
		variables.roles = []
		variables.users = []

		return this
	}

	/**
	 * Gets the prefix of the permission string (the part before the first :).
	 * Example: For permission "user:create", this method returns "user".
	 * If the permission string does not contain a colon, it returns an empty string.
	 *
	 * @return The prefix of the permission string, or an empty string if none exists.
	 */
	string function getPrefix(){
		if( variables.permission.contains( ":" ) ){
			return variables.permission.getToken( 1, ":" )
		}
		return ""
	}

	/**
	 * Gets the slug of the permission string (the part after the first :).
	 * Example: For permission "user:create", this method returns "create".
	 * If the permission string does not contain a colon, it returns the entire permission string.
	 *
	 * @return The slug of the permission string, or the entire permission string if no colon exists.
	 */
	string function getSlug(){
		if( variables.permission.contains( ":" ) ){
			return listRest( variables.permission, ":" )
		}
		return variables.permission
	}
}