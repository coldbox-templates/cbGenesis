/**
 * API Token entity for user-authenticated API access.
 *
 * Tokens are stored as SHA-256 hashes. The raw token value is returned
 * only at creation time via APITokenService.createToken().
 */
@persistent( true )
@table( "user_api_tokens" )
class extends="app.models.BaseEntity" {

	/**
	 * --------------------------------------------------------------------------
	 * Injections
	 * --------------------------------------------------------------------------
	 */
	@inject( "APITokenService" )
	@persistent( false )
	property name="apiTokenService";

	/**
	 * --------------------------------------------------------------------------
	 * Properties
	 * --------------------------------------------------------------------------
	 */

	/**
	 * The primary key (UUID) for this token.
	 */
	@fieldType( "id" )
	@generator( "uuid" )
	property
		name="tokenId"
		setter="false";

	/**
	 * The label for this token, provided by the user.
	 */
	@notNull( true )
	property name="label" default="";

	/**
	 * The SHA-256 hash of the token value. The raw token value is never stored.
	 */
	@notNull( true )
	@unique( true )
	property name="token" default="";

	/**
	 * The expiration date for this token, if any. Null means no expiration.
	 */
	property name="expiration" type="date";

	/**
	 * The last time this token was used, if any. Null means never used.
	 */
	property name="lastUsed" type="date";

	/**
	 * --------------------------------------------------------------------------
	 * Relationships
	 * --------------------------------------------------------------------------
	 */

	@notnull( true )
	@fieldtype( "many-to-one" )
	@class( "app.models.system.User" )
	@fkcolumn( "FK_userId" )
	@lazy( "proxy" )
	property name="user";

	/**
	 * --------------------------------------------------------------------------
	 * Validation Constraints
	 * --------------------------------------------------------------------------
	 * https://coldbox-validation.ortusbooks.com/overview/valid-constraints
	 */
	this.constraints = {
		"label": { required: true, size: "1..255" },
		"token": {
			required: true,
			unique  : { table: "user_api_tokens", column: "token" }
		}
	}

	/**
	 * --------------------------------------------------------------------------
	 * Population
	 * --------------------------------------------------------------------------
	 * Fields to exclude when populating the entity.
	 * https://coldbox.ortusbooks.com/the-basics/event-handlers/model-integration/model-data-binding#mass-population-control-this.population
	 */
	this.population = {
		excludes: [ "token", "user", "lastUsed" ]
	}

	/**
	 * --------------------------------------------------------------------------
	 * Serialization
	 * --------------------------------------------------------------------------
	 * NEVER expose the hashed token.
	 */
	this.memento = {
		defaultIncludes: [
			"label",
			"expiration",
			"lastUsed",
			"tokenSnapshot"
		],
		defaultExcludes: [],
		neverInclude   : [ "token" ]
	}

	/**
	 * Constructor
	 */
	function init() {
		super.init( "tokenId" )
		variables.label = ""
		variables.token = generateRawToken()
		variables.expiration = null
		variables.lastUsed = null
		return this
	}

	/**
	 * This method shows only a token identifier so folks can see which token they are using
	 * but never exposes the full token
	 */
	string function getTokenSnapshot(){
		if( variables.token.isEmpty() ){
			return ""
		}
		return left( variables.token, 5 ) & "****"
	}

	/**
	 * Check if the provided apiToken matches the user's current apiToken
	 *
	 * @apiToken The apiToken to check
	 *
	 * @return boolean True if the apiToken matches, false otherwise.
	 */
	boolean function sameApiToken( required string apiToken ) {
		return BCryptVerify( arguments.apiToken, getToken() )
	}

	/**
	 * Check if the provided user is the same as the user associated with this token.
	 *
	 * @target The user to compare against.
	 *
	 * @return boolean True if the users are the same, false otherwise.
	 */
	boolean function sameUser( required User target ){
		return !isNull( variables.user ) && !isNull( arguments.target ) && variables.user.getId() == arguments.target.getId()
	}

	/**
	 * Returns true if the token has an expiration date.
	 */
	boolean function hasExpiration() {
		return !isNull( variables.expiration );
	}

	/**
	 * Returns true if the token has an expiration date and it has passed.
	 */
	boolean function isExpired() {
		if ( isNull( variables.expiration ) ) {
			return false;
		}
		return dateCompare(
				variables.expiration,
				now(),
				"s"
			) <
			0;
	}

	/**
	 * Returns true if the token will expire within the given number of days.
	 *
	 * @days Number of days to check within. Defaults to 7.
	 *
	 * @return Boolean indicating if the token is expiring soon.
	 */
	boolean function isExpiringSoon( numeric days = 7 ) {
		if ( isNull( variables.expiration ) ) {
			return false
		}
		var threshold = dateAdd(
			"d",
			arguments.days,
			now()
		)

		return dateCompare(
					variables.expiration,
					threshold,
					"s"
				) <=
				0 &&
			!this.isExpired()
	}

	/**
	 * Set the expiration date for this token.
	 *
	 * @expiration The expiration date to set.
	 *
	 * @return The updated API token entity.
	 */
	APIToken function setExpiration( any expiration ) {
		variables.expiration = parseTokenExpiration( arguments.expiration )
		return this
	}

	/**
	 * --------------------------------------------------------------------------
	 * Private Methods
	 * --------------------------------------------------------------------------
	 */

	/**
	 * Generate a raw token using a cryptographically secure random number generator.
	 *
	 * @return A cryptographically generated token with a "cb_" prefix.
	 */
	private string function generateRawToken() {
		return "cb_" & generateSecretKey( "AES", 256 )
	}

	/**
	 * Parse a token expiration date from a string.
	 *
	 * @expiration The expiration date as a string.
	 *
	 * @return The parsed date or null if the input is empty.
	 */
	private date function parseTokenExpiration( required string expiration ) {
		if ( isNull( arguments.expiration ) || !len( trim( arguments.expiration ) ) ) {
			return null
		}
		return parseDateTime( "#trim( arguments.expiration )# 23:59:59" )
	}

}