/**
 * A cbgenesis basic entity which provides uniformity to all objects
 */

@singleton
@threadSafe
class {

	/**
	 * --------------------------------------------------------------------------
	 * Injections
	 * --------------------------------------------------------------------------
	 */
	property name="qb" inject="provider:QueryBuilder@qb";

	property name="coldbox" inject="coldbox";

	property name="wirebox" inject="wirebox";

	property name="cache" inject="cachebox:template";

	property name="populator" inject="wirebox:populator";

	property name="validationManager" inject="ValidationManager@cbvalidation";

	property name="log" inject="logbox:logger:{this}";


	/**
	 * Ensure the sort order is valid.
	 *
	 * @orderDirection The order direction, either "asc" or "desc".
	 *
	 * @return The validated order direction.
	 */
	private string function ensureSortOrder( required orderDirection ) {
		var order = lcase( arguments.orderDirection )
		if ( listFindNoCase( "asc,desc", order ) == 0 ) {
			order = "desc"
		}
		return order
	}

}