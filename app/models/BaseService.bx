/**
 * A cbgenesis basic entity which provides uniformity to all objects
 */

@singleton
@threadSafe
class extends="cborm.models.VirtualEntityService" {
	/**
	 * --------------------------------------------------------------------------
	 * Injections
	 * --------------------------------------------------------------------------
	 */
	@inject( "provider:QueryBuilder@qb" )
	property name="qb";

	@inject( "coldbox" )
	property name="coldbox";

	@inject( "wirebox" )
	property name="wirebox";

	@inject( "cachebox:template" )
	property name="cache";

	@inject( "ValidationManager@cbvalidation" )
	property name="validationManager";

	@inject( "logbox:logger:{this}" )
	property name="log";

	/**
	 * Ensure a sort order contains only an allowed column and direction.
	 *
	 * @sortOrder        The requested column, or column plus "asc" or "desc".
	 * @sortMap          A map of allowed sort columns to entity properties.
	 * @defaultSortOrder The fallback sort order.
	 *
	 * @return The validated sort order.
	 */
	protected string function ensureSortOrder(
		required sortOrder,
		required sortMap,
		string defaultSortOrder = "lastName asc"
	) {
		var sortParts = reMatchNoCase( "\\S+", trim( arguments.sortOrder ?: "" ) )
		var sortColumn = sortParts.len() && structKeyExists( arguments.sortMap, sortParts[ 1 ] )
			? arguments.sortMap[ sortParts[ 1 ] ]
			: ""
		var sortDirection = sortParts.len() > 1 ? lcase( sortParts[ 2 ] ) : "asc"

		if (
			len( sortColumn )
			&& sortParts.len() <= 2
			&& [ "asc", "desc" ].findNoCase( sortDirection )
		) {
			return sortColumn & " " & sortDirection
		}

		return arguments.defaultSortOrder
	}
}