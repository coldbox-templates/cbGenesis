/**
 * A cbgenesis basic entity which provides uniformity to all objects
 */

@singleton
@threadSafe
class extends="cborm.models.VirtualEntityService" {
	/**
	 * --------------------------------------------------------------------------
	 * Injections
	 * --------------------------------------------------------------------------
	 */
	@inject( "provider:QueryBuilder@qb" )
	property name="qb";

	@inject( "coldbox" )
	property name="coldbox";

	@inject( "wirebox" )
	property name="wirebox";

	@inject( "cachebox:template" )
	property name="cache";

	@inject( "ValidationManager@cbvalidation" )
	property name="validationManager";

	@inject( "logbox:logger:{this}" )
	property name="log";

	/**
	 * Ensure the sort order is valid.
	 *
	 * @orderDirection The order direction, either "asc" or "desc".
	 *
	 * @return The validated order direction.
	 */
	private string function ensureSortOrder( required orderDirection ) {
		var order = lcase( arguments.orderDirection );
		if ( listFindNoCase( "asc,desc", order ) == 0 ) {
			order = "desc";
		}
		return order;
	}
}