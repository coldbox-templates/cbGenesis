/**
 * A cbgenesis basic entity which provides uniformity to all objects
 */

@singleton
@threadSafe
class extends="cborm.models.VirtualEntityService" {
	/**
	 * --------------------------------------------------------------------------
	 * Injections
	 * --------------------------------------------------------------------------
	 */
	@inject( "provider:QueryBuilder@qb" )
	property name="qb";

	@inject( "coldbox" )
	property name="coldbox";

	@inject( "wirebox" )
	property name="wirebox";

	@inject( "cachebox:template" )
	property name="cache";

	@inject( "ValidationManager@cbvalidation" )
	property name="validationManager";

	@inject( "logbox:logger:{this}" )
	property name="log";

	/**
	 * cborm's save()/delete() wrap every call in $transactioned(), which opens and commits
	 * its own transaction{} block unless it sees request.cbox_aop_transaction set. BoxLang's
	 * ORM transaction manager has no concept of nested transactions: closing that inner block
	 * unconditionally commits whatever Hibernate transaction is currently active, which ends
	 * an outer transaction{} block (e.g. the one integration tests wrap each spec in) before
	 * it is done - the following query then runs on a connection whose prepared statements
	 * were already invalidated when that transaction committed. Some databases' JDBC drivers
	 * tolerate reusing it silently (MySQL); others don't (MSSQL, Postgres: "The statement is
	 * closed."). request.cbox_aop_transaction is the documented way to suppress this, but it
	 * did not reliably reach $transactioned() in practice. Instead, flip a boolean that
	 * $transactioned() also honors: when useTransactions is false, it skips its own
	 * transaction{} block entirely. Gate it on an application-scope flag (set only by
	 * tests/resources/BaseIntegrationSpec.cfc for the life of its own outer transaction) so
	 * production behavior is unaffected.
	 */
	boolean function getUseTransactions() {
		if ( application?.cbTestTransactionActive ?: false ) {
			return false;
		}
		return super.getUseTransactions();
	}

	/**
	 * Ensure a sort order contains only an allowed column and direction.
	 *
	 * @sortOrder        The requested column, or column plus "asc" or "desc".
	 * @sortMap          A map of allowed sort columns to entity properties.
	 * @defaultSortOrder The fallback sort order.
	 *
	 * @return The validated sort order.
	 */
	public string function ensureSortOrder(
		required sortOrder,
		required sortMap,
		string defaultSortOrder = "lastName asc"
	) {
		var sortParts = reMatchNoCase( "\S+", trim( arguments.sortOrder ?: "" ) )
		var sortColumn = sortParts.len() && structKeyExists( arguments.sortMap, sortParts[ 1 ] )
			? arguments.sortMap[ sortParts[ 1 ] ]
			: ""
		var sortDirection = sortParts.len() > 1 ? lcase( sortParts[ 2 ] ) : "asc"

		if (
			len( sortColumn )
			&& sortParts.len() <= 2
			&& [ "asc", "desc" ].findNoCase( sortDirection )
		) {
			return sortColumn & " " & sortDirection
		}

		return arguments.defaultSortOrder
	}
}