/**
 * A system user
 *
 * It implements the following interfaces
 * - cbsecurity.interfaces.jwt.IJwtSubject
 * - cbsecurity.interfaces.IAuthUser
 */
@persistent( true )
@table( "users" )
class extends="app.models.BaseEntity" {

	/**
	 * --------------------------------------------------------------------------
	 * Injections
	 * --------------------------------------------------------------------------
	 */
	@inject( "UserService" )
	@persistent( false )
	property name="userService";

	/**
	 * --------------------------------------------------------------------------
	 * Properties
	 * --------------------------------------------------------------------------
	 */

	@fieldType( "id" )
	@generator( "uuid" )
	property
		name="userId"
		setter="false";

	@notNull( true )
	property name="firstName" default="";

	@notNull( true )
	property name="lastName" default="";

	@notNull( true )
	@unique( true )
	property name="email" default="";

	@notNull( true )
	property name="password" default="";

	@ormType( "text" )
	property name="biography" default="";

	@ormType( "dateTime" )
	property name="verifiedAt" type="date";

	@ormType( "dateTime" )
	property name="lastLogin" type="date";

	@ormType( "text" )
	property name="preferences" default="{}";

	/**
	 * --------------------------------------------------------------------------
	 * Non Persisted Properties
	 * --------------------------------------------------------------------------
	 */

	@persistent( false )
	property
		name="loggedIn"
		default=false
		type="boolean";

	/**
	 * --------------------------------------------------------------------------
	 * Relationships
	 * --------------------------------------------------------------------------
	 */

	property
		name="roles"
		fieldtype="many-to-many"
		type="array"
		lazy="extra"
		cascade="save-update"
		cfc="app.models.security.Role"
		fkcolumn="FK_userId"
		linktable="user_roles"
		inversejoincolumn="FK_roleId";

	property
		name="permissions"
		fieldtype="many-to-many"
		type="array"
		lazy="extra"
		cascade="save-update"
		cfc="app.models.security.Permission"
		fkcolumn="FK_userId"
		linktable="user_permissions"
		inversejoincolumn="FK_permissionId";

    property
        name="apiTokens"
        fieldtype="one-to-many"
        type="array"
		inverse="true"
        lazy="extra"
        class="app.models.security.APIToken"
        fkcolumn="FK_userId"
        cascade="all-delete-orphan"
		batchsize="25"
		orderby="label asc";

	/**
	 * --------------------------------------------------------------------------
	 * Validation Constraints
	 * --------------------------------------------------------------------------
	 * https://coldbox-validation.ortusbooks.com/overview/valid-constraints
	 */
	this.constraints = {
		firstName: { required: true },
		lastName : { required: true },
		email    : {
			required: true,
			size: "1..255",
			type: "email",
			validator: "UniqueValidator@cborm"
		},
		"preferences": { required: false, size: "0..8000" },
		"biography": { required: false, size: "0..8000" },
		"password": { required: true, size: "8..255" }
	};
	// https://coldbox-validation.ortusbooks.com/overview/validating-constraints/validating-with-profiles
	this.constraintProfiles = {
		"update": "firstName,lastName,email,preferences,biography"
	}

	/**
	 * --------------------------------------------------------------------------
	 * Population Options
	 * --------------------------------------------------------------------------
	 */
	this.population = { exclude: [ "userId", "lastLogin", "verifiedAt", "isActive" ] }

	/**
	 * --------------------------------------------------------------------------
	 * Mementifier Options
	 * --------------------------------------------------------------------------
	 * https://forgebox.io/view/mementifier
	 */
	this.memento = {
		// Default properties to serialize
		defaultIncludes: [
			"firstName",
			"lastName",
			"email",
			"biography",
			"preferences",
			"verifiedAt",
			"lastLogin",
			// relationships
			"roles",
			"permissions",
			"apiTokens"
		 ],
		// Default Exclusions
		defaultExcludes: [],
		// Never Include
		neverInclude   : [ "password" ]
	};

	/**
	 * Constructor
	 */
	function init() {
		super.init( "userId" )
		variables.loggedIn = false
		variables.firstName = ""
		variables.lastName = ""
		variables.email = ""
		variables.password = ""
		variables.biography = ""

		// relationships
		variables.roles = []
		variables.permissions = []
		variables.apiTokens = []

		// preferences
		setPreferences( {} )

		return this
	}

	/**
	 * Has the user been verified via email or not
	 */
	boolean function isEmailVerified() {
		return !isNull( variables.verifiedAt ) && isDate( variables.verifiedAt );
	}

	/**
	 * Retrieve the user's full name
	 */
	string function getFullName() {
		return getFirstName() & " " & getLastName();
	}

	/**
	 * Get the user's initials
	 */
	string function getInitials() {
		var initials = "";
		if ( len( variables.firstName ) ) {
			initials &= left( variables.firstName, 1 );
		}
		if ( len( variables.lastName ) ) {
			initials &= left( variables.lastName, 1 );
		}
		return initials;
	}

	/*************************** Preference Functions *****************************/

	/**
	 * Set the user's preferences
	 *
	 * @preferences A struct or json string of preferences to set
	 *
	 * @return User
	 */
	User function setPreferences( required preferences ) {
		if( isStruct( arguments.preferences ) ) {
			variables.preferences = jsonSerialize( arguments.preferences )
		} else if( isSimpleValue( arguments.preferences ) ) {
			variables.preferences = arguments.preferences
		} else {
			throw( type="InvalidArgumentException", message="Preferences must be a struct or JSON string" )
		}
		return this
	}

	/**
	 * Get the user's preferences as a struct
	 */
	struct function getAllPreferences() {
		return jsonDeserialize( getPreferences() ?: "{}" )
	}

	/**
	 * Get a preference, you can pass a default value if preference does not exist
	 *
	 * @name         The preference to get
	 * @defaultValue The default value if not found
	 *
	 * @throws UserPreferenceNotFound
	 */
	any function getPreference( required name, defaultValue ) {
		var allPreferences = getAllPreferences()
		if ( structKeyExists( allPreferences, arguments.name ) ) {
			return allPreferences[ arguments.name ]
		}

		// default values
		if ( !isNull( arguments.defaultValue ) ) {
			return arguments.defaultValue
		}

		// exception
		throw(
			message = "The preference you requested (#arguments.name#) does not exist",
			type = "UserPreferenceNotFound",
			detail = "Valid preferences are #structKeyList( allPreferences )#"
		)
	}

	/**
	 * Set a preference in the user preferences
	 *
	 * @name  The name of the preference
	 * @value The value of the preference
	 */
	User function setPreference( required name, required value ) {
		var allPreferences = getAllPreferences()
		allPreferences[ arguments.name ] = arguments.value
		setPreferences( allPreferences )
		return this
	}

	/*************************** Utility Functions *****************************/

	/**
	 * Validate if a user is logged in or not
	 */
	boolean function isLoggedIn() {
		return variables.loggedIn;
	}
}