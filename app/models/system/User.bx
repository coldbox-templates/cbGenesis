/**
 * A system user
 *
 * It implements the following interfaces
 * - cbsecurity.interfaces.jwt.IJwtSubject
 * - cbsecurity.interfaces.IAuthUser
 */
@persistent( true )
@table( "users" )
class extends="app.models.BaseEntity" {

	/**
	 * --------------------------------------------------------------------------
	 * Injections
	 * --------------------------------------------------------------------------
	 */
	@inject( "UserService" )
	@persistent( false )
	property name="userService";

	/**
	 * --------------------------------------------------------------------------
	 * Properties
	 * --------------------------------------------------------------------------
	 */

	@fieldType( "id" )
	@generator( "uuid" )
	property
		name="userId"
		setter="false";

	@notNull( true )
	property name="firstName" default="";

	@notNull( true )
	property name="lastName" default="";

	@notNull( true )
	@unique( true )
	property name="email" default="";

	@notNull( true )
	property name="password" default="";

	@ormType( "text" )
	property name="biography" default="";

	@ormType( "dateTime" )
	property name="verifiedAt" type="date";

	@ormType( "dateTime" )
	property name="lastLogin" type="date";

	@ormType( "text" )
	property name="preferences" default="{}";

	@ormType( "boolean" )
	property name="isPasswordReset" default="false";

	@ormType( "boolean" )
	property name="is2FactorAuth" default="false";

	/**
	 * --------------------------------------------------------------------------
	 * Non Persisted Properties
	 * --------------------------------------------------------------------------
	 */

	@persistent( false )
	property
		name="loggedIn"
		default=false
		type="boolean";

	/**
	 * --------------------------------------------------------------------------
	 * Relationships
	 * --------------------------------------------------------------------------
	 */

	/**
	 * Roles that belong to this user.
	 */
	@fieldtype( "many-to-many" )
	@lazy( "extra" )
	@cascade( "save-update" )
	@class( "app.models.security.Role" )
	@fkcolumn( "FK_userId" )
	@linktable( "user_roles" )
	@inversejoincolumn( "FK_roleId" )
	@singularName( "role" )
	property
		name="roles"
		type="array";

	/**
	 * A-la-carte Permissions that belong to this user.
	 */
	@fieldtype( "many-to-many" )
	@lazy( "extra" )
	@cascade( "save-update" )
	@class( "app.models.security.Permission" )
	@fkcolumn( "FK_userId" )
	@linktable( "user_permissions" )
	@inversejoincolumn( "FK_permissionId" )
	@singularName( "permission" )
	property
		name="permissions"
		type="array";

	/**
	 * APITokens that belong to this user.
	 */
	@fieldtype( "one-to-many" )
	@inverse( "true" )
	@lazy( "extra" )
	@class( "app.models.security.APIToken" )
	@fkcolumn( "FK_userId" )
	@cascade( "all-delete-orphan" )
	@batchsize( "25" )
	@orderby( "label asc" )
	@singularName( "apiToken" )
	property
		name="apiTokens"
		type="array";

	/**
	 * RememberTokens that belong to this user.
	 */
	@fieldtype( "one-to-many" )
	@inverse( "true" )
	@lazy( "extra" )
	@class( "app.models.security.RememberToken" )
	@fkcolumn( "FK_userId" )
	@cascade( "all-delete-orphan" )
	@batchsize( "25" )
	@orderby( "expiration desc" )
	@singularName( "rememberToken" )
	property
		name="rememberTokens"
		type="array";

	/**
	 * --------------------------------------------------------------------------
	 * Validation Constraints
	 * --------------------------------------------------------------------------
	 * https://coldbox-validation.ortusbooks.com/overview/valid-constraints
	 */
	this.constraints = {
		"firstName": { required: true },
		"lastName" : { required: true },
		"email"    : {
			required: true,
			size: "1..255",
			type: "email",
			validator: "UniqueValidator@cborm"
		},
		"preferences": { required: false, size: "0..8000" },
		"biography": { required: false, size: "0..8000" },
		"password": { required: true, size: "8..255" }
	};
	// https://coldbox-validation.ortusbooks.com/overview/validating-constraints/validating-with-profiles
	this.constraintProfiles = {
		"update": "firstName,lastName,email,preferences,biography"
	}

	/**
	 * --------------------------------------------------------------------------
	 * Population Options
	 * --------------------------------------------------------------------------
	 */
	this.population = {
		exclude: [
			"userId", "lastLogin", "verifiedAt", "isActive"
		]
	}

	/**
	 * --------------------------------------------------------------------------
	 * Mementifier Options
	 * --------------------------------------------------------------------------
	 * https://forgebox.io/view/mementifier
	 */
	this.memento = {
		// Default properties to serialize
		defaultIncludes: [
			"firstName",
			"lastName",
			"fullName",
			"email",
			"biography",
			"preferences",
			"verifiedAt",
			"lastLogin",
			// relationships
			"roles",
			"permissions",
			"apiTokens"
		 ],
		// Default Exclusions
		defaultExcludes: [],
		// Never Include
		neverInclude   : [ "password" ]
	};

	/**
	 * Constructor
	 */
	function init() {
		super.init( "userId" )
		variables.loggedIn = false
		variables.firstName = ""
		variables.lastName = ""
		variables.email = ""
		variables.password = ""
		variables.biography = ""

		// relationships
		variables.roles = []
		variables.permissions = []
		variables.apiTokens = []
		variables.rememberTokens = []

		// preferences
		setPreferences( {} )

		return this
	}

	/**
	 * Has the user been verified via email or not
	 */
	boolean function isEmailVerified() {
		return !isNull( variables.verifiedAt ) && isDate( variables.verifiedAt );
	}

	/**
	 * Retrieve the user's full name
	 */
	string function getFullName() {
		return getFirstName() & " " & getLastName();
	}

	/**
	 * Get the user's initials
	 */
	string function getInitials() {
		var initials = "";
		if ( len( variables.firstName ) ) {
			initials &= left( variables.firstName, 1 );
		}
		if ( len( variables.lastName ) ) {
			initials &= left( variables.lastName, 1 );
		}
		return initials;
	}

	/*************************** Preference Functions *****************************/

	/**
	 * Set the user's preferences
	 *
	 * @preferences A struct or json string of preferences to set
	 *
	 * @return User
	 */
	User function setPreferences( required preferences ) {
		if( isStruct( arguments.preferences ) ) {
			variables.preferences = jsonSerialize( arguments.preferences )
		} else if( isSimpleValue( arguments.preferences ) ) {
			variables.preferences = arguments.preferences
		} else {
			throw( type="InvalidArgumentException", message="Preferences must be a struct or JSON string" )
		}
		return this
	}

	/**
	 * Get the user's preferences as a struct
	 */
	struct function getAllPreferences() {
		return jsonDeserialize( getPreferences() ?: "{}" )
	}

	/**
	 * Get a preference, you can pass a default value if preference does not exist
	 *
	 * @name         The preference to get
	 * @defaultValue The default value if not found
	 *
	 * @throws UserPreferenceNotFound
	 */
	any function getPreference( required name, defaultValue ) {
		var allPreferences = getAllPreferences()
		if ( structKeyExists( allPreferences, arguments.name ) ) {
			return allPreferences[ arguments.name ]
		}

		// default values
		if ( !isNull( arguments.defaultValue ) ) {
			return arguments.defaultValue
		}

		// exception
		throw(
			message = "The preference you requested (#arguments.name#) does not exist",
			type = "UserPreferenceNotFound",
			detail = "Valid preferences are #structKeyList( allPreferences )#"
		)
	}

	/**
	 * Set a preference in the user preferences
	 *
	 * @name  The name of the preference
	 * @value The value of the preference
	 */
	User function setPreference( required name, required value ) {
		var allPreferences = getAllPreferences()
		allPreferences[ arguments.name ] = arguments.value
		setPreferences( allPreferences )
		return this
	}

	/*************************** Utility Functions *****************************/

	/**
	 * Save the user to the database
	 *
	 * @passwordChange If true, the password will be hashed before saving
	 *
	 * @return User
	 */
	User function save( boolean passwordChange = false) {
		variables.userService.save( this, passwordChange )
		return this
	}

	/**
	 * Delete the user
	 *
	 * @return User
	 */
	User function delete() {
		variables.userService.delete( this )
		return this
	}

	/**
	 * Validate if a user is logged in or not
	 */
	boolean function isLoggedIn() {
		return variables.loggedIn;
	}

	/**
	 * Get the user's role names as an array
	 */
	array function getRoleNames(){
		return variables.roles.map( .getRole() )
	}

	/**
	 * Get's all the permissions attached to this user from roles and a-la-carte permissions
	 *
	 * @return array An array of permission strings
	 */
	set function getAllPermissions(){
		if( !isNull( variables.allPermissions ) ){
			return variables.allPermissions
		}

		variables.allPermissions =
			// A-la-carte Permissions
			setNew( values: variables.permissions.map( .getPermission ) )
			// Add all role permissions
			.addAll(
				variables.roles
					.map( r => r.getPermissions().map( .getPermission ) )
					.flatten()
			)

		return variables.allPermissions
	}

	/**
	 * Verifies if the user has a specific permission(s)
	 *
	 * If there are more than 1 permission, it's an OR check, meaning if the user has any of the permissions,
	 * it will return true. If you want to check for all permissions, use the hasAllPermissions() method instead.
	 *
	 * @permission A permission string, list, or array of permissions to check against the user's permissions.
	 *
	 * @return boolean True if the user has the specified permission(s), false otherwise.
	 */
	boolean function hasPermission( required permission ){
		return getAllPermissions()
			.intersection( inflatePermissions( arguments.permission ) ).len() > 0
	}

	/**
	 * Verifies if the user has all of the specified permissions
	 *
	 * @permission A permission string, list, or array of permissions to check against the user's permissions.
	 *
	 * @return boolean True if the user has all specified permissions, false otherwise.
	 */
	boolean function hasAllPermissions( required permission ){
		return getAllPermissions().containsAll(
			inflatePermissions( arguments.permission)
		 )
	}

	/**
	 * Clear all permissions
	 */
	User function clearPermissions() {
		variables.permissions = []
		return this
	}

	/**
	 * Override the setPermissions
	 * So hibernate can clear relationships if set.
	 */
	User function setPermissions( required array permissions ) {
		if ( hasPermission() ) {
			variables.permissions.clear()
			variables.permissions.addAll( arguments.permissions )
		} else {
			variables.permissions = arguments.permissions
		}
		return this
	}

	/**
	 * Override the setRoles
	 * So hibernate can clear relationships if set.
	 */
	User function setRoles( required array roles ) {
		if ( hasRole() ) {
			variables.roles.clear()
			variables.roles.addAll( arguments.roles )
		} else {
			variables.roles = arguments.roles
		}
		return this
	}

	/**
	 * Clear all roles
	 */
	User function clearRoles() {
		variables.roles = []
		return this
	}

	/**
	 * Check if the provided password matches the user's current password
	 *
	 * @password The password to check
	 *
	 * @return boolean True if the password matches, false otherwise.
	 */
	boolean function samePassword( required string password ) {
		return BCryptVerify( arguments.password, getPassword() )
	}

	/************************* PRIVATE FUNCTIONS *****************************/


	/**
	 * Inflates the permissions argument to a set for easier processing
	 *
	 * @permission A permission string, list, or array of permissions to check against the user's permissions.
	 *
	 * @return A set of permissions for easier processing
	 */
	private set function inflatePermissions( required permission ){
		// Get the user's permissions as an array of permission strings
		if( isSimpleValue( arguments.permission ) ){
			arguments.permission = arguments.permission.listToArray()
		}
		// Convert the array to a set for easier processing
		if( isArray( arguments.permission ) ){
			arguments.permission = arguments.permission.toSet()
		} else if( !isBoxSet( arguments.permission ) ){
			throw( type="InvalidArgumentException", message="Permission must be a string, list, set or array" )
		}
		return arguments.permission
	}

}