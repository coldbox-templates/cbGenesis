/**
 * Crops, resizes, and stores the user avatar and application branding logo on
 * the cbfs "assets" disk (see app/config/modules/cbfs.bx). There is no stored
 * filename anywhere - paths are derived deterministically, so callers only
 * ever need a userId (for avatars) or nothing (for the single logo).
 *
 * Avatars are center-cropped to a square, then resized down, and always saved
 * as JPEG - a photo does not need transparency. The branding logo is scaled
 * to fit its target height without cropping, and always saved as PNG so a
 * transparent logo is preserved.
 */
// Not entity-backed, so this does not extend app.models.BaseService: that base
// extends cborm's VirtualEntityService, which requires an entityName this
// service has no corresponding ORM entity to supply.
@singleton
@threadSafe
class {

	@inject( "cbfs:disks:assets" )
	property name="assetsDisk";

	variables.MAX_UPLOAD_BYTES = 2 * 1024 * 1024;
	variables.ALLOWED_FORMATS  = [ "jpeg", "jpg", "png", "webp" ];
	variables.AVATAR_SIZES     = { sm: 64, lg: 256 };
	variables.LOGO_HEIGHTS     = { sm: 64, lg: 256 };

	/**
	 * Center-crops and resizes an uploaded image into the sm/lg avatar variants
	 * and stores both on the assets disk as JPEG.
	 *
	 * @userId    The user to store an avatar for.
	 * @imageData Raw bytes of the uploaded image.
	 *
	 * @throws Image.TooLarge      When imageData exceeds the configured upload limit.
	 * @throws Image.InvalidFormat When imageData cannot be decoded as one of the allowed formats.
	 */
	void function storeAvatar( required string userId, required binary imageData ) {
		var base64 = validate( arguments.imageData )

		for ( var size in variables.AVATAR_SIZES ) {
			// bx-image has no "clone" - a fresh decode per variant is what
			// guarantees each size is independent of the others.
			var variant = imageReadBase64( base64 )
			squareCrop( variant )
			variant.resize( variables.AVATAR_SIZES[ size ], variables.AVATAR_SIZES[ size ] )
			writeVariant( variant, avatarPath( arguments.userId, size ), "jpg" )
		}
	}

	/**
	 * Deletes both avatar variants for a user, if present.
	 */
	void function deleteAvatar( required string userId ) {
		for ( var size in variables.AVATAR_SIZES ) {
			var path = avatarPath( arguments.userId, size )
			if ( variables.assetsDisk.exists( path ) ) {
				variables.assetsDisk.delete( path )
			}
		}
	}

	/**
	 * Scales an uploaded image to fit the sm/lg logo heights (width follows
	 * proportionally, no cropping) and stores both on the assets disk as PNG.
	 *
	 * @imageData Raw bytes of the uploaded image.
	 *
	 * @throws Image.TooLarge      When imageData exceeds the configured upload limit.
	 * @throws Image.InvalidFormat When imageData cannot be decoded as one of the allowed formats.
	 */
	void function storeLogo( required binary imageData ) {
		var base64 = validate( arguments.imageData )

		for ( var size in variables.LOGO_HEIGHTS ) {
			var variant = imageReadBase64( base64 )
			imageScaleToFit( variant, "", variables.LOGO_HEIGHTS[ size ] )
			writeVariant( variant, logoPath( size ), "png" )
		}
	}

	/**
	 * Deletes both branding logo variants, if present.
	 */
	void function deleteLogo() {
		for ( var size in variables.LOGO_HEIGHTS ) {
			var path = logoPath( size )
			if ( variables.assetsDisk.exists( path ) ) {
				variables.assetsDisk.delete( path )
			}
		}
	}

	/**
	 * The deterministic cbfs path for a user's avatar variant.
	 *
	 * @size "sm" or "lg"
	 */
	string function avatarPath( required string userId, required string size ) {
		return "avatars/#arguments.userId#/#arguments.size#.jpg"
	}

	/**
	 * The deterministic cbfs path for a branding logo variant.
	 *
	 * @size "sm" or "lg"
	 */
	string function logoPath( required string size ) {
		return "branding/logo-#arguments.size#.png"
	}

	/************************* PRIVATE FUNCTIONS *****************************/

	/**
	 * Validates raw image bytes and returns them base64-encoded, ready to be
	 * decoded fresh (via imageReadBase64()) once per size variant.
	 */
	private string function validate( required binary imageData ) {
		if ( arrayLen( arguments.imageData ) > variables.MAX_UPLOAD_BYTES ) {
			throw(
				type    = "Image.TooLarge",
				message = "Image exceeds the maximum upload size of #variables.MAX_UPLOAD_BYTES / 1024 / 1024#MB."
			)
		}

		var base64 = binaryEncode( arguments.imageData, "base64" )

		try {
			var img = imageReadBase64( base64 )
		} catch ( any e ) {
			throw( type = "Image.InvalidFormat", message = "The uploaded file is not a readable image." )
		}

		if ( !variables.ALLOWED_FORMATS.findNoCase( img.getFormat() ) ) {
			throw(
				type    = "Image.InvalidFormat",
				message = "Unsupported image format [#img.getFormat()#]. Allowed formats: #variables.ALLOWED_FORMATS.toList( ', ' )#."
			)
		}

		return base64
	}

	/**
	 * Center-crops an image to a square in place, using the shorter dimension.
	 */
	private void function squareCrop( required img ) {
		var side = min( arguments.img.getWidth(), arguments.img.getHeight() )
		var x    = int( ( arguments.img.getWidth() - side ) / 2 )
		var y    = int( ( arguments.img.getHeight() - side ) / 2 )
		arguments.img.crop( x, y, side, side )
	}

	/**
	 * Encodes an image variant to the given format and writes it to the assets disk.
	 */
	private void function writeVariant( required img, required string path, required string format ) {
		var bytes = binaryDecode( imageWriteBase64( arguments.img, arguments.format ), "base64" )
		variables.assetsDisk.create( arguments.path, bytes )
	}

}
