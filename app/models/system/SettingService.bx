 * ---
 * Manage the application system settings.
 */
class extends="app.models.BaseService" {

	/**
	 * --------------------------------------------------------------------------
	 * Static Defaults
	 * --------------------------------------------------------------------------
	 */

	static{
		DEFAULTS = {
		}
	}

	/**
	 * Constructor
	 */
	SettingService function init() {
		return this
	}

	/**
	 * This method will go over all system settings and make sure that there are no missing default core settings.
	 * If they are, we will create the core settings with the appropriate defaults: this.DEFAULTS
	 */
	SettingService function preFlightCheck() {
		var missingSettings = false
		var loadedSettings = getAllSettings( force = true )

		transaction {
			this.DEFAULTS
				// only load defaults that do not exist
				.filter( function( key, value ) {
					return !loadedSettings.keyExists( key );
				} )
				// Create the missing setting
				.each( function( key, value ) {
					log.info( "Missing setting in pre-flight: #key#, adding it!" );
					missingSettings = true;
					save( new ( { name: key, value: trim( value ), isCore: true } ) );
				} );
		}

		// if we added new ones, flush caches
		if ( missingSettings ) {
			flushSettingsCache();
		}

		log.info( "TimeBox Settings pre-flight checks passed!" );

		return this;
	}

	/**
	 * Retrieve a multi-tenant settings cache key
	 */
	string function getSettingsCacheKey() {
		return "timebox-settings";
	}

	/**
	 * Get a setting value
	 *
	 * @name         The name of the seting
	 * @defaultValue The default value if setting not found.
	 */
	function getSetting( required name, defaultValue ) {
		var allSettings = getAllSettings();
		if ( structKeyExists( allSettings, arguments.name ) ) {
			return allSettings[ arguments.name ];
		}
		if ( !isNull( arguments.defaultValue ) ) {
			return arguments.defaultValue;
		}
		throw(
			message = "Setting #arguments.name# not found in settings collection",
			detail = "Registered settings are: #structKeyList( allSettings )#",
			type = "SettingService.SettingNotFound"
		);
	}

	/**
	 * Get all loaded settings in array of struct format.  This method checks
	 * the distributed cache for the map first, else it creates it.
	 *
	 * @force If true, it will force a cache clear and reload of settings from the database.
	 *
	 * @return struct of settings
	 */
	struct function getAllSettings( boolean force = false ) {
		if ( arguments.force ) {
			log.info( "Forcing clearing of settings cache!" );
			cache.clear( getSettingsCacheKey() );
		}

		return cache.getOrSet(
			getSettingsCacheKey(),
			function() {
				log.info( "Settings not cached, rebuilding from DB!" );
				return list( sorOrder = "name", asQuery = false ).reduce( function( result, item ) {
					result[ item.getName() ] = item.getValue();
					return result;
				}, {} )
			},
			7200
		);
	}

	/**
	 * This will store the incoming structure as the settings in cache.
	 * Usually this method is used for major overrides.
	 */
	SettingService function storeSettings( struct settings ) {
		// cache them for 5 days, usually app timeout
		cache.set( getSettingsCacheKey(), arguments.settings, 7200 );
		return this;
	}

	/**timebox_invoice_terms_conditions
	 * flush settings cache for current multi-tenant host
	 * Reload overrides and reload env overrides
	 */
	SettingService function flushSettingsCache() {
		log.info( "Settings Flush Executed!" );
		// Clear out the settings cache
		cache.clear( getSettingsCacheKey() );
		// Loadup Config Overrides
		loadConfigOverrides();
		// Load Environment Overrides Now, they take precedence
		loadEnvironmentOverrides();
		// Overwrite settings for Coldbox modules
		overwriteModuleSettings();
		cache.clearAllEvents();
		return this;
	}

	/**
	 * Bulk saving of options using a memento structure of options
	 * This is usually done from the settings display manager
	 *
	 * @memento The struct of settings
	 */
	SettingService function bulkSave( Struct memento, banner, logo ) {
		var allSettings = getAllSettings();
		var oOption = "";
		var newOptions = [];

		arguments.memento
			// Only save, saveable keys
			.filter( function( key, value ) {
				return allSettings.keyExists( key );
			} )
			// Build out array of settings to save
			.each( function( key, value ) {
				var thisSetting = findWhere( { name: key } );
				thisSetting.setValue( toString( value ) );
				newOptions.append( thisSetting );
			} )

		if ( !isNull( arguments.banner ) && len( arguments.banner ) ) {
			// Select format
			uploadedFile = fileUpload(
				getTempDirectory(),
				"banner",
				"",
				"MakeUnique"
			);

			var defaultDisk = variables.cbfs.defaultDisk();
			var fileDirectory = "data/settings";
			var fileName = "banner." & uploadedFile.serverfileext;
			var filePath = [ fileDirectory, fileName ].toList( "/" );

			// Resize the banner image
			var bannerFilePath = mediaUtil.createVariation(
				original = uploadedFile.serverDirectory & "/" & uploadedFile.serverfile,
				filePath = filePath,
				width = 700,
				height = 120,
				mimeType = uploadedFile.serverfileext
			);


			// create public file on disk
			var disk = defaultDisk.createFromFile(
				source = expandPath( bannerFilePath ),
				directory = fileDirectory,
				deleteSource = true,
				name = fileName,
				overwrite = true,
				visibility = "public"
			);
			var thisSetting = findWhere( { name: "timebox_company_banner" } );
			thisSetting.setValue( filePath );
			newOptions.append( thisSetting );
		}

		if ( !isNull( arguments.logo ) && len( arguments.logo ) ) {
			uploadedFile = fileUpload(
				getTempDirectory(),
				"logo",
				"",
				"MakeUnique"
			);

			var defaultDisk = variables.cbfs.defaultDisk();
			var fileDirectory = "data/settings";
			var fileName = "logo." & uploadedFile.serverfileext;
			var filePath = [ fileDirectory, fileName ].toList( "/" );

			// Resize the banner image
			var logoFilePath = mediaUtil.createVariation(
				original = uploadedFile.serverDirectory & "/" & uploadedFile.serverfile,
				filePath = filePath,
				width = 296,
				height = 62,
				mimeType = uploadedFile.serverfileext
			);

			// create public file on disk
			var disk = defaultDisk.createFromFile(
				source = expandPath( logoFilePath ),
				directory = fileDirectory,
				deleteSource = true,
				name = fileName,
				overwrite = true,
				visibility = "public"
			);
			var thisSetting = findWhere( { name: "timebox_company_logo" } );
			thisSetting.setValue( filePath );
			newOptions.append( thisSetting );
		}
		// save new settings and flush cache
		saveAll( newOptions );
		flushSettingsCache();

		return this;
	}

	/**
	 * Setting search returns struct with keys [records,count]
	 *
	 * @search  The search term to look for
	 * @isCore  The flag to filter core settings
	 * @isActive The flag to filter active settings
	 * @sortOrder  The sort ordering to do. Defaults to sort by name
	 * @propertyList The difault properties to return
	 * @max The max records to return
	 * @offset  The offset pagination
	 * @currentUser The current user to filter settings base on permissions
	 *
	 * @return struct of { records:array, count:numeric }
	 */
	struct function search(
		search = "",
		isCore = "",
		isActive = true,
		sortOrder = "name asc",
		propertyList = "settingId,isActive,name,value,isCore",
		numeric max = 0,
		numeric offset = 0,
		required currentUser
	) {
		var results = { "count": 0, "records": [] };
		// cfformat-ignore-start
        var c = newCriteria()
            .eq( "this.isActive", autoCast( "isActive", arguments.isActive ) )
            .when( !isNull( arguments.isCore ) && isBoolean( arguments.isCore ), ( c ) => {
                c.eq( "isCore", autoCast( "isCore", isCore ) );
            } )
            .when( len( arguments.search ), ( c ) => {
                c.like( "name", "%#search#%" )
            } )
            .when( !arguments.currentUser.hasPermission( "SETTINGS_ADMIN" ), ( c ) => {
                c.isIn(
                    "name",
                    wirebox
                        .getInstance( "UserService" )
                        .getBaseUISettings( currentUser )
                )
            } );
        // cfformat-ignore-end

		results.count = c.count( "settingId" );

		results.records = c
			.withProjections( property = "#arguments.propertyList#" )
			.asStruct()
			.list(
				offset = arguments.offset,
				max = arguments.max,
				sortOrder = arguments.sortOrder,
				asQuery = false
			);

		return results;
	}

	/**
	 * Load up config overrides
	 */
	function loadConfigOverrides() {
		var oConfig = coldbox.getSetting( "ColdBoxConfig" );
		var configStruct = coldbox.getConfigSettings();
		var timeboxDSL = oConfig.getPropertyMixin( "timebox", "variables", structNew() );

		// Verify Settings
		if ( structKeyExists( timeboxDSL, "settings" ) ) {
			var overrides = timeboxDSL.settings;
			// Store Appended Set
			storeSettings( getAllSettings().append( overrides, true ) );
			// Log it
			variables.log.info( "TimeBox config overrides loaded." );
		}
	}

	/**
	 * Load up java environment overrides for ForgeBox settings
	 * The pattern to look is `timebox_{setting}`
	 * Example: timebox_storage_s3_url_timeout
	 */
	function loadEnvironmentOverrides() {
		var environmentSettings = getSystemEnvironmentMap();
		var overrides = {};

		// iterate and override, can't use functional, it's a java native object :(
		for ( var thisKey in environmentSettings ) {
			if ( reFindNoCase( "^timebox\_", thisKey ) ) {
				overrides[ thisKey ] = environmentSettings[ thisKey ];
			}
		}

		// If empty, exit out.
		if ( overrides.isEmpty() ) {
			return;
		}

		// Append and override
		storeSettings( getAllSettings().append( overrides, true ) );

		// Log it
		variables.log.info( "TimeBox environment overrides loaded." );
	}

	/******************************** PRIVATE ************************************************/


	/**
	 * Overwrite settings for Coldbox modules
	 */
	SettingService function overwriteModuleSettings() {
		var settings = getAllSettings();
		// Overwrite cbmail settings using DB settings
		wirebox
			.getInstance( "MailService@cbmailservices" )
			.getDefaultSettings()
			.append(
				{
					"username": settings.timebox_mail_username,
					"password": settings.timebox_mail_password,
					"port": settings.timebox_mail_smtp,
					"useTLS": settings.timebox_mail_tls,
					"useSSL": settings.timebox_mail_ssl
				},
				true
			);
		return this;
	}

	/**
	 * Updates the active status of a setting (soft delete or restore)
	 * @Setting The setting to update
	 * @isActive Boolean indicating whether the setting should be active (true = restore, false = delete)
	 * @return response
	 */
	function toggleStatus( required setting, required boolean isActive ) {
		arguments.setting
			.setIsActive( arguments.isActive )
			.save();

		return { "isUpdated": true, "isActive": arguments.isActive };
	}

}
