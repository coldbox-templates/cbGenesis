import java.lang.System

class extends="app.models.BaseService" {
	/**
	 * --------------------------------------------------------------------------
	 * Static Defaults
	 * --------------------------------------------------------------------------
	 */

	static {
		CACHE_KEY = "cbgenesis-settings"
		DEFAULTS = {
			// The main logo path for the app, if empty it will use the default cbGenesis logo
			cbAppLogo                : "/includes/images/cbgenesis-icon-full.svg",
			// The main title for the app used in the sidebar
			cbAppName                : "cbGenesis",
			// The tagline for the app used in the sidebar and login page
			cbAppTagline             : "A Modern ColdBox Application Starter Kit",
			// The tagline for the app used in the branding area of the sidebar
			cbAppBrandTagline        : "Starter Kit",
			// Copyright notice
			cbCopyrightNotice        : "&copy; #year()# cbGenesis. All rights reserved.",
			// The default theme for the app, can be "light" or "dark"
			cbDefaultTheme           : "dark",
			// The login layout to use, can be "AuthCenter" or "AuthSplit" or your own custom layout.
			cbLoginLayout            : "AuthSplit",
			// Allow users to register themselves, if false, the register page will be disabled.
			cbAllowRegistration      : true,
			// Allow users to reset their password, if false, the forgot password page will be disabled.
			cbAllowForgotPassword    : true,
			// Encryption secret key for the application, if empty it will use the default cbGenesis key
			cbEncryptionKey          : generateSecretKey( "AES", 256 ),
			// Salting key for security usage
			cbSaltingKey             : generateSecretKey( "AES", 256 ),
			// The default email address to use for sending emails, if empty it will use the default cbGenesis email address
			cbDefaultEmail           : "no-reply@cbgenesis.com",
			// Minimum password length for user accounts
			cbMinPasswordLength      : 8,
			// Password reset expiration time in minutes,
			cbPasswordResetExpiration: 60,
			// Administrator invitation expiration time in days
			cbInvitationExpiration   : 7,
			// Self-registration verification expiration time in hours
			cbRegistrationVerificationExpiration: 24,
			// Persistent browser-login duration in days
			cbRememberMeDays          : 14,
			cbAllowRememberMe		: true,
			// Maximum API token validity in months
			cbApiTokenMaxValidityMonths: 12,
			// Mail Settings
			cbMailHost               : "smtp.mailtrap.io",
			cbMailPort               : 25,
			cbMailUsername           : "",
			cbMailPassword           : "",
			cbMailTLS                : false,
			cbMailSSL                : false
		};
	}

	/**
	 * Constructor
	 */
	SettingService function init() {
		super.init( entityName: "Setting" )
		return this;
	}

	/**
	 * Check if a password meets the minimum system requirements and rules.
	 *
	 * - Min length: 8 characters
	 * - Must contain at least one uppercase letter
	 * - Must contain at least one lowercase letter
	 * - Must contain at least one number
	 * - Must contain at least one special character
	 *
	 * @password The password to check.
	 * @predicate A function that takes a password and returns true if it meets the requirements, false otherwise. This allows for custom password validation logic to be passed in.
	 *
	 * @return True if the password is valid, false otherwise.
	 */
	boolean function isValidPassword( required string password, function predicate ) {
		var minLength = getSetting( "cbMinPasswordLength" )

		// Check the minimum length
		if ( len( arguments.password ) < minLength ) {
			return false
		}

		// Check the custom predicate if provided
		if ( !isNull( arguments.predicate ) && !arguments.predicate( password ) ) {
			return false
		}

		// Check for at least one uppercase letter
		if ( !reFind( "[A-Z]", arguments.password ) ) {
			return false
		}

		// Check for at least one lowercase letter
		if ( !reFind( "[a-z]", arguments.password ) ) {
			return false
		}

		// Check for at least one number
		if ( !reFind( "[0-9]", arguments.password ) ) {
			return false
		}

		// Check for at least one special character
		if ( !reFind( "[^A-Za-z0-9]", arguments.password ) ) {
			return false
		}

		return true
	}

	/**
	 * This method will go over all system settings and make sure that there are no missing default core settings.
	 * If they are, we will create the core settings with the appropriate defaults: this.DEFAULTS
	 */
	SettingService function preFlightCheck() {
		var missingSettings = false;
		var loadedSettings = getAllSettings( force = true );

		transaction {
			this.DEFAULTS.filter( ( key, value ) => !loadedSettings.keyExists( arguments.key ) )
				// only load defaults that do not exist
				// Create the missing setting
				.each(
					( key, value ) => {
						log.info( "Missing setting in pre-flight: #key#, adding it!" )
						missingSettings = true
						save( new( { name: key, value: trim( value ) } ) )
					}
				);
		}

		// if we added new ones, flush caches
		if ( missingSettings ) {
			flushSettingsCache()
		}

		log.info( "cbGenesis Settings pre-flight checks passed!" )

		return this
	}

	/**
	 * Retrieve a multi-tenant settings cache key
	 */
	string function getSettingsCacheKey() {
		return static.CACHE_KEY & "-" & cgi.http_host
	}

	/**
	 * Get a setting value
	 *
	 * @name         The name of the seting
	 * @defaultValue The default value if setting not found.
	 */
	function getSetting( required name, defaultValue ) {
		var allSettings = getAllSettings()
		if ( structKeyExists( allSettings, arguments.name ) ) {
			return allSettings[ arguments.name ]
		}
		if ( !isNull( arguments.defaultValue ) ) {
			return arguments.defaultValue
		}
		throw(
			message = "Setting [#arguments.name#] not found in settings collection",
			detail  = "Registered settings are: #structKeyList( allSettings )#",
			type    = "SettingNotFound"
		)
	}

	/**
	 * Get all loaded settings in array of struct format.  This method checks
	 * the distributed cache for the map first, else it creates it.
	 *
	 * @force If true, it will force a cache clear and reload of settings from the database.
	 *
	 * @return struct of settings
	 */
	struct function getAllSettings( boolean force = false ) {
		if ( arguments.force ) {
			log.info( "Forcing clearing of settings cache!" )
			variables.cache.clear( getSettingsCacheKey() )
		}

		return cache.getOrSet(
				getSettingsCacheKey(),
				() => {
					log.info( "Settings not cached, rebuilding from DB!" )
					// Get all settings and do a struct of name => setting struct for easy access
					return getAll(
						sortOrder: "name",
						properties: "name as name, value as value"
					).reduce(
						( result, item ) => {
							result[ item.name ] = item.value
							return result
						},
						{}
					)
				},
				7200
			)
	}

	/**
	 * This will store the incoming structure as the settings in cache.
	 * Usually this method is used for major overrides.
	 *
	 * @settings The struct of settings to store in cache.
	 *
	 * @return SettingService
	 */
	SettingService function storeSettings( struct settings ) {
		// cache them for 5 days, usually app timeout
		cache.set(
				getSettingsCacheKey(),
				arguments.settings,
				7200
			)
		return this
	}

	/**
	 * Flush settings cache for current multi-tenant host
	 * Reload overrides and reload env overrides
	 */
	SettingService function flushSettingsCache() {
		log.info( "Settings Flush Executed!" )
		// Clear out the settings cache
		cache.clear( getSettingsCacheKey() )
		// Loadup Config Overrides
		loadConfigOverrides()
		// Load Environment Overrides Now, they take precedence
		loadEnvironmentOverrides()
		// Overwrite settings for Coldbox modules
		overwriteModuleSettings();
		cache.clearAllEvents()
		return this
	}

	/**
	 * Bulk saving of settings using a memento structure of settings
	 * This is usually done from the settings display manager
	 *
	 * @memento The struct of settings
	 */
	SettingService function bulkSave( Struct memento ) {
		validateSettings( arguments.memento )
		var allSettings = getAllSettings()
		var oOption = ""
		var newOptions = []

		arguments
			.memento
			.filter(
				( key, value ) => {
					return allSettings.keyExists( key )
				}
			)
			// Only save, saveable keys
			// Build out array of settings to save
			.each(
				( key, value ) => {
					var thisSetting = findWhere( { name: key } )
					thisSetting.setValue( toString( value ) )
					newOptions.append( thisSetting )
				}
			);


		// save new settings and flush cache
		saveAll( newOptions )
		flushSettingsCache()

		return this
	}

	/**
	 * Validates the settings memento for any invalid values.  This is usually done before saving the settings.
	 *
	 * @memento The struct of settings
	 *
	 * @throws "Setting.Invalid" if any setting is invalid.
	 */
	private void function validateSettings( required struct memento ) {
		// Validate the cbInvitationExpiration setting to be a whole number greater than zero
		var invitationExpiration = arguments.memento.keyExists( "cbInvitationExpiration" ) ? arguments.memento.cbInvitationExpiration : this.DEFAULTS.cbInvitationExpiration
		if ( !isNumeric( invitationExpiration ) || int( invitationExpiration ) != invitationExpiration || int( invitationExpiration ) < 1 ) {
			throw(
				type   = "Setting.Invalid",
				message = "Administrator invitation expiration must be a whole number greater than zero days."
			)
		}

		// Validate the cbRegistrationVerificationExpiration setting to be a whole number greater than zero
		var registrationVerificationExpiration = arguments.memento.keyExists( "cbRegistrationVerificationExpiration" ) ? arguments.memento.cbRegistrationVerificationExpiration : this.DEFAULTS.cbRegistrationVerificationExpiration
		if ( !isNumeric( registrationVerificationExpiration ) || int( registrationVerificationExpiration ) != registrationVerificationExpiration || int( registrationVerificationExpiration ) < 1 ) {
			throw(
				type   = "Setting.Invalid",
				message = "Registration verification expiration must be a whole number greater than zero hours."
			)
		}

		// Validate the cbRememberMeDays setting to be a whole number between 1 and 365
		var days = arguments.memento?.cbRememberMeDays ?: this.DEFAULTS.cbRememberMeDays
		if ( !isNumeric( days ) || int( days ) != days || int( days ) < 1 || int( days ) > 365 ) {
			throw(
				type   = "Setting.Invalid",
				message = "Keep me signed in duration must be a whole number between 1 and 365 days."
			)
		}

		var months = arguments.memento?.cbApiTokenMaxValidityMonths ?: this.DEFAULTS.cbApiTokenMaxValidityMonths
		if ( !isNumeric( months ) || int( months ) != months || int( months ) < 1 || int( months ) > 120 ) {
			throw(
				type   = "Setting.Invalid",
				message = "API token maximum validity must be a whole number between 1 and 120 months."
			)
		}
	}

	/**
	 * Setting search returns struct with keys [records,count]
	 *
	 * @search  The search term to look for
	 * @isCore  The flag to filter core settings
	 * @isActive The flag to filter active settings
	 * @sortOrder  The sort ordering to do. Defaults to sort by name
	 * @propertyList The difault properties to return
	 * @max The max records to return
	 * @offset  The offset pagination
	 * @currentUser The current user to filter settings base on permissions
	 *
	 * @return struct of { records:array, count:numeric }
	 */
	struct function search(
		search         = "",
		isCore         = "",
		any isActive           = "",
		string sortOrder      = "name asc",
		string propertyList   = "settingId,isActive,name,value",
		numeric max    = 0,
		numeric offset = 0,
		required currentUser
	) {
		var results = { "count": 0, "records": [] }

		// cfformat-ignore-start
		var c = newCriteria()
           .when( isBoolean( arguments.isActive ), c => c.eq( "this.isActive", isActive castAs boolean ) )
           .when( !isNull( arguments.isCore ) && isBoolean( arguments.isCore ), c => {
               c.eq( "isCore", isCore castAs boolean )
           } )
           .when( len( arguments.search ), c => c.like( "name", "%#search#%" ) )
		// cfformat-ignore-end

		results.count = c.count( "settingId" )

		results.records = c
			.withProjections( property: "#arguments.propertyList#" )
			.asStruct()
			.list(
				offset    : arguments.offset,
				max       : arguments.max,
				sortOrder : arguments.sortOrder
			)

		return results
	}

	/**
	 * This returns a struct report of the settings counts according to state:
	 * - all
	 * - active
	 * - inactive
	 */
	struct function settingsCountsReport() {
		return {
			all: count(),
			active: count( "isActive = ?", [ true ] ),
			inactive: count( "isActive = ?", [ false ] )
		}
	}

	/**
	 * This method will load up any config overrides for the settings from the ColdBox config file.
	 * All cbGenesis settings are in the main settings with a prefix of `cb{Setting}`
	 */
	function loadConfigOverrides() {
		var cbSettings = variables.coldbox.getConfigSettings()
			.filter( ( key, value ) => reFindNoCase( "^cb", key ) )

		// Verify Settings
		if ( cbSettings.count() ) {
			// Store Appended Settings
			storeSettings( getAllSettings().append( cbSettings, true ) )
			// Log it
			variables.log.info( "cbGenesis config overrides loaded." )
		}
	}

	/**
	 * This method will load up any environment overrides for the settings from the ColdBox config file.
	 * All cbGenesis settings are in the main settings with a prefix of `genesis_`
	 */
	function loadEnvironmentOverrides() {
		var environmentSettings = getSystemEnvironmentMap()
		var overrides = {}

		// iterate and override, can't use functional, it's a java native object :(
		for ( var thisKey in environmentSettings ) {
			if ( reFindNoCase( "^genesis\_", thisKey ) ) {
				overrides[ thisKey ] = environmentSettings[ thisKey ]
			}
		}

		// If empty, exit out.
		if ( overrides.isEmpty() ) {
			return
		}

		// Append and override
		storeSettings( getAllSettings().append( overrides, true ) )

		// Log it
		variables.log.info( "cbGenesis environment overrides loaded." )
	}

	/**
	 * Overwrite settings for Coldbox modules
	 */
	SettingService function overwriteModuleSettings() {
		var settings = getAllSettings()

		// Overwrite cbmail settings using DB settings
		wirebox
			.getInstance( "MailService@cbmailservices" )
			.getDefaultSettings()
			.append(
				{
					"from"    : settings.cbDefaultEmail,
					"server"	: settings.cbMailHost,
					"username": settings.cbMailUsername,
					"password": settings.cbMailPassword,
					"port"    : settings.cbMailPort,
					"useTLS"  : settings.cbMailTLS,
					"useSSL"  : settings.cbMailSSL
				},
				true
			)

		return this
	}

	/**
	 * Updates the active status of a setting (soft delete or restore)
	 *
	 * @Setting The setting to update
	 * @isActive Boolean indicating whether the setting should be active (true = restore, false = delete)
	 *
	 * @return The updated setting memento
	 */
	function toggleStatus( required setting, required boolean isActive ) {
		return arguments
			.setting
			.setIsActive( arguments.isActive )
			.save()
			.getMemento()
	}

	/**
	 * Retrieve system env map, mostly encapsulated for mocking purposes
	 */
	private function getSystemEnvironmentMap() {
		return System.getEnv()
	}

}