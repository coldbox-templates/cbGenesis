/**
 * This User Service provider connects to the database configured in your appliction.
 *
 * Implements virtually from cbsecurity.interfaces.IUserService
 * https://coldbox-security.ortusbooks.com/usage/authentication-services#iuserservice
 * - isValidCredentials
 * - retrieveUserById
 * - retrieveUserByUsername
 */
@singleton
@threadSafe
class extends="app.models.BaseService" {

	/**
	 * --------------------------------------------------------------------------
	 * Injections
	 * --------------------------------------------------------------------------
	 */

	@inject( "provider:mailService@cbmailServices" )
	property name="mailService";

	@inject( "provider:SecurityService" )
	property name="securityService";

	@inject( "provider:settingService" )
	property name="settingService";

	@inject
	property name="userActionTokenService";

	@inject( "provider:RoleService" )
	property name="roleService";



	@inject( "coldbox:RequestService" )
	property name="requestService";

	@inject( "coldbox:renderer" )
	property name="renderer";

	@inject( "@cbSecurity" )
	property name="cbSecurity";

	static{
		SORT_MAP = {
			"firstName" : "firstName",
			"lastName"  : "lastName",
			"email"     : "email",
			"createdDate" : "createdDate",
			"isActive"  : "isActive",
			"isPasswordReset" : "isPasswordReset",
			"is2FactorAuth" : "is2FactorAuth",
			"verifiedAt": "verifiedAt",
			"lastLogin": "lastLogin"
		}
		DEFAULT_SORT_ORDER = "lastName asc"
	}

	/**
	 * Constructor
	 */
	function init() {
		super.init( entityName: "User" )
		return this;
	}

	/**
	 * Get a new user by id
	 *
	 * @id The id to get the user with
	 *
	 * @return The located user or a new un-loaded user object
	 */
	User function retrieveUserById( required id ) {
		return newCriteria()
			.eq( "userId", arguments.id )
			.isTrue( "isActive" )
			.get() ?: throw( type = "EntityNotFound", message = "User not found" )
	}

	/**
	 * Get a user by email
	 *
	 * @email The email to get the user with
	 *
	 * @return The valid user object representing the email or an empty user object
	 */
	User function retrieveUserByUsername( required email ) {
		return newCriteria()
			.eq( "email", arguments.email )
			.isTrue( "isActive" )
			.get() ?: throw( type = "EntityNotFound", message = "User not found" )
	}

	/**
	 * Verify if the incoming username and password are valid credentials. The user must also have been verified
	 * in order to log in.
	 *
	 * @username The username/email to test
	 * @password The password to test
	 *
	 * @return true if valid, else false
	 */
	boolean function isValidCredentials( required username, required password ) {
		var oUser = retrieveUserByUsername( arguments.username )

		// If the user is not loaded or the user has not been verified, then we cannot log in
		if ( !oUser.isLoaded() || !oUser.isEmailVerified() || isNull( oUser.getPassword() ) || !len( oUser.getPassword() ) ) {
			return false
		}

		// https://boxlang.ortusbooks.com/boxlang-framework/modularity/password-encryption#bcrypt-hashing
		return BCryptVerify( arguments.password, oUser.getPassword() );
	}

	/**
	 * Verify if an email address is in use
	 *
	 * @email The email target
	 * @id    The user id, optional
	 *
	 * @return Boolean
	 */
	boolean function isEmailInUse( required email, String id = "" ) {
		var c = newCriteria()
		c.eq( "email", arguments.email )
			.when( len( arguments.id ), ( c ) => c.ne( "userId", id ) )
		return ( c.count() > 0 )
	}

	/**
	 * Create a new user in the system and send them an invitation email.  The user is created but it is NOT verified.
	 *
	 * @user The user to create
	 *
	 * @return Mail results: { error: boolean, errorArray: array }
	 */
	struct function createRegistration( required user ) {
		transaction {
			save( arguments.user )
			return sendRegistrationVerificationEmail( arguments.user )
		}
	}

	/**
	 * Create a new user in the system and send them an invitation email.  The user is created but it is NOT verified.
	 *
	 * @user The user to create
	 *
	 * @return Mail results: { error: boolean, errorArray: array }
	 */
	struct function createInvitation( required user ) {
		// Clear the password so that the user cannot log in until they set their own
		arguments.user.setPassword( "" )
		transaction {
			save( arguments.user )
			return sendInvitationEmail( arguments.user )
		}
	}

	/**
	 * Save a user in the database
	 *
	 * @user           The user to save
	 * @passwordChange Are we changing the user's password
	 *
	 * @return The persisted user
	 */
	User function save(
		required user,
		boolean passwordChange = false
	) {
		// bcrypt the password if new user or change requested
		if ( ( !arguments.user.isLoaded() || arguments.passwordChange ) && len( arguments.user.getPassword() ) ) {
			// Setup the password with bcrypt
			arguments.user.setPassword( BCryptHash( arguments.user.getPassword() ) )
			// Revoke tokens if the user is changing their password
			if( arguments.user.isLoaded() ){
				securityService.revokeRememberTokensForUser( arguments.user.getId() )
			}
		}

		arguments.entity = arguments.user

		// save the user and return it
		return super.save( argumentCollection: arguments )
	}

	/**
	 * This function takes an incoming sort order from a form,
	 * and returns only valid sort orders.
	 * If the sort order is invalid, it will default to lastName asc.
	 *
	 * @sortOrder The sort order to validate
	 *
	 * @return The validated sort order
	 */
	string function ensureSortOrder( string sortOrder ) {
		return super.ensureSortOrder(
			sortOrder: arguments.sortOrder,
			sortMap: static.SORT_MAP,
			defaultSortOrder: static.DEFAULT_SORT_ORDER
		)
	}

	/**
	 * This returns a struct report of the user counts according to state:
	 * - all
	 * - active
	 * - pending
	 * - inactive
	 */
	struct function userCountsReport() {
		return {
			all: count(),
			active: count( "isActive = ? AND verifiedAt IS NOT NULL", [ true ] ),
			pending: count( "isActive = ? AND verifiedAt IS NULL", [ true ] ),
			inactive: count( "isActive = ?", [ false ] )
		}
	}

	/**
	 * Search users across different criteria with pagination
	 *
	 * @searchTerm The search term to look for in: firstName, lastName, email
	 * @offset     The offset pagination
	 * @max        The max records to return, defaults to 10
	 * @isActive   If passed, active, inactive or all users
	 * @isVerified If passed, verified or unverified users
	 * @roleId     If passed, the role Id to filter the users on
	 * @excludeRoleId If passed, excludes users assigned to the role Id
	 * @sortOrder  The sort ordering to do. Defaults to sort by name
	 * @propertyList The list or array of properties to include in the results as a projection instead of ORM Objects
	 *
	 * @return     struct of { count:numeric, records:array }
	 */
	struct function search(
		string searchTerm = "",
		numeric offset = 0,
		numeric max = 25,
		boolean isActive,
		boolean isVerified,
		string roleId,
		string excludeRoleId = "",
		string sortOrder = static.DEFAULT_SORT_ORDER,
		any propertyList = ""
	) {
		var results = { "count": 0, "records": [] }

		// Validate the sort order
		arguments.sortOrder = ensureSortOrder( arguments.sortOrder )

		// If the property list is an array, convert it to a list for the criteria builder
		if( isArray( arguments.propertyList ) ) {
			arguments.propertyList = arguments.propertyList.toList()
		}

		var c = newCriteria()
			// Search Terms
			.when( len( arguments.searchTerm ), ( c ) => {
				c.or(
					c.restrictions.like( "firstName", "%#searchTerm#%" ),
					c.restrictions.like( "lastName", "%#searchTerm#%" ),
					c.restrictions.like( "email", "%#searchTerm#%" )
				)
			} )
			// Is Active
			.when( !isNull( arguments.isActive ), ( c ) => c.eq( "isActive", isActive castAs "Boolean" ) )
			// Verified
			.when( !isNull( arguments.isVerified ), ( c ) => isVerified ? c.isNotNull( "verifiedAt" ) : c.isNull( "verifiedAt" )  )
			// Role Filters
			.when( !isNull( arguments.roleId ) && len( arguments.roleId ), ( c ) => c.eq( "roles.roleId", roleId ) )
			.when( len( arguments.excludeRoleId ), ( c ) => c.ne( "roles.roleId", excludeRoleId ) )

		// Run Results
		results.count = c.count( "userId" )

		// If we have a property list, then we will use projections to return a struct instead of ORM objects
		if ( len( arguments.propertyList ) ) {
			c.withProjections( property: arguments.propertyList ).asStruct()
		}

		results.records = c.list( offset: arguments.offset, max: arguments.max, sortOrder: arguments.sortOrder )

		// If we have a property list, then we will need to do some additional processing to get the roles and invitation details for each user
		if ( len( arguments.propertyList ) && results.records.len() ) {
			// --- Get all Roles for the user
			var userIds = results.records.map( user -> user.userId )
			var roleRows = roleService
				.newCriteria()
				.createAlias( "users", "user" )
				.isIn( "user.userId", userIds )
				.withProjections( property: "user.userId:userId,role:roleName" )
				.asStruct()
				.list()
			var rolesByUser = {}

			roleRows.each( ( roleRow ) => {
				if ( !structKeyExists( rolesByUser, roleRow.userId ) ) {
					rolesByUser[ roleRow.userId ] = []
				}
				rolesByUser[ roleRow.userId ].append( roleRow.roleName )
			} )

			results.records.each( ( user ) => {
				user.roles = structKeyExists( rolesByUser, user.userId ) ? rolesByUser[ user.userId ] : []
			} )

			// -- Get all Invitation Details for the user
			var invitationRows = variables.userActionTokenService.getInvitationDetails( userIds )
			var invitationsByUser = {}
			invitationRows.each( ( invitation ) => {
				if ( !structKeyExists( invitationsByUser, invitation.userId ) ) {
					invitationsByUser[ invitation.userId ] = invitation
				}
			} )

			results.records.each( ( user ) => {
				var invitation = invitationsByUser[ user.userId ] ?: {}
				user.invitationInvitedAt = invitation.invitedAt ?: null
				user.invitationExpiresAt = invitation.expiresAt ?: null
				user.invitationStatus = user.verifiedAt != null
					? "Accepted"
					: structKeyExists( invitation, "expiresAt" )
						? dateCompare( invitation.expiresAt, now(), "s" ) <= 0 ? "Expired" : "Invited"
						: "Not invited"
				user.canResendInvitation = isNull( user.verifiedAt ) && [ "Invited", "Expired" ].contains( user.invitationStatus )
			} )
		}

		return results
	}

	/**
	 * Delete a user from  the system
	 *
	 * @user The user to delete
	 */
	function delete( required user ) {
		transaction {
			// Any manual cleanup of relationships??

			// Delete the user with cascade
			super.delete( arguments.user )
		}
	}


	/**
	 * Send a purpose-bound registration verification email to a user.
	 *
	 * @user The user to send the registration verification to
	 *
	 * @return Mail results: { error: boolean, errorArray: array }
	 */
	struct function sendRegistrationVerificationEmail( required user ) {
		var settings = variables.settingService.getAllSettings()
		var event = variables.requestService.getContext()
		var tokenResult = variables.userActionTokenService.issue(
			user: arguments.user,
			purpose: variables.userActionTokenService.PURPOSE_REGISTRATION,
			expiresAt: dateAdd( "h", settings.cbRegistrationVerificationExpiration, now() )
		)
		var token = tokenResult.rawToken

		var bodyTokens = {
			name: arguments.user.getFullName(),
			email: arguments.user.getEmail(),
			appName: settings.cbAppName,
			appNameInitial: left( settings.cbAppName, 1 ),
			linkTimeout: settings.cbRegistrationVerificationExpiration & " hours",
			linkToken: event.buildLink( "verify-registration?token=#token#" )
		}

		return variables.mailservice.newMail()
			.configure( to: arguments.user.getEmail(), from: settings.cbDefaultEmail, subject: "Verify your " & settings.cbAppName & " account", bodyTokens: bodyTokens, type: "html" )
			.setBody( variables.renderer.externalView( "/app/email_templates/registration_verification" ) )
			.send().getResults()
	}

	/**
	 * Send a purpose-bound invitation email to a user, it automatically generates a new invitation token for the mail.
	 *
	 * @user The user to send the invitation to
	 *
	 * @return Mail results: { error: boolean, errorArray: array }
	 */
	struct function sendInvitationEmail( required user ) {
		var settings = variables.settingService.getAllSettings()
		var event = variables.requestService.getContext()
		var tokenResult = variables.userActionTokenService.issue(
			user: arguments.user,
			purpose: variables.userActionTokenService.PURPOSE_INVITATION,
			expiresAt: dateAdd( "d", settings.cbInvitationExpiration, now() )
		)
		var token = tokenResult.rawToken

		// Prepare replacement tokens
		var bodyTokens = {
			name: arguments.user.getFullName(),
			email: arguments.user.getEmail(),
			appName: settings.cbAppName,
			appNameInitial: left( settings.cbAppName, 1 ),
			linkTimeout: settings.cbInvitationExpiration & " days",
			linkToken: event.buildLink( "activate-invitation?token=#token#" )
		}

		// Build email out
		return variables.mailservice
			.newMail()
			.configure(
				to: arguments.user.getEmail(),
				from: settings.cbDefaultEmail,
				subject: "You have been invited to " & settings.cbAppName,
				bodyTokens: bodyTokens,
				type: "html"
			)
			.setBody(
				variables.renderer.externalView( "/app/email_templates/user_welcome" )
			)
			.send()
			.getResults()
	}

	/**
	 * Revoke the current invitation and send a replacement invitation email.
	 *
	 * @user The unverified user to invite again.
	 *
	 * @throws "UserInvitation.AlreadyAccepted" if the user has already accepted their invitation.
	 *
	 * @return Mail results: { error: boolean, errorArray: array }
	 */
	struct function resendInvitation( required user ) {
		if ( arguments.user.isEmailVerified() ) {
			throw( type: "UserInvitation.AlreadyAccepted", message: "This user has already accepted their invitation." )
		}

		transaction {
			variables.userActionTokenService.revokeForUser(
				userId: arguments.user.getUserId(),
				purpose: variables.userActionTokenService.PURPOSE_INVITATION
			)
			return sendInvitationEmail( arguments.user )
		}
	}

	/**
	 * Send a password reminder email to a user
	 *
	 * @user        The user
	 * @issuer      The admin user that issued the reset
	 *
	 * @return error:boolean,errorArray
	 */
	struct function sendPasswordReminder( required user, issuer ) {
		// If the issuer is not null, then we will set the user to be in a password reset state.
		// This will prevent them from logging in until they reset their password.
		if ( !isNull( arguments.issuer ) ) {
			arguments.user.setIsPasswordReset( true )
			save( arguments.user )
		}
		// Generate a password reset token and send the email
		var token = variables.securityService.generatePasswordResetToken( arguments.user )
		var settings = variables.settingService.getAllSettings()
		var event = variables.requestService.getContext()

		// Prepare replacement tokens
		var bodyTokens = {
			name: arguments.user.getFullName(),
			email: arguments.user.getEmail(),
			appName: settings.cbAppName,
			appNameInitial: left( settings.cbAppName, 1 ),
			linkTimeout: settings.cbPasswordResetExpiration,
			ip: variables.cbSecurity.getRealIP(),
			linkToken: event.buildLink( "reset-password?token=#token#" ),
			issuedBy: isNull( arguments.issuer ) ? "" : arguments.issuer.getFullName(),
			issuedEmail: isNull( arguments.issuer ) ? "" : arguments.issuer.getEmail()
		}

		// Build email out
		return variables.mailservice
			.newMail()
			.configure(
				to: arguments.user.getEmail(),
				from: settings.cbDefaultEmail,
				subject: "A " & settings.cbAppName & " Password Reset Verification",
				bodyTokens: bodyTokens,
				type: "html"
			)
			.setBody( variables.renderer.externalView( view: "/app/email_templates/password_verification", args:{
				hasIssued: !isNull( arguments.issuer )
			} ) )
			.send()
			.getResults()
	}

	/**
	 * Resets a user's password.
	 *
	 * @token    Security token
	 * @user     The user you are reseting the password for
	 * @password The password you have chosen to reset with
	 *
	 * @return {error:boolean, errorArray:array}
	 */
	struct function resetPassword( required token, required user, required password ) {
		var settings = variables.settingService.getAllSettings()
		var event = variables.requestService.getContext()

		transaction {
			// set it in the user and save reset password
			arguments.user
				.setPassword( arguments.password )
				.setIsPasswordReset( false )
				.save( passwordChange = true )

			// Remove token now that we have the data and it has been validated
			variables.securityService.clearPasswordResetToken( arguments.token )

			// get mail payload
			var bodyTokens = {
				name: arguments.user.getFullName(),
				email: arguments.user.getEmail(),
				company: settings.cbAppName,
				companyInitial: left( settings.cbAppName, 1 ),
				companyEmail: settings.cbDefaultEmail,
				ip: variables.cbSecurity.getRealIP(),
				linkLogin: event.buildLink( "login" )
			}

			var mail = variables.mailservice.newMail();

			mail.configure(
				to: arguments.user.getEmail(),
				from: settings.cbDefaultEmail,
				subject: "Password Reset Completed",
				bodyTokens: bodyTokens,
				type: "html"
			)

			mail.setBody( variables.renderer.externalView( "/app/email_templates/password_reset" ) )

			// send it out
			return mail
				.send()
				.getResults()
		}
		// end of transaction
	}

}