 * www.ortussolutions.com
 * ---
 * A global setting object
 */
@persistent( true )
@table( "settings" )
class extends="app.models.BaseEntity" {

	/**
	 * --------------------------------------------------------------------------
	 * Persisted Properties
	 * --------------------------------------------------------------------------
	 */

	@fieldType( "id" )
	@generator( "uuid" )
	property
		name="settingId"
		setter="false";

	@notNull( true )
	@unique( true )
	property name="name" default="";

	@ormType( "text" )
	@notNull( true )
	property name="value" default="";

	/**
	 * --------------------------------------------------------------------------
	 * Population Options
	 * --------------------------------------------------------------------------
	 */
	this.population = { exclude: [ "settingId" ] }

	/**
	 * --------------------------------------------------------------------------
	 * Validation Constraints
	 * --------------------------------------------------------------------------
	 */
	this.constraints = {
		"name": {
			required : true,
			size     : "1..255",
			validator: "UniqueValidator@cborm"
		},
		"value": { required: true }
	}

	/**
	 * --------------------------------------------------------------------------
	 * Memento Configuration
	 * --------------------------------------------------------------------------
	 */
	this.memento = {
		// Default properties to serialize
		defaultIncludes: [ "*" ],
		// Default Exclusions
		defaultExcludes: [],
		// Never Include
		neverInclude   : []
	}

	/**********************************************************************
	 * **							PUBLIC METHODS
	 **********************************************************************/

	/**
	 * Constructor
	 */
	function init() {
		super.init( "settingId" )
		variables.name = ""
		variables.value = ""
		return this
	}
}