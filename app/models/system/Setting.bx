 * ---
 * A global setting object
 */
class extends="app.models.BaseEntity" {

	/**
	 * --------------------------------------------------------------------------
	 * Persisted Properties
	 * --------------------------------------------------------------------------
	 */

	property name="name" notnull="true" unique="true";

	property name="value" notnull="true" default="";

	property name="description" default="";

	/**
	 * --------------------------------------------------------------------------
	 * Validatation Constraints
	 * --------------------------------------------------------------------------
	 */
	this.constraints = {
		"name": {
			required : true,
			size     : "1..255",
			validator: "UniqueValidator"
		},
		"value": { required: true }
	}

	/**
	 * --------------------------------------------------------------------------
	 * Memento Configuration
	 * --------------------------------------------------------------------------
	 */
	this.memento = {
		// Default properties to serialize
		defaultIncludes: [ "*"],
		// Default Exclusions
		defaultExcludes: [],
		// Never Include
		neverInclude   : []
	}

	/**********************************************************************
	 * **							PUBLIC METHODS
	 **********************************************************************/

	/**
	 * Constructor
	 */
	function init() {
		return super.init( "settingId" )
	}
}